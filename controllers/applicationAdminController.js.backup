/* ==========================================================
   Reject Application
========================================================== */

exports.rejectApplication = (req, res) => {

    const applicationId = req.params.id;

    Application.updateStatus(applicationId, "Rejected", (err) => {

        if (err) {
            console.error("Reject Application Error:", err);

            req.flash(
                "error",
                "Unable to reject application."
            );

            return res.redirect(
                "/admin/application/" + applicationId
            );
        }

        req.flash(
            "success",
            "Application rejected successfully."
        );

        return res.redirect(
            "/admin/application/" + applicationId
        );

    });

};


/* ==========================================================
   Edit Application Page
========================================================== */

exports.editApplicationPage = (req, res) => {

    const applicationId = req.params.id;

    Application.getById(applicationId, (err, rows) => {

        if (err) {
            console.error("Edit Page Error:", err);
            return res.redirect("/admin/applications");
        }

        if (!rows || rows.length === 0) {

            req.flash(
                "error",
                "Application not found."
            );

            return res.redirect("/admin/applications");

        }

        res.render("admin/edit-application", {

            title: "Edit Application",
            application: rows[0]

        });

    });

};


/* ==========================================================
   Update Application
========================================================== */

exports.updateApplication = (req, res) => {

    const applicationId = req.params.id;

    Application.update(applicationId, req.body, (err) => {

        if (err) {

            console.error("Update Application Error:", err);

            req.flash(
                "error",
                "Unable to update application."
            );

            return res.redirect(
                "/admin/application/" +
                applicationId +
                "/edit"
            );

        }

        req.flash(
            "success",
            "Application updated successfully."
        );

        return res.redirect(
            "/admin/application/" + applicationId
        );

    });

};







