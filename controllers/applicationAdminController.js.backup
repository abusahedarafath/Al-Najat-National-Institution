const bcrypt = require("bcryptjs");

const Application = require("../models/Application");
const Student = require("../models/Student");
const StudentUser = require("../models/StudentUser");
const ApplicationDocument = require("../models/ApplicationDocument");


/* ==========================================================
   Show All Applications
========================================================== */


    Application.getAll((err, applications) => {

        if (err) {
            console.error("Load Applications Error:", err);
            req.flash("error", "Unable to load applications.");
            return res.redirect("/admin");
        }

        res.render("admin/applications", {
            title: "Applications",
            applications
        });

    });

};



exports.showApplications = async (req, res) => {


    try {

        const applications = await Application.getAll();

        res.render("admin/applications", {
            title: "Applications",
            applications
        });

    } catch (err) {

        console.error("Load Applications Error:", err);
        req.flash("error", "Unable to load applications.");
        res.redirect("/admin");

    }

};

/* ==========================================================
   View Single Application
========================================================== */

    const applicationId = req.params.id;

    Application.getById(applicationId, (err, rows) => {

        if (err) {
            console.error(err);
            return res.redirect("/admin/applications");
        }

        if (!rows || rows.length === 0) {
            req.flash("error", "Application not found.");
            return res.redirect("/admin/applications");
        }

        const application = rows[0];

        ApplicationDocument.getByApplicationId(
            applicationId,
            (err, documents) => {

                if (err) {
                    console.error(err);
                    documents = [];
                }

                res.render("admin/application-details", {
                    title: "Application Details",
                    application,
                    documents
                });

            }
        );

    });

};





exports.viewApplication = async (req, res) => {

    try {

        const applicationId = req.params.id;

        const rows = await Application.getById(applicationId);

        if (!rows || rows.length === 0) {
            req.flash("error", "Application not found.");
            return res.redirect("/admin/applications");
        }

        const application = rows[0];

        ApplicationDocument.getByApplicationId(applicationId, (err, documents) => {

            if (err) {
                console.error(err);
                documents = [];
            }

            res.render("admin/application-details", {
                title: "Application Details",
                application,
                documents
            });

        });

    } catch (err) {

        console.error(err);
        req.flash("error", "Unable to load application.");
        res.redirect("/admin/applications");

    }

};



