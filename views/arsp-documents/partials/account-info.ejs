<div class="section-title">

MEMBER LOGIN INFORMATION

</div>

<div
style="
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
margin-bottom:20px;">

<div
style="
border:2px solid #0B6B3A;
border-radius:8px;
overflow:hidden;">

<div
style="
background:#0B6B3A;
color:#fff;
padding:8px 12px;
font-weight:bold;">

Login Details

</div>

<table class="table">

<tr>

<td>Username</td>

<td><%= username %></td>

</tr>

<tr>

<td>Password</td>

<td><%= password %></td>

</tr>

<tr>

<td>Login URL</td>

<td>

<small>

<%= loginUrl %>

</small>

</td>

</tr>

<tr>

<td>Source</td>

<td><%= registrationSource %></td>

</tr>

<tr>

<td>Status</td>

<td>

<strong style="color:#0B6B3A;">

<%= member.status %>

</strong>

</td>

</tr>

</table>

</div>

<div
style="
background:#FFF8E8;
border-left:5px solid #F0AD4E;
padding:15px;
border-radius:8px;">

<strong>

Important Instructions

</strong>

<ul
style="
margin-top:10px;
padding-left:18px;
line-height:1.7;
font-size:13px;">

<li>Keep this registration slip safe.</li>

<li>Use your Member ID to log in.</li>

<li>Change the temporary password after first login.</li>

<li>Do not share your password.</li>

<li>Download your ID Card after logging in.</li>

</ul>

</div>

</div>
