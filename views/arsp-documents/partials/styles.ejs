<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

@page{
size:A4 portrait;
margin:8mm;
}

body{
background:#ececec;
font-family:Arial,Helvetica,sans-serif;
color:#222;
padding:20px;
}

.page{

width:210mm;

margin:0 auto;

background:#fff;

}

.slip-card{

background:#fff;

border:3px double #0B6B3A;

border-radius:8px;

padding:20px;

box-shadow:0 5px 15px rgba(0,0,0,.12);

}

.header{

display:flex;

align-items:center;

justify-content:space-between;

border-bottom:2px solid #0B6B3A;

padding-bottom:12px;

margin-bottom:15px;

}

.logo{

width:70px;

height:70px;

object-fit:contain;

}

.header-center{

flex:1;

text-align:center;

padding:0 15px;

}

.org-title{

font-size:24px;

font-weight:bold;

color:#0B6B3A;

text-transform:uppercase;

}

.org-sub{

font-size:12px;

color:#666;

margin-top:4px;

}

.document-title{

margin-top:10px;

display:inline-block;

padding:8px 20px;

background:#0B6B3A;

color:#fff;

border-radius:4px;

font-size:15px;

font-weight:bold;

letter-spacing:.5px;

text-transform:uppercase;

}

.verify-box{

width:110px;

text-align:center;

}

.verify-box img{

width:90px;

height:90px;

object-fit:contain;

}

.verify-text{

font-size:11px;

font-weight:bold;

margin-top:5px;

color:#0B6B3A;

}





.main-content{

display:flex;

gap:18px;

align-items:flex-start;

margin-top:15px;

}

.left-section{

flex:1;

}

.right-section{

width:130px;

text-align:center;

}

.photo-box{

border:2px solid #0B6B3A;

padding:6px;

border-radius:6px;

background:#fafafa;

}

.photo-box img{

width:100%;

height:160px;

object-fit:cover;

display:block;

}

.member-status{

margin-top:10px;

background:#0B6B3A;

color:#fff;

padding:6px;

font-size:12px;

font-weight:bold;

border-radius:4px;

}

.info-table{

width:100%;

border-collapse:collapse;

font-size:13px;

}

.info-table td{

border:1px solid #d9d9d9;

padding:7px 9px;

vertical-align:middle;

}

.info-table .label{

width:170px;

background:#F5F8F5;

font-weight:bold;

color:#0B6B3A;

}

.section-box{

margin-top:18px;

border:1px solid #d9d9d9;

border-left:5px solid #0B6B3A;

padding:12px;

border-radius:4px;

background:#FCFCFC;

}

.section-title{

font-size:15px;

font-weight:bold;

color:#0B6B3A;

margin-bottom:8px;

text-transform:uppercase;

letter-spacing:.4px;

}

.section-box p{

font-size:13px;

line-height:1.6;

}

.section-box ul{

margin-top:8px;

padding-left:18px;

}

.section-box li{

margin-bottom:6px;

font-size:13px;

}


.qr-panel{

margin-top:15px;

border:2px solid #0B6B3A;

border-radius:6px;

padding:10px;

text-align:center;

background:#fff;

}

.qr-panel img{

width:90px;

height:90px;

object-fit:contain;

display:block;

margin:auto;

}

.qr-panel h4{

margin-top:8px;

font-size:13px;

color:#0B6B3A;

}

.auth-box{

margin-top:18px;

display:grid;

grid-template-columns:1fr 1fr;

gap:15px;

}

.auth-card{

border:1px solid #d9d9d9;

padding:12px;

border-radius:5px;

background:#fafafa;

}

.auth-card h4{

color:#0B6B3A;

margin-bottom:8px;

font-size:14px;

}

.signature-area{

display:flex;

justify-content:space-between;

margin-top:30px;

gap:20px;

}

.signature{

flex:1;

text-align:center;

}

.signature-space{

height:28px;

}

.signature hr{

border:none;

border-top:1px solid #333;

margin-bottom:5px;

}

.signature span{

font-size:12px;

font-weight:bold;

color:#0B6B3A;

}

.footer{

margin-top:20px;

padding-top:10px;

border-top:1px solid #bbb;

display:flex;

justify-content:space-between;

align-items:center;

font-size:11px;

color:#555;

}

.footer-left{

line-height:1.6;

}

.footer-right{

text-align:right;

line-height:1.6;

}

.action-buttons{

margin-top:20px;

display:flex;

justify-content:center;

gap:12px;

}

.btn{

background:#0B6B3A;

color:#fff;

padding:10px 18px;

text-decoration:none;

border:none;

border-radius:4px;

cursor:pointer;

font-size:14px;

}

.btn:hover{

background:#084d2b;

}

@media print{

body{

background:#fff;

padding:0;

}

.page{

width:100%;

margin:0;

}

.slip-card{

box-shadow:none;

border:2px double #0B6B3A;

}

.action-buttons{

display:none;

}

}
</style>
