<footer class="footer">

    <div class="footer-container">

        <!-- =========================
             ORGANIZATION
        ========================== -->

        <div class="footer-column">

            <% if (siteSettings && siteSettings.logo) { %>
                <img
                    src="/uploads/site-settings/<%= siteSettings.logo %>"
                    alt="<%= siteSettings.institution_name || '' %>"
                    class="footer-logo"
                >
            <% } %>

            <% if (siteSettings && siteSettings.institution_name) { %>
                <h3>
                    <%= siteSettings.institution_name %>
                </h3>
            <% } %>

            <% if (footerSettings && footerSettings.description) { %>
                <p>
                    <%= footerSettings.description %>
                </p>
            <% } %>

        </div>


        <!-- =========================
             QUICK LINKS
        ========================== -->

        <div class="footer-column">

            <h3>Quick Links</h3>

            <ul>

                <% if (footerLinks && footerLinks.length) { %>

                    <% footerLinks
                        .filter(link => link.section === "quick" && link.is_active)
                        .forEach(link => { %>

                        <li>
                            <a href="<%= link.url %>">
                                <%= link.title %>
                            </a>
                        </li>

                    <% }) %>

                <% } %>

            </ul>

        </div>


        <!-- =========================
             LATEST NEWS
        ========================== -->

        <div class="footer-column">

            <h3>Latest News</h3>

            <ul>

                <% if (latestNews && latestNews.length) { %>

                    <% latestNews.forEach(news => { %>

                        <li>
                            <a href="/news/<%= news.id %>">
                                <%= news.title %>
                            </a>
                        </li>

                    <% }) %>

                <% } %>

            </ul>

        </div>


        <!-- =========================
             CONTACT
        ========================== -->

        <div class="footer-column">

            <h3>Contact</h3>

            <% if (footerSettings && footerSettings.address) { %>
                <p>
                    📍 <%= footerSettings.address %>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.phone) { %>
                <p>
                    📞
                    <a href="tel:<%= footerSettings.phone %>">
                        <%= footerSettings.phone %>
                    </a>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.email) { %>
                <p>
                    ✉
                    <a href="mailto:<%= footerSettings.email %>">
                        <%= footerSettings.email %>
                    </a>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.whatsapp) { %>
                <p>
                    💬 <%= footerSettings.whatsapp %>
                </p>
            <% } %>


            <!-- Social Media -->

            <% if (footerSocialLinks && footerSocialLinks.length) { %>

                <div class="footer-social">

                    <% footerSocialLinks
                        .filter(social => social.is_active)
                        .forEach(social => { %>

                        <a
                            href="<%= social.url %>"
                            target="_blank"
                            rel="noopener"
                            aria-label="<%= social.platform %>"
                            title="<%= social.platform %>"
                        >

                            <% if (social.icon_class) { %>
                                <i class="<%= social.icon_class %>"></i>
                            <% } %>

                        </a>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =========================
         COPYRIGHT
    ========================== -->

    <div class="footer-bottom">

        <% if (footerSettings && footerSettings.copyright_text) { %>
            <%= footerSettings.copyright_text %>
        <% } %>

        <% if (footerSettings && footerSettings.developer_text) { %>
            <span>
                <%= footerSettings.developer_text %>
            </span>
        <% } %>

    </div>

</footer>

<script src="/js/honour-heart-popup.js"></script>

    <script src="/js/form-navigation.js"></script>
</body>
</html>
