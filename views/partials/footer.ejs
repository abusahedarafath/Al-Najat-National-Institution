<footer class="footer">

    <div class="footer-container">

        <!-- =========================
             ORGANIZATION
        ========================== -->

        <div class="footer-column">

            <% if (siteSettings && siteSettings.logo) { %>
                <img
                    src="/uploads/site-settings/<%= siteSettings.logo %>"
                    alt="<%= siteSettings.institution_name || '' %>"
                    class="footer-logo"
                >
            <% } %>

            <% if (siteSettings && siteSettings.institution_name) { %>
                <h3>
                    <%= siteSettings.institution_name %>
                </h3>
            <% } %>

            <% if (footerSettings && footerSettings.description) { %>
                <p>
                    <%= footerSettings.description %>
                </p>
            <% } %>

        </div>


        <!-- =========================
             QUICK LINKS
        ========================== -->

        <div class="footer-column">

            <h3>Quick Links</h3>

            <ul>

                <% if (footerLinks && footerLinks.length) { %>

                    <% footerLinks
                        .filter(link => link.section === "quick" && link.is_active)
                        .forEach(link => { %>

                        <li>
                            <a href="<%= link.url %>">
                                <%= link.title %>
                            </a>
                        </li>

                    <% }) %>

                <% } %>

            </ul>

        </div>


        <!-- =========================
             LATEST NEWS
        ========================== -->

        <div class="footer-column">

            <h3>Latest News</h3>

            <ul>

                <% if (latestNews && latestNews.length) { %>

                    <% latestNews.forEach(news => { %>

                        <li>
                            <a href="/news/<%= news.id %>">
                                <%= news.title %>
                            </a>
                        </li>

                    <% }) %>

                <% } %>

            </ul>

        </div>


        <!-- =========================
             CONTACT
        ========================== -->

        <div class="footer-column">

            <h3>Contact</h3>

            <% if (footerSettings && footerSettings.address) { %>
                <p>
                    📍 <%= footerSettings.address %>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.phone) { %>
                <p>
                    📞
                    <a href="tel:<%= footerSettings.phone %>">
                        <%= footerSettings.phone %>
                    </a>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.email) { %>
                <p>
                    ✉
                    <a href="mailto:<%= footerSettings.email %>">
                        <%= footerSettings.email %>
                    </a>
                </p>
            <% } %>

            <% if (footerSettings && footerSettings.whatsapp) { %>
                <p>
                    💬 <%= footerSettings.whatsapp %>
                </p>
            <% } %>


            <!-- Social Media -->

            <% if (footerSocialLinks && footerSocialLinks.length) { %>

                <div class="footer-social">

                    <% footerSocialLinks
                        .filter(social => social.is_active)
                        .forEach(social => { %>

                        <a
                            href="<%= social.url %>"
                            target="_blank"
                            rel="noopener"
                            aria-label="<%= social.platform %>"
                            title="<%= social.platform %>"
                        >

                            <% if (social.icon_class) { %>
                                <i class="<%= social.icon_class %>"></i>
                            <% } %>

                        </a>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =========================
         COPYRIGHT
    ========================== -->

    <div class="footer-bottom">

        <% if (footerSettings && footerSettings.copyright_text) { %>
            <%= footerSettings.copyright_text %>
        <% } %>

        <% if (footerSettings && footerSettings.developer_text) { %>
            <span>
                <%= footerSettings.developer_text %>
            </span>
        <% } %>

    </div>

</footer>

<script src="/js/honour-heart-popup.js"></script>

    <script src="/js/form-navigation.js"></script>
<script>
(function () {
    "use strict";

    const VISITOR_STORAGE_KEY = "alnajat_visitor_id";
    const HEARTBEAT_INTERVAL = 5000;

    function generateVisitorId() {
        if (
            window.crypto &&
            typeof window.crypto.randomUUID === "function"
        ) {
            return window.crypto.randomUUID();
        }

        return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
            /[xy]/g,
            function (character) {
                const random =
                    Math.random() * 16 | 0;

                const value =
                    character === "x"
                        ? random
                        : (random & 0x3 | 0x8);

                return value.toString(16);
            }
        );
    }

    function getVisitorId() {
        try {
            let visitorId =
                localStorage.getItem(
                    VISITOR_STORAGE_KEY
                );

            if (!visitorId) {
                visitorId = generateVisitorId();

                localStorage.setItem(
                    VISITOR_STORAGE_KEY,
                    visitorId
                );
            }

            return visitorId;
        } catch (error) {
            return generateVisitorId();
        }
    }

    const visitorId = getVisitorId();

    let heartbeatInFlight = false;
    let liveStatusInFlight = false;

    function getCurrentPath() {
        return (
            window.location.pathname +
            window.location.search
        );
    }

    function sendHeartbeat() {
        if (heartbeatInFlight) {
            return;
        }

        heartbeatInFlight = true;

        fetch("/visitor/heartbeat", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            credentials: "same-origin",
            body: JSON.stringify({
                visitorId: visitorId,
                path: getCurrentPath()
            }),
            keepalive: true
        })
        .catch(function () {
            // Visitor statistics must never interrupt
            // the public website experience.
        })
        .finally(function () {
            heartbeatInFlight = false;
        });
    }

    function sendLiveStatus(isLive, useBeacon) {
        const payload = JSON.stringify({
            visitorId: visitorId,
            path: getCurrentPath(),
            isLive: Boolean(isLive)
        });

        if (useBeacon && navigator.sendBeacon) {
            try {
                const blob = new Blob(
                    [payload],
                    {
                        type: "application/json"
                    }
                );

                if (
                    navigator.sendBeacon(
                        "/visitor/live-status",
                        blob
                    )
                ) {
                    return;
                }
            } catch (error) {
                // Fall through to fetch.
            }
        }

        if (liveStatusInFlight) {
            return;
        }

        liveStatusInFlight = true;

        fetch("/visitor/live-status", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            credentials: "same-origin",
            body: payload,
            keepalive: true
        })
        .catch(function () {
            // Visitor statistics must never interrupt
            // the public website experience.
        })
        .finally(function () {
            liveStatusInFlight = false;
        });
    }

    // A page becomes a live visit when it is opened.
    sendLiveStatus(true, false);
    sendHeartbeat();

    // Heartbeat records visitor activity only.
    // It does NOT control the live visitor state.
    window.setInterval(
        sendHeartbeat,
        HEARTBEAT_INTERVAL
    );

    // If the browser moves this page into the background,
    // consider the visit inactive.
    document.addEventListener(
        "visibilitychange",
        function () {
            if (document.visibilityState === "visible") {
                sendLiveStatus(true, false);
                sendHeartbeat();
            } else {
                sendLiveStatus(false, true);
            }
        }
    );

    // pagehide is the primary signal that the visitor has
    // actually left/navigated away from this page.
    window.addEventListener(
        "pagehide",
        function () {
            sendLiveStatus(false, true);
        }
    );
})();
</script>

</body>
</html>
