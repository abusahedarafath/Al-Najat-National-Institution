<!DOCTYPE html>
<html lang="en">
<head>




<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= typeof title !== "undefined" ? title : "Active Rural Social Progress" %></title>

<meta name="description"
      content="<%= typeof metaDescription !== "undefined" ? metaDescription : "Active Rural Social Progress (ARSP) — education, rural development, student empowerment and social progress initiatives." %>">

<meta name="robots"
      content="<%= typeof noIndex !== "undefined" && noIndex ? "noindex, nofollow" : "index, follow" %>">

<link rel="canonical"
      href="https://arsp.co.in<%= typeof canonicalPath !== "undefined" ? canonicalPath : "/" %>">

<meta property="og:type" content="website">
<meta property="og:title"
      content="<%= typeof title !== "undefined" ? title : "Active Rural Social Progress" %>">
<meta property="og:description"
      content="<%= typeof metaDescription !== "undefined" ? metaDescription : "Active Rural Social Progress (ARSP) — education, rural development, student empowerment and social progress initiatives." %>">
<meta property="og:url"
      content="https://arsp.co.in<%= (typeof canonicalPath !== "undefined" ? canonicalPath : "/") %>">
<meta property="og:site_name" content="Active Rural Social Progress">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title"
      content="<%= typeof title !== "undefined" ? title : "Active Rural Social Progress" %>">
<meta name="twitter:description"
      content="<%= typeof metaDescription !== "undefined" ? metaDescription : "Active Rural Social Progress (ARSP) — education, rural development, student empowerment and social progress initiatives." %>">

<link rel="stylesheet" href="/css/honour-heart.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/arsp-team.css">
<link rel="stylesheet" href="/css/navbar.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>
