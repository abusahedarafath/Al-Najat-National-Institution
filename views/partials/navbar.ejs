<header class="main-header">

    <!-- =====================================================
         HEADER MAIN
    ===================================================== -->

    <div class="arsp-header-main">

        <!-- =================================================
             LEFT: LOGO CONTAINER
        ================================================== -->

        <div class="arsp-logo-section">

            <div class="arsp-logo-box">

                <img
                    src="<%= siteSettings && siteSettings.logo
                        ? '/uploads/site-settings/' + siteSettings.logo
                        : '/images/logo.png' %>"
                    alt="<%= siteSettings && siteSettings.institution_name
                        ? siteSettings.institution_name
                        : 'Active Rural Social Progress' %>"
                    class="arsp-main-logo"
                >

                <!-- MOBILE MENU BUTTON -->

                <button
                    type="button"
                    id="mobileNavToggle"
                    class="arsp-mobile-menu"
                    aria-label="Open navigation"
                    aria-expanded="false">

                    <i class="fa-solid fa-bars"></i>

                </button>

            </div>


            <!-- =================================================
                 DYNAMIC ACTION BUTTONS
                 DIRECTLY UNDER LOGO
            ================================================== -->


        

            

        

            <div class="arsp-action-buttons">

                <!-- QR SCANNER -->

                <button
                    type="button"
                    id="openArspScanner"
                    class="arsp-action-btn arsp-qr-btn">

                    <i class="fa-solid fa-qrcode"></i>
                    <span>Scan QR Code</span>

                </button>


                <!-- DYNAMIC DATABASE BUTTONS -->

                <% if (headerButtons && headerButtons.length) { %>

                    <% headerButtons.forEach(button => { %>

                        <a
                            href="<%= button.url %>"
                            class="arsp-action-btn"

                            <% if (button.button_color) { %>
                                style="background:<%= button.button_color %>;"
                            <% } %>
                        >

                            <% if (button.icon) { %>

                                <i class="fa-solid fa-<%= button.icon %>"></i>

                            <% } %>

                            <span>
                                <%= button.title %>
                            </span>

                        </a>

                    <% }) %>

                <% } %>

            </div>

        </div>


        <!-- =================================================
             RIGHT: BRANDING CONTAINER
        ================================================== -->

        <div class="arsp-branding-section">

            <div class="arsp-branding-content">

                <h1>

                    <%= siteSettings
                        ? siteSettings.institution_name
                        : "Active Rural Social Progress" %>

                </h1>

                <p>

                    <%= siteSettings
                        ? siteSettings.tagline
                        : "Empowering Rural, Inspiring Future" %>

                </p>

            </div>

        </div>


            

    </div>


    <!-- =====================================================
         MOVING NOTICE
    ===================================================== -->

    <% if (scrollingMessages && scrollingMessages.length) { %>

        <div class="scrolling-messages">

            <div class="scrolling-messages-track">

                <% scrollingMessages.forEach(message => { %>

                    <a
                        href="<%= message.url || '#' %>"
                        class="scrolling-message"

                        style="color:<%= message.text_color || '#071d68' %>;"

                        <% if (!message.url) { %>
                            onclick="return false;"
                        <% } %>
                    >

                        <i class="fa-solid fa-bullhorn"></i>

                        <span>
                            <%= message.message %>
                        </span>

                    </a>

                <% }) %>

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         NAVIGATION
    ===================================================== -->

    <nav
        class="navbar"
        id="mainNavbar"
        aria-label="Main navigation">

        <%
            const parentMenus = [];
            const childMenus = {};

            if (menus && menus.length) {

                menus.forEach(menu => {

                    if (!menu.parent_id) {

                        parentMenus.push(menu);

                    } else {

                        if (!childMenus[menu.parent_id]) {
                            childMenus[menu.parent_id] = [];
                        }

                        childMenus[menu.parent_id].push(menu);

                    }

                });

            }
        %>


        <% parentMenus.forEach(parent => { %>

            <% const children = childMenus[parent.id] || []; %>


            <% if (children.length > 0) { %>

                <div class="dropdown">

                    <a
                        href="<%= parent.menu_url %>"
                        target="<%= parent.target %>"
                        class="dropdown-toggle">

                        <%= parent.menu_title %>

                    </a>

                    <div class="dropdown-content">

                        <% children.forEach(child => { %>

                            <a
                                href="<%= child.menu_url %>"
                                target="<%= child.target %>">

                                <%= child.menu_title %>

                            </a>

                        <% }) %>

                    </div>

                </div>


            <% } else { %>

                <a
                    href="<%= parent.menu_url %>"
                    target="<%= parent.target %>">

                    <%= parent.menu_title %>

                </a>

            <% } %>

        <% }) %>

    </nav>


    <!-- =====================================================
         ARSP SCANNER
    ===================================================== -->

    <%- include("../home/arsp-scanner") %>

</header>


<!-- =========================================================
     MOBILE MENU SCRIPT
========================================================= -->

<script>
(function () {

    const toggle = document.getElementById("mobileNavToggle");
    const navbar = document.getElementById("mainNavbar");

    if (!toggle || !navbar) return;

    /* =========================================
       MOBILE MAIN MENU
    ========================================= */

    toggle.addEventListener("click", function () {

        const opened = navbar.classList.toggle("mobile-open");

        toggle.setAttribute(
            "aria-expanded",
            opened ? "true" : "false"
        );

        toggle.setAttribute(
            "aria-label",
            opened
                ? "Close navigation"
                : "Open navigation"
        );

        const icon = toggle.querySelector("i");

        if (icon) {
            icon.className = opened
                ? "fa-solid fa-xmark"
                : "fa-solid fa-bars";
        }

    });


    /* =========================================
       MOBILE DROPDOWNS
    ========================================= */

    document
        .querySelectorAll(".dropdown > .dropdown-toggle")
        .forEach(function (link) {

            link.addEventListener("click", function (event) {

                if (window.innerWidth <= 768) {

                    event.preventDefault();

                    const dropdown =
                        this.parentElement;

                    dropdown.classList.toggle("open");

                }

            });

        });


    /* =========================================
       CLOSE MENU WHEN NORMAL LINK IS CLICKED
    ========================================= */

    navbar.querySelectorAll("a").forEach(function (link) {

        link.addEventListener("click", function () {

            if (
                window.innerWidth <= 768 &&
                !this.classList.contains("dropdown-toggle")
            ) {

                navbar.classList.remove("mobile-open");

                toggle.setAttribute(
                    "aria-expanded",
                    "false"
                );

                toggle.setAttribute(
                    "aria-label",
                    "Open navigation"
                );

                const icon =
                    toggle.querySelector("i");

                if (icon) {
                    icon.className =
                        "fa-solid fa-bars";
                }

            }

        });

    });


    /* =========================================
       RESET WHEN RETURNING TO DESKTOP
    ========================================= */

    window.addEventListener("resize", function () {

        if (window.innerWidth > 768) {

            navbar.classList.remove("mobile-open");

            document
                .querySelectorAll(".dropdown.open")
                .forEach(function (item) {

                    item.classList.remove("open");

                });

            toggle.setAttribute(
                "aria-expanded",
                "false"
            );

            toggle.setAttribute(
                "aria-label",
                "Open navigation"
            );

            const icon =
                toggle.querySelector("i");

            if (icon) {
                icon.className =
                    "fa-solid fa-bars";
            }

        }

    });

})();
</script>

