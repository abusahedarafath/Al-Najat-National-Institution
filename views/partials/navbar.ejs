<header class="main-header">

    <div class="header-top">

        <div class="brand">

            <img
                src="<%= siteSettings && siteSettings.logo ? '/uploads/site-settings/' + siteSettings.logo : '/images/logo.png' %>"
                alt="Logo"
                class="logo">

            <div class="brand-text">

                <h1>
                    <%= siteSettings
                        ? siteSettings.institution_name
                        : "Al-Najat National Institution" %>
                </h1>

                <p>
                    <%= siteSettings
                        ? siteSettings.tagline
                        : "An Islamic Madrasa Integrated School" %>
                </p>

            </div>

        </div>

        <div class="header-buttons">
            <button
                type="button"
                id="openArspScanner"
                class="login-btn header-button arsp-header-scanner"
                aria-label="Scan ARSP QR Code">
                <i class="fa-solid fa-qrcode"></i>
                Scan QR
            </button>

            <% if (headerButtons && headerButtons.length) { %>
                <% headerButtons.forEach(button => { %>
                    <a
                        href="<%= button.url %>"
                        class="login-btn header-button"
                        <% if (button.button_color) { %>
                            style="background:<%= button.button_color %>;"
                        <% } %>
                    >
                        <% if (button.icon) { %>
                            <i class="fa-solid fa-<%= button.icon %>"></i>
                        <% } %>
                        <%= button.title %>
                    </a>
                <% }) %>
            <% } %>
        </div>

    </div>

    <!-- =====================================
         SCROLLING NOTICE TICKER
    ====================================== -->

    <% if (scrollingMessages && scrollingMessages.length) { %>

        <div class="scrolling-messages">

            <div class="scrolling-messages-track">

                <% scrollingMessages.forEach(message => { %>

                    <a
                        href="<%= message.url || '#' %>"
                        class="scrolling-message"
                        style="color:<%= message.text_color %>;"
                        <% if (!message.url) { %>
                            onclick="return false;"
                        <% } %>
                    >
                        <i class="fa-solid fa-bullhorn"></i>
                        <span><%= message.message %></span>
                    </a>

                <% }) %>

            </div>

        </div>

    <% } %>


    <nav class="navbar">

        <%
            const parentMenus = [];
            const childMenus = {};

            if (menus && menus.length) {
                menus.forEach(menu => {
                    if (!menu.parent_id) {
                        parentMenus.push(menu);
                    } else {
                        if (!childMenus[menu.parent_id]) {
                            childMenus[menu.parent_id] = [];
                        }
                        childMenus[menu.parent_id].push(menu);
                    }
                });
            }
        %>

        <% parentMenus.forEach(parent => { %>

            <% const children = childMenus[parent.id] || []; %>

            <% if (children.length > 0) { %>

                <div class="dropdown">

                    <a
                        href="<%= parent.menu_url %>"
                        target="<%= parent.target %>">

                        <%= parent.menu_title %>

                    </a>

                    <div class="dropdown-content">

                        <% children.forEach(child => { %>

                            <a
                                href="<%= child.menu_url %>"
                                target="<%= child.target %>">

                                <%= child.menu_title %>

                            </a>

                        <% }) %>

                    </div>

                </div>

            <% } else { %>

                <a
                    href="<%= parent.menu_url %>"
                    target="<%= parent.target %>">

                    <%= parent.menu_title %>

                </a>

            <% } %>

        <% }) %>

    </nav>

    <!-- ARSP QR SCANNER MODAL -->
    <%- include("../home/arsp-scanner") %>

</header>
