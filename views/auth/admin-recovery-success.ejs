<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/auth.css"
    >

</head>

<body>

<div class="login-container">

    <div class="login-card">

        <h2>
            Admin Recovery Successful
        </h2>

        <p>
            Your administrator credentials have been changed
            successfully.
        </p>

        <p>
            <strong>New Admin ID:</strong>
            <%= username %>
        </p>

        <p>
            The previous Admin ID has been deactivated.
        </p>

        <a
            href="/admin/login"
            class="btn btn-primary"
        >
            Go to Admin Login
        </a>

    </div>

</div>

</body>

</html>
