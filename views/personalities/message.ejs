<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">

<%- include("../partials/navbar") %>

<section class="page-banner">

    <div class="container text-center">

        <h1>

            <%= personality.message_title %>

        </h1>

        <p>

            <%= personality.name %>

        </p>

    </div>

</section>

<section class="message-section">

    <div class="container">

        <div class="message-wrapper">

            <div class="message-image">

                <img
                    src="/uploads/personalities/<%= personality.photo %>"
                    alt="<%= personality.name %>">

            </div>

            <div class="message-content">

                <span class="section-badge">

                    <%= personality.message_title %>

                </span>

                <h2>

                    <%= personality.name %>

                </h2>

                <h4>

                    <%= personality.designation %>

                </h4>

            </div>

        </div>

    </div>

</section>

<section class="welcome-section">

    <div class="container">

        <div class="feature-card">

            <p style="white-space:pre-line;line-height:2;">

               <%- personality.message %>

            </p>

            <div class="mt-4">

                <a
                    href="/personality/<%= personality.slug %>/biography"
                    class="btn">

                    <%= personality.biography_button_text %>

                </a>

            </div>

        </div>

    </div>

</section>

<%- include("../partials/footer") %>
