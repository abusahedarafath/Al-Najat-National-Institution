<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/home.css">

<%- include('../partials/navbar') %>



<!-- =====================================
     HERO SECTION
===================================== -->

<section class="hero-slider">

    <% if (sliders && sliders.length) { %>

        <% sliders.forEach((slider,index)=>{ %>

            <div class="slide <%= index === 0 ? 'active' : '' %>">

                <img
                    src="/uploads/sliders/<%= slider.image %>"
                    alt="<%= slider.title %>">

                <div class="hero-overlay"></div>

                <div class="hero-content">

                    <h1><%= slider.title %></h1>

                    <p><%= slider.subtitle %></p>

                    <% if (slider.button_text) { %>

                        <a
                            href="<%= slider.button_link %>"
                            class="btn hero-btn">

                            <%= slider.button_text %>

                        </a>

                    <% } %>

                </div>

            </div>

        <% }) %>

    <% } %>

    <button class="prev">&#10094;</button>

    <button class="next">&#10095;</button>

</section>








<!-- =====================================
     WELCOME SECTION
===================================== -->

<% if (welcome) { %>

<section class="welcome-section">

    <div class="container">

        <div class="welcome-wrapper">

            <div class="welcome-image">

                <% if (welcome.image) { %>

                    <img
                        src="/uploads/welcome/<%= welcome.image %>"
                        alt="<%= welcome.title %>">

                <% } %>

            </div>

            <div class="welcome-content">

                <span class="section-badge">

                    <%= welcome.small_title %>

                </span>

                <h2>

                    <%= welcome.title %>

                </h2>

                <p>

                    <%= welcome.description %>

                </p>

                <% if (welcome.button_text) { %>

                    <a
                        href="<%= welcome.button_link %>"
                        class="btn welcome-btn">

                        <%= welcome.button_text %>

                    </a>

                <% } %>

            </div>

        </div>

    </div>

</section>

<% } %>








<!-- =====================================
     QUICK ACCESS
===================================== -->

<section class="quick-access">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Quick Access

            </span>

            <h2>

                Important Links

            </h2>

            <p>

                Access important services, information and resources.

            </p>

        </div>

        <div class="quick-grid">

            <% if (quickAccess && quickAccess.length > 0) { %>

                <% quickAccess.forEach(item => { %>

                    <a
                        href="<%= item.link %>"
                        class="quick-card">

                        <div class="quick-icon">

                            <i class="<%= item.icon %>"></i>

                        </div>

                        <h3>

                            <%= item.title %>

                        </h3>

                        <p>

                            <%= item.description %>

                        </p>

                    </a>

                <% }) %>

            <% } else { %>

                <div class="empty-box">

                    No Quick Access items found.

                </div>

            <% } %>

        </div>

    </div>

</section>






<!-- =====================================
     CHAIRMAN MESSAGE
===================================== -->

<% if (chairman) { %>

<section class="message-section">

    <div class="container">

        <div class="message-wrapper">

            <div class="message-image">

                <img
                    src="/uploads/chairman/<%= chairman.image %>"
                    alt="<%= chairman.name %>">

            </div>

            <div class="message-content">

                <span class="section-badge">

                    Chairman's Message

                </span>

                <h2>

                    <%= chairman.name %>

                </h2>

                <h4>

                    <%= chairman.designation %>

                </h4>

                <p>

                    <%= chairman.message.substring(0,300) %>...

                </p>

                <a
                    href="/chairman-message"
                    class="btn message-btn">

                    Read Full Message

                </a>

            </div>

        </div>

    </div>

</section>

<% } %>






