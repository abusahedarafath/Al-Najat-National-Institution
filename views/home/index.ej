                    </div>

                <% }) %>

            <% } else { %>

                <div class="empty-box">

                    No news available.

                </div>

            <% } %>

        </div>

    </div>

</section>










<script src="/js/home-slider.js"></script>

<%- include('../partials/footer') %>
