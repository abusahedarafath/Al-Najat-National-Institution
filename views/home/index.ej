<!-- =====================================
     STATISTICS
===================================== -->

<section class="stats-section">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Our Achievements

            </span>

            <h2>

                Institution Statistics

            </h2>

        </div>

        <div class="stats-grid">

            <div class="stat-card">

                <h2>2500+</h2>

                <p>Students</p>

            </div>

            <div class="stat-card">

                <h2>120+</h2>

                <p>Teachers</p>

            </div>

            <div class="stat-card">

                <h2>98%</h2>

                <p>Success Rate</p>

            </div>

            <div class="stat-card">

                <h2>25+</h2>

                <p>Courses</p>

            </div>

        </div>

    </div>

</section>















<!-- =====================================
     WHY CHOOSE US
===================================== -->

<section class="features-section">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Why Choose Us

            </span>

            <h2>

                Why Choose Al-Najat?

            </h2>

        </div>

        <div class="feature-grid">

            <div class="feature-card">

                <h3>Quality Education</h3>

                <p>

                    Experienced teachers and modern learning methods.

                </p>

            </div>

            <div class="feature-card">

                <h3>Islamic Environment</h3>

                <p>

                    Academic excellence with moral and Islamic values.

                </p>

            </div>

            <div class="feature-card">

                <h3>Excellent Results</h3>

                <p>

                    Helping students achieve success in every field.

                </p>

            </div>

        </div>

    </div>

</section>







<!-- =====================================
     LATEST NEWS
===================================== -->

<section class="latest-section">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                News & Updates

            </span>

            <h2>

                Latest News

            </h2>

        </div>

        <div class="feature-grid">

            <% if (news && news.length) { %>

                <% news.forEach(item => { %>

                    <div class="feature-card">

                        <h3><%= item.title %></h3>

                        <p><%= item.publish_date %></p>

                        <a
                            href="/news/<%= item.id %>"
                            class="btn">

                            Read More

                        </a>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="empty-box">

                    No news available.

                </div>

            <% } %>

        </div>

    </div>

</section>







