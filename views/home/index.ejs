<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/home.css">

<%- include('../partials/navbar') %>

<!-- =====================================================
     HERO SECTION
===================================================== -->

<section class="hero-slider">

    <% if (sliders && sliders.length) { %>

        <% sliders.forEach((slider,index)=>{ %>

            <div class="slide <%= index===0 ? 'active' : '' %>">

                <img
                    src="/uploads/sliders/<%= slider.image %>"
                    alt="<%= slider.title %>">

                <div class="hero-overlay"></div>

                <div class="hero-content">

                    <span class="hero-badge">

                        Welcome to

                    </span>

                    <h1>

                        <%= slider.title %>

                    </h1>

                    <p>

                        <%= slider.subtitle %>

                    </p>

                    <% if(slider.button_text){ %>

                        <a
                            href="<%= slider.button_link %>"
                            class="btn hero-btn">

                            <%= slider.button_text %>

                        </a>

                    <% } %>

                </div>

            </div>

        <% }) %>

    <% } %>

    <button class="prev">&#10094;</button>

    <button class="next">&#10095;</button>

</section>

<!-- =====================================================
     WELCOME SECTION
===================================================== -->

<% if (welcome) { %>

<section class="welcome-section">

    <div class="container">

        <div class="welcome-wrapper">

            <div class="welcome-image">

                <% if (welcome.image) { %>

                    <img
                        src="/uploads/welcome/<%= welcome.image %>"
                        alt="<%= welcome.title %>">

                <% } %>

            </div>

            <div class="welcome-content">

                <span class="section-badge">

                    <%= welcome.small_title %>

                </span>

                <h2>

                    <%= welcome.title %>

                </h2>

                <p>

                    <%= welcome.description %>

                </p>

                <% if (welcome.button_text) { %>

                    <a
                        href="<%= welcome.button_link %>"
                        class="btn welcome-btn">

                        <%= welcome.button_text %>

                    </a>

                <% } %>

            </div>

        </div>

    </div>

</section>

<% } %>






<%- include('./arsp-scanner') %>

<!-- =====================================================
     QUICK ACCESS
===================================================== -->

<section class="quick-access">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Quick Access

            </span>

            <h2>

                Important Links

            </h2>

            <p>

                Access all important services with a single click.

            </p>

        </div>

        <div class="quick-grid">




<% if (quickButtons && quickButtons.length) { %>

    <% quickButtons.forEach(button => { %>

        <a
            href="<%= button.url %>"
            class="quick-card">

            <div class="quick-icon">

<i class="fa-solid fa-<%= button.icon %>"></i>
            </div>

            <h3>

                <%= button.title %>

            </h3>

            <p>

                <%= button.subtitle %>

            </p>

        </a>

    <% }) %>

<% } else { %>

    <div class="empty-box">

        No Quick Buttons Available.

    </div>

<% } %>






        </div>

    </div>

</section>





<!-- =====================================================
     INSTITUTIONAL PERSONALITIES
===================================================== -->

<% if (personalities && personalities.length) { %>

<section class="personality-section">
    <div class="container">

        <% personalities.forEach((person,index)=>{ %>

<div class="personality-wrapper <%= index % 2 ? 'reverse' : '' %>">
<div class="personality-image">
                <img
                    src="/uploads/personalities/<%= person.photo %>"
                    alt="<%= person.name %>">

            </div>

<div class="personality-content">
                <span class="section-badge">

                    <%= person.message_title %>

                </span>

                <h2>

                    <%= person.name %>

                </h2>

                <h4>

                    <%= person.designation %>

                </h4>

                <p>

                    <%= person.message.substring(0,300) %>...

                </p>

                <div class="d-flex flex-wrap gap-2 mt-4">

               <a href="/personality/<%= person.slug %>" class="btn personality-btn">
    <%= person.message_button_text && person.message_button_text.trim()
        ? person.message_button_text
        : "Read Full Message" %>
</a>

                    <a
                        href="/personality/<%= person.slug %>/biography"
                        class="btn btn-outline-success">

                        <%= person.biography_button_text %>

                    </a>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</section>

<% } %>





<% if (achievements && achievements.length > 0) { %>

    <!-- =====================================================
         STATISTICS / OUR ACHIEVEMENTS
    ===================================================== -->

    <section class="stats-section">

        <div class="container">

            <div class="section-header">

                <span class="section-badge">
                    Our Achievements
                </span>

                <h2>
                    Institution Statistics
                </h2>

                <p>
                    Our growth in numbers reflects our commitment to quality education.
                </p>

            </div>

            <div class="stats-grid">

                <% achievements.forEach(achievement => { %>

                    <div class="stat-card">

                        <h2>
                            <%= achievement.value %>
                        </h2>

                        <p>
                            <%= achievement.title %>
                        </p>

                        <% if (achievement.description) { %>

                            <small>
                                <%= achievement.description %>
                            </small>

                        <% } %>

                    </div>

                <% }) %>

            </div>

        </div>

    </section>

<% } %>







<% if (features && features.length > 0) { %>

    <!-- =====================================================
         WHY CHOOSE US
    ===================================================== -->

    <section class="features-section">

        <div class="container">

            <div class="section-header">

                <span class="section-badge">
                    Why Choose Us
                </span>

                <h2>
                    Why Choose Al-Najat?
                </h2>

                <p>
                    Building knowledge, character and leadership through quality education.
                </p>

            </div>

            <div class="feature-grid">

                <% features.forEach(feature => { %>

                    <div class="feature-card">

                        <% if (feature.icon) { %>

                            <i class="<%= feature.icon %>"></i>

                        <% } %>

                        <h3>
                            <%= feature.title %>
                        </h3>

                        <p>
                            <%= feature.description %>
                        </p>

                    </div>

                <% }) %>

            </div>

        </div>

    </section>

<% } %>	












<!-- =====================================================
     LATEST NOTICES
===================================================== -->

<section class="latest-section">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Notice Board

            </span>

            <h2>

                Latest Notices

            </h2>

            <p>

                Stay updated with our latest announcements.

            </p>

        </div>

        <div class="feature-grid">

            <% if (notices && notices.length) { %>

                <% notices.forEach(notice => { %>

                   

<div class="feature-card">

    <span class="date-badge">
        <%= notice.publish_date %>
    </span>

    <h3>
        <%= notice.title %>
    </h3>

    <a href="/notice/<%= notice.id %>" class="btn">
        Read More
    </a>

</div>




                <% }) %>

            <% } else { %>

                <div class="empty-box">

                    No notices available.

                </div>

            <% } %>

        </div>

    </div>

</section>






<!-- =====================================================
     LATEST NEWS
===================================================== -->

<section class="latest-section">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                News & Updates

            </span>

            <h2>

                Latest News

            </h2>

            <p>

                Discover what's happening in our institution.

            </p>

        </div>

        <div class="feature-grid">

            <% if (news && news.length) { %>

                <% news.forEach(item => { %>






<div class="feature-card">

<%
const ext = item.image
    ? item.image.split(".").pop().toLowerCase()
    : "";
%>

<% if(["jpg","jpeg","png","webp"].includes(ext)){ %>

    <img
        src="/uploads/news/<%= item.image %>"
        alt="<%= item.title %>"
        class="news-image">

<% } else if(ext==="pdf"){ %>

    <div class="pdf-preview">
        <i class="fas fa-file-pdf"></i>
        <span>PDF Document</span>
    </div>

<% } %>

    <span class="date-badge">
        <%= item.publish_date %>
    </span>

    <h3>
        <%= item.title %>
    </h3>

    <p>
        <%= item.description.substring(0,120) %>...
    </p>

    <a
        href="/news/<%= item.id %>"
        class="btn">

        Read More

    </a>

   <% if(ext==="pdf"){ %>

<a
    href="/uploads/news/<%= item.image %>"
    target="_blank"
    class="btn pdf-btn">

    Open PDF

</a>

<% } %>


</div>





                <% }) %>

            <% } else { %>

                <div class="empty-box">

                    No news available.

                </div>

            <% } %>

        </div>

    </div>

</section>

<script src="/js/home-slider.js"></script>


<% if(honourHeartPopup){ %>

<div id="honourHeartPopup" class="hh-popup-overlay">

<div class="hh-popup">

<button
class="hh-close"
onclick="document.getElementById('honourHeartPopup').style.display='none'">

&times;

</button>

<img
src="/uploads/honour-heart/awardees/<%= honourHeartPopup.photo %>">

<h2>

<%= honourHeartPopup.name %>

</h2>

<h4>

<%= honourHeartPopup.designation %>

</h4>

<p>

Congratulations!

ARSP has selected

<strong><%= honourHeartPopup.name %></strong>

to receive the

<strong>ARSP Honour Heart Award <%= honourHeartPopup.award_year %></strong>.

</p>

<a
href="/honour-heart"
class="hh-btn">

Know More

</a>

</div>

</div>

<% } %>


<%- include('../partials/footer') %>



