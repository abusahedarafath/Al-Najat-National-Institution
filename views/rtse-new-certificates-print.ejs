<%
    function getDesign(rank) {

        rank = Number(rank || 0);

        if (rank === 1) {
            return "rank1";
        }

        if (rank === 2) {
            return "rank2";
        }

        if (rank === 3) {
            return "rank3";
        }

        if (rank >= 4 && rank <= 10) {
            return "merit";
        }

        throw new Error(
            "The new certificate print system only supports Section Rank 1–10."
        );
    }

    function getCategory(rank) {

        rank = Number(rank || 0);

        if (rank <= 3) {
            return "Excellence Certificate";
        }

        if (rank >= 4 && rank <= 10) {
            return "Merit Certificate";
        }

        throw new Error(
            "The new certificate print system only supports Section Rank 1–10."
        );
    }

    function getRankLabel(rank) {

        rank = Number(rank || 0);

        if (rank === 1) return "1st Rank";
        if (rank === 2) return "2nd Rank";
        if (rank === 3) return "3rd Rank";

        return `Section Rank ${rank}`;
    }

    const examName =
        certificateSetting?.exam_name ||
        "RATABARI TALLENT SEARCH EXAMINATION 2026";

    const organizedBy =
        certificateSetting?.organized_by ||
        "ARSP NGO";

    const logo =
        siteSettings?.logo
            ? `/uploads/site-settings/${siteSettings.logo}`
            : "";

    const presidentSignatureImage =
        certificateSetting?.left_signature
            ? `/uploads/rtse-certificate-settings/${certificateSetting.left_signature}`
            : "";

    const directorSignatureImage =
        certificateSetting?.right_signature
            ? `/uploads/rtse-certificate-settings/${certificateSetting.right_signature}`
            : "";

    const presidentLabel =
        certificateSetting?.left_signature_label ||
        "President";

    const directorLabel =
        certificateSetting?.right_signature_label ||
        "RTSE Controller";
%>

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= group === "rank1"
            ? "1st Rank Certificates"
            : group === "rank2"
                ? "2nd Rank Certificates"
                : group === "rank3"
                    ? "3rd Rank Certificates"
                    : "Merit Certificates"
        %>
        -
        Section <%= section %>
    </title>

    <style>

        @page {
            size: A4 landscape;
            margin: 0;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            background: #fff;
        }

        .print-certificate-page {
            width: 297mm;
            height: 210mm;
            page-break-after: always;
            break-after: page;
            overflow: hidden;
            position: relative;
        }

        .print-certificate-page:last-child {
            page-break-after: auto;
            break-after: auto;
        }

        @media print {

            html,
            body {
                width: 297mm;
                background: #fff;
            }

            .print-certificate-page {
                width: 297mm;
                height: 210mm;
            }

        }

    </style>

</head>

<body>

<% certificates.forEach(function(certificate) { %>

    <%
        const sectionRank =
            Number(certificate?.section_rank || 0);

        const design =
            getDesign(sectionRank);

        const category =
            getCategory(sectionRank);

        const rankLabel =
            getRankLabel(sectionRank);

        const writingSkillGrade =
            certificate?.writing_skill_grade || "—";

        const qrCode =
            certificate?.qr_code
                ? `/uploads/rtse-certificates/${certificate.qr_code}`
                : "";
    %>

    <link
        rel="stylesheet"
        href="/css/rtse-certificate-<%= design %>.css"
    >
<% if (design === "rank1") { %>
    <%
        const rank1StudentPhoto =
            certificate?.photo
                ? `/uploads/rtse/${certificate.photo}`
                : "";

        const rank1QrCode =
            certificate?.qr_code
                ? `/uploads/rtse-certificates/${certificate.qr_code}`
                : "";

        const rank1Description =
            (certificateCategorySetting?.certificate_description || "")
                .replace(/\{student_name\}/g, certificate?.full_name || "Student Name")
                .replace(/\{exam_name\}/g, examName)
                .replace(/\{rank\}/g, String(sectionRank))
                .replace(/\{rank_label\}/g, rankLabel)
                .replace(/\{section\}/g, certificate?.section || "Section")
                .replace(/\{year\}/g, String(new Date().getFullYear()));
    %>

