<%
    function getDesign(rank) {

        rank = Number(rank || 0);

        if (rank === 1) {
            return "rank1";
        }

        if (rank === 2) {
            return "rank2";
        }

        if (rank === 3) {
            return "rank3";
        }

        if (rank >= 4 && rank <= 10) {
            return "merit";
        }

        throw new Error(
            "The new certificate print system only supports Section Rank 1–10."
        );
    }

    function getCategory(rank) {

        rank = Number(rank || 0);

        if (rank <= 3) {
            return "Excellence Certificate";
        }

        if (rank >= 4 && rank <= 10) {
            return "Merit Certificate";
        }

        throw new Error(
            "The new certificate print system only supports Section Rank 1–10."
        );
    }

    function getRankLabel(rank) {

        rank = Number(rank || 0);

        if (rank === 1) return "1st Rank";
        if (rank === 2) return "2nd Rank";
        if (rank === 3) return "3rd Rank";

        return `Section Rank ${rank}`;
    }

    const examName =
        setting?.exam_name ||
        "RATABARI TALLENT SEARCH EXAMINATION 2026";

    const logo =
        setting?.logo
            ? `/uploads/arsp-settings/${setting.logo}`
            : "";
%>

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= group === "rank1"
            ? "1st Rank Certificates"
            : group === "rank2"
                ? "2nd Rank Certificates"
                : group === "rank3"
                    ? "3rd Rank Certificates"
                    : "Merit Certificates"
        %>
        -
        Section <%= section %>
    </title>

    <style>

        @page {
            size: A4 landscape;
            margin: 0;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            background: #fff;
        }

        .print-certificate-page {
            width: 297mm;
            height: 210mm;
            page-break-after: always;
            break-after: page;
            overflow: hidden;
            position: relative;
        }

        .print-certificate-page:last-child {
            page-break-after: auto;
            break-after: auto;
        }

        @media print {

            html,
            body {
                width: 297mm;
                background: #fff;
            }

            .print-certificate-page {
                width: 297mm;
                height: 210mm;
            }

        }

    </style>

</head>

<body>

<% certificates.forEach(function(certificate) { %>

    <%
        const sectionRank =
            Number(certificate?.section_rank || 0);

        const design =
            getDesign(sectionRank);

        const category =
            getCategory(sectionRank);

        const rankLabel =
            getRankLabel(sectionRank);

        const writingSkillGrade =
            certificate?.writing_skill_grade || "—";

        const qrCode =
            certificate?.qr_code
                ? `/uploads/rtse-qr/${certificate.qr_code}`
                : "";
    %>

    <link
        rel="stylesheet"
        href="/css/rtse-certificate-<%= design %>.css"
    >

    <div class="print-certificate-page">


<% if (design === "rank2") { %>
    <%
        const studentPhoto = certificate?.photo
            ? `/uploads/rtse/${certificate.photo}`
            : "";
    %>

    <div class="print-certificate-page">
        <div class="certificate-page rank2">
            <div class="rank2-frame">
                <img
                    class="rank2-template-background"
                    src="/images/rtse-certificates/rank2-template.png"
                    alt=""
                    aria-hidden="true"
                >

                <div class="rank2-overlay">

                    <% if (logo) { %>
                        <img
                            class="rank2-overlay-logo"
                            src="<%= logo %>"
                            alt="ARSP Logo"
                        >
                    <% } %>

                    <div class="rank2-overlay-heading">
                        <div class="rank2-overlay-exam-name">
                            <%= examName %>
                        </div>

                        <div class="rank2-overlay-organized">
                            Organized by ARSP NGO
                        </div>
                    </div>

                    <% if (studentPhoto) { %>
                        <img
                            class="rank2-overlay-photo"
                            src="<%= studentPhoto %>"
                            alt="Student Photo"
                        >
                    <% } %>

                    <div class="rank2-overlay-main">

                        <div class="rank2-overlay-student-name">
                            <%= certificate?.full_name || "Student Name" %>
                        </div>

                        <div class="rank2-overlay-title">
                            CERTIFICATE OF EXCELLENCE
                        </div>

                        <div class="rank2-overlay-description">
                            This is proudly presented to
                            <strong><%= certificate?.full_name || "Student Name" %></strong>
                            for exceptional achievement and securing the
                            <strong>Second Rank</strong> in the
                            <strong><%= examName %></strong>
                            held in 2026.
                            Their dedication, perseverance, and outstanding performance
                            across all subjects have distinguished them as a leader
                            among their peers.
                            We commend their hard work and commitment to excellence.
                        </div>

                    </div>

                    <% if (qrCode) { %>
                        <img
                            class="rank2-overlay-qr"
                            src="<%= qrCode %>"
                            alt="Certification QR Code"
                        >
                    <% } %>

                    <% if (logo) { %>
                    <% } %>

                    <div class="rank2-overlay-president-label">
                        President
                    </div>

                    <div class="rank2-overlay-director-label">
                        RTSE Controller
                    </div>

                </div>
            </div>
        </div>
    </div>

<% } else if (design === "rank3") { %>
    <%
        const studentPhoto = certificate?.photo
            ? `/uploads/rtse/${certificate.photo}`
            : "";

        const presidentSignature =
            setting?.president_signature
                ? `/uploads/arsp-settings/${setting.president_signature}`
                : "";

        const directorSignature =
            certificate?.director_signature
                ? `/uploads/rtse/${certificate.director_signature}`
                : (
                    setting?.director_signature
                        ? `/uploads/arsp-settings/${setting.director_signature}`
                        : ""
                );
    %>

    <div class="print-certificate-page">
        <div class="certificate-page rank3">
            <div class="rank3-frame">

                <img
                    class="rank3-template-background"
                    src="/images/rtse-certificates/rank3-template.png"
                    alt=""
                    aria-hidden="true"
                >

                <div class="rank3-overlay">

                    <% if (logo) { %>
                        <img
                            class="rank3-overlay-logo"
                            src="<%= logo %>"
                            alt="ARSP Logo"
                        >
                    <% } %>

                    <div class="rank3-overlay-heading">
                        <div class="rank3-overlay-exam-name">
                            <%= examName %>
                        </div>

                        <div class="rank3-overlay-organized">
                            Organized by ARSP NGO
                        </div>
                    </div>

                    <% if (studentPhoto) { %>
                        <img
                            class="rank3-overlay-photo"
                            src="<%= studentPhoto %>"
                            alt="Student Photo"
                        >
                    <% } %>

                    <div class="rank3-overlay-main">

                        <div class="rank3-overlay-student-name">
                            <%= certificate?.full_name || "Student Name" %>
                        </div>

                        <div class="rank3-overlay-title">
                            CERTIFICATE OF EXCELLENCE
                        </div>

                        <div class="rank3-overlay-description">
                            This is proudly presented to
                            <strong><%= certificate?.full_name || "Student Name" %></strong>
                            for exceptional achievement and securing the
                            <strong>Third Rank</strong> in the
                            <strong><%= examName %></strong>
                            held in 2026.
                            Their dedication, perseverance, and outstanding performance
                            across all subjects have distinguished them as a leader
                            among their peers.
                            We commend their hard work and commitment to excellence.
                        </div>

                    </div>

                    <% if (qrCode) { %>
                        <img
                            class="rank3-overlay-qr"
                            src="<%= qrCode %>"
                            alt="Certification QR Code"
                        >
                    <% } %>

                    <% if (presidentSignature) { %>
                        <img
                            class="rank3-overlay-president-signature"
                            src="<%= presidentSignature %>"
                            alt="President Signature"
                        >
                    <% } %>

                    <% if (directorSignature) { %>
                        <img
                            class="rank3-overlay-director-signature"
                            src="<%= directorSignature %>"
                            alt="Director Signature"
                        >
                    <% } %>

                    <div class="rank3-overlay-president-label">
                        President
                    </div>

                    <div class="rank3-overlay-director-label">
                        RTSE Controller
                    </div>

                </div>
            </div>
        </div>
<% } else if (design === "merit") { %>
    <%
        const studentPhoto = certificate?.photo
            ? `/uploads/rtse/${certificate.photo}`
            : "";

        const presidentSignature =
            setting?.president_signature
                ? `/uploads/arsp-settings/${setting.president_signature}`
                : "";

        const directorSignature =
            certificate?.director_signature
                ? `/uploads/rtse/${certificate.director_signature}`
                : (
                    setting?.director_signature
                        ? `/uploads/arsp-settings/${setting.director_signature}`
                        : ""
                );
    %>

    <div class="merit-frame">

        <img
            class="merit-template-background"
            src="/images/rtse-certificates/merit-template.png"
            alt=""
            aria-hidden="true"
        >

        <div class="merit-overlay">

            <% if (logo) { %>
                <img
                    class="merit-overlay-logo"
                    src="<%= logo %>"
                    alt="ARSP Logo"
                >
            <% } %>

            <div class="merit-overlay-heading">

                <div class="merit-overlay-exam-name">
                    <%= examName %>
                </div>

                <div class="merit-overlay-organized">
                    Organized by ARSP NGO
                </div>

            </div>

            <% if (studentPhoto) { %>
                <img
                    class="merit-overlay-photo"
                    src="<%= studentPhoto %>"
                    alt="Student Photo"
                >
            <% } %>

            <div class="merit-overlay-main">

                <div class="merit-overlay-title">
                    CERTIFICATE OF MERIT
                </div>

                <div class="merit-overlay-student-name">
                    <%= certificate?.full_name || "Student Name" %>
                </div>

                <div class="merit-overlay-description">
                    This is proudly presented to
                    <strong><%= certificate?.full_name || "Student Name" %></strong>
                    for exceptional achievement and securing the
                    <strong>
                        <%= sectionRank || "Merit" %><%= sectionRank ? (
                            sectionRank == 1 ? "st" :
                            sectionRank == 2 ? "nd" :
                            sectionRank == 3 ? "rd" : "th"
                        ) : "" %> Rank
                    </strong>
                    in the
                    <strong><%= examName %></strong>
                    held in 2026.
                    Their dedication, perseverance, and outstanding performance
                    across all subjects have distinguished them among their peers.
                    We commend their hard work and commitment to excellence.
                </div>

            </div>

            <% if (qrCode) { %>
                <img
                    class="merit-overlay-qr"
                    src="<%= qrCode %>"
                    alt="Certification QR Code"
                >
            <% } %>

            <% if (presidentSignature) { %>
                <img
                    class="merit-overlay-president-signature"
                    src="<%= presidentSignature %>"
                    alt="President Signature"
                >
            <% } %>

            <% if (directorSignature) { %>
                <img
                    class="merit-overlay-director-signature"
                    src="<%= directorSignature %>"
                    alt="RTSE Controller Signature"
                >
            <% } %>

            <div class="merit-overlay-president-label">
                President
            </div>

            <div class="merit-overlay-director-label">
                RTSE Controller
            </div>

        </div>
    </div>

<% } else { %>


            <div class="certificate-frame">

                <div class="inner-frame"></div>

                <div class="ornament ornament-top-left"></div>
                <div class="ornament ornament-top-right"></div>
                <div class="ornament ornament-bottom-left"></div>
                <div class="ornament ornament-bottom-right"></div>

                <header class="certificate-header">

                    <% if (logo) { %>

                        <img
                            class="arsp-logo"
                            src="<%= logo %>"
                            alt="ARSP Logo"
                        >

                    <% } %>

                    <div class="organization-block">

                        <div class="organization-name">
                            ACTIVE RURAL SOCIAL PROGRESS
                        </div>

                        <div class="exam-name">
                            <%= examName %>
                        </div>

                        <div class="organized-by">
                            Organized by ARSP
                        </div>

                    </div>

                    <div class="rank-badge">
                        <span>
                            <%= rankLabel %>
                        </span>
                    </div>

                </header>

                <main class="certificate-content">

                    <div class="certificate-category">
                        <%= category %>
                    </div>

                    <div class="certificate-intro">
                        This certificate is proudly presented to
                    </div>

                    <div class="student-name">
                        <%= certificate?.full_name || "Student Name" %>
                    </div>

                    <div class="student-divider"></div>

                    <div class="achievement-text">

                        for outstanding performance in the

                        <strong>
                            <%= certificate?.section || "Section" %>
                        </strong>

                        section of the examination.

                    </div>

                    <section class="achievement-grid">

                        <div class="achievement-item">

                            <span class="label">
                                SECTION
                            </span>

                            <strong>
                                <%= certificate?.section || "—" %>
                            </strong>

                        </div>

                        <div class="achievement-item rank-item">

                            <span class="label">
                                SECTION RANK
                            </span>

                            <strong>
                                <%= sectionRank || "—" %>
                            </strong>

                        </div>

                        <div class="achievement-item">

                            <span class="label">
                                WRITING SKILL
                            </span>

                            <strong>
                                <%= writingSkillGrade %>
                            </strong>

                        </div>

                    </section>

                </main>

                <footer class="certificate-footer">

                    <div class="signature-block">

                        <div class="signature-line"></div>

                        <span>
                            Controller of Examination
                        </span>

                    </div>

                    <% if (qrCode) { %>

                        <div class="certificate-qr">

                            <img
                                src="<%= qrCode %>"
                                alt="Certificate QR"
                            >

                        </div>

                    <% } %>

                    <div class="certificate-number">

                        <span>
                            Certificate No.
                        </span>

                        <strong>
                            <%= certificate?.certificate_number || "—" %>
                        </strong>

                    </div>

                    <div class="signature-block">

                        <div class="signature-line"></div>

                        <span>
                            President, ARSP
                        </span>

                    </div>

                </footer>

            </div>

        </div>

    </div>

<% } %>
<% }); %>

<script>

    window.addEventListener(
        "load",
        function () {

            setTimeout(
                function () {
                    window.print();
                },
                500
            );

        }
    );

</script>

</body>

</html>
