                    alt="Student Photo"
                >
            <% } %>

            <div class="merit-overlay-main">

                <div class="merit-overlay-title">
                    <%= certificateCategorySetting?.certificate_name || "CERTIFICATE OF MERIT" %>
                </div>

                <div class="merit-overlay-student-name">
                    <%= certificate?.full_name || "Student Name" %>
                </div>

                <div class="merit-overlay-description">
                    <%= (certificateCategorySetting?.certificate_description || "")
                        .replace(/\{student_name\}/g, certificate?.full_name || "Student Name")
                        .replace(/\{exam_name\}/g, examName)
                        .replace(/\{rank\}/g, String(sectionRank))
                        .replace(/\{rank_label\}/g, rankLabel)
                        .replace(/\{section\}/g, certificate?.section || "Section")
                        .replace(/\{year\}/g, String(new Date().getFullYear())) %>
                </div>

            </div>

            <% if (qrCode) { %>
                <img
                    class="merit-overlay-qr"
                    src="<%= qrCode %>"
                    alt="Certification QR Code"
                >
            <% } %>

            <% if (presidentSignatureImage) { %>
                <img
                    class="merit-overlay-president-signature"
                    src="<%= presidentSignatureImage %>"
                    alt="President Signature"
                >
            <% } %>

            <% if (directorSignatureImage) { %>
                <img
                    class="merit-overlay-director-signature"
                    src="<%= directorSignatureImage %>"
                    alt="RTSE Controller Signature"
