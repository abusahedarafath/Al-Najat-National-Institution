<script>

let currentToken = null;
let currentStudent = null;
let currentScanType = "GATE";


let scanner = null;
let scannerRunning = false;


/* =====================================
   ELEMENTS
===================================== */

const messageBox =
    document.getElementById("message");

const studentCard =
    document.getElementById("studentCard");

const cameraStatus =
    document.getElementById("cameraStatus");

const markButton =
    document.getElementById("markPresentButton");

const resultEntryPanel =
    document.getElementById("resultEntryPanel");

const resultFullMarks =
    document.getElementById("resultFullMarks");

const resultMarks =
    document.getElementById("resultMarks");

const resultComponentInputs =
    document.querySelectorAll(
        "[data-rtse-component-mark]"
    );

const resultTotalMarks =
    document.getElementById("resultTotalMarks");

const resultTotalFullMarks =
    document.getElementById("resultTotalFullMarks");

const resultPercentage =
    document.getElementById("resultPercentage");

const resultGrade =
    document.getElementById("resultGrade");

const resultSaveButton =
    document.getElementById("resultSaveButton");



/* =====================================
   MESSAGE
===================================== */

function showMessage(text, type){

    messageBox.textContent = text;

    messageBox.className =
        "message " + type;

}


/* =====================================
   START CAMERA
===================================== */

function startScanner(){

    if(typeof Html5Qrcode === "undefined"){

        cameraStatus.textContent =
            "QR scanner library could not be loaded.";

        return;

    }

    scanner =
        new Html5Qrcode("qr-reader");


    const config = {

        fps: 10,

        qrbox: function(width, height){

            const size =
                Math.min(width, height) * 0.70;

            return {
                width: size,
                height: size
            };

        }

    };


    scanner.start(

        {
            facingMode: "environment"
        },

        config,

        function(decodedText){

            handleScannedToken(decodedText);

        },

        function(){

            // Ignore normal scanning frames.

        }

    ).then(function(){

        scannerRunning = true;

        cameraStatus.textContent =
            "Camera ready — scan the RTSE QR code.";

    }).catch(function(error){

        console.error(
            "Camera start error:",
            error
        );

        cameraStatus.textContent =
            "Unable to access camera. Please allow camera permission.";

    });

}


/* =====================================
   SCAN TOKEN
===================================== */


/* =====================================
   SCANNER RESULT SOUNDS
   ===================================== */

let scannerAudioUnlocked = false;

const scanSuccessAudio =
        new Audio("/audio/super-scanner-success.mp3");

    const confirmSuccessAudio =
        new Audio("/audio/super-scanner-confirm-success.mp3");

    const rejectionAudio =
        new Audio("/audio/super-scanner-rejection.mp3");

    scanSuccessAudio.preload = "auto";
    confirmSuccessAudio.preload = "auto";
    rejectionAudio.preload = "auto";

function unlockScannerAudio(){
        if(scannerAudioUnlocked){
            return;
        }

        try{
            [
                scanSuccessAudio,
                confirmSuccessAudio,
                rejectionAudio
            ].forEach(function(audio){

                audio.muted = true;

                const promise = audio.play();

                if(promise){
                    Promise.resolve(promise).catch(() => {});
                }

                audio.pause();
                audio.currentTime = 0;
                audio.muted = false;
            });

            scannerAudioUnlocked = true;

        }catch(error){
            console.warn(
                "Scanner audio unlock unavailable:",
                error
            );
        }
    }

function playScanSuccessSound(){
        try{
            scanSuccessAudio.pause();
            scanSuccessAudio.currentTime = 0;
            scanSuccessAudio.muted = false;

            const playPromise =
                scanSuccessAudio.play();

            if(playPromise){
                playPromise.catch(function(error){
                    console.warn(
                        "Scan success sound unavailable:",
                        error
                    );
                });
            }

        }catch(error){
            console.warn(
                "Scan success sound unavailable:",
                error
            );
        }
    }

function playConfirmSuccessSound(){
        try{
            confirmSuccessAudio.pause();
            confirmSuccessAudio.currentTime = 0;
            confirmSuccessAudio.muted = false;

            const playPromise =
                confirmSuccessAudio.play();

            if(playPromise){
                playPromise.catch(function(error){
                    console.warn(
                        "Confirm success sound unavailable:",
                        error
                    );
                });
            }

        }catch(error){
            console.warn(
                "Confirm success sound unavailable:",
                error
            );
        }
    }

function playRejectionSound(){
    try{
        rejectionAudio.pause();
        rejectionAudio.currentTime = 0;
        rejectionAudio.muted = false;

        const playPromise = rejectionAudio.play();

        if(playPromise){
            playPromise.catch(function(error){
                console.warn("Rejection sound unavailable:", error);
            });
        }
    }catch(error){
        console.warn("Rejection sound unavailable:", error);
    }
}

/*
 * Browsers normally require user interaction before allowing
 * audio playback. Unlock the scanner sounds on the first
 * interaction with the page.
 */
document.addEventListener("click", unlockScannerAudio, { once:true });
document.addEventListener("touchstart", unlockScannerAudio, { once:true });
document.addEventListener("keydown", unlockScannerAudio, { once:true });

async function handleScannedToken(token){

    token =
        String(token || "").trim();

    if(!token){
        return;
    }

    /*
     * Ignore additional camera detections while the current
     * candidate popup is open or being verified.
     */
    if(currentToken){
        return;
    }

    currentToken =
        token;

    showMessage(
        "Verifying RTSE candidate...",
        "info"
    );

    /*
     * IMPORTANT:
     * Do NOT stop the scanner here.
     * The camera remains active underneath the popup.
     */
    await lookupToken(token);
}


/* =====================================
   LOOKUP
===================================== */

async function lookupToken(token){

    try{

        const response =
            await fetch(
                "/super-scanner/lookup",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        qr_token:token
                    })
                }
            );

        const data =
            await response.json();

        if(!response.ok || !data.success){

            playRejectionSound();

            showRejectionPopup(
                data.message ||
                "Unable to verify QR code."
            );

            return;
        }

        currentStudent =
            data.student;

        if(data.scanType === "RESULT"){

            currentScanType =
                "RESULT";

            playScanSuccessSound();

            displayResultStudent(
                data.student,
                data.result,
                data.resultComponentMarks
            );

            showMessage(
                "✓ " +
                data.student.full_name +
                " (" +
                data.student.roll_no +
                ") — RESULT QR VERIFIED.",
                "success"
            );

            return;
        }

        currentScanType =
            "GATE";

        displayStudent(
            data.student,
            data.alreadyPresent
        );

        if(data.alreadyPresent){

            playRejectionSound();

            const popupMessage =
                document.getElementById("popupMessage");

            const closeButton =
                document.getElementById("popupCloseButton");

            popupMessage.textContent =
                data.student.full_name +
                " (" +
                data.student.roll_no +
                ") — ALREADY PRESENT";

            popupMessage.className =
                "popup-message rejection";

            popupMessage.style.display =
                "block";

            closeButton.style.display =
                "block";

            closeButton.textContent =
                "Close";

            markButton.style.display =
                "none";

            showPopupIcon(
                "rejection",
                "❌"
            );

            showMessage(
                "Candidate already has a recorded gate entry.",
                "info"
            );

        }else{

            playScanSuccessSound();

            showMessage(
                "✓ " +
                data.student.full_name +
                " (" +
                data.student.roll_no +
                ") — VERIFIED. Confirm gate entry.",
                "success"
            );
        }

    }catch(error){

        console.error(
            "Super Scanner Lookup Error:",
            error
        );

        playRejectionSound();

        showRejectionPopup(
            "Unable to connect to the attendance server."
        );
    }
}

/* =====================================
   DISPLAY STUDENT
===================================== */

function showPopupIcon(type, symbol){

    const icon =
        document.getElementById("popupIcon");

    icon.className =
        "popup-icon " + type;

    icon.textContent =
        symbol;

    icon.style.display =
        "flex";
}


function showRejectionPopup(message){

    const photo =
        document.getElementById("studentPhoto");

    const details =
        document.querySelector(".student-details");

    const status =
        document.getElementById("attendanceStatus");

    const popupMessage =
        document.getElementById("popupMessage");

    const closeButton =
        document.getElementById("popupCloseButton");

    const subtitle =
        document.getElementById("popupSubtitle");

    if(photo){
        photo.removeAttribute("src");
        photo.style.display =
            "none";
    }

    details.style.display =
        "none";

    status.style.display =
        "none";

    markButton.style.display =
        "none";
        resultEntryPanel.style.display =
            "none";

    document.getElementById("studentName").textContent =
        "Verification Rejected";

    subtitle.textContent =
        "RTSE Candidate Verification";

    popupMessage.textContent =
        message;

    popupMessage.className =
        "popup-message rejection";

    popupMessage.style.display =
        "block";

    closeButton.style.display =
        "block";

    closeButton.textContent =
        "Close";

    showPopupIcon(
        "rejection",
        "❌"
    );

    studentCard.style.display =
        "flex";
}


function closeStudentPopup(){

    currentToken =
        null;

    currentStudent =
        null;
    currentScanType =
        "GATE";

    const photo =
        document.getElementById("studentPhoto");

    const details =
        document.querySelector(".student-details");

    const status =
        document.getElementById("attendanceStatus");

    const popupMessage =
        document.getElementById("popupMessage");

    const closeButton =
        document.getElementById("popupCloseButton");

    const icon =
        document.getElementById("popupIcon");

    const subtitle =
        document.getElementById("popupSubtitle");

    if(photo){
        photo.removeAttribute("src");
        photo.style.display =
            "none";
    }

    details.style.display =
        "";

    status.style.display =
        "";

    markButton.style.display =
        "";

    markButton.disabled =
        false;

    markButton.textContent =
        "Confirm Gate Entry";

    resultEntryPanel.style.display =
        "none";

    resultFullMarks.value =
        "100";

    resultMarks.value =
        "";
    resultComponentInputs.forEach(
        function(input){
            input.value = "";
        }
    );


    resultPercentage.value =
        "";

    resultGrade.value =
        "";

    resultSaveButton.disabled =
        false;

    resultSaveButton.textContent =
        "Save Result";

    const scannerOmrExisting =
        document.getElementById("rtseOmrExisting");

    const scannerOmrExistingView =
        document.getElementById("rtseOmrExistingView");

    const scannerOmrModal =
        document.getElementById("rtseOmrModal");

    if(scannerOmrExisting){
        scannerOmrExisting.hidden = true;
    }

    if(scannerOmrExistingView){
        scannerOmrExistingView.href = "#";
    }

    if(scannerOmrModal){
        scannerOmrModal.hidden = true;
        scannerOmrModal.setAttribute(
            "aria-hidden",
            "true"
        );
    }

    document.body.classList.remove(
        "rtse-omr-modal-open"
    );

    popupMessage.textContent =
        "";

    popupMessage.style.display =
        "none";

    popupMessage.className =
        "popup-message";

    closeButton.style.display =
        "none";

    icon.style.display =
        "none";

    subtitle.textContent =
        "RTSE Examination Candidate";

    studentCard.style.display =
        "none";

    showMessage(
        "Ready to scan another candidate.",
        "info"
    );
}


function displayStudent(student, alreadyPresent){

    currentScanType =
        "GATE";

    resultEntryPanel.style.display =
        "none";

    const photo =
        document.getElementById("studentPhoto");

    if(student.photo){

        photo.src =
            "/uploads/rtse/" +
            encodeURIComponent(student.photo);

        photo.style.display =
            "block";

    }else{

        photo.removeAttribute("src");

        photo.style.display =
            "none";
    }

    document.getElementById(
        "studentName"
    ).textContent =
        student.full_name || "-";

    document.getElementById(
        "registrationNo"
    ).textContent =
        student.registration_no || "-";

    document.getElementById(
        "rollNo"
    ).textContent =
        student.roll_no || "-";

    document.getElementById(
        "fatherName"
    ).textContent =
        student.father_name || "-";

    document.getElementById(
        "schoolName"
    ).textContent =
        student.school_name || "-";

    document.getElementById(
        "studentClass"
    ).textContent =
        student.class || "-";

    document.getElementById(
        "section"
    ).textContent =
        student.section || "-";

    const lockedRoomBadge =
        document.getElementById(
            "lockedRoomBadge"
        );

    const lockedRoomNumber =
        document.getElementById(
            "lockedRoomNumber"
        );

    if(lockedRoomBadge && lockedRoomNumber){
        if(student.room_no){
            lockedRoomNumber.textContent =
                "ROOM " + student.room_no;

            lockedRoomBadge.style.display =
                "flex";
        }else{
            lockedRoomNumber.textContent =
                "";

            lockedRoomBadge.style.display =
                "none";
        }
    }

    const status =
        document.getElementById(
            "attendanceStatus"
        );

    const popupMessage =
        document.getElementById(
            "popupMessage"
        );

    const closeButton =
        document.getElementById(
            "popupCloseButton"
        );

    const subtitle =
        document.getElementById(
            "popupSubtitle"
        );

    status.style.display =
        "";

    markButton.style.display =
        "";

    popupMessage.style.display =
        "none";

    popupMessage.textContent =
        "";

    closeButton.style.display =
        "none";

    subtitle.textContent =
        "RTSE Examination Candidate";

    showPopupIcon(
        alreadyPresent ? "rejection" : "success",
        alreadyPresent ? "❌" : "✓"
    );

    if(alreadyPresent){

        status.textContent =
            "✓ ATTENDANCE ALREADY MARKED PRESENT";

        status.className =
            "attendance-status present";

        markButton.disabled =
            true;

        markButton.textContent =
            "✓ ALREADY PRESENT";

    }else{

        status.textContent =
            "CURRENT STATUS: ABSENT";

        status.className =
            "attendance-status absent";

        markButton.disabled =
            false;

        markButton.textContent =
            "Confirm Gate Entry";
    }

    studentCard.style.display =
        "flex";
}


/* =====================================
   RESULT STUDENT DISPLAY
===================================== */

function initializeScannerCountedOmr(student){
    if(
        !student ||
        !student.id ||
        typeof window.initializeRtseCountedOmr !== "function"
    ){
        return;
    }

    window.initializeRtseCountedOmr(
        document,
        Number(student.id),
        {
            uploadUrl:
                "/super-scanner/counted-omr/" +
                Number(student.id),

            viewUrl:
                "/super-scanner/counted-omr/" +
                Number(student.id)
        }
    );
}


function displayResultStudent(student, result, resultComponentMarks){

    const photo =
        document.getElementById("studentPhoto");

    if(student.photo){

        photo.src =
            "/uploads/rtse/" +
            encodeURIComponent(student.photo);

        photo.style.display =
            "block";

    }else{

        photo.removeAttribute("src");

        photo.style.display =
            "none";
    }

    document.getElementById("studentName").textContent =
        student.full_name || "-";

    document.getElementById("registrationNo").textContent =
        student.registration_no || "-";

    document.getElementById("rollNo").textContent =
        student.roll_no || "-";

    document.getElementById("fatherName").textContent =
        student.father_name || "-";

    document.getElementById("schoolName").textContent =
        student.school_name || "-";

    document.getElementById("studentClass").textContent =
        student.class || "-";

    document.getElementById("section").textContent =
        student.section || "-";

    const status =
        document.getElementById("attendanceStatus");

    const popupMessage =
        document.getElementById("popupMessage");

    const closeButton =
        document.getElementById("popupCloseButton");

    const subtitle =
        document.getElementById("popupSubtitle");

    status.textContent =
        "✓ GATE ENTRY CONFIRMED — PRESENT";

    status.className =
        "attendance-status present";

    status.style.display =
        "";

    markButton.style.display =
        "none";

    popupMessage.textContent =
        "";

    popupMessage.style.display =
        "none";

    popupMessage.className =
        "popup-message";

    closeButton.style.display =
        "block";

    closeButton.textContent =
        "Close";

    subtitle.textContent =
        "RTSE Result Entry";

    showPopupIcon(
        "success",
        "✓"
    );

    resultEntryPanel.style.display =
        "block";

    resultFullMarks.value =
        "100";

    resultMarks.value =
        result &&
        result.marks !== null &&
        result.marks !== undefined
            ? result.marks
            : "";

    const savedComponentMarks =
        Array.isArray(resultComponentMarks)
            ? resultComponentMarks
            : [];

    resultComponentInputs.forEach(
        function(input){
            const componentId =
                Number(input.dataset.componentId);

            const saved =
                savedComponentMarks.find(
                    function(item){
                        return Number(item.component_id) ===
                            componentId;
                    }
                );

            input.value =
                saved &&
                saved.marks !== null &&
                saved.marks !== undefined
                    ? saved.marks
                    : "";
        }
    );

    resultPercentage.value =
        result &&
        result.percentage !== null &&
        result.percentage !== undefined
            ? result.percentage
            : "";

    resultGrade.value =
        result && result.grade
            ? result.grade
            : "";

    calculateScannerResult();

    if(currentScanType === "RESULT"){
        initializeScannerCountedOmr(student);
    }

    studentCard.style.display =
        "flex";
}


/* =====================================
   RESULT CALCULATION
===================================== */

function calculateScannerResult(){

    const omrMarks =
        Number(resultMarks.value);

    if(
        !Number.isFinite(omrMarks) ||
        omrMarks < 0 ||
        omrMarks > 100
    ){

        resultTotalMarks.value =
            "";

        resultTotalFullMarks.value =
            "";

        resultPercentage.value =
            "";

        resultGrade.value =
            "";

        return;
    }

    let configuredObtained = 0;
    let configuredFullMarks = 0;
    let invalidComponent = false;

    resultComponentInputs.forEach(
        function(input){

            const maximum =
                Number(input.dataset.componentMax);

            const obtained =
                input.value === ""
                    ? 0
                    : Number(input.value);

            if(
                !Number.isFinite(maximum) ||
                maximum < 0 ||
                !Number.isFinite(obtained) ||
                obtained < 0 ||
                obtained > maximum
            ){
                invalidComponent = true;
                return;
            }

            configuredObtained +=
                obtained;

            configuredFullMarks +=
                maximum;
        }
    );

    if(invalidComponent){

        resultTotalMarks.value =
            "";

        resultTotalFullMarks.value =
            "";

        resultPercentage.value =
            "";

        resultGrade.value =
            "";

        return;
    }

    const totalMarks =
        omrMarks +
        configuredObtained;

    const totalFullMarks =
        100 +
        configuredFullMarks;

    const percentage =
        Number(
            (
                (totalMarks / totalFullMarks) *
                100
            ).toFixed(2)
        );

    let grade;

    if(percentage >= 90)
        grade = "A+";
    else if(percentage >= 80)
        grade = "A";
    else if(percentage >= 70)
        grade = "B+";
    else if(percentage >= 60)
        grade = "B";
    else if(percentage >= 50)
        grade = "C+";
    else if(percentage >= 40)
        grade = "C";
    else
        grade = "F";

    resultTotalMarks.value =
        totalMarks.toFixed(2);

    resultTotalFullMarks.value =
        totalFullMarks.toFixed(2);

    resultPercentage.value =
        percentage.toFixed(2);

    resultGrade.value =
        grade;
}

if(resultMarks){

    resultMarks.addEventListener(
        "input",
        calculateScannerResult
    );

    resultMarks.addEventListener(
        "change",
        calculateScannerResult
    );
}

resultComponentInputs.forEach(
    function(input){

        input.addEventListener(
            "input",
            calculateScannerResult
        );

        input.addEventListener(
            "change",
            calculateScannerResult
        );
    }
);


/* =====================================
   RESULT SAVE
===================================== */

async function saveScannerResult(){

    if(
        !currentToken ||
        !currentStudent ||
        currentScanType !== "RESULT"
    ){

        showMessage(
            "No active Result QR candidate.",
            "error"
        );

        return;
    }

const omrMarks = Number(resultMarks.value);

if(
    !Number.isFinite(omrMarks) ||
    omrMarks < 0 ||
    omrMarks > 100
){

          showMessage(
              "Enter valid OMR obtained marks.",
              "error"
          );

          return;
      }

      const componentMarks = {};

      let invalidComponent = false;

      resultComponentInputs.forEach(
          function(input){

              const componentId =
                  Number(input.dataset.componentId);

              const maximum =
                  Number(input.dataset.componentMax);

              const obtained =
                  input.value === ""
                      ? 0
                      : Number(input.value);

              if(
                  !Number.isInteger(componentId) ||
                  componentId <= 0 ||
                  !Number.isFinite(maximum) ||
                  maximum < 0 ||
                  !Number.isFinite(obtained) ||
                  obtained < 0 ||
                  obtained > maximum
              ){
                  invalidComponent = true;
                  return;
              }

              componentMarks[componentId] =
                  obtained;
          }
      );

      if(invalidComponent){

          showMessage(
              "Enter valid marks for all configured components.",
              "error"
          );

          return;
      }


    resultSaveButton.disabled =
        true;

    resultSaveButton.textContent =
        "Saving Result...";

    try{

        const response =
            await fetch(
                "/super-scanner/result/" +
                encodeURIComponent(
                    currentStudent.id
                ),
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    credentials:
                        "same-origin",

                      body:
                          JSON.stringify({
                              qr_token:
                                  currentToken,

                              marks:
    omrMarks,
                              component_marks:
                                  componentMarks
                          })
                }
            );

        const data =
            await response.json();

        if(
            !response.ok ||
            !data.success
        ){

            resultSaveButton.disabled =
                false;

            resultSaveButton.textContent =
                "Save Result";

            showMessage(
                data.message ||
                "Unable to save result.",
                "error"
            );

            return;
        }

        calculateScannerResult();

        playConfirmSuccessSound();

        showMessage(
            data.message ||
            "Result saved successfully.",
            "success"
        );

        resultSaveButton.textContent =
            "✓ Result Saved";

        setTimeout(
            function(){
                closeStudentPopup();
            },
            500
        );

    }catch(error){

        console.error(
            "Super Scanner Result Save Error:",
            error
        );

        resultSaveButton.disabled =
            false;

        resultSaveButton.textContent =
            "Save Result";

        showMessage(
            "Unable to connect to the result server.",
            "error"
        );
    }
}


/* =====================================
   MARK PRESENT
===================================== */

async function markPresent(){

    if(!currentToken){

        showMessage(
            "No candidate is currently selected.",
            "error"
        );

        return;

    }


    markButton.disabled =
        true;

    markButton.textContent =
        "Marking Attendance...";


    try{

        const response =
            await fetch(
                "/super-scanner/mark-present",
                {

                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        qr_token:currentToken
                    })

                }
            );


        const data =
            await response.json();

        /*
         * Gate entry confirmation request received.
         * The success sound is played only after the server
         * confirms that attendance was marked successfully.
         */



        if(!response.ok || !data.success){

            markButton.disabled =
                false;

            markButton.textContent =
                "Confirm Gate Entry";


            showMessage(
                data.message ||
                "Unable to mark attendance.",
                "error"
            );

            return;

        }


                /*
         * Server confirmed the gate entry successfully.
         * Play the dedicated confirmation sound only now.
         */
        playConfirmSuccessSound();

showMessage(
            data.message ||
            "Attendance marked PRESENT successfully.",
            "success"
        );


        const status =
            document.getElementById(
                "attendanceStatus"
            );


        status.textContent =
            "✓ ATTENDANCE MARKED PRESENT";


        status.className =
            "attendance-status present";


        markButton.disabled =
            true;


        markButton.textContent =
            "Gate Entry Confirmed";

        /*
         * Server has confirmed the gate entry.
         * Close the popup immediately. The scanner has
         * remained active underneath it.
         */
        closeStudentPopup();

    }catch(error){

        console.error(error);

        markButton.disabled =
            false;

        markButton.textContent =
            "Confirm Gate Entry";


        showMessage(
            "Unable to connect to the attendance server.",
            "error"
        );

    }

}


/* =====================================
   MANUAL TOKEN
===================================== */

function lookupManualToken(){

    const input =
        document.getElementById(
            "manualToken"
        );


    const token =
        String(input.value || "").trim();


    if(!token){

        showMessage(
            "Enter an RTSE QR token.",
            "error"
        );

        return;

    }


    currentToken =
        token;


    lookupToken(token);

}


/* =====================================
   STOP CAMERA
===================================== */

async function stopScanner(){

    if(
        scanner &&
        scannerRunning
    ){

        try{

            await scanner.stop();

        }catch(error){

            console.warn(
                "Scanner stop:",
                error
            );

        }

        scannerRunning =
            false;

    }

}


/* =====================================
   RESET
===================================== */

async function resetScanner(){

    closeStudentPopup();

}


/* =====================================
   START
===================================== */

window.addEventListener(
    "load",
    function(){

        startScanner();

    }
);

</script>

