<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">

<title><%= title %></title>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<style>
.section-room-card,
.locked-room-badge{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    width:100%;
    min-height:76px;
    margin:0;
    padding:12px 10px;
    box-sizing:border-box;
    text-align:center;
    border-radius:10px;
}

.class-full-row{
    grid-column:1 / -1;
}

.section-room-card{
    display:flex !important;
    flex-direction:column !important;
    align-items:center !important;
    justify-content:center !important;
    background:#0057d9 !important;
    color:#ffffff !important;
    min-height:76px !important;
    text-align:center !important;
}

.section-room-card .detail-label,
.section-room-card .detail-value{
    color:#ffffff !important;
    text-align:center !important;
}

.locked-room-badge{
    grid-column:auto;
    justify-self:stretch;
    background:#d00000;
    color:#ffffff;
}

.locked-room-label,
.section-room-card .detail-label{
    font-size:12px;
    font-weight:700;
    letter-spacing:1px;
    color:#ffffff;
}

.locked-room-number,
.section-room-card .detail-value{
    margin-top:3px;
    font-size:24px;
    font-weight:900;
    line-height:1.1;
    color:#ffffff;
}

</style>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f3f4f6;
    color:#111827;
}

.scanner-page{
    min-height:100vh;
}

/* =====================================
   HEADER
===================================== */

.scanner-header{
    background:#111827;
    color:#fff;
    padding:16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}

.scanner-header h1{
    margin:0;
    font-size:21px;
}

.scanner-user{
    margin-top:4px;
    font-size:13px;
    opacity:.85;
}

.logout-btn{
    color:#fff;
    text-decoration:none;
    border:1px solid rgba(255,255,255,.35);
    padding:8px 12px;
    border-radius:8px;
    font-size:13px;
}

/* =====================================
   MAIN
===================================== */

.scanner-container{
    width:100%;
    max-width:700px;
    margin:auto;
    padding:18px 14px 30px;
}

/* =====================================
   SCANNER CARD
===================================== */

.scanner-card{
    background:#fff;
    border-radius:16px;
    padding:16px;
    box-shadow:0 4px 18px rgba(0,0,0,.08);
}

.scanner-title{
    text-align:center;
    margin-bottom:14px;
}

.scanner-title h2{
    margin:0;
    font-size:20px;
}

.scanner-title p{
    margin:6px 0 0;
    color:#6b7280;
    font-size:13px;
}

/* =====================================
   CAMERA
===================================== */

#qr-reader{
    width:100%;
    overflow:hidden;
    border-radius:14px;
    background:#111;
}

#qr-reader video{
    border-radius:14px !important;
}

.camera-status{
    text-align:center;
    margin-top:12px;
    font-size:14px;
    color:#6b7280;
}

/* =====================================
   MANUAL TOKEN
===================================== */

.manual-box{
    margin-top:16px;
    padding-top:16px;
    border-top:1px solid #e5e7eb;
}

.manual-box label{
    display:block;
    font-size:13px;
    font-weight:bold;
    margin-bottom:6px;
}

.manual-row{
    display:flex;
    gap:8px;
}

.manual-row input{
    flex:1;
    min-width:0;
    padding:12px;
    border:1px solid #d1d5db;
    border-radius:8px;
    font-size:14px;
}

.manual-row button{
    border:0;
    background:#111827;
    color:#fff;
    padding:0 16px;
    border-radius:8px;
    font-weight:bold;
}

/* =====================================
   MESSAGE
===================================== */

.message{
    display:none;
    margin-top:14px;
    padding:12px;
    border-radius:9px;
    font-size:14px;
    font-weight:bold;
}

.message.success{
    display:block;
    background:#dcfce7;
    color:#166534;
}

.message.error{
    display:block;
    background:#fee2e2;
    color:#991b1b;
}

.message.info{
    display:block;
    background:#dbeafe;
    color:#1e40af;
}

/* =====================================
   STUDENT CARD
===================================== */

.student-card{
    display:none;
    position:fixed;
    inset:0;
    z-index:9999;
    margin:0;
    padding:20px;
    background:rgba(0,0,0,.58);
    align-items:center;
    justify-content:center;
    overflow-y:auto;
}

.student-popup{
    width:min(560px, 100%);
    max-height:calc(100vh - 40px);
    overflow-y:auto;
    background:#fff;
    border-radius:16px;
    box-shadow:0 20px 60px rgba(0,0,0,.25);
}

.student-popup > .student-header{
    border-radius:16px 16px 0 0;
    padding:22px 20px 14px;
}

.student-popup > .student-details{
    padding:0 20px 14px;
}

.student-popup > .attendance-status{
    padding:0 20px 14px;
    margin:0;
}

.student-popup > .mark-btn{
    margin:0;
    border-radius:0;
    padding:15px 20px;
}

.student-popup > .scan-again{
    margin:0;
    border-radius:0 0 16px 16px;
    padding:12px 20px;
}

.popup-icon{
    width:64px;
    height:64px;
    margin:0 auto 12px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:36px;
    font-weight:900;
}

.popup-icon.success{
    background:#dcfce7;
    color:#15803d;
}

.popup-icon.rejection{
    background:#fee2e2;
    color:#dc2626;
}

.popup-message{
    margin:14px 0 0;
    font-size:15px;
    line-height:1.5;
    font-weight:700;
}

.popup-message.rejection{
    color:#b91c1c;
}

.student-header{
    text-align:center;
    border-bottom:1px solid #e5e7eb;
    padding-bottom:14px;
    margin-bottom:14px;
}

.student-header h2{
    margin:0;
    font-size:21px;
}

.student-header p{
    margin:5px 0 0;
    color:#6b7280;
    font-size:13px;
}

.student-details{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.detail{
    background:#f9fafb;
    border-radius:8px;
    padding:10px;
}

.detail-label{
    display:block;
    color:#6b7280;
    font-size:11px;
    margin-bottom:3px;
}

.detail-value{
    display:block;
    font-weight:bold;
    font-size:14px;
    word-break:break-word;
}

/* =====================================
   ATTENDANCE STATUS
===================================== */

.attendance-status{
    margin-top:16px;
    text-align:center;
    padding:13px;
    border-radius:10px;
    font-weight:bold;
}

.attendance-status.absent{
    background:#fef3c7;
    color:#92400e;
}

.attendance-status.present{
    background:#dcfce7;
    color:#166534;
}

/* =====================================
   ACTION BUTTON
===================================== */

.mark-btn{
    width:100%;
    margin-top:14px;
    padding:15px;
    border:0;
    border-radius:10px;
    background:#15803d;
    color:#fff;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
}

.mark-btn:disabled{
    opacity:.6;
    cursor:not-allowed;
}

.scan-again{
    width:100%;
    margin-top:10px;
    padding:12px;
    border:1px solid #d1d5db;
    border-radius:10px;
    background:#fff;
    color:#111827;
    font-weight:bold;
}

/* =====================================
   MOBILE
===================================== */

/* =====================================
   RESULT ENTRY PANEL
===================================== */

.result-entry-panel{
    width:calc(100% - 40px);
    box-sizing:border-box;
    margin:0 20px 14px;
    padding:14px;
    border:1px solid #dbeafe;
    border-radius:12px;
    background:#f8fbff;
}

.result-entry-title{
    margin-bottom:12px;
    text-align:center;
    font-size:15px;
    font-weight:800;
    color:#1e3a8a;
}

.result-form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.result-field{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.result-field label{
    font-size:11px;
    font-weight:700;
    color:#6b7280;
}

.result-field input{
    width:100%;
    box-sizing:border-box;
    padding:10px;
    border:1px solid #d1d5db;
    border-radius:8px;
    background:#fff;
    color:#111827;
    font-size:14px;
    font-weight:700;
    outline:none;
}

.result-field input:focus{
    border-color:#2563eb;
}

.result-field input[readonly]{
    background:#f3f4f6;
}

.result-save-btn{
    width:100%;
    margin-top:12px;
    padding:13px;
    border:0;
    border-radius:9px;
    background:#2563eb;
    color:#fff;
    font-size:15px;
    font-weight:800;
    cursor:pointer;
}

.result-save-btn:disabled{
    opacity:.6;
    cursor:not-allowed;
}

@media(max-width:520px){

    .scanner-header{
        align-items:flex-start;
    }

    .scanner-header h1{
        font-size:18px;
    }

    .scanner-container{
        padding:12px 10px 25px;
    }

    .scanner-card{
        padding:12px;
    }

    .student-details{
        grid-template-columns:1fr;
    }

    .manual-row{
        flex-direction:column;
    }

    .manual-row button{
        padding:12px;
    }

}



/* SUPER SCANNER COUNTED OMR CSS */
/* ============================================================
   Separate Counted OMR Popup
   ============================================================ */

.rtse-counted-omr-box {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid #dbe3ea;
    border-radius: 14px;
    background: #f8fafc;
    box-sizing: border-box;
}

.rtse-counted-omr-note {
    margin: 8px 0 12px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
}

.rtse-counted-omr-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.rtse-omr-existing[hidden] {
    display: none !important;
}

.rtse-omr-existing {
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    padding: 9px 11px;
    border-radius: 10px;
    background: #ecfdf5;
    color: #166534;
    font-size: 13px;
}

.rtse-omr-modal[hidden] {
    display: none !important;
}

.rtse-omr-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 100000 !important;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100vw;
    height: 100vh;

    padding: 12px;
    box-sizing: border-box;
}

.rtse-omr-modal-backdrop {
    position: absolute;
    inset: 0;

    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(3px);
}

.rtse-omr-modal-card {
    position: relative;
    z-index: 1;

    width: min(960px, 96vw);
    max-width: 960px;
    max-height: 94vh;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border-radius: 18px;
    background: #ffffff;

    box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.30);

    box-sizing: border-box;
}

.rtse-omr-modal-header {
    flex: 0 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding: 13px 16px;

    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
}

.rtse-omr-modal-header strong {
    display: block;
    color: #0f172a;
    font-size: 16px;
}

.rtse-omr-modal-header small {
    display: block;
    margin-top: 3px;
    color: #64748b;
    font-size: 12px;
}

.rtse-omr-modal-close {
    width: 34px;
    height: 34px;
    min-width: 34px;

    flex: 0 0 34px;

    border: 0;
    border-radius: 50%;

    background: #e2e8f0;
    color: #334155;

    font-size: 24px;
    line-height: 1;

    cursor: pointer;
}

.rtse-omr-modal-close:hover {
    background: #cbd5e1;
}

.rtse-omr-modal-body {
    min-height: 0;

    overflow: auto;

    padding: 14px;
    box-sizing: border-box;
}

.rtse-omr-modal-body .rtse-omr-editor,
.rtse-omr-modal-body .rtse-omr-cropped-preview {
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
}

body.rtse-omr-modal-open {
    overflow: hidden !important;
}

@media (max-width: 640px) {

    .rtse-omr-modal {
        padding: 7px;
    }

    .rtse-omr-modal-card {
        width: 100%;
        max-width: 100%;
        max-height: 96vh;
        border-radius: 14px;
    }

    .rtse-omr-modal-header {
        padding: 11px 12px;
    }

    .rtse-omr-modal-body {
        padding: 9px;
    }

    .rtse-counted-omr-actions {
        flex-direction: column;
    }

    .rtse-counted-omr-actions .rtse-omr-btn {
        width: 100%;
    }
}

/* =========================================
   RTSE Counted OMR
   ========================================= */

.rtse-counted-omr-box {
    border:1px solid #e5e7eb;
    border-radius:10px;
    background:#fff;
    padding:12px;
    margin-bottom:10px;
    box-sizing:border-box;
}

.rtse-counted-omr-note {
    font-size:11px;
    line-height:1.5;
    color:#6b7280;
    margin:-3px 0 9px;
}

.rtse-counted-omr-actions,
.rtse-omr-editor-actions,
.rtse-omr-upload-actions {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:7px;
}

.rtse-omr-btn {
    width:100%;
    min-height:36px;
    border:0;
    border-radius:7px;
    padding:7px 9px;
    font-size:12px;
    font-weight:600;
    cursor:pointer;
    box-sizing:border-box;
}

.rtse-omr-btn:disabled {
    opacity:.65;
    cursor:not-allowed;
}

.rtse-omr-btn-camera {
    background:#2563eb;
    color:#fff;
}

.rtse-omr-btn-choose {
    background:#475569;
    color:#fff;
}

.rtse-omr-btn-crop {
    background:#16a34a;
    color:#fff;
}

.rtse-omr-btn-upload {
    background:#16a34a;
    color:#fff;
}

.rtse-omr-btn-cancel {
    background:#e5e7eb;
    color:#374151;
}

.rtse-omr-editor {
    margin-top:9px;
    border:1px solid #e2e8f0;
    border-radius:9px;
    background:#f8fafc;
    padding:9px;
}

.rtse-omr-editor-title {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    margin-bottom:7px;
    font-size:12px;
    font-weight:700;
    color:#172033;
}

.rtse-omr-editor-title small {
    font-size:9px;
    font-weight:500;
    color:#16a34a;
}

.rtse-omr-crop-stage {
    position:relative;
    width:100%;
    max-height:62vh;
    min-height:180px;
    overflow:hidden;
    border-radius:7px;
    background:#111827;
    touch-action:none;
    user-select:none;
}

.rtse-omr-crop-stage > img {
    display:block;
    width:100%;
    height:auto;
    max-height:62vh;
    object-fit:contain;
    margin:0 auto;
    user-select:none;
    pointer-events:none;
}

.rtse-omr-crop-box {
    position:absolute;
    box-sizing:border-box;
    border:2px solid #16a34a;
    background:rgba(22,163,74,.08);
    box-shadow:0 0 0 9999px rgba(0,0,0,.42);
    touch-action:none;
    cursor:move;
}

.rtse-omr-crop-label {
    position:absolute;
    top:5px;
    left:5px;
    padding:2px 5px;
    border-radius:4px;
    background:#16a34a;
    color:#fff;
    font-size:8px;
    font-weight:700;
    letter-spacing:.3px;
    pointer-events:none;
}

.rtse-omr-handle {
    position:absolute;
    width:15px;
    height:15px;
    border:2px solid #fff;
    background:#16a34a;
    border-radius:3px;
    box-sizing:border-box;
}

.rtse-omr-handle-nw {
    top:-7px;
    left:-7px;
    cursor:nwse-resize;
}

.rtse-omr-handle-ne {
    top:-7px;
    right:-7px;
    cursor:nesw-resize;
}

.rtse-omr-handle-sw {
    bottom:-7px;
    left:-7px;
    cursor:nesw-resize;
}

.rtse-omr-handle-se {
    bottom:-7px;
    right:-7px;
    cursor:nwse-resize;
}

.rtse-omr-editor-help {
    padding:7px 2px;
    color:#64748b;
    font-size:10px;
    line-height:1.4;
}

.rtse-omr-cropped-preview {
    margin-top:9px;
    padding:9px;
    border:1px solid #bbf7d0;
    border-radius:9px;
    background:#f0fdf4;
}

.rtse-omr-cropped-title {
    margin-bottom:7px;
    font-size:11px;
    font-weight:700;
    color:#15803d;
}

.rtse-omr-cropped-preview img {
    display:block;
    width:100%;
    max-height:55vh;
    object-fit:contain;
    border:1px solid #d1d5db;
    border-radius:6px;
    background:#fff;
    margin-bottom:8px;
}

.rtse-omr-upload-status {
    margin-top:7px;
    min-height:16px;
    font-size:10px;
    line-height:1.4;
    color:#475569;
}

.rtse-omr-existing {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-top:9px;
    padding:8px 9px;
    border:1px solid #bbf7d0;
    border-radius:7px;
    background:#f0fdf4;
    color:#15803d;
    font-size:10px;
    font-weight:600;
}

.rtse-omr-see-button {
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:30px;
    padding:5px 8px;
    border-radius:6px;
    background:#16a34a;
    color:#fff;
    text-decoration:none;
    font-size:10px;
    font-weight:700;
}

@media (max-width:600px) {

    .rtse-counted-omr-box {
        padding:9px;
    }

    .rtse-counted-omr-actions,
    .rtse-omr-editor-actions,
    .rtse-omr-upload-actions {
        gap:5px;
    }

    .rtse-omr-btn {
        min-height:34px;
        padding:6px 5px;
        font-size:10px;
    }

    .rtse-omr-editor-title {
        font-size:11px;
    }

    .rtse-omr-editor-title small {
        font-size:8px;
    }

    .rtse-omr-crop-stage {
        max-height:55vh;
    }

    .rtse-omr-crop-stage > img {
        max-height:55vh;
    }

    .rtse-omr-existing {
        align-items:stretch;
        flex-direction:column;
    }

    .rtse-omr-see-button {
        width:100%;
    }
}
</style>

</head>

<body>

<div class="scanner-page">

<header class="scanner-header">

    <div>

        <h1>
            RTSE Super Scanner
        </h1>

        <div class="scanner-user">

            Logged in as:
            <strong>
                <%= user.username %>
            </strong>

        </div>

    </div>

    <a
        href="/admin/logout"
        class="logout-btn">

        Logout

    </a>

</header>


<main class="scanner-container">


<!-- =====================================
     QR SCANNER
===================================== -->

<section class="scanner-card">

    <div class="scanner-title">

        <h2>
            Scan RTSE Admit Card
        </h2>

        <p>
            Point the camera at the Examination Entry QR code.
        </p>

    </div>


    <div id="qr-reader"></div>


    <div
        id="cameraStatus"
        class="camera-status">

        Starting camera...

    </div>


    <!-- Manual token fallback -->

    <div class="manual-box">

        <label for="manualToken">
            Manual QR Token
        </label>

        <div class="manual-row">

            <input
                type="text"
                id="manualToken"
                placeholder="RTSE-xxxxxxxx...">

            <button
                type="button"
                onclick="lookupManualToken()">

                Verify

            </button>

        </div>

    </div>


    <div
        id="message"
        class="message">
    </div>

</section>


<!-- =====================================
     STUDENT INFORMATION
===================================== -->

<section
    id="studentCard"
    class="student-card">

    <div class="student-popup">

    <div class="student-header">

        <div
            id="popupIcon"
            class="popup-icon"
            style="display:none;"
        ></div>
            <img
                id="studentPhoto"
                class="student-photo"
                src=""
                alt="Student Photo"
                style="display:none; width:110px; height:135px; object-fit:cover; border-radius:10px; margin:0 auto 12px; border:2px solid rgba(255,255,255,.25);"
            >


        <h2 id="studentName">
            Student
