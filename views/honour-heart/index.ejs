    padding: 9px 11px !important;

    border: 1px solid #d7b45b !important;
    border-radius: 8px !important;

    background:
        linear-gradient(
            90deg,
            #fffdf8 0%,
            #ffffff 60%,
            #fffdf7 100%
        ) !important;

    box-shadow: none !important;

    text-decoration: none !important;
}


/* portrait */

.hh-reference-card .hh-upcoming-photo {
    width: 58px !important;
    height: 58px !important;

    min-width: 58px !important;
    min-height: 58px !important;

    border-radius: 50% !important;

    overflow: hidden !important;

    border: 2px solid #d9dfe7 !important;

    background: #eef1f4 !important;

    box-shadow: none !important;
}

.hh-reference-card .hh-upcoming-photo img {
    width: 100% !important;
    height: 100% !important;

    object-fit: cover !important;

    display: block !important;
}


/* central information */

.hh-reference-card .hh-upcoming-info {
    min-width: 0 !important;

    display: flex !important;
    flex-direction: column !important;

    justify-content: center !important;
    align-items: flex-start !important;

    padding: 0 !important;
    margin: 0 !important;
}

.hh-reference-card .hh-upcoming-label {
    display: block !important;

    margin: 0 0 2px !important;

    color: #b17c1c !important;

    font-size: 6px !important;
    line-height: 1 !important;

    font-weight: 900 !important;

    letter-spacing: .1em !important;
}

.hh-reference-card .hh-upcoming-info h2 {
    margin: 0 0 3px !important;

    color: #102f5e !important;

    font-size: 13px !important;
    line-height: 1.15 !important;

    font-weight: 900 !important;
}

.hh-reference-card .hh-upcoming-designation {
    display: block !important;

    margin: 0 0 2px !important;

    color: #536174 !important;

    font-size: 7px !important;
    line-height: 1.25 !important;
}

.hh-reference-card .hh-upcoming-location {
    display: block !important;

    margin: 0 !important;

    color: #59677a !important;

    font-size: 6px !important;
    line-height: 1.2 !important;
}

.hh-reference-card .hh-upcoming-category {
    display: inline-block !important;

    margin-top: 4px !important;

    color: #98701d !important;

    font-size: 5px !important;
    line-height: 1.15 !important;

    font-weight: 800 !important;
}


/* award year */

.hh-reference-card .hh-upcoming-year {
    min-width: 0 !important;

    border-left: 1px solid #dfe3e8 !important;

    padding: 4px 0 4px 10px !important;

    text-align: center !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
}

.hh-reference-card .hh-upcoming-year span {
    display: block !important;

    color: #7b8491 !important;

    font-size: 5px !important;
    line-height: 1.1 !important;

    font-weight: 800 !important;
}

.hh-reference-card .hh-upcoming-year strong {
    display: block !important;

    margin: 2px 0 !important;

    color: #102f5e !important;

    font-size: 20px !important;
    line-height: 1 !important;

    font-weight: 900 !important;
}

.hh-reference-card .hh-upcoming-year small {
    display: block !important;

    color: #8a929d !important;

    font-size: 5px !important;
    line-height: 1.1 !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 700px) {

    .hh-upcoming-section {
        width: calc(100% - 18px) !important;

        padding-top: 7px !important;
        padding-bottom: 7px !important;
    }

    .hh-upcoming-section .hh-section-heading {
        margin-bottom: 5px !important;
    }

    .hh-upcoming-reference-card {
        width: 100% !important;

        min-height: 0 !important;
        height: 76px !important;

        grid-template-columns: 45px minmax(0,1fr) 52px !important;

        gap: 7px !important;

        padding: 6px 7px !important;

        border-radius: 6px !important;
    }

    .hh-reference-card .hh-upcoming-photo {
        width: 42px !important;
        height: 42px !important;

