<%- include("../partials/header") %>


<!-- HONOUR HEART DEDICATED MOBILE/DESKTOP HEADER -->
<div class="hh-reference-header">
    <div class="hh-reference-header-inner">

        <a href="/" class="hh-reference-brand">
            <span class="hh-reference-logo">
                <img
                        src="<%= siteSettings && siteSettings.logo ? siteSettings.logo : '/images/logo.png' %>"
                        alt="<%= siteSettings && siteSettings.institution_name ? siteSettings.institution_name : 'ARSP' %>"
                    >
            </span>

            <span class="hh-reference-brand-text">
                <strong>ACTIVE RURAL SOCIAL PROGRESS (ARSP)</strong>
                <small>TOGETHER FOR A BETTER SOCIETY</small>
            </span>
        </a>

        <button
            type="button"
            class="hh-reference-menu"
            aria-label="Open navigation"
            onclick="document.body.classList.toggle('hh-reference-menu-open')"
        >
            ☰
        </button>

    </div>
</div>

<main class="hh-page">

    <!-- HONOUR HEART IDENTITY -->
    <section class="hh-identity">
        <div class="hh-identity-inner">

            <div class="hh-trophy">
                <div class="hh-laurel hh-laurel-left">❯</div>
                <div class="hh-trophy-icon">
                    <span>🏆</span>
                    <strong>ARSP</strong>
                    <small>HONOUR<br>HEART</small>
                </div>
                <div class="hh-laurel hh-laurel-right">❮</div>
            </div>

            <div class="hh-identity-copy">
                <span class="hh-eyebrow">
                    <%= settings?.identity_eyebrow || "ARSP HONOUR HEART" %>
                </span>

                <h1>
                    <%= settings?.identity_title || "ARSP HONOUR HEART" %>
                </h1>

                <h2>
                    <%= settings?.identity_tagline || "Recognising the Hearts that Inspire Society" %>
                </h2>

                <p>
                    <%= settings?.identity_description ||
                        "The ARSP Honour HEART is a prestigious recognition presented by Active Rural Social Progress (ARSP) to individuals who have made remarkable contributions towards welfare, development, empowerment, and social progress." %>
                </p>

                <div class="hh-identity-actions">
                    <a
                        href="<%= settings?.identity_primary_url || '#previous-awardees' %>"
                        class="hh-btn hh-btn-primary"
                    >
                        <span>🏆</span>
                        <%= settings?.identity_primary_text || "VIEW AWARDEES" %>
                    </a>

                    <a
                        href="<%= settings?.identity_secondary_url || '#selection-board' %>"
                        class="hh-btn hh-btn-secondary"
                    >
                        <span>♟</span>
                        <%= settings?.identity_secondary_text || "SELECTION BODY" %>
                    </a>
                </div>
            </div>

            <div class="hh-recognition-box">
                <div>♙ <span>Recognises individuals for their extraordinary contributions in various fields of service.</span></div>
                <div>♨ <span>Encourages and motivates selfless service and social responsibility.</span></div>
                <div>▣ <span>Awardees are displayed chronologically with the most recent recipient at the top.</span></div>
                <div>◎ <span>The individual selected for the forthcoming award is shown at the very top in a light-grey card.</span></div>
                <div>★ <span>A legacy dedicated to service, inspiration, leadership, and social progress.</span></div>
            </div>

        </div>
    </section>


    <!-- AT A GLANCE -->
    <section class="hh-section hh-glance">
        <div class="hh-section-heading">
            <span>AT A GLANCE</span>
        </div>

        <div class="hh-stat-grid">

            <div class="hh-stat-card">
                <span class="hh-stat-icon">🏆</span>
                <strong><%= previousAwardees.length + (upcomingAwardee ? 1 : 0) %></strong>
                <small>Honour HEART<br>Recipients</small>
            </div>

            <div class="hh-stat-card">
                <span class="hh-stat-icon">♟</span>
                <strong><%= board.length %></strong>
                <small>Selection Body<br>Members</small>
            </div>

            <div class="hh-stat-card">
                <span class="hh-stat-icon">▣</span>
                <strong>2021</strong>
                <small>Recognition<br>Started</small>
            </div>

            <div class="hh-stat-card">
                <span class="hh-stat-icon">♕</span>
                <strong><%= upcomingAwardee ? 1 : 0 %></strong>
                <small>Upcoming<br>Honouree</small>
            </div>

        </div>
    </section>


    <!-- SELECTION BODY -->
    <section id="selection-board" class="hh-section hh-selection">
        <div class="hh-section-heading">
            <span>ARSP HONOUR HEART</span>
            <h2>
                <%= settings?.selection_title || "SELECTION BODY" %>
            </h2>
            <p>
                <%= settings?.selection_description ||
                    "The ARSP Honour HEART recipient is selected by an independent Selection Body consisting of four distinguished members." %>
            </p>
        </div>

        <div class="hh-board-shell">

            <button class="hh-carousel-arrow hh-carousel-prev" type="button" aria-label="Previous">
                ‹
            </button>

            <div class="hh-board-track">
                <% board.forEach((member, index) => { %>
                    <article class="hh-board-card">

                        <div class="hh-board-number">
                            <%= index + 1 %>
                        </div>

                        <div class="hh-board-photo">
                            <% if (member.photo) { %>
                                <img
                                    src="/uploads/honour-heart/board/<%= member.photo %>"
                                    alt="<%= member.name %>"
                                >
                            <% } else { %>
                                <div class="hh-photo-placeholder">👤</div>
                            <% } %>
                        </div>

                        <div class="hh-board-info">
                            <h3><%= member.name %></h3>

                            <span class="hh-board-role">
                                <%= index === 0 ? "CHAIRPERSON" : "MEMBER" %>
                            </span>

                            <% if (member.designation) { %>
                                <p><%= member.designation %></p>
                            <% } %>

                            <% if (member.organisation) { %>
                                <small><%= member.organisation %></small>
                            <% } %>
                        </div>

                    </article>
                <% }) %>
            </div>

            <button class="hh-carousel-arrow hh-carousel-next" type="button" aria-label="Next">
                ›
            </button>

        </div>

        <div class="hh-carousel-dots" data-carousel-dots="board">
            <% const boardDots = Math.max(1, Math.min(6, board.length)); %>
            <% for (let i = 0; i < boardDots; i++) { %>
                <span class="<%= i === 0 ? 'active' : '' %>"></span>
            <% } %>
        </div>

        <div class="hh-selection-note">
            <span>♢</span>
            <p>
                <%= settings?.selection_note ||
                    "The Selection Body evaluates nominations based on contribution to society, impact, leadership, dedication, consistency, and ethical conduct. The decision is made independently and without any discrimination." %>
            </p>
        </div>
    </section>


    <!-- UPCOMING HONOUREE -->
    <% if (upcomingAwardee) { %>
        <section class="hh-section hh-upcoming-section">

            <div class="hh-section-heading compact">
                <span>UPCOMING HONOUREE</span>
            </div>

            <a
                class="hh-upcoming-card hh-upcoming-reference-card"
                href="/honour-heart/awardee/<%= upcomingAwardee.id %>"
            >

                <div class="hh-upcoming-photo">
                    <% if (upcomingAwardee.photo) { %>
                        <img
                            src="/uploads/honour-heart/awardees/<%= upcomingAwardee.photo %>"
                            alt="<%= upcomingAwardee.name %>"
                        >
                    <% } else { %>
                        <div class="hh-photo-placeholder">👤</div>
                    <% } %>
                </div>

                <div class="hh-upcoming-info">

                    <span class="hh-upcoming-label">
                        UPCOMING HONOUREE
                    </span>

                    <h2>
                        <%= upcomingAwardee.name %>
                    </h2>

                    <% if (upcomingAwardee.designation) { %>
                        <p class="hh-upcoming-designation">
                            <%= upcomingAwardee.designation %>
                        </p>
                    <% } %>

                    <% if (upcomingAwardee.venue) { %>
                        <small class="hh-upcoming-location">
                            ● <%= upcomingAwardee.venue %>
                        </small>
                    <% } %>

                    <% if (upcomingAwardee.award_category) { %>
                        <span class="hh-upcoming-category">
                            <%= upcomingAwardee.award_category %>
                        </span>
                    <% } %>

                </div>

                <div class="hh-upcoming-year">

                    <span>AWARD YEAR</span>

                    <strong>
                        <%= upcomingAwardee.award_year || "—" %>
                    </strong>

                    <small>
                        To Be Conferred
                    </small>

                </div>

            </a>

        </section>
    <% } %>


    <!-- LEGACY -->
    <section id="previous-awardees" class="hh-section hh-legacy">

        <div class="hh-section-heading">
            <span>ARSP HONOUR HEART</span>
            <h2><%= settings?.legacy_title || "LEGACY" %></h2>
            <p>
                <%= settings?.legacy_description ||
                    "Honouring individuals whose service, leadership and social impact continue to inspire a better society." %>
            </p>
        </div>

        <div class="hh-legacy-list">

            <% previousAwardees.forEach((awardee) => { %>

                <a
                    href="/honour-heart/awardee/<%= awardee.id %>"
                    class="hh-legacy-row"
                >

                    <div class="hh-year">
                        <%= awardee.award_year || "—" %>
                    </div>

                    <div class="hh-legacy-photo">
                        <% if (awardee.photo) { %>
                            <img
                                src="/uploads/honour-heart/awardees/<%= awardee.photo %>"
                                alt="<%= awardee.name %>"
                            >
                        <% } else { %>
                            <div class="hh-photo-placeholder">👤</div>
                        <% } %>
                    </div>

                    <div class="hh-legacy-person">
                        <h3><%= awardee.name %></h3>

                        <% if (awardee.designation) { %>
                            <p><%= awardee.designation %></p>
                        <% } %>

                        <% if (awardee.venue) { %>
                            <small>● <%= awardee.venue %></small>
                        <% } %>
                    </div>

                    <div class="hh-legacy-date">
                        <span>AWARDED IN</span>
                        <strong><%= awardee.award_year || "—" %></strong>
                    </div>

                    <span class="hh-row-arrow">›</span>

                </a>

            <% }) %>

        </div>

        <a
            href="<%= settings?.legacy_button_url || '/honour-heart/awardees' %>"
            class="hh-view-all"
        >
            <span>♟</span>
            <%= settings?.legacy_button_text || "VIEW ALL AWARDEES" %>
        </a>

    </section>



    <!-- LEGENDARY PERSONALITIES -->
    <section class="legend-section">
        <div class="container">

            <div class="section-title">
                <span class="section-badge">
                    LEGENDARY PERSONALITIES
                </span>

                <h2>
                    Great Souls Who Inspire Generations
                </h2>

                <p>
                    Every ARSP Honour Heart Award is dedicated to the ideals and
                    legacy of extraordinary personalities whose lives continue to
                    inspire humanity.
                </p>
            </div>

            <div class="legend-grid">
                <% legends.forEach((legend) => { %>

                    <a
                        href="/honour-heart/legend/<%= legend.slug %>"
                        class="legend-card"
                    >

                        <div class="legend-image">
                            <img
                                src="/uploads/honour-heart/legends/<%= legend.photo %>"
                                alt="<%= legend.name %>"
                                loading="lazy"
                            >
                        </div>

                        <div class="legend-body">

                            <h3>
                                <%= legend.name %>
                            </h3>

                            <% if (legend.designation) { %>
                                <h5>
                                    <%= legend.designation %>
                                </h5>
                            <% } %>

                            <div class="legend-btn">
                                Read Biography
                                <span aria-hidden="true">→</span>
                            </div>

                        </div>

                    </a>

                <% }) %>
            </div>

        </div>
    </section>

    <!-- RECOGNITION PRINCIPLES -->
    <section class="hh-section hh-principles">

        <div class="hh-section-heading">
            <span>OUR RECOGNITION PRINCIPLES</span>
        </div>

        <div class="hh-principles-grid">

            <% for (let i = 1; i <= 5; i++) { %>
                <div class="hh-principle">

                    <div class="hh-principle-icon">
                        <%= settings?.["principle_" + i + "_icon"] || ["♡","✦","♧","⚖","✓"][i - 1] %>
                    </div>

                    <strong>
                        <%= settings?.["principle_" + i + "_title"] || [
                            "Selfless Service",
                            "Positive Social Impact",
                            "Leadership & Inspiration",
                            "Fairness & Transparency",
                            "Integrity & Accountability"
                        ][i - 1] %>
                    </strong>

                    <p>
                        <%= settings?.["principle_" + i + "_description"] || "" %>
                    </p>

                </div>
            <% } %>

        </div>

    </section>

</main>


<style id="hh-upcoming-reference-fix">

/* =========================================================
   UPCOMING HONOUREE — REFERENCE CARD
   ========================================================= */

.hh-upcoming-reference-card {
    width: 100% !important;
