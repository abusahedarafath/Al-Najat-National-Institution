<script>
(function () {

    function setupCarousel(section) {
        const track = section.querySelector(".hh-board-track");
        const prev = section.querySelector(".hh-carousel-prev");
        const next = section.querySelector(".hh-carousel-next");
        const dots = section.querySelectorAll(".hh-carousel-dots span");

        if (!track || !prev || !next) return;

        let index = 0;

        function visibleCards() {
            return window.innerWidth <= 700 ? 4 : 4;
        }

        function maxIndex() {
            return Math.max(
                0,
                track.children.length - visibleCards()
            );
        }

        function update() {
            const cards = track.children;
            if (!cards.length) return;

            const first = cards[0];
            const gap = parseFloat(getComputedStyle(track).gap || "0");
            const width = first.getBoundingClientRect().width + gap;

            track.scrollTo({
                left: index * width,
                behavior: "smooth"
            });

            dots.forEach((dot, i) => {
                dot.classList.toggle(
                    "active",
                    i === Math.min(
                        dots.length - 1,
                        Math.floor(index / Math.max(1, visibleCards()))
                    )
                );
            });

            prev.disabled = index <= 0;
            next.disabled = index >= maxIndex();
        }

        prev.addEventListener("click", function () {
            index = Math.max(0, index - 1);
            update();
        });

        next.addEventListener("click", function () {
            index = Math.min(maxIndex(), index + 1);
            update();
        });

        window.addEventListener("resize", update);
        update();
    }

    document.querySelectorAll(".hh-selection").forEach(setupCarousel);

})();
</script>

