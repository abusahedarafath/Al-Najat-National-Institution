<%- include("../partials/header") %>

<section class="page-banner">

<div class="container">

<h1>

<%= awardee.name %>

</h1>

<p>

ARSP Honour Heart Award <%= awardee.award_year %>

</p>

</div>

</section>

<section class="about-section">

<div class="container">

<div class="personality-wrapper">

<div class="personality-image">

<img

src="/uploads/honour-heart/awardees/<%= awardee.photo %>"

alt="<%= awardee.name %>">

</div>

<div class="personality-content">

<span class="section-badge">

<%= awardee.award_category %>

</span>

<h2>

<%= awardee.name %>

</h2>

<h4>

<%= awardee.designation %>

</h4>

<p>

<%= awardee.biography %>

</p>

<br>

<h3>

Achievements

</h3>

<p>

<%= awardee.achievements %>

</p>

<br>

<h3>

Award Citation

</h3>

<p>

<%= awardee.citation %>

</p>

<% if(legend){ %>

<br>

<h3>

Award Named After

</h3>

<p>

<strong>

<%= legend.name %>

</strong>

-

<%= legend.designation %>

</p>

<% } %>

</div>

</div>

</div>

</section>

<%- include("../partials/footer") %>
