<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f1f5f9;
    color:#0f172a;
}

.topbar{
    background:#1e3a8a;
    color:#fff;
    padding:15px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}

.topbar strong{
    font-size:18px;
}

.topbar small{
    display:block;
    margin-top:3px;
    opacity:.8;
}

.logout{
    background:transparent;
    color:#fff;
    border:1px solid rgba(255,255,255,.4);
    padding:9px 13px;
    border-radius:8px;
}

main{
    max-width:1250px;
    margin:auto;
    padding:20px;
}

.back{
    display:inline-block;
    margin-bottom:15px;
    color:#1d4ed8;
    text-decoration:none;
    font-weight:600;
}

.card{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:14px;
    padding:20px;
    margin-bottom:18px;
}

h1{
    margin:0 0 6px;
    font-size:24px;
}

.muted{
    color:#64748b;
    font-size:13px;
}

.search-form{
    display:flex;
    gap:10px;
    margin-top:18px;
}

.search-form input{
    flex:1;
    min-width:0;
    padding:12px 14px;
    border:1px solid #cbd5e1;
    border-radius:8px;
    font-size:14px;
}

.search-form button,
.clear{
    padding:12px 16px;
    border:0;
    border-radius:8px;
    text-decoration:none;
    cursor:pointer;
    font-weight:600;
}

.search-form button{
    background:#2563eb;
    color:#fff;
}

.clear{
    background:#f1f5f9;
    color:#334155;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

th,td{
    padding:12px 10px;
    border-bottom:1px solid #e2e8f0;
    text-align:left;
    font-size:13px;
}

th{
    background:#f8fafc;
    color:#475569;
}

.badge{
    display:inline-block;
    padding:4px 8px;
    border-radius:999px;
    font-size:11px;
    font-weight:700;
}

.approved{
    background:#dcfce7;
    color:#166534;
}

.pending{
    background:#fef3c7;
    color:#92400e;
}

.rejected{
    background:#fee2e2;
    color:#991b1b;
}

.empty{
    text-align:center;
    padding:35px;
    color:#64748b;
}

@media(max-width:650px){
    main{
        padding:14px;
    }

    .search-form{
        flex-direction:column;
    }

    .topbar{
        padding:14px;
    }
}

        .view-btn {
            display: inline-block;
            padding: 7px 12px;
            background: #0d6efd;
            color: #fff;
            text-decoration: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
        }

        .view-btn:hover {
            opacity: 0.9;
        }

</style>
</head>

<body>

<header class="topbar">
    <div>
        <strong>ARSP School Portal</strong>
        <small>
            <%= school.school_name %> · <%= school.school_code %>
        </small>
    </div>

    <form
        method="POST"
        action="/arsp/school/logout"
        style="margin:0"
        onsubmit="return confirm('Logout from the School Portal?');"
    >
        <button class="logout" type="submit">Logout</button>
    </form>
</header>

<main>

<a class="back" href="/arsp/school/dashboard">
    ← Back to Dashboard
</a>

<section class="card">

    <h1>RTSE Student Registry</h1>

    <div class="muted">
        RTSE students registered under
        <strong><%= school.school_name %></strong>.
    </div>

    <form
        class="search-form"
        method="GET"
        action="/arsp/school/rtse-students"
    >

        <input
            type="search"
            name="search"
            value="<%= search %>"
            placeholder="Search registration no., name, mobile, class, section or roll..."
            autocomplete="off"
        >

        <button type="submit">Search</button>

        <% if(search){ %>
            <a
                class="clear"
                href="/arsp/school/rtse-students"
            >
                Clear
            </a>
        <% } %>

    </form>

</section>

<section class="card">

<div id="schoolRtseStudentsResults">
<div class="muted" style="margin-bottom:12px">
    <strong><%= students.length %></strong> student(s) found
</div>

<div class="table-wrap">

<table>

<thead>
<tr>
    <th>Registration No.</th>
    <th>Student</th>
    <th>Class</th>
    <th>Section</th>
    <th>Mobile</th>
    <th>Status</th>
    <th>Roll No.</th>
    <th>Admit</th>
    <th>Action</th>
</tr>
</thead>

<tbody>

<% if(!students.length){ %>

<tr>
<td colspan="9" class="empty">
    No RTSE students found for this school.
</td>
</tr>

<% } %>

<% students.forEach(student => { %>

<tr>

<td>
<strong><%= student.registration_no %></strong>
</td>

<td>
<strong><%= student.full_name %></strong>
<br>
<span class="muted">
Father: <%= student.father_name || "-" %>
</span>
</td>

<td><%= student.class %></td>

<td><%= student.section || "-" %></td>

<td><%= student.mobile || "-" %></td>

<td>

<%
const status =
    String(student.status || "").toLowerCase();
%>

<span class="badge
<%= status === 'approved'
    ? 'approved'
    : status === 'rejected'
    ? 'rejected'
    : 'pending'
%>">

<%= student.status || "-" %>

</span>

</td>

<td>
<%= student.roll_no || student.roll_number || "-" %>
</td>

<td>
<%= Number(student.admit_generated) === 1
    ? "Generated"
    : "Not Generated"
%>
</td>

<td>
    <a
        href="/arsp/school/rtse-students/<%= student.id %>"
        class="view-btn"
    >
        View
    </a>
</td>

</tr>

<% }) %>

</tbody>

</table>

</div>
</div>
</section>

</main>




<script>
(function () {
    "use strict";

    const form = document.querySelector(
        'form.search-form[action="/arsp/school/rtse-students"]'
    );

    const input = form
        ? form.querySelector('input[name="search"]')
        : null;

    const results = document.getElementById(
        "schoolRtseStudentsResults"
    );

    if (!form || !input || !results) return;

    let timer = null;
    let controller = null;

    input.addEventListener("input", function () {
        const value = input.value.trim();

        clearTimeout(timer);

        timer = setTimeout(async function () {
            if (controller) controller.abort();

            controller = new AbortController();

            const url = new URL(
                form.getAttribute("action"),
                window.location.origin
            );

            if (value) {
                url.searchParams.set("search", value);
            }

            try {
                results.style.opacity = "0.55";

                const response = await fetch(url.toString(), {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "text/html"
                    },
                    signal: controller.signal
                });

                if (!response.ok) {
                    throw new Error("Search request failed.");
                }

                const html = await response.text();

                const parser = new DOMParser();
                const doc = parser.parseFromString(
                    html,
                    "text/html"
                );

                const newResults = doc.getElementById(
                    "schoolRtseStudentsResults"
                );

                if (!newResults) {
                    throw new Error(
                        "Search results container not found."
                    );
                }

                results.innerHTML = newResults.innerHTML;

                const newUrl = value
                    ? form.action + "?search=" +
                      encodeURIComponent(value)
                    : form.action;

                window.history.replaceState(
                    {},
                    "",
                    newUrl
                );

            } catch (error) {
                if (error.name !== "AbortError") {
                    console.error(
                        "School RTSE live search error:",
                        error
                    );
                }
            } finally {
                results.style.opacity = "1";
            }
        }, 350);
    });
})();
</script>

</body>
</html>
