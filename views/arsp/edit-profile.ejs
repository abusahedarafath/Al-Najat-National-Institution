<%- include("../partials/arsp-member-top") %>




<section class="arsp-member-page arsp-member-page-edit-profile">
<div class="notice-section">

        <h2>Edit My Profile</h2>

        <div class="notice-card">

            <form
                action="/arsp/profile/edit"
                method="POST"
                enctype="multipart/form-data"
            >

                <!-- PROFILE PHOTO -->

                <div>

                    <img
                        src="<%= member.photo
                            ? '/uploads/arsp-members/' + member.photo
                            : '/images/default-user.png' %>"
                        alt="Profile Photo"

                    >

                    <label for="photo">
                        <strong>Change Profile Photo</strong>
                    </label>

                    <br>

                    <input
                        type="file"
                        id="photo"
                        name="photo"
                        accept="image/jpeg,image/png,image/webp"
                    >

                    <small>
                        JPG, JPEG, PNG or WEBP only.
                    </small>

                </div>


                <!-- ACCOUNT INFORMATION -->

                <h3>Account Information</h3>

                <div class="form-group">

                    <label>Member ID</label>

                    <input
                        type="text"
                        value="<%= member.member_id %>"
                        readonly
                    >

                </div>


                <!-- PERSONAL INFORMATION -->

                <h3>
                    Personal Information
                </h3>

                <div class="form-group">
                    <label>Full Name</label>
                    <input
                        type="text"
                        name="full_name"
                        value="<%= member.full_name || '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Father's Name</label>
                    <input
                        type="text"
                        name="father_name"
                        value="<%= member.father_name || '' %>"
                    >
                </div>

                <div class="form-group">
                    <label>Mother's Name</label>
                    <input
                        type="text"
                        name="mother_name"
                        value="<%= member.mother_name || '' %>"
                    >
                </div>

                <div class="form-group">

                    <label>Gender</label>

                    <select name="gender">

                        <option value="">Select Gender</option>

                        <option
                            value="Male"
                            <%= member.gender === "Male" ? "selected" : "" %>
                        >
                            Male
                        </option>

                        <option
                            value="Female"
                            <%= member.gender === "Female" ? "selected" : "" %>
                        >
                            Female
                        </option>

                        <option
                            value="Other"
                            <%= member.gender === "Other" ? "selected" : "" %>
                        >
                            Other
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label>Date of Birth</label>

                    <input
                        type="date"
                        name="dob"
                        value="<%= member.dob
                            ? new Date(member.dob).toISOString().split('T')[0]
                            : '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Blood Group</label>

                    <input
                        type="text"
                        name="blood_group"
                        value="<%= member.blood_group || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Occupation</label>

                    <input
                        type="text"
                        name="occupation"
                        value="<%= member.occupation || '' %>"
                    >

                </div>


                <!-- CONTACT -->

                <h3>
                    Contact Information
                </h3>

                <div class="form-group">

                    <label>Mobile</label>

                    <input
                        type="text"
                        name="mobile"
                        value="<%= member.mobile || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Email</label>

                    <input
                        type="email"
                        name="email"
                        value="<%= member.email || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Address</label>

                    <textarea
                        name="address"
                        rows="3"
                    ><%= member.address || '' %></textarea>

                </div>

                <div class="form-group">

                    <label>District</label>

                    <input
                        type="text"
                        name="district"
                        value="<%= member.district || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>State</label>

                    <input
                        type="text"
                        name="state"
                        value="<%= member.state || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>PIN Code</label>

                    <input
                        type="text"
                        name="pincode"
                        value="<%= member.pincode || '' %>"
                    >

                </div>


                <!-- EMERGENCY CONTACT -->

                <h3>
                    Emergency Contact
                </h3>

                <div class="form-group">

                    <label>Contact Name</label>

                    <input
                        type="text"
                        name="emergency_contact_name"
                        value="<%= member.emergency_contact_name || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Relationship</label>

                    <input
                        type="text"
                        name="emergency_contact_relation"
                        value="<%= member.emergency_contact_relation || '' %>"
                    >

                </div>

                <div class="form-group">

                    <label>Contact Mobile</label>

                    <input
                        type="text"
                        name="emergency_contact_mobile"
                        value="<%= member.emergency_contact_mobile || '' %>"
                    >

                </div>


                <!-- BUTTONS -->

                <div>

                    <button
                        type="submit"
                        class="profile-btn"
                    >
                        Save Changes
                    </button>

                    <a
                        href="/arsp/dashboard"
                        class="profile-btn"

                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
</section>

<%- include("../partials/arsp-member-bottom") %>
