<%- include("../partials/arsp-member-top") %>

<link rel="stylesheet" href="/css/arsp.css">

<section class="arsp-member-page arsp-member-page-change-password">
<div class="form-card">

<h2>

Change Password

</h2>

<form action="/arsp/change-password" method="POST">

<div class="form-group">

<label>

Current Password

</label>

<input
type="password"
name="current_password"
required>

</div>

<div class="form-group">

<label>

New Password

</label>

<input
type="password"
name="new_password"
required>

</div>

<div class="form-group">

<label>

Confirm Password

</label>

<input
type="password"
name="confirm_password"
required>

</div>

<button
type="submit"
class="btn">

Update Password

</button>

</form>

</div>
</section>

<%- include("../partials/arsp-member-bottom") %>
