<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Change Password</title>

<link rel="stylesheet" href="/css/arsp.css">

</head>

<body>

<header class="topbar">

<div>

<strong>ARSP Member Portal</strong>

</div>

<div>

<a href="/arsp/dashboard">Dashboard</a>

</div>

</header>

<div class="container">

<div class="form-card">

<h2>

Change Password

</h2>

<form action="/arsp/change-password" method="POST">

<div class="form-group">

<label>

Current Password

</label>

<input
type="password"
name="current_password"
required>

</div>

<div class="form-group">

<label>

New Password

</label>

<input
type="password"
name="new_password"
required>

</div>

<div class="form-group">

<label>

Confirm Password

</label>

<input
type="password"
name="confirm_password"
required>

</div>

<button
type="submit"
class="btn">

Update Password

</button>

</form>

</div>

</div>

</body>

</html>
