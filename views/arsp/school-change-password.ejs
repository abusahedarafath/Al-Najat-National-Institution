<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .card {
            width: 100%;
            max-width: 450px;
            background: white;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 35px rgba(0,0,0,.10);
        }

        h1 {
            margin-top: 0;
        }

        .school {
            color: #64748b;
            margin-bottom: 25px;
        }

        .notice {
            background: #fef3c7;
            color: #92400e;
            padding: 13px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 15px;
        }

        button {
            width: 100%;
            padding: 13px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-weight: 700;
            font-size: 15px;
        }

        .message {
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>

<body>

<div class="card">

    <h1>Change Password</h1>

    <div class="school">
        <strong><%= school.school_name %></strong><br>
        <%= school.school_code %>
    </div>

    <div class="notice">
        You are using a temporary password.
        You must create a new password before
        accessing the School Portal.
    </div>

    <% if (error && error.length) { %>
        <% error.forEach(function(message) { %>
            <div class="message error">
                <%= message %>
            </div>
        <% }) %>
    <% } %>

    <form
        method="POST"
        action="/arsp/school/change-password"
    >

        <label for="new_password">
            New Password
        </label>

        <input
            type="password"
            id="new_password"
            name="new_password"
            minlength="8"
            required
        >

        <label for="confirm_password">
            Confirm New Password
        </label>

        <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            minlength="8"
            required
        >

        <button type="submit">
            Change Password
        </button>

    </form>

</div>

</body>
</html>
