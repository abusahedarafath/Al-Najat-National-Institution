<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title><%= title %></title>

<link rel="stylesheet" href="/css/arsp.css">

</head>

<body>

<div class="container">

    <div class="form-card">

        <div style="text-align:center;margin-bottom:25px;">

            <% if (arsp && arsp.logo) { %>

                <img
                    src="/uploads/arsp-settings/<%= arsp.logo %>"
                    alt="ARSP Logo"
                    style="width:90px;height:90px;object-fit:contain;margin:auto;">

            <% } else if (site && site.logo) { %>

                <img
                    src="/uploads/site-settings/<%= site.logo %>"
                    alt="Website Logo"
                    style="width:90px;height:90px;object-fit:contain;margin:auto;">

            <% } else { %>

                <img
                    src="/images/logo.png"
                    alt="Logo"
                    style="width:90px;height:90px;object-fit:contain;margin:auto;">

            <% } %>

            <h2 style="margin-top:15px;color:#0B6B3A;">

                <%= arsp && arsp.organization_name
                    ? arsp.organization_name
                    : (site ? site.institution_name : "ACTIVE RURAL SOCIAL PROGRESS") %>

            </h2>

            <p style="color:#666;margin-top:8px;">

                <%= arsp && arsp.tagline
                    ? arsp.tagline
                    : (site ? site.tagline : "Member Login Portal") %>

            </p>

        </div>

        <form
            action="/arsp/login"
            method="POST">

            <div class="form-group">

                <label>ARSP ID</label>

                <input
                    type="text"
                    name="username"
                    placeholder="ARSP000001"
                    required>

            </div>

            <div class="form-group">

                <label>Password</label>

                <input
                    type="password"
                    name="password"
                    placeholder="Enter Password"
                    required>

            </div>

            <button
                type="submit"
                class="btn">

                Login

            </button>

        </form>

        <div
            style="margin-top:25px;text-align:center;">

            <a href="/arsp/forgot-password">

                Forgot Password?

            </a>

            &nbsp; | &nbsp;

            <a href="/arsp/team">

                Public Team

            </a>

        </div>

        <div
            style="margin-top:25px;text-align:center;color:#777;">

            © <%= new Date().getFullYear() %>

            <%= arsp && arsp.short_name ? arsp.short_name : "ARSP" %>

        </div>

    </div>

</div>

</body>

</html>
