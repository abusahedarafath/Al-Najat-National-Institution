<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .page {
            max-width: 850px;
            margin: 30px auto;
            padding: 15px;
        }

        .card {
            background: #fff;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 5px 25px rgba(0,0,0,.08);
        }

        h1 {
            text-align: center;
            margin-top: 0;
        }

        .notice {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
            padding: 13px;
            border-radius: 8px;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .section {
            margin-top: 25px;
        }

        .section h2 {
            font-size: 18px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 11px 8px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }

        td:first-child {
            width: 38%;
            font-weight: 700;
        }

        .actions {
            margin-top: 30px;
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        button,
        a {
            border: 0;
            border-radius: 8px;
            padding: 12px 24px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .confirm {
            background: #16a34a;
            color: #fff;
        }

        .back {
            background: #e5e7eb;
            color: #111827;
        }

        @media (max-width: 600px) {
            .page {
                margin: 10px auto;
                padding: 10px;
            }

            .card {
                padding: 18px;
            }

            td:first-child {
                width: 42%;
            }
        }
    </style>
</head>

<body>

<div class="page">

    <div class="card">

        <h1>Review School Registration</h1>

        <div class="notice">
            Please carefully check all information before submitting.
            After submission, the application will be sent to ARSP
            administration for verification and approval.
        </div>


        <div class="section">

            <h2>Institution Information</h2>

            <table>

                <tr>
                    <td>School / Institution Name</td>
                    <td><%= data.school_name %></td>
                </tr>

                <tr>
                    <td>Institution Type</td>
                    <td><%= data.school_type %></td>
                </tr>

                <tr>
                    <td>Head / Principal / Director</td>
                    <td><%= data.head_name || "—" %></td>
                </tr>

            </table>

        </div>


        <div class="section">

            <h2>Contact Information</h2>

            <table>

                <tr>
                    <td>Mobile</td>
                    <td><%= data.mobile || "—" %></td>
                </tr>

                <tr>
                    <td>Email</td>
                    <td><%= data.email || "—" %></td>
                </tr>

            </table>

        </div>


        <div class="section">

            <h2>Address</h2>

            <table>

                <tr>
                    <td>Full Address</td>
                    <td><%= data.address || "—" %></td>
                </tr>

                <tr>
                    <td>Village / Town</td>
                    <td><%= data.village || "—" %></td>
                </tr>

                <tr>
                    <td>Post Office</td>
                    <td><%= data.post_office || "—" %></td>
                </tr>

                <tr>
                    <td>District</td>
                    <td><%= data.district %></td>
                </tr>

                <tr>
                    <td>State</td>
                    <td><%= data.state || "—" %></td>
                </tr>

                <tr>
                    <td>Pincode</td>
                    <td><%= data.pincode || "—" %></td>
                </tr>

            </table>

        </div>


        <div class="section">
                <h2>RTSE Examination Centre</h2>

                <table>
                    <tr>
                        <td>Selected Centre</td>
                        <td>
                            <% if (centre) { %>
                                <strong><%= centre.centre_name %></strong>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                    </tr>

                    <tr>
                        <td>Centre Code</td>
                        <td><%= centre ? centre.centre_code : "—" %></td>
                    </tr>

                    <tr>
                        <td>District</td>
                        <td><%= centre ? (centre.district || "—") : "—" %></td>
                    </tr>
                </table>
            </div>

            <div class="actions">

            <a
                href="/arsp/school/register"
                class="back"
            >
                ← Edit Information
            </a>


            <form
                method="POST"
                action="/arsp/school/register/confirm"
                style="margin:0;"
            >
                <button
                    type="submit"
                    class="confirm"
                >
                    Confirm & Submit
                </button>
            </form>

        </div>

    </div>

</div>

</body>
</html>
