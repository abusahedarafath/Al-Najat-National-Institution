                                cursor:pointer;
                            ">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div style="
                    display:grid;
                    grid-template-columns:repeat(2,minmax(0,1fr));
                    gap:10px;
                    margin-bottom:18px;
                ">
                    <div style="background:#f8fafc;border-radius:12px;padding:12px;">
                        <small style="color:#7b8493;">Registration No.</small>
                        <strong style="display:block;margin-top:4px;">
                            ${escapeHtml(student.registration_no)}
                        </strong>
                    </div>

                    <div style="background:#f8fafc;border-radius:12px;padding:12px;">
                        <small style="color:#7b8493;">Roll No.</small>
                        <strong style="display:block;margin-top:4px;">
                            ${escapeHtml(student.roll_no)}
                        </strong>
                    </div>

                    <div style="background:#f8fafc;border-radius:12px;padding:12px;">
                        <small style="color:#7b8493;">Class</small>
                        <strong style="display:block;margin-top:4px;">
                            ${escapeHtml(student.class)}
                        </strong>
                    </div>

                    <div style="background:#f8fafc;border-radius:12px;padding:12px;">
                        <small style="color:#7b8493;">Section</small>
                        <strong style="display:block;margin-top:4px;">
                            ${escapeHtml(student.section || "-")}
                        </strong>
                    </div>
                </div>

                <div style="
                    border:1px solid #e7ebf0;
                    border-radius:14px;
                    padding:14px;
                    margin-bottom:14px;
                ">
                    <div style="
                        font-size:14px;
                        font-weight:800;
                        color:#333;
                        margin-bottom:4px;
                    ">
                        OMR Marks
                    </div>

                    <div style="
                        font-size:28px;
                        font-weight:900;
                        color:#173b72;
                    ">
                        ${escapeHtml(student.omr_marks ?? "-")}
                    </div>
                </div>

                <div style="
                    border:1px solid #e7ebf0;
                    border-radius:14px;
                    padding:14px;
                ">
                    <div style="
                        font-size:15px;
                        font-weight:800;
                        margin-bottom:4px;
                        color:#333;
                    ">
                        Grades
                    </div>

                    ${componentHtml}
                </div>

                <div style="
                    display:grid;
                    grid-template-columns:repeat(2,minmax(0,1fr));
                    gap:10px;
                    margin-top:14px;
                ">
                    <div style="
                        background:#f8fafc;
                        border-radius:12px;
                        padding:13px;
                        text-align:center;
                    ">
                        <small style="color:#7b8493;">Section Rank</small>
                        <strong style="
                            display:block;
                            font-size:22px;
                            color:#173b72;
                            margin-top:4px;
                        ">
                            ${escapeHtml(student.section_rank ?? "-")}
                        </strong>
                    </div>

                    <div style="
                        background:#f8fafc;
                        border-radius:12px;
                        padding:13px;
                        text-align:center;
                    ">
                        <small style="color:#7b8493;">Overall Rank</small>
                        <strong style="
                            display:block;
                            font-size:22px;
                            color:#173b72;
                            margin-top:4px;
                        ">
                            ${escapeHtml(student.overall_rank ?? "-")}
                        </strong>
                    </div>
                </div>
            </div>
        `;

        const closeButton =
            memberResultModal.querySelector(
                "#arspMemberResultCloseBtn"
            );

        if (closeButton) {
            closeButton.addEventListener(
                "click",
                closeMemberResultModal
            );
        }

        memberResultModal.addEventListener(
            "click",
            function (event) {
                if (event.target === memberResultModal) {
                    closeMemberResultModal();
                }
            }
        );

        const celebrationAudio =
            new Audio(
                "/audio/rtse-result-congratulations.mp3"
            );

        celebrationAudio.play().catch(function (error) {
            console.warn(
                "RTSE result celebration audio could not play:",
                error
            );
        });
    }

    document.addEventListener(
        "click",
        function (event) {
            const button =
                event.target.closest(".arsp-member-see-result");

            if (!button) {
                return;
            }

            const registrationNo =
                button.dataset.registrationNo || "";

            if (!registrationNo) {
                return;
            }

            showMemberResultModal(
                registrationNo
            );
        }
    );

})();
</script>

<%- include("../partials/arsp-member-bottom") %>
