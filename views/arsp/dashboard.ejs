                                        <button
                                            type="button"
                                            class="btn-view arsp-full-select-student"
                                            data-registration-no="${escapeHtml(student.registration_no)}"
                                        >
                                            <i class="fa-solid fa-user-check"></i>
                                            Download Admit Card
                                        </button>
                                        <% } %>
                                        <% if (Number(rtseSettings && rtseSettings.result_publish) === 1) { %>
