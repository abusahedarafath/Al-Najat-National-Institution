<%- include("../partials/arsp-member-top") %>
<!-- =================================================
     TOP GRID
================================================== -->
<section class="arsp-md-top-grid">

    <!-- WELCOME -->
    <article class="arsp-md-welcome-card">

                    <div class="arsp-md-welcome-content">

                        <div class="arsp-md-welcome-photo">

                            <img
                                src="<%= member.photo
                                    ? '/uploads/arsp-members/' + member.photo
                                    : '/images/default-user.png' %>"
                                alt="<%= member.full_name %>"
                            >

                            <span class="arsp-md-online"></span>

                        </div>


                        <div class="arsp-md-welcome-copy">

                            <div class="arsp-md-eyebrow">
                                Welcome Back,
                            </div>

                            <h2>
                                <%= member.full_name %>
                            </h2>

                            <div class="arsp-md-member-number">
                                <%= member.member_id %>
                            </div>

                            <div class="arsp-md-active-badge">
                                <i class="fa-solid fa-check"></i>
                                <%= member.status || "Active Member" %>
                            </div>

                            <p>
                                Thank you for being a part of
                                Active Rural Social Progress.
                            </p>

                        </div>

                    </div>


                    <div class="arsp-md-welcome-search" id="rtseStudentSearch">
    <div class="arsp-md-welcome-search-label">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Search a student</span>
    </div>


                        <div class="arsp-md-search-row">

                            <div class="arsp-md-search-input-wrap">

                                <i class="fa-solid fa-magnifying-glass"></i>

                                <input
                                    type="text"
                                    id="arspAdmitRegistration"
                                    placeholder="<%= String(member.admit_card_access || 'Partial') === 'Full' ? 'Search registration number, name, mobile, father name or school' : 'Search registration number, student name or father name' %>"
                                    autocomplete="off"
                                    aria-label="<%= String(member.admit_card_access || 'Partial') === 'Full' ? 'Universal student search' : 'RTSE registration number' %>"
                                >

                            </div>


                        </div>


                        <div
                            id="arspAdmitSearchStatus"
                            class="arsp-md-search-status">
                        </div>


                        <div
                            id="arspAdmitStudentResult"
                            class="arsp-md-student-result">
                        </div>


                        <div
                            id="arspAdmitMobileArea"
                            class="arsp-md-mobile-verification"
                            style="display:none;">

                            <div class="arsp-md-verification-label">
                                <i class="fa-solid fa-mobile-screen-button"></i>
                                <% if (String(member.admit_card_access || "Partial") === "Full") { %>
                                    Please enter your registered mobile number
                                    to download the selected student's admit card.
                                <% } else { %>
                                    Please enter the student's registered mobile number
                                    to download the student's admit card.
                                <% } %>
                            </div>

                            <div class="arsp-md-mobile-row">

                                <input
                                    type="tel"
                                    id="arspAdmitMobile"
                                    inputmode="numeric"
                                    pattern="[0-9]{10}"
                                    maxlength="10"
                                    minlength="10"
                                    placeholder="Enter registered mobile number"
                                    autocomplete="off"
                                >

                                <button
                                    type="button"
                                    id="arspAdmitDownloadBtn">

                                    <i class="fa-solid fa-download"></i>
                                    Download Admit Card

                                </button>

                            </div>

                            <div
                                id="arspAdmitDownloadStatus"
                                class="arsp-md-download-status">
                            </div>

                        </div>


                    </div>

                      <div class="arsp-md-welcome-art">

                        <div class="arsp-md-building-glow">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>

                        <div class="arsp-md-welcome-quote">
                            <span>“</span>
                            Education for a<br>
                            Brighter Rural Tomorrow
                            <span>”</span>
                        </div>

                    </div>

                </article>

    <!-- DATE -->
    <article class="arsp-md-date-card">

                    <div class="arsp-md-date-icon">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>

                    <div class="arsp-md-date-copy">

                        <span>Today</span>

                        <strong id="arspCurrentDate">
                            Loading...
                        </strong>

                        <small id="arspCurrentDayTime">
                            Loading...
                        </small>

                    </div>

                </article>

</section>

<section class="arsp-md-dashboard-grid">

    <div class="arsp-md-primary-column">

        <div class="arsp-md-lower-grid">


                        <!-- NOTICES -->
                        <article class="arsp-md-panel arsp-md-notices-panel">

                            <div class="arsp-md-section-header">

                                <div class="arsp-md-section-title">
                                    <div class="arsp-md-small-icon">
                                        <i class="fa-solid fa-bullhorn"></i>
                                    </div>

                                    <h2>Latest Notices</h2>
                                </div>

                                <a href="/notice">
                                    View All
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>

                            </div>


                            <div class="arsp-md-list">

                                <% if (typeof notices !== "undefined" &&
                                      notices && notices.length) { %>

                                    <% notices.slice(0, 3).forEach(function(notice, index) { %>

                                        <div class="arsp-md-notice-item">

                                            <div class="arsp-md-notice-marker
                                                <%= index === 0 ? 'new' : '' %>">
                                                <%= index === 0 ? 'New' : '' %>
                                            </div>

                                            <div class="arsp-md-list-copy">

                                                <strong>
                                                    <%= notice.title %>
                                                </strong>

                                                <p>
                                                    <%= notice.description || "" %>
                                                </p>

                                            </div>

                                            <time>
                                                <%= notice.publish_date || "" %>
                                            </time>

                                        </div>

                                    <% }) %>

                                <% } else { %>

                                    <div class="arsp-md-empty">
                                        <i class="fa-regular fa-bell-slash"></i>
                                        No notices available.
                                    </div>

                                <% } %>

                            </div>

                        </article>


                        <!-- ACTIVITY -->
                        <article class="arsp-md-panel arsp-md-activity-panel">

                            <div class="arsp-md-section-header">

                                <div class="arsp-md-section-title">
                                    <div class="arsp-md-small-icon purple">
                                        <i class="fa-solid fa-clock"></i>
                                    </div>

                                    <h2>My Activity</h2>
                                </div>

                                <a href="/arsp/activity">
                                    View All
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>

                            </div>


                            <div class="arsp-md-activity-list">

                                <a href="/arsp/activity"
                                   class="arsp-md-activity-item">

                                    <div class="arsp-md-activity-icon">
                                        <i class="fa-solid fa-user-check"></i>
                                    </div>

                                    <div>
                                        <strong>Member activity history</strong>
                                        <small>
                                            View your recent ARSP activities
                                        </small>
                                    </div>

                                    <i class="fa-solid fa-chevron-right"></i>

                                </a>


                                <a href="/arsp/activity"
                                   class="arsp-md-activity-item">

                                    <div class="arsp-md-activity-icon">
                                        <i class="fa-solid fa-chart-line"></i>
                                    </div>

                                    <div>
                                        <strong>Activity records</strong>
                                        <small>
                                            Open your complete activity history
                                        </small>
                                    </div>

                                    <i class="fa-solid fa-chevron-right"></i>

                                </a>

                            </div>

                        </article>

                    </div>

    </div>

    <aside class="arsp-md-secondary-column">


                    <!-- MEMBER INFORMATION -->
                    <article class="arsp-md-panel arsp-md-member-info">

                        <div class="arsp-md-section-title">

                            <div class="arsp-md-small-icon">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <h2>Member Information</h2>

                        </div>



                        <div class="arsp-md-member-info-list">

                            <div class="arsp-md-info-row">
                                <span>Name</span>
                                <strong><%= member.full_name %></strong>
                            </div>

                            <div class="arsp-md-info-row">
                                <span>Member ID</span>
                                <strong><%= member.member_id %></strong>
                            </div>

                            <div class="arsp-md-info-row">
                                <span>Status</span>
                                <strong class="arsp-md-status">
                                    <i class="fa-solid fa-check"></i>
                                    <%= member.status || "Active Member" %>
                                </strong>
                            </div>

                            <div class="arsp-md-info-row">
                                <span>Joined On</span>
                                <strong>
                                    <%= member.joined_on ||
                                        member.joined_date ||
                                        member.created_at ||
                                        "—" %>
                                </strong>
                            </div>

                        </div>

                    </article>


                    <!-- HELP -->
                    <article class="arsp-md-panel arsp-md-help-card">

                        <div class="arsp-md-help-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>

                        <h2>Need Help?</h2>

                        <p>
                            If you need any assistance regarding RTSE
                            or other member services, please contact
                            our support team.
                        </p>

                        <a href="/contact"
                           class="arsp-md-support-button">

                            <i class="fa-regular fa-envelope"></i>
                            Contact Support

                        </a>

                    </article>


                    <!-- QUICK SERVICES -->
                    <article class="arsp-md-panel arsp-md-quick-panel">

                        <div class="arsp-md-section-header">

                            <div class="arsp-md-section-title">

                                <div class="arsp-md-small-icon">
                                    <i class="fa-solid fa-grid-2"></i>
                                </div>

                                <h2>Quick Services</h2>

                            </div>

                        </div>


                        <div class="arsp-md-quick-list">

                            <a href="/arsp/profile/edit">
                                <i class="fa-solid fa-user-pen"></i>
                                <span>My Profile</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>

                            <a href="/arsp/registration-slip">
                                <i class="fa-solid fa-file-lines"></i>
                                <span>My Documents</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>

                            <a href="/arsp/id-card/pdf">
                                <i class="fa-solid fa-id-card"></i>
                                <span>Download ID PDF</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>

                            <a href="/arsp/activity">
                                <i class="fa-solid fa-chart-column"></i>
                                <span>Activity History</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>

                        </div>

                    </article>

                </aside>

            </section>

<style id="arsp-admit-card-mobile-ui-fix">

/* =====================================================
   ADMIT CARD MOBILE VERIFICATION POPUP
   ===================================================== */

.arsp-admit-mobile-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 99999 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    min-height: 100vh !important;

    box-sizing: border-box !important;
    padding: 16px !important;

    background: rgba(15, 23, 42, 0.62) !important;
}

.arsp-admit-mobile-modal > div[role="dialog"] {
    width: 100% !important;
    max-width: 430px !important;

    box-sizing: border-box !important;

    margin: 0 auto !important;
    padding: 22px !important;

    background: #ffffff !important;
    border-radius: 16px !important;

    box-shadow:
        0 20px 55px rgba(0, 0, 0, 0.28) !important;

    overflow: hidden !important;
}

/* Popup heading */
.arsp-admit-mobile-modal
> div[role="dialog"]
> div:first-child {
    display: flex !important;
    align-items: center !important;

    gap: 10px !important;

    margin: 0 0 12px !important;
}

.arsp-admit-mobile-modal
> div[role="dialog"]
> div:first-child i {
    font-size: 17px !important;
}

.arsp-admit-mobile-modal
> div[role="dialog"]
> div:first-child strong {
    display: block !important;

    font-size: 18px !important;
    line-height: 1.3 !important;
}

/* Popup description */
.arsp-admit-mobile-modal
> div[role="dialog"]
> p {
    margin: 0 0 17px !important;

    font-size: 14px !important;
    line-height: 1.55 !important;

    color: #64748b !important;
}

/* Mobile input */
.arsp-admit-mobile-modal
input[type="tel"] {
    display: block !important;

    width: 100% !important;
    height: 48px !important;

    box-sizing: border-box !important;

    margin: 0 !important;
    padding: 0 14px !important;

    border: 1px solid #cbd5e1 !important;
    border-radius: 10px !important;

    background: #ffffff !important;
    color: #0f172a !important;

    font-size: 16px !important;
    line-height: 48px !important;

    outline: none !important;
}

.arsp-admit-mobile-modal
input[type="tel"]:focus {
    border-color: #2563eb !important;

    box-shadow:
        0 0 0 3px rgba(37, 99, 235, 0.12) !important;
}

/* Status area */
.arsp-admit-mobile-modal
[id*="MobileStatus"] {
    min-height: 20px !important;

    margin: 9px 0 !important;

    font-size: 13px !important;
    line-height: 1.4 !important;
}

/* Popup buttons row */
.arsp-admit-mobile-modal
> div[role="dialog"]
> div:last-child {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;

    gap: 9px !important;

    margin-top: 14px !important;
}

/* Popup buttons */
.arsp-admit-mobile-modal
> div[role="dialog"]
button {
    display: inline-flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 6px !important;

    width: auto !important;
    min-width: 0 !important;
    min-height: 42px !important;

    box-sizing: border-box !important;

    margin: 0 !important;
    padding: 9px 13px !important;

    border-radius: 8px !important;

    font-size: 13px !important;
    font-weight: 600 !important;

    line-height: 1.2 !important;

    white-space: nowrap !important;
}

/* =====================================================
   SELECT STUDENT BUTTON
   ===================================================== */

.arsp-partial-select-student,
.arsp-full-select-student {
    display: inline-flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 6px !important;

    width: auto !important;
    max-width: 100% !important;

    min-height: 36px !important;

    box-sizing: border-box !important;

    margin: 8px 0 0 auto !important;
    padding: 8px 12px !important;

    border-radius: 7px !important;

    font-size: 12px !important;
    font-weight: 600 !important;

    line-height: 1.2 !important;

    white-space: nowrap !important;

    cursor: pointer !important;
}

.arsp-partial-select-student i,
.arsp-full-select-student i {
    flex: 0 0 auto !important;
    font-size: 12px !important;
}

.arsp-partial-select-student:disabled,
.arsp-full-select-student:disabled {
    opacity: 0.6 !important;
    cursor: not-allowed !important;
}

/* =====================================================
   SMALL MOBILE DEVICES
   ===================================================== */

@media (max-width: 600px) {

    .arsp-admit-mobile-modal {
        padding: 14px !important;
    }

    .arsp-admit-mobile-modal
    > div[role="dialog"] {
        max-width: 430px !important;

        padding: 20px !important;

        border-radius: 14px !important;
    }

    .arsp-admit-mobile-modal
    > div[role="dialog"]
    > div:first-child strong {
        font-size: 17px !important;
    }

    .arsp-admit-mobile-modal
    > div[role="dialog"]
    > p {
        font-size: 13px !important;
    }

    .arsp-partial-select-student,
    .arsp-full-select-student {
        min-height: 35px !important;

        padding: 8px 10px !important;

        font-size: 12px !important;
    }
}

/* =====================================================
   VERY SMALL PHONES
   ===================================================== */

@media (max-width: 380px) {

    .arsp-admit-mobile-modal
    > div[role="dialog"]
    > div:last-child {
        flex-direction: column-reverse !important;
        align-items: stretch !important;
    }

    .arsp-admit-mobile-modal
    > div[role="dialog"]
    button {
        width: 100% !important;
    }

    .arsp-partial-select-student,
    .arsp-full-select-student {
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
}

</style>

<script>
(function () {

    "use strict";

    /* =====================================================
       MOBILE SIDEBAR
    ====================================================== */

    const sidebar = document.getElementById("arspMemberSidebar");
    const menuToggle = document.getElementById("arspMemberMenuToggle");
    const overlay = document.getElementById("arspMemberOverlay");

    function closeSidebar() {

        if (sidebar) {
            sidebar.classList.remove("open");
        }

        if (overlay) {
            overlay.classList.remove("show");
        }

        if (menuToggle) {
            menuToggle.setAttribute("aria-expanded", "false");
        }

    }

    if (menuToggle && sidebar && overlay) {

        menuToggle.addEventListener("click", function () {

            const opened =
                sidebar.classList.toggle("open");

            overlay.classList.toggle("show", opened);

            menuToggle.setAttribute(
                "aria-expanded",
                opened ? "true" : "false"
            );

        });

        overlay.addEventListener("click", closeSidebar);

        sidebar.querySelectorAll("a").forEach(function (link) {

            link.addEventListener("click", function () {

                if (window.innerWidth <= 900) {
                    closeSidebar();
                }

            });

        });

    }


    /* =====================================================
       CURRENT DATE / TIME
    ====================================================== */

    const dateElement =
        document.getElementById("arspCurrentDate");

    const timeElement =
        document.getElementById("arspCurrentDayTime");

    function updateDateTime() {

        const now = new Date();

        const dateText =
            new Intl.DateTimeFormat("en-IN", {
                day: "2-digit",
                month: "long",
                year: "numeric"
            }).format(now);

        const dayText =
            new Intl.DateTimeFormat("en-IN", {
                weekday: "long"
            }).format(now);

        const timeText =
            new Intl.DateTimeFormat("en-IN", {
                hour: "numeric",
                minute: "2-digit",
                hour12: true
            }).format(now);

        if (dateElement) {
            dateElement.textContent = dateText;
        }

        if (timeElement) {
            timeElement.textContent =
                dayText + ", " + timeText;
        }

    }

    updateDateTime();

    setInterval(updateDateTime, 30000);


    /* =====================================================
       SCROLL LINK
    ====================================================== */

    document.querySelectorAll(
        ".arsp-md-scroll-link"
    ).forEach(function (link) {

        link.addEventListener("click", function (event) {

            const target =
                document.querySelector(this.getAttribute("href"));

            if (!target) return;

            event.preventDefault();

            target.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        });

    });


    /* =====================================================
       RTSE STUDENT SEARCH
       Existing API preserved.
    ====================================================== */

    const registrationInput =
        document.getElementById("arspAdmitRegistration");


    const status =
        document.getElementById("arspAdmitSearchStatus");

    const result =
        document.getElementById("arspAdmitStudentResult");

    const mobileArea =
        document.getElementById("arspAdmitMobileArea");

    const mobileInput =
        document.getElementById("arspAdmitMobile");

    const downloadButton =
        document.getElementById("arspAdmitDownloadBtn");

    const downloadStatus =
        document.getElementById("arspAdmitDownloadStatus");

    let searchTimer = null;
    let currentAccess =
        "<%= String(member.admit_card_access || 'Partial') === 'Full' ? 'Full' : 'Partial' %>";
    let selectedRegistrationNo = "";
    let fullAccessMobileModal = null;
    let partialAccessMobileModal = null;
    let admitCardVerificationMode = null;


    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    function clearStudent() {
        selectedRegistrationNo = "";

        if (fullAccessMobileModal) {
            closeFullAccessMobileModal();
        }

        if (partialAccessMobileModal) {
            closePartialAccessMobileModal();
        }


        if (result) {
            result.innerHTML = "";
        }

        if (mobileArea) {
            mobileArea.style.display = "none";
        }

        if (mobileInput) {
            mobileInput.value = "";
        }

        if (downloadStatus) {
            downloadStatus.innerHTML = "";
        }

    }


    function closeFullAccessMobileModal() {
        if (fullAccessMobileModal) {
            fullAccessMobileModal.remove();
            fullAccessMobileModal = null;
        }
    }

    function closePartialAccessMobileModal() {
        if (partialAccessMobileModal) {
            partialAccessMobileModal.remove();
            partialAccessMobileModal = null;
        }
    }

    function openPartialAccessMobileModal() {
        closePartialAccessMobileModal();

        partialAccessMobileModal =
            document.createElement("div");

        partialAccessMobileModal.className =
            "arsp-admit-mobile-modal";

        partialAccessMobileModal.style.cssText =
            "position:fixed;inset:0;z-index:99999;" +
            "display:flex;align-items:center;justify-content:center;" +
            "padding:20px;background:rgba(0,0,0,.55);";

        partialAccessMobileModal.innerHTML = `
            <div role="dialog" aria-modal="true"
                 style="width:min(430px,100%);background:#fff;
                        border-radius:16px;padding:24px;
                        box-shadow:0 20px 60px rgba(0,0,0,.25);">

                <div style="display:flex;align-items:center;
                            gap:10px;margin-bottom:10px;">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <strong style="font-size:18px;">
                        Verify Student Mobile
                    </strong>
                </div>

                <p style="margin:0 0 16px;color:#666;line-height:1.5;">
                    Enter the selected student's registered mobile number
                    to download the admit card.
                </p>

                <input
                    type="tel"
                    id="arspPartialAccessMobileInput"
                    inputmode="numeric"
                    maxlength="10"
                    placeholder="Enter student's registered mobile number"
                    autocomplete="off"
                    style="width:100%;box-sizing:border-box;
                           padding:12px 14px;border:1px solid #ccc;
                           border-radius:8px;font-size:16px;"
                >

                <div id="arspPartialAccessMobileStatus"
                     style="min-height:22px;margin:10px 0;">
                </div>

                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button type="button"
                            id="arspPartialAccessMobileCancel"
                            class="btn-view">
                        Cancel
                    </button>

                    <button type="button"
                            id="arspPartialAccessMobileVerify"
                            class="btn-view">
                        <i class="fa-solid fa-download"></i>
                        Verify & Download
                    </button>
                </div>
            </div>
        `;

        document.body.appendChild(partialAccessMobileModal);

        const input =
            document.getElementById(
                "arspPartialAccessMobileInput"
            );

        const status =
            document.getElementById(
                "arspPartialAccessMobileStatus"
            );

        const cancel =
            document.getElementById(
                "arspPartialAccessMobileCancel"
            );

        const verify =
            document.getElementById(
                "arspPartialAccessMobileVerify"
            );

        input.addEventListener("input", function() {
            this.value =
                this.value.replace(/\D/g, "").slice(0, 10);
        });

        cancel.addEventListener(
            "click",
            closePartialAccessMobileModal
        );

        verify.addEventListener("click", function() {

            const mobile = input.value.trim();

            if (!/^\d{10}$/.test(mobile)) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    'Please enter a valid 10-digit mobile number.' +
                    '</span>';
                return;
            }

            if (!selectedRegistrationNo) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    'Please select a student first.' +
                    '</span>';
                return;
            }

            if (mobileInput) {
                mobileInput.value = mobile;
            }

            admitCardVerificationMode = "student";

            status.innerHTML =
                '<span class="arsp-md-searching">' +
                '<i class="fa-solid fa-spinner fa-spin"></i> ' +
                'Verifying registered mobile number...' +
                '</span>';

            verify.disabled = true;
            cancel.disabled = true;

            if (downloadButton) {
                downloadButton.click();
            }

            let attempts = 0;

            const timer = setInterval(function() {

                attempts++;

                const text =
                    downloadStatus
                        ? downloadStatus.textContent.toLowerCase()
                        : "";

                if (
                    text.includes(
                        "admit card verified successfully"
                    )
                ) {
                    clearInterval(timer);
                    closePartialAccessMobileModal();
                    return;
                }

                if (
                    text.includes("does not match") ||
                    text.includes("could not be verified") ||
                    text.includes("unable to download")
                ) {
                    clearInterval(timer);

                    status.innerHTML =
                        '<span class="arsp-md-error">' +
                        escapeHtml(
                            downloadStatus.textContent.trim()
                        ) +
                        '</span>';

                    verify.disabled = false;
                    cancel.disabled = false;
                    return;
                }

                if (attempts >= 120) {
                    clearInterval(timer);

                    status.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Verification is taking too long. Please try again.' +
                        '</span>';

                    verify.disabled = false;
                    cancel.disabled = false;
                }

            }, 250);
        });

        input.addEventListener("keydown", function(event) {
            if (event.key === "Enter") {
                event.preventDefault();
                verify.click();
            }

            if (event.key === "Escape") {
                closePartialAccessMobileModal();
            }
        });

        setTimeout(function() {
            input.focus();
        }, 0);
    }

    function openFullAccessMobileModal() {
        closeFullAccessMobileModal();

        fullAccessMobileModal = document.createElement("div");
        fullAccessMobileModal.id = "arspFullAccessMobileModal";

        fullAccessMobileModal.className =
            "arsp-admit-mobile-modal";
        fullAccessMobileModal.style.cssText =
            "position:fixed;inset:0;z-index:99999;" +
            "display:flex;align-items:center;justify-content:center;" +
            "padding:20px;background:rgba(0,0,0,.55);";

        fullAccessMobileModal.innerHTML = `
            <div role="dialog" aria-modal="true"
                 style="width:min(430px,100%);background:#fff;
                        border-radius:16px;padding:24px;
                        box-shadow:0 20px 60px rgba(0,0,0,.25);">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <strong style="font-size:18px;">Verify Member Mobile</strong>
                </div>

                <p style="margin:0 0 16px;color:#666;line-height:1.5;">
                    Enter your registered ARSP member mobile number
                    to download this student's admit card.
                </p>

                <input
                    type="tel"
                    id="arspFullAccessMobileInput"
                    inputmode="numeric"
                    maxlength="10"
                    placeholder="Enter your registered mobile number"
                    autocomplete="off"
                    style="width:100%;box-sizing:border-box;padding:12px 14px;
                           border:1px solid #ccc;border-radius:8px;font-size:16px;"
                >

                <div id="arspFullAccessMobileStatus"
                     style="min-height:22px;margin:10px 0;"></div>

                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button type="button"
                            id="arspFullAccessMobileCancel"
                            class="btn-view">
                        Cancel
                    </button>

                    <button type="button"
                            id="arspFullAccessMobileVerify"
                            class="btn-view">
                        <i class="fa-solid fa-download"></i>
                        Verify & Download
                    </button>
                </div>
            </div>
        `;

        document.body.appendChild(fullAccessMobileModal);

        const input =
            document.getElementById("arspFullAccessMobileInput");
        const status =
            document.getElementById("arspFullAccessMobileStatus");
        const cancel =
            document.getElementById("arspFullAccessMobileCancel");
        const verify =
            document.getElementById("arspFullAccessMobileVerify");

        input.addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, "").slice(0, 10);
        });

        cancel.addEventListener(
            "click",
            closeFullAccessMobileModal
        );

        verify.addEventListener("click", function () {
            const mobile = input.value.trim();

            if (!/^\d{10}$/.test(mobile)) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    'Please enter a valid 10-digit mobile number.' +
                    '</span>';
                return;
            }

            if (!selectedRegistrationNo) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    'Please select a student first.' +
                    '</span>';
                return;
            }

            if (mobileInput) {
                mobileInput.value = mobile;
            }

            admitCardVerificationMode = "member";

            status.innerHTML =
                '<span class="arsp-md-searching">' +
                '<i class="fa-solid fa-spinner fa-spin"></i> ' +
                'Verifying registered mobile number...' +
                '</span>';

            verify.disabled = true;
            cancel.disabled = true;

            if (downloadButton) {
                downloadButton.click();
            }

            let attempts = 0;

            const timer = setInterval(function () {
                attempts++;

                const text =
                    downloadStatus
                        ? downloadStatus.textContent.toLowerCase()
                        : "";

                if (text.includes("admit card verified successfully")) {
                    clearInterval(timer);
                    closeFullAccessMobileModal();
                    return;
                }

                if (
                    text.includes("does not match") ||
                    text.includes("could not be verified") ||
                    text.includes("unable to download")
                ) {
                    clearInterval(timer);

                    status.innerHTML =
                        '<span class="arsp-md-error">' +
                        escapeHtml(downloadStatus.textContent.trim()) +
                        '</span>';

                    verify.disabled = false;
                    cancel.disabled = false;
                    return;
                }

                if (attempts >= 120) {
                    clearInterval(timer);

                    status.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Verification is taking too long. Please try again.' +
                        '</span>';

                    verify.disabled = false;
                    cancel.disabled = false;
                }
            }, 250);
        });

        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                verify.click();
            }

            if (event.key === "Escape") {
                closeFullAccessMobileModal();
            }
        });

        setTimeout(function () {
            input.focus();
        }, 0);
    }

    async function searchStudent() {
        if (!registrationInput) return;

        const keyword =
            registrationInput.value.trim();

        clearStudent();

        if (!keyword) {
            status.innerHTML = "";
            return;
        }

        status.innerHTML =
            '<span class="arsp-md-searching">' +
            '<i class="fa-solid fa-spinner fa-spin"></i> Searching...' +
            '</span>';

        try {
            const response = await fetch(
                "/arsp/student/admit-card/search?keyword=" +
                encodeURIComponent(keyword),
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    escapeHtml(
                        data && data.message
                            ? data.message
                            : "Unable to search student."
                    ) +
                    '</span>';
                return;
            }

            currentAccess =
                data.access === "Full"
                    ? "Full"
                    : "Partial";

            /*
             * ==========================
             * PARTIAL ACCESS
             * ==========================
             *
             * Keep the existing workflow:
             * registration number -> student
             * -> student's registered mobile.
             */
            if (currentAccess !== "Full") {

                const students =
                    Array.isArray(data.students)
                        ? data.students
                        : (
                            data.student
                                ? [data.student]
                                : []
                        );

                selectedRegistrationNo = "";

                if (!students.length) {
                    status.innerHTML =
                        '<span class="arsp-md-error">' +
                        'No student found.' +
                        '</span>';
                    return;
                }

                status.innerHTML =
                    '<span class="arsp-md-success">' +
                    '<i class="fa-solid fa-circle-check"></i> ' +
                    students.length +
                    ' student' +
                    (students.length === 1 ? "" : "s") +
                    ' found. Please select a student.' +
                    '</span>';

                result.innerHTML = `
                    <div class="arsp-md-student-card">
                        <div class="arsp-md-student-card-title">
                            <i class="fa-solid fa-user-graduate"></i>
                            Select Student
                        </div>

                        <div style="
                            display:flex;
                            flex-direction:column;
                            gap:12px;
                            margin-top:12px;
                        ">
                            ${students.map(function(student) {
                                return `
                                    <div
                                        class="arsp-md-student-card"
                                        style="
                                            margin:0;
                                            border:1px solid #e5e7eb;
                                        "
                                    >
                                        <div class="arsp-md-student-grid">
                                            <div>
                                                <small>Registration Number</small>
                                                <strong>${escapeHtml(student.registration_no)}</strong>
                                            </div>

                                            <div>
                                                <small>Name</small>
                                                <strong>${escapeHtml(student.full_name)}</strong>
                                            </div>

                                            <div>
                                                <small>Father Name</small>
                                                <strong>${escapeHtml(student.father_name)}</strong>
                                            </div>

                                            <div>
                                                <small>School Name</small>
                                                <strong>${escapeHtml(student.school_name)}</strong>
                                            </div>

                                            <div>
                                                <small>Class</small>
                                                <strong>${escapeHtml(student.class)}</strong>
                                            </div>

                                            <div>
                                                <small>Section</small>
                                                <strong>${escapeHtml(student.section)}</strong>
                                            </div>
                                        </div>

                                        <div style="
                                            margin-top:14px;
                                            display:flex;
                                            justify-content:flex-end;
                                        ">
                                            <button
                                                type="button"
                                                class="btn-view arsp-partial-select-student"
                                                data-registration-no="${escapeHtml(student.registration_no)}"
                                            >
                                                <i class="fa-solid fa-user-check"></i>
                                                Select Student
                                            </button>
                                        </div>
                                    </div>
                                `;
                            }).join("")}
                        </div>
                    </div>
                `;

                if (mobileArea) {
                    mobileArea.style.display = "none";
                }

                result
                    .querySelectorAll(
                        ".arsp-partial-select-student"
                    )
                    .forEach(function(button) {

                        button.addEventListener(
                            "click",
                            function() {

                                selectedRegistrationNo =
                                    this.dataset.registrationNo || "";

                                if (!selectedRegistrationNo) {
                                    return;
                                }

                                result
                                    .querySelectorAll(
                                        ".arsp-partial-select-student"
                                    )
                                    .forEach(function(other) {
                                        other.disabled = false;
                                    });

                                this.disabled = true;

                                openPartialAccessMobileModal();
                            }
                        );
                    });

                return;
            }

            /*
             * ==========================
             * FULL ACCESS
             * ==========================
             *
             * Universal search returns
             * multiple students.
             *
             * The member must always select
             * a student before verification.
             */
            const students =
                Array.isArray(data.students)
                    ? data.students
                    : [];

            selectedRegistrationNo = "";

            if (!students.length) {
                status.innerHTML =
                    '<span class="arsp-md-error">' +
                    'No student found.' +
                    '</span>';
                return;
            }

            status.innerHTML =
                '<span class="arsp-md-success">' +
                '<i class="fa-solid fa-circle-check"></i> ' +
                students.length +
                ' student' +
                (students.length === 1 ? "" : "s") +
                ' found. Please select a student.' +
                '</span>';

            result.innerHTML = `
                <div class="arsp-md-student-card">
                    <div class="arsp-md-student-card-title">
                        <i class="fa-solid fa-users"></i>
                        Select Student
                    </div>

                    <div style="
                        display:flex;
                        flex-direction:column;
                        gap:12px;
                        margin-top:12px;
                    ">
                        ${students.map(function(student, index) {
                            return `
                                <div
                                    class="arsp-md-student-card"
                                    style="
                                        margin:0;
                                        cursor:pointer;
                                        border:1px solid #e5e7eb;
                                    "
                                >
                                    <div class="arsp-md-student-grid">
                                        <div>
                                            <small>Registration Number</small>
                                            <strong>${escapeHtml(student.registration_no)}</strong>
                                        </div>

                                        <div>
                                            <small>Name</small>
                                            <strong>${escapeHtml(student.full_name)}</strong>
                                        </div>

                                        <div>
                                            <small>Father Name</small>
                                            <strong>${escapeHtml(student.father_name)}</strong>
                                        </div>

                                        <div>
                                            <small>School Name</small>
                                            <strong>${escapeHtml(student.school_name)}</strong>
                                        </div>

                                        <div>
                                            <small>Class</small>
                                            <strong>${escapeHtml(student.class)}</strong>
                                        </div>

                                        <div>
                                            <small>Section</small>
                                            <strong>${escapeHtml(student.section)}</strong>
                                        </div>
                                    </div>

                                    <div style="
                                        margin-top:14px;
                                        display:flex;
                                        justify-content:flex-end;
                                    ">
                                        <button
                                            type="button"
                                            class="btn-view arsp-full-select-student"
                                            data-registration-no="${escapeHtml(student.registration_no)}"
                                        >
                                            <i class="fa-solid fa-user-check"></i>
                                            Select Student
                                        </button>
                                    </div>
                                </div>
                            `;
                        }).join("")}
                    </div>
                </div>
            `;

            if (mobileArea) {
                mobileArea.style.display = "none";
            }

            result
                .querySelectorAll(
                    ".arsp-full-select-student"
                )
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        function() {

                            selectedRegistrationNo =
                                this.dataset.registrationNo || "";

                            if (!selectedRegistrationNo) {
                                return;
                            }

                            result
                                .querySelectorAll(
                                    ".arsp-full-select-student"
                                )
                                .forEach(function(other) {
                                    other.disabled = false;
                                });

                            this.disabled = true;

                            openFullAccessMobileModal();
                        }
                    );
                });

        } catch (error) {
            console.error(
                "ARSP admit-card search error:",
                error
            );

            status.innerHTML =
                '<span class="arsp-md-error">' +
                'Unable to search student.' +
                '</span>';
        }
    }

    if (registrationInput) {

        registrationInput.addEventListener(
            "input",
            function () {

                clearTimeout(searchTimer);

                const value =
                    registrationInput.value.trim();

                clearStudent();

                if (!value) {

                    status.innerHTML = "";

                    return;
                }

                searchTimer =
                    setTimeout(searchStudent, 300);

            }
        );

        registrationInput.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    clearTimeout(searchTimer);

                    searchStudent();

                }

            }
        );

    }


    if (mobileInput) {

        mobileInput.addEventListener(
            "input",
            function () {

                this.value =
                    this.value
                        .replace(/\D/g, "")
                        .slice(0, 10);

            }
        );

    }


    if (downloadButton) {

        downloadButton.addEventListener(
            "click",
            async function () {

                const registrationNo =
                    selectedRegistrationNo ||
                    (
                        registrationInput
                            ? registrationInput.value.trim()
                            : ""
                    );

                const mobile =
                    mobileInput
                        ? mobileInput.value.trim()
                        : "";

                if (!registrationNo) {

                    downloadStatus.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Please select a student first.' +
                        '</span>';

                    return;
                }

                if (!mobile) {

                    downloadStatus.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Please enter the registered mobile number.' +
                        '</span>';

                    return;
                }

                if (!/^\d{10}$/.test(mobile)) {

                    downloadStatus.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Please enter a valid 10-digit mobile number.' +
                        '</span>';

                    return;

                }

                downloadButton.disabled = true;

                downloadStatus.innerHTML =
                    '<span class="arsp-md-searching">' +
                    '<i class="fa-solid fa-spinner fa-spin"></i> ' +
                    'Verifying registered mobile number...' +
                    '</span>';

                try {

                    const response =
                        await fetch(
                            "/arsp/student/admit-card/download",
                            {
                                method: "POST",
                                headers: {
                                    "Content-Type":
                                        "application/json",
                                    "Accept": "text/html"
                                },
                                body: JSON.stringify({
                                    registration_no:
                                        registrationNo,
                                    mobile:
                                        mobile,
                                    verification_mode:
                                        admitCardVerificationMode ||
                                        (
                                            currentAccess === "Full"
                                                ? "member"
                                                : "student"
                                        )
                                })
                            }
                        );

                    if (!response.ok) {

                        let message =
                            "Mobile verification failed.";

                        try {

                            const data =
                                await response.json();

                            if (
                                data &&
                                data.message
                            ) {
                                message =
                                    data.message;
                            }

                        } catch (_) {}

                        downloadStatus.innerHTML =
                            '<span class="arsp-md-error">' +
                            escapeHtml(message) +
                            '</span>';

                        return;

                    }

                    const html =
                        await response.text();

                    const admitWindow =
                        window.open("", "_blank");

                    if (!admitWindow) {

                        downloadStatus.innerHTML =
                            '<span class="arsp-md-error">' +
                            'Please allow pop-ups to open the admit card.' +
                            '</span>';

                        return;

                    }

                    admitWindow.document.open();
                    admitWindow.document.write(html);
                    admitWindow.document.close();

                    downloadStatus.innerHTML =
                        '<span class="arsp-md-success">' +
                        '<i class="fa-solid fa-circle-check"></i> ' +
                        'Admit card verified successfully.' +
                        '</span>';

                } catch (error) {

                    console.error(
                        "ARSP admit-card download error:",
                        error
                    );

                    downloadStatus.innerHTML =
                        '<span class="arsp-md-error">' +
                        'Unable to download admit card.' +
                        '</span>';

                } finally {

                    downloadButton.disabled = false;

                }

            }
        );

    }

})();
</script>

<%- include("../partials/arsp-member-bottom") %>
