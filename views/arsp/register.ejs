<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/arsp-register.css">

<div class="arsp-register-page">

<div class="arsp-register-container">

<div class="arsp-register-header">

<% if(setting && setting.logo){ %>

<img
src="/uploads/arsp-settings/<%= setting.logo %>"
class="arsp-logo"
alt="<%= setting.organization_name %>">

<% } %>

<h1>

<%= setting.organization_name %>

</h1>

<h2>

ONLINE MEMBERSHIP REGISTRATION

</h2>

</div>

<!-- Registration Form Starts Here -->

<form
    id="registrationForm"
    action="/arsp/register"
    method="POST"
    enctype="multipart/form-data">

<!-- We will continue here -->


<div class="arsp-form">

<div class="section-title">

Personal Information

</div>

<div class="form-row">

<div class="form-group">

<label>

Full Name
<span class="required">*</span>

</label>

<input
type="text"
name="full_name"
required>

</div>

<div class="form-group">

<label>

Father's Name

</label>

<input
type="text"
name="father_name">

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

Mother's Name

</label>

<input
type="text"
name="mother_name">

</div>

<div class="form-group">

<label>

Gender
<span class="required">*</span>

</label>

<select
name="gender"
required>

<option value="">

Select Gender

</option>

<option>Male</option>

<option>Female</option>

<option>Other</option>

</select>

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

Date of Birth

</label>

<input
type="date"
name="dob">

</div>

<div class="form-group">

<label>

Blood Group

</label>

<select
name="blood_group">

<option value="">Select Blood Group</option>

<option>A+</option>
<option>A-</option>
<option>B+</option>
<option>B-</option>
<option>AB+</option>
<option>AB-</option>
<option>O+</option>
<option>O-</option>

</select>

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

Occupation

</label>

<input
type="text"
name="occupation">

</div>

<div class="form-group">

<label>

Nationality

</label>

<input
type="text"
name="nationality"
value="Indian">

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

Joining Date
<span class="required">*</span>

</label>

<input
type="date"
name="joining_date"
value="<%= new Date().toISOString().split('T')[0] %>"
required>

</div>

</div>





<div class="section-title">

Contact Information

</div>

<div class="form-row">

<div class="form-group">

<label>

Mobile Number
<span class="required">*</span>

</label>

<input
type="text"
name="mobile"
required>

</div>

<div class="form-group">

<label>

Email Address

</label>

<input
type="email"
name="email">

</div>

</div>

<div class="section-title">

Address Information

</div>

<div class="form-row">

<div class="form-group">

<label>

Full Address
<span class="required">*</span>

</label>

<textarea
name="address"
rows="4"
required></textarea>

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

District
<span class="required">*</span>

</label>

<input
type="text"
name="district"
required>

</div>

<div class="form-group">

<label>

State
<span class="required">*</span>

</label>

<input
type="text"
name="state"
required>

</div>

<div class="form-group">

<label>

PIN Code
<span class="required">*</span>

</label>

<input
type="text"
name="pincode"
required>

</div>

</div>






<div class="section-title">

Identity Verification

</div>

<div class="form-row">

<div class="form-group">

<label>

Identity Proof
<span class="required">*</span>

</label>

<select
name="identity_type"
required>

<option value="">Select Identity Proof</option>

<option value="Aadhaar">Aadhaar Card</option>

<option value="PAN">PAN Card</option>

<option value="Voter ID">Voter ID</option>

<option value="Passport">Passport</option>

<option value="Driving Licence">Driving Licence</option>

<option value="Bank Passbook">Bank Passbook</option>

</select>

</div>

<div class="form-group">

<label>

Identity Number
<span class="required">*</span>

</label>

<input
type="text"
name="identity_number"
required>

</div>

</div>

<div class="form-row">

<div class="form-group">

<label>

Identity Proof (Front)
<span class="required">*</span>

</label>

<input
type="file"
name="identity_front"
accept="image/*,.pdf"
required>

<small>

Upload the front side of the selected identity proof.

</small>

</div>

<div class="form-group">

<label>

Identity Proof (Back)

</label>

<input
type="file"
name="identity_back"
accept="image/*,.pdf">

<small>

Upload the back side if your document has one.

</small>

</div>

</div>

<div
style="
background:#FFF8E8;
padding:15px;
border-left:5px solid orange;
border-radius:6px;
margin-top:20px;">

<strong>Note:</strong>

Please upload clear and readable identity documents. Blurred or incomplete documents may result in rejection of your membership application.

</div>









<div class="section-title">

Photograph

</div>

<div class="form-row">

<div class="form-group">

<label>

Passport Size Photograph
<span class="required">*</span>

</label>


<input
    type="file"
    name="photo"
    id="photo"
    accept="image/*"
    required>

<div
    id="photoCropArea"
    style="
        display:none;
        margin-top:18px;
        padding:15px;
        background:#F8F9FA;
        border:1px solid #DDD;
        border-radius:10px;
    "
>
    <div
        style="
            width:100%;
            max-width:400px;
            margin:0 auto;
            aspect-ratio:4 / 5;
            overflow:hidden;
            background:#222;
            border-radius:8px;
        "
    >
        <img
            id="photoCropImage"
            alt="Photo crop preview"
            style="
                display:block;
                max-width:100%;
            "
        >
    </div>

    <div
        style="
            margin-top:12px;
            text-align:center;
            color:#555;
            font-size:14px;
            line-height:1.6;
        "
    >
        <strong>Position your face inside the frame.</strong><br>
        You can move and zoom the photograph.
    </div>

    <div
        style="
            display:flex;
            gap:10px;
            justify-content:center;
            flex-wrap:wrap;
            margin-top:15px;
        "
    >
        <button
            type="button"
            id="photoZoomOut"
            class="btn-submit"
            style="background:#6c757d;padding:8px 14px;"
        >
            − Zoom
        </button>

        <button
            type="button"
            id="photoZoomIn"
            class="btn-submit"
            style="padding:8px 14px;"
        >
            + Zoom
        </button>

        <button
            type="button"
            id="photoCropReset"
            class="btn-submit"
            style="background:#6c757d;padding:8px 14px;"
        >
            Reset
        </button>

        <button
            type="button"
            id="photoCropApply"
            class="btn-submit"
            style="padding:8px 14px;"
        >
            Use This Photo
        </button>
    </div>
</div>

<img
    id="photoPreview"
    alt="Prepared passport-size photograph"
    style="
        display:none;
        margin-top:15px;
        width:120px;
        height:150px;
        object-fit:cover;
        border-radius:8px;
        border:1px solid #DDD;
    "
>


</div>

</div>

<div class="section-title">

Declaration

</div>

<div
style="
background:#F8F9FA;
padding:20px;
border-left:5px solid #0B6B3A;
border-radius:8px;">

<p
style="
line-height:1.8;
text-align:justify;">

I hereby declare that all information furnished by me is true and correct to the best of my knowledge.

I agree to abide by the Constitution, Rules, Regulations and Code of Conduct of

<strong>

<%= setting.organization_name %>

</strong>.

If any information submitted by me is found to be false, my membership may be cancelled.

</p>

<label
style="
display:flex;
align-items:flex-start;
gap:12px;
margin-top:15px;">

<input
type="checkbox"
required>

<span>

I accept the declaration and certify that the information provided is correct.

</span>

</label>

</div>

<div class="submit-section">

<button
type="reset"
class="btn-submit"
style="background:#6c757d;">

Reset Form

</button>

<button
type="submit"
class="btn-submit">

Submit Membership Registration

</button>

</div>

</div>

</form>

</div>

</div>











</div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const registrationForm =
        document.getElementById("registrationForm");

    const photoInput =
        document.getElementById("photo");

    if (!registrationForm || !photoInput) {
        return;
    }

    registrationForm.addEventListener("submit", function (event) {

        const file =
            photoInput.files && photoInput.files[0];

        if (!file) {
            event.preventDefault();

            alert(
                "Please select and prepare your passport-size photograph."
            );

            return;
        }

        if (
            !file.type ||
            !file.type.startsWith("image/")
        ) {
            event.preventDefault();

            alert(
                "Please use the photograph prepared by the crop tool."
            );
        }
    });

});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const oldData = <%- JSON.stringify(old || {}) %>;
    const form = document.getElementById("registrationForm");

    if (!form) return;

    Object.keys(oldData).forEach(function (name) {

        const field = form.elements[name];

        if (!field) return;

        // Browsers do not allow file inputs to be restored.
        if (field.type === "file") return;

        if (field.type === "checkbox" || field.type === "radio") {
            field.checked = field.value === oldData[name];
            return;
        }

        field.value = oldData[name] || "";
    });

});
</script>

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">

<script
src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js">
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const photoInput = document.getElementById("photo");
    const cropArea = document.getElementById("photoCropArea");
    const cropImage = document.getElementById("photoCropImage");
    const preview = document.getElementById("photoPreview");

    const zoomIn = document.getElementById("photoZoomIn");
    const zoomOut = document.getElementById("photoZoomOut");
    const resetButton = document.getElementById("photoCropReset");
    const applyButton = document.getElementById("photoCropApply");
    const registrationForm = document.getElementById("registrationForm");

    if (
        !photoInput ||
        !cropArea ||
        !cropImage ||
        !preview ||
        typeof Cropper === "undefined"
    ) {
        return;
    }

    let cropper = null;
    let selectedObjectUrl = null;
    let preparedPhoto = false;

    photoInput.addEventListener("change", function () {
        const file = this.files && this.files[0];

        preparedPhoto = false;

        if (!file) {
            return;
        }

        if (!file.type || !file.type.startsWith("image/")) {
            alert("Please select a valid image.");
            this.value = "";
            return;
        }

        if (selectedObjectUrl) {
            URL.revokeObjectURL(selectedObjectUrl);
            selectedObjectUrl = null;
        }

        selectedObjectUrl = URL.createObjectURL(file);

        cropImage.onload = function () {
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            cropper = new Cropper(cropImage, {
                aspectRatio: 4 / 5,
                viewMode: 1,
                dragMode: "move",
                autoCropArea: 0.85,
                responsive: true,
                restore: false,
                guides: true,
                center: true,
                highlight: false,
                background: false,
                movable: true,
                zoomable: true,
                rotatable: false,
                scalable: false
            });

            cropArea.style.display = "block";
            preview.style.display = "none";
        };

        cropImage.src = selectedObjectUrl;
    });

    zoomIn.addEventListener("click", function () {
        if (cropper) {
            cropper.zoom(0.1);
        }
    });

    zoomOut.addEventListener("click", function () {
        if (cropper) {
            cropper.zoom(-0.1);
        }
    });

    resetButton.addEventListener("click", function () {
        if (cropper) {
            cropper.reset();
        }
    });

    applyButton.addEventListener("click", function () {
        if (!cropper) {
            alert("Please select a photograph first.");
            return;
        }

        const canvas = cropper.getCroppedCanvas({
            width: 400,
            height: 500,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: "high"
        });

        if (!canvas) {
            alert("Unable to prepare the photograph.");
            return;
        }

        canvas.toBlob(
            function (blob) {
                if (!blob) {
                    alert("Unable to prepare the photograph.");
                    return;
                }

                /*
                 * The browser prepares a standardized 400 x 500 JPEG.
                 * The server independently enforces the final <= 1 MB
                 * requirement.
                 */
                const croppedFile = new File(
                    [blob],
                    "member-photo.jpg",
                    {
                        type: "image/jpeg",
                        lastModified: Date.now()
                    }
                );

                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(croppedFile);
                photoInput.files = dataTransfer.files;

                const previewUrl = URL.createObjectURL(blob);

                preview.onload = function () {
                    URL.revokeObjectURL(previewUrl);
                };

                preview.src = previewUrl;
                preview.style.display = "block";

                cropArea.style.display = "none";

                preparedPhoto = true;

                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }

                if (selectedObjectUrl) {
                    URL.revokeObjectURL(selectedObjectUrl);
                    selectedObjectUrl = null;
                }
            },
            "image/jpeg",
            0.88
        );
    });

    registrationForm.addEventListener("submit", function (event) {
        const file = photoInput.files && photoInput.files[0];

        if (!file) {
            event.preventDefault();
            alert("Please select and prepare your passport-size photograph.");
            return;
        }

        if (!preparedPhoto) {
            event.preventDefault();
            alert("Please position your photograph and click \"Use This Photo\" before submitting.");
            return;
        }
    });
});
</script>

<script src="/js/arsp-register.js"></script>


