<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        * { box-sizing:border-box; }

        html, body {
            margin:0;
            padding:0;
            width:100%;
            min-width:0;
        }

        body {
            font-family:Arial,sans-serif;
            background:#f1f5f9;
            color:#0f172a;
            overflow-x:hidden;
        }

        .topbar {
            width:100%;
            min-height:64px;
            background:#1e3a8a;
            color:#fff;
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:12px 20px;
        }

        .brand {
            font-size:18px;
            font-weight:700;
        }

        .brand small {
            display:block;
            font-size:11px;
            opacity:.8;
            margin-top:3px;
        }

        .logout {
            border:1px solid rgba(255,255,255,.4);
            background:transparent;
            color:#fff;
            padding:9px 13px;
            border-radius:8px;
            cursor:pointer;
        }

        .layout {
            width:100%;
            display:flex;
            align-items:stretch;
            min-height:calc(100vh - 64px);
        }

        .sidebar {
            flex:0 0 245px;
            width:245px;
            background:#fff;
            border-right:1px solid #e2e8f0;
            padding:18px 12px;
        }

        .school-box {
            padding:14px;
            background:#eff6ff;
            border-radius:12px;
            margin-bottom:18px;
        }

        .school-box strong {
            display:block;
            font-size:14px;
            margin-bottom:5px;
        }

        .school-box span {
            color:#64748b;
            font-size:12px;
        }

        .nav-title {
            color:#94a3b8;
            font-size:11px;
            font-weight:700;
            text-transform:uppercase;
            padding:8px 12px;
        }

        .nav-link {
            display:block;
            padding:11px 12px;
            margin:3px 0;
            border-radius:8px;
            color:#334155;
            text-decoration:none;
            font-size:14px;
        }

        .nav-link:hover,
        .nav-link.active {
            background:#eff6ff;
            color:#1d4ed8;
            font-weight:600;
        }

        .content {
            flex:1 1 auto;
            min-width:0;
            width:auto;
            padding:24px;
        }

        .header {
            margin-bottom:20px;
        }

        .header h1 {
            margin:0 0 6px;
            font-size:26px;
            line-height:1.25;
        }

        .header p {
            margin:0;
            color:#64748b;
            font-size:13px;
            line-height:1.5;
        }

        .stats {
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:14px;
            margin-bottom:20px;
        }

        .stat {
            min-width:0;
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:12px;
            padding:17px;
        }

        .stat-label {
            color:#64748b;
            font-size:12px;
            margin-bottom:7px;
        }

        .stat-value {
            font-size:25px;
            font-weight:800;
        }

        .filters {
            width:100%;
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:12px;
            padding:17px;
            margin-bottom:20px;
        }

        .filter-grid {
            display:grid;
            grid-template-columns:minmax(180px,2fr) minmax(130px,1fr) minmax(130px,1fr) auto auto;
            gap:10px;
            align-items:end;
        }

        .field {
            min-width:0;
        }

        .field label {
            display:block;
            margin-bottom:6px;
            color:#374151;
            font-size:12px;
            font-weight:700;
        }

        .field input {
            display:block;
            width:100%;
            min-width:0;
            padding:10px 11px;
            border:1px solid #d1d5db;
            border-radius:8px;
            font-size:13px;
        }

        .button {
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-height:39px;
            padding:10px 15px;
            border-radius:8px;
            font-size:13px;
            font-weight:700;
            text-decoration:none;
            cursor:pointer;
            white-space:nowrap;
        }

        .search-button {
            border:0;
            background:#111827;
            color:#fff;
        }

        .clear-button {
            border:1px solid #d1d5db;
            background:#fff;
            color:#374151;
        }

        .table-wrap {
            width:100%;
            max-width:100%;
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:12px;
            overflow-x:auto;
            overflow-y:hidden;
            -webkit-overflow-scrolling:touch;
        }

        table {
            width:100%;
            min-width:1050px;
            border-collapse:collapse;
        }

        th {
            background:#f8fafc;
            color:#475569;
            font-size:11px;
            font-weight:800;
            text-align:left;
            padding:12px;
            border-bottom:1px solid #e5e7eb;
            white-space:nowrap;
        }

        td {
            padding:12px;
            border-bottom:1px solid #f1f5f9;
            color:#374151;
            font-size:12px;
            vertical-align:top;
        }

        tr:last-child td {
            border-bottom:0;
        }

        .student {
            font-weight:700;
            color:#111827;
        }

        .muted {
            margin-top:3px;
            color:#64748b;
            font-size:11px;
        }

        .mono {
            font-family:monospace;
            white-space:nowrap;
        }

        .verified {
            display:inline-block;
            padding:4px 8px;
            border-radius:20px;
            background:#dcfce7;
            color:#166534;
            font-size:10px;
            font-weight:800;
        }

        .empty {
            padding:45px 20px;
            text-align:center;
            color:#64748b;
        }

        .pagination {
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:12px;
            flex-wrap:wrap;
            margin-top:17px;
        }

        .page-info {
            color:#64748b;
            font-size:12px;
        }

        .page-links {
            display:flex;
            gap:6px;
            flex-wrap:wrap;
        }

        .page-link {
            min-width:34px;
            height:34px;
            padding:0 9px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            border:1px solid #d1d5db;
            border-radius:7px;
            background:#fff;
            color:#374151;
            text-decoration:none;
            font-size:12px;
            font-weight:700;
        }

        .page-link.active {
            background:#111827;
            color:#fff;
            border-color:#111827;
        }

        @media (max-width:1000px) {
            .filter-grid {
                grid-template-columns:1fr 1fr;
            }

            .stats {
                grid-template-columns:1fr 1fr;
            }
        }

        @media (max-width:700px) {
            .topbar {
                min-height:58px;
                padding:10px 12px;
            }

            .brand {
                font-size:16px;
            }

            .brand small {
                font-size:10px;
            }

            .logout {
                padding:8px 10px;
                font-size:12px;
            }

            .layout {
                display:block;
                width:100%;
                min-height:0;
            }

            .sidebar {
                display:block;
                width:100%;
                max-width:none;
                padding:10px;
                border-right:0;
                border-bottom:1px solid #e2e8f0;
            }

            .school-box {
                padding:11px;
                margin-bottom:10px;
            }

            .nav-title {
                padding:7px 8px 5px;
            }

            .nav-link {
                display:inline-flex;
                width:auto;
                margin:2px;
                padding:8px 10px;
                font-size:12px;
                vertical-align:middle;
            }

            .content {
                display:block;
                width:100%;
                max-width:none;
                min-width:0;
                padding:14px 10px 24px;
            }

            .header h1 {
                font-size:21px;
            }

            .header p {
                font-size:12px;
            }

            .stats,
            .filter-grid {
                grid-template-columns:1fr;
            }

            .filters {
                padding:12px;
                margin-bottom:14px;
            }

            .button {
                width:100%;
            }

            .table-wrap {
                width:100%;
                max-width:100%;
            }

            table {
                min-width:1050px;
            }

            .pagination {
                align-items:stretch;
            }

            .page-info,
            .page-links {
                width:100%;
            }
        }

    </style>
</head>

<body>

<header class="topbar">
    <div class="brand">
        ARSP School Portal
        <small>RTSE Admit Card History</small>
    </div>

    <form method="POST"
          action="/arsp/school/logout"
          onsubmit="return confirm('Logout from the School Portal?');">

        <button class="logout" type="submit">
            Logout
        </button>

    </form>
</header>

<div class="layout">

    <aside class="sidebar">

        <div class="school-box">
            <strong><%= school.school_name %></strong>
            <span><%= school.school_code %></span>
        </div>

        <div class="nav-title">RTSE</div>

        <a href="/arsp/school/dashboard"
           class="nav-link">
            Student Registry
        </a>

        <a href="/arsp/school/rtse-register"
           class="nav-link">
            Register Student
        </a>

        <a href="/arsp/school/rtse-students"
           class="nav-link">
            All Students
        </a>

        <a href="/arsp/school/rtse-admit-download-history"
           class="nav-link active">
            Admit Card History
        </a>

        <div class="nav-title">School</div>

        <a href="/arsp/school/dashboard#school-profile"
           class="nav-link">
            School Profile
        </a>

        <a href="/arsp/school/dashboard#account"
           class="nav-link">
            School Account
        </a>

        <div class="nav-title">Security</div>

        <a href="/arsp/school/change-password"
           class="nav-link">
            Change Password
        </a>

    </aside>

    <main class="content">

        <div class="header">

            <h1>RTSE Admit Card Download History</h1>

            <p>
                Successfully verified admit-card access events for students
                registered under <strong><%= school.school_name %></strong>.
            </p>

        </div>

        <div class="stats">

            <div class="stat">
                <div class="stat-label">Total Downloads</div>
                <div class="stat-value">
                    <%= history.stats.total %>
                </div>
            </div>

            <div class="stat">
                <div class="stat-label">Unique Students</div>
                <div class="stat-value">
                    <%= history.stats.uniqueStudents %>
                </div>
            </div>

            <div class="stat">
                <div class="stat-label">Downloads Today</div>
                <div class="stat-value">
                    <%= history.stats.today %>
                </div>
            </div>

        </div>

        <form class="filters"
              method="GET"
              action="/arsp/school/rtse-admit-download-history">

            <div class="filter-grid">

                <div class="field">
                    <label for="search">Search</label>

                    <input
                        id="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Registration no, student, Google account, mobile..."
                    >
                </div>

                <div class="field">
                    <label for="dateFrom">From Date</label>

                    <input
                        id="dateFrom"
                        type="date"
                        name="dateFrom"
                        value="<%= dateFrom %>"
                    >
                </div>

                <div class="field">
                    <label for="dateTo">To Date</label>

                    <input
                        id="dateTo"
                        type="date"
                        name="dateTo"
                        value="<%= dateTo %>"
                    >
                </div>

                <button
                    class="button search-button"
                    type="submit">
                    Search
                </button>

                <a
                    class="button clear-button"
                    href="/arsp/school/rtse-admit-download-history">
                    Clear
                </a>

            </div>

        </form>

        <div class="table-wrap">

            <% if (!history.rows.length) { %>

                <div class="empty">
                    No admit-card download history found for your school.
                </div>

            <% } else { %>

                <table>

                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Class / Section</th>
                            <th>Google Account</th>
                            <th>Downloader</th>
                            <th>Mobile</th>
                            <th>Verification</th>
                            <th>Verified At</th>
                            <th>Downloaded At</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>

                    <tbody>

                    <% history.rows.forEach(row => { %>

                        <tr>

                            <td>
                                <div class="student">
                                    <%= row.application_student_name || row.student_name || "—" %>
                                </div>

                                <div class="muted mono">
                                    <%= row.registration_no || "—" %>
                                </div>
                            </td>

                            <td>
                                <%= row.student_class || "—" %>
                                /
                                <%= row.student_section || "—" %>
                            </td>

                            <td>
                                <div class="student">
                                    <%= row.google_name || "—" %>
                                </div>

                                <div class="muted">
                                    <%= row.google_email || "—" %>
                                </div>

                                <div class="muted mono">
                                    <%= row.google_subject || "—" %>
                                </div>
                            </td>

                            <td>
                                <%= row.downloader_name || "—" %>
                            </td>

                            <td class="mono">
                                <%= row.mobile || "—" %>
                            </td>

                            <td>
                                <span class="verified">
                                    <%= row.mobile_verified ? "VERIFIED" : "RECORDED" %>
                                </span>
                            </td>

                            <td>
                                <%= row.verified_at || "—" %>
                            </td>

                            <td>
                                <%= row.downloaded_at || "—" %>
                            </td>

                            <td class="mono">
                                <%= row.ip_address || "—" %>
                            </td>

                        </tr>

                    <% }); %>

                    </tbody>

                </table>

            <% } %>

        </div>

        <% if (history.total > 0) { %>

            <div class="pagination">

                <div class="page-info">
                    Page <strong><%= history.page %></strong>
                    of <strong><%= history.totalPages %></strong>
                    · <%= history.total %> matching records
                </div>

                <div class="page-links">

                    <% if (history.page > 1) { %>

                        <a
                            class="page-link"
                            href="/arsp/school/rtse-admit-download-history?page=<%= history.page - 1 %>&search=<%= encodeURIComponent(search) %>&dateFrom=<%= encodeURIComponent(dateFrom) %>&dateTo=<%= encodeURIComponent(dateTo) %>">
                            ‹
                        </a>

                    <% } %>

                    <%
                        const startPage = Math.max(1, history.page - 2);
                        const endPage = Math.min(history.totalPages, history.page + 2);
                    %>

                    <% for (let p = startPage; p <= endPage; p++) { %>

                        <a
                            class="page-link <%= p === history.page ? 'active' : '' %>"
                            href="/arsp/school/rtse-admit-download-history?page=<%= p %>&search=<%= encodeURIComponent(search) %>&dateFrom=<%= encodeURIComponent(dateFrom) %>&dateTo=<%= encodeURIComponent(dateTo) %>">
                            <%= p %>
                        </a>

                    <% } %>

                    <% if (history.page < history.totalPages) { %>

                        <a
                            class="page-link"
                            href="/arsp/school/rtse-admit-download-history?page=<%= history.page + 1 %>&search=<%= encodeURIComponent(search) %>&dateFrom=<%= encodeURIComponent(dateFrom) %>&dateTo=<%= encodeURIComponent(dateTo) %>">
                            ›
                        </a>

                    <% } %>

                </div>

            </div>

        <% } %>

    </main>

</div>

</body>
</html>
