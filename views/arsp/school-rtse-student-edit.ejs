<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/css/admin.css">

    <style>
        body {
            background: #f5f7fa;
        }

        .edit-page {
            max-width: 1000px;
            margin: 30px auto;
            padding: 0 16px;
        }

        .edit-card {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .header h1 {
            margin: 0;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 7px;
            border: 0;
            text-decoration: none;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-primary {
            background: #0d6efd;
            color: #fff;
        }

        .btn-secondary {
            background: #6c757d;
            color: #fff;
        }

        .section-title {
            margin: 25px 0 15px;
            padding-bottom: 8px;
            border-bottom: 1px solid #ddd;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 15px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        label {
            font-size: 14px;
            font-weight: 600;
        }

        input,
        select,
        textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 11px;
            border: 1px solid #ccc;
            border-radius: 7px;
            font-size: 14px;
            background: #fff;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        .locked {
            background: #f1f3f5;
            color: #555;
            cursor: not-allowed;
        }

        .locked-note {
            font-size: 12px;
            color: #777;
        }

        .school-box {
            padding: 15px;
            background: #f8f9fa;
            border-left: 4px solid #198754;
            border-radius: 7px;
        }

        .submit-area {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .error {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 7px;
            background: #f8d7da;
            color: #842029;
        }

        @media (max-width: 700px) {

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
            }

            .submit-area {
                flex-direction: column;
            }

            .submit-area .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="edit-page">

    <div class="edit-card">

        <div class="header">

            <div>
                <h1>Edit Student</h1>

                <p style="margin:6px 0 0;color:#666;">
                    Registration No.
                    <strong>
                        <%= student.registration_no || "-" %>
                    </strong>
                </p>
            </div>

            <div class="actions">

                <a
                    class="btn btn-secondary"
                    href="/arsp/school/rtse-students/<%= student.id %>"
                >
                    ← View Student
                </a>

            </div>

        </div>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <form
            method="POST"
            action="/arsp/school/rtse-students/<%= student.id %>/edit"
        >


            <!-- ============================== -->
            <!-- School Information              -->
            <!-- ============================== -->

            <h2 class="section-title">
                School Information
            </h2>

            <div class="school-box">

                <strong>
                    <%= student.school_name || "-" %>
                </strong>

                <div class="locked-note">
                    Registered school cannot be changed by the school account.
                </div>

            </div>


            <!-- ============================== -->
            <!-- Personal Information             -->
            <!-- ============================== -->

            <h2 class="section-title">
                Personal Information
            </h2>

            <div class="form-grid">

                <div class="form-group">
                    <label>Full Name *</label>

                    <input
                        type="text"
                        name="full_name"
                        value="<%= student.full_name || '' %>"
                        required
                    >
                </div>


                <div class="form-group">
                    <label>Father's Name</label>

                    <input
                        type="text"
                        name="father_name"
                        value="<%= student.father_name || '' %>"
                    >
                </div>


                <div class="form-group">
                    <label>Mother's Name</label>

                    <input
                        type="text"
                        name="mother_name"
                        value="<%= student.mother_name || '' %>"
                    >
                </div>


                <div class="form-group">
                    <label>Gender</label>

                    <select name="gender">

                        <option value="">
                            Select Gender
                        </option>

                        <option
                            value="Male"
                            <%= student.gender === "Male" ? "selected" : "" %>
                        >
                            Male
                        </option>

                        <option
                            value="Female"
                            <%= student.gender === "Female" ? "selected" : "" %>
                        >
                            Female
                        </option>

                        <option
                            value="Other"
                            <%= student.gender === "Other" ? "selected" : "" %>
                        >
                            Other
                        </option>

                    </select>
                </div>


                <div class="form-group">
                    <label>Date of Birth</label>

                    <input
                        type="date"
                        name="dob"
                        value="<%= student.dob ? new Date(student.dob).toISOString().slice(0,10) : '' %>"
                    >
                </div>


                <div class="form-group">
                    <label>Mobile</label>

                    <input
                        type="text"
                        name="mobile"
                        value="<%= student.mobile || '' %>"
                    >
                </div>


                <div class="form-group full">
                    <label>Email</label>

                    <input
                        type="email"
                        name="email"
                        value="<%= student.email || '' %>"
                    >
                </div>

            </div>


            <!-- ============================== -->
            <!-- Academic Information             -->
            <!-- ============================== -->

            <h2 class="section-title">
                Academic Information
            </h2>

            <div class="form-grid">

                <div class="form-group">
                    <label>Class *</label>

                    <select
                        name="class"
                        id="studentClass"
                        required
                    >

                        <option value="">
                            Select Class
                        </option>

                        <% [4,5,6,7,8,9,10].forEach(function(cls) { %>

                            <option
                                value="<%= cls %>"
                                <%= Number(student.class) === cls ? "selected" : "" %>
                            >
                                Class <%= cls %>
                            </option>

                        <% }); %>

                    </select>
                </div>


                <div class="form-group">
                    <label>Section</label>

                    <input
                        type="text"
                        name="section"
                        id="section"
                        value="<%= student.section || '' %>"
                        readonly
                        class="locked"
                    >

                    <span class="locked-note">
                        Section is automatically determined from the class.
                    </span>
                </div>

            </div>


            <!-- ============================== -->
            <!-- Address                         -->
            <!-- ============================== -->

            <h2 class="section-title">
                Address
            </h2>

            <div class="form-grid">

                <div class="form-group full">
                    <label>Address</label>

                    <textarea name="address"><%= student.address || '' %></textarea>
                </div>


                <div class="form-group">
                    <label>District</label>

                    <input
                        type="text"
                        name="district"
                        value="<%= student.district || '' %>"
                    >
                </div>


                <div class="form-group">
                    <label>State</label>

                    <input
                        type="text"
                        name="state"
                        value="<%= student.state || 'Assam' %>"
                    >
                </div>


                <div class="form-group">
                    <label>PIN Code</label>

                    <input
                        type="text"
                        name="pincode"
                        value="<%= student.pincode || '' %>"
                    >
                </div>

            </div>


            <div class="submit-area">

                <a
                    class="btn btn-secondary"
                    href="/arsp/school/rtse-students/<%= student.id %>"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<script>

const studentClass =
    document.getElementById("studentClass");

const section =
    document.getElementById("section");

function updateSection() {

    let value = "";

    if (
        studentClass.value === "4" ||
        studentClass.value === "5"
    ) {
        value = "A";
    }

    else if (
        studentClass.value === "6" ||
        studentClass.value === "7"
    ) {
        value = "B";
    }

    else if (studentClass.value === "8") {
        value = "C";
    }

    else if (studentClass.value === "9") {
        value = "D";
    }

    else if (studentClass.value === "10") {
        value = "E";
    }

    section.value = value;
}

studentClass.addEventListener(
    "change",
    updateSection
);

updateSection();

</script>

</body>
</html>
