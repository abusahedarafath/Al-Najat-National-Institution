<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/arsp.css">
<link rel="stylesheet" href="/css/arsp-team.css">

<%- include("../partials/navbar") %>

<!-- =====================================================
     ARSP MANAGEMENT TEAM HERO
===================================================== -->

<section class="arsp-team-hero">
    <div class="arsp-team-hero-inner">
        <h1>ARSP Management Team</h1>
        <p>Active Rural Social Progress</p>
    </div>
</section>


<!-- =====================================================
     TEAM CONTENT
===================================================== -->

<main class="arsp-team-page">

    <div class="arsp-team-content">

        <!-- Breadcrumb -->
        <nav class="arsp-team-breadcrumb" aria-label="breadcrumb">
            <ol>
                <li>
                    <a href="/">Home</a>
                </li>

                <li aria-hidden="true">/</li>

                <li class="active">
                    ARSP Management Team
                </li>
            </ol>
        </nav>


        <!-- =================================================
             QUICK NAVIGATION
        ================================================== -->

        <div class="arsp-team-quick">

            <a href="/arsp/founder" class="arsp-team-quick-card">
                <div class="arsp-team-quick-icon">F</div>

                <h3>Founder</h3>

                <p>View Founder</p>
            </a>


            <a href="/arsp/organizing-body" class="arsp-team-quick-card">
                <div class="arsp-team-quick-icon">O</div>

                <h3>Organizing Body</h3>

                <p>View Members</p>
            </a>


            <a href="/arsp/chief-adviser" class="arsp-team-quick-card">
                <div class="arsp-team-quick-icon">C</div>

                <h3>Chief Adviser</h3>

                <p>View Profile</p>
            </a>


            <a href="/arsp/advisory-body" class="arsp-team-quick-card">
                <div class="arsp-team-quick-icon">A</div>

                <h3>Advisory Body</h3>

                <p>View Members</p>
            </a>

        </div>


        <!-- =================================================
             FOUNDER
        ================================================== -->

        <section class="arsp-team-section">

            <div class="arsp-team-section-heading">
                <h2>Founder</h2>
                <p>Leadership and founding members of ARSP.</p>
            </div>


            <div class="arsp-team-grid">

                <% if (founders && founders.length) { %>

                    <% founders.forEach(member => { %>

                        <article class="arsp-team-member">

                            <img
                                src="/uploads/arsp-members/<%= member.photo %>"
                                alt="<%= member.full_name %>"
                                class="arsp-team-member-photo"
                            >

                            <h3 class="arsp-team-member-name">
                                <%= member.full_name %>
                            </h3>

                            <span class="arsp-team-member-role">
                                <%= member.designation %>
                            </span>

                            <div class="arsp-team-member-id">
                                Member ID
                                <strong>
                                    <%= member.member_id %>
                                </strong>
                            </div>

                            <a
                                href="/arsp/member/<%= member.member_id %>"
                                class="arsp-team-profile-btn"
                            >
                                View Profile
                            </a>

                        </article>

                    <% }) %>

                <% } else { %>

                    <div class="arsp-team-empty">
                        No founder information available.
                    </div>

                <% } %>

            </div>

        </section>


        <!-- =================================================
             ORGANIZING BODY
        ================================================== -->

        <section class="arsp-team-section">

            <div class="arsp-team-section-heading">
                <h2>Organizing Body</h2>
                <p>Members responsible for organizational coordination and administration.</p>
            </div>


            <div class="arsp-team-grid">

                <% if (organizingBody && organizingBody.length) { %>

                    <% organizingBody.forEach(member => { %>

                        <article class="arsp-team-member">

                            <img
                                src="/uploads/arsp-members/<%= member.photo %>"
                                alt="<%= member.full_name %>"
                                class="arsp-team-member-photo"
                            >

                            <h3 class="arsp-team-member-name">
                                <%= member.full_name %>
                            </h3>

                            <span class="arsp-team-member-role">
                                <%= member.designation %>
                            </span>

                            <div class="arsp-team-member-id">
                                Member ID
                                <strong>
                                    <%= member.member_id %>
                                </strong>
                            </div>

                            <a
                                href="/arsp/member/<%= member.member_id %>"
                                class="arsp-team-profile-btn"
                            >
                                View Profile
                            </a>

                        </article>

                    <% }) %>

                <% } else { %>

                    <div class="arsp-team-empty">
                        No organizing body members available.
                    </div>

                <% } %>

            </div>

        </section>


        <!-- =================================================
             CHIEF ADVISER
             SINGLE FULL-WIDTH CARD
        ================================================== -->

        <% if (chiefAdviser) { %>

            <section class="arsp-team-section">

                <div class="arsp-team-section-heading">
                    <h2>Chief Adviser</h2>
                    <p>Senior advisory leadership of ARSP.</p>
                </div>


                <article class="arsp-team-chief">

                    <div>
                        <img
                            src="/uploads/arsp-members/<%= chiefAdviser.photo %>"
                            alt="<%= chiefAdviser.full_name %>"
                            class="arsp-team-chief-photo"
                        >
                    </div>


                    <div class="arsp-team-chief-content">

                        <h2>
                            <%= chiefAdviser.full_name %>
                        </h2>

                        <span class="role">
                            <%= chiefAdviser.designation %>
                        </span>


                        <div class="arsp-team-chief-meta">

                            <div>
                                <small>Member ID</small>

                                <strong>
                                    <%= chiefAdviser.member_id %>
                                </strong>
                            </div>


                            <div>
                                <small>District</small>

                                <strong>
                                    <%= chiefAdviser.district || "-" %>
                                </strong>
                            </div>


                            <div>
                                <small>Status</small>

                                <strong>
                                    <%= chiefAdviser.status || "-" %>
                                </strong>
                            </div>

                        </div>


                        <a
                            href="/arsp/member/<%= chiefAdviser.member_id %>"
                            class="arsp-team-profile-btn"
                        >
                            View Full Profile
                        </a>

                    </div>

                </article>

            </section>

        <% } %>


        <!-- =================================================
             ADVISORY BODY
        ================================================== -->

        <section class="arsp-team-section">

            <div class="arsp-team-section-heading">
                <h2>Advisory Body</h2>
                <p>Advisers supporting the vision and development of ARSP.</p>
            </div>


            <div class="arsp-team-grid">

                <% if (advisoryBody && advisoryBody.length) { %>

                    <% advisoryBody.forEach(member => { %>

                        <article class="arsp-team-member">

                            <img
                                src="/uploads/arsp-members/<%= member.photo %>"
                                alt="<%= member.full_name %>"
                                class="arsp-team-member-photo"
                            >

                            <h3 class="arsp-team-member-name">
                                <%= member.full_name %>
                            </h3>

                            <span class="arsp-team-member-role">
                                <%= member.designation %>
                            </span>

                            <div class="arsp-team-member-id">
                                Member ID
                                <strong>
                                    <%= member.member_id %>
                                </strong>
                            </div>

                            <a
                                href="/arsp/member/<%= member.member_id %>"
                                class="arsp-team-profile-btn"
                            >
                                View Profile
                            </a>

                        </article>

                    <% }) %>

                <% } else { %>

                    <div class="arsp-team-empty">
                        No advisory body members available.
                    </div>

                <% } %>

            </div>

        </section>

    </div>

</main>

<%- include("../partials/footer") %>
