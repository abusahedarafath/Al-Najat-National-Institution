<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        * { box-sizing:border-box; }

        body {
            margin:0;
            font-family:Arial,sans-serif;
            background:#f1f5f9;
            color:#0f172a;
        }

        .topbar {
            min-height:64px;
            background:#1e3a8a;
            color:#fff;
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:12px 20px;
        }

        .brand {
            font-size:18px;
            font-weight:700;
        }

        .brand small {
            display:block;
            font-size:11px;
            opacity:.8;
            margin-top:3px;
        }

        .logout {
            border:1px solid rgba(255,255,255,.4);
            background:transparent;
            color:#fff;
            padding:9px 13px;
            border-radius:8px;
            cursor:pointer;
        }

        .layout {
            display:flex;
            min-height:calc(100vh - 64px);
        }

        .sidebar {
            width:245px;
            background:#fff;
            border-right:1px solid #e2e8f0;
            padding:18px 12px;
        }

        .school-box {
            padding:14px;
            background:#eff6ff;
            border-radius:12px;
            margin-bottom:18px;
        }

        .school-box strong {
            display:block;
            font-size:14px;
            margin-bottom:5px;
        }

        .school-box span {
            color:#64748b;
            font-size:12px;
        }

        .nav-title {
            color:#94a3b8;
            font-size:11px;
            font-weight:700;
            text-transform:uppercase;
            padding:8px 12px;
        }

        .nav-link {
            display:block;
            padding:11px 12px;
            margin:3px 0;
            border-radius:8px;
            color:#334155;
            text-decoration:none;
            font-size:14px;
        }

        .nav-link:hover,
        .nav-link.active {
            background:#eff6ff;
            color:#1d4ed8;
            font-weight:600;
        }

        .content {
            flex:1;
            padding:24px;
            max-width:1400px;
        }

        .welcome {
            margin-bottom:20px;
        }

        .welcome h1 {
            margin:0 0 6px;
            font-size:27px;
        }

        .welcome p {
            margin:0;
            color:#64748b;
        }

        .stats {
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:14px;
            margin-bottom:22px;
        }

        .stat {
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:13px;
            padding:18px;
            text-decoration:none;
            color:#0f172a;
        }

        .stat:hover {
            border-color:#2563eb;
            box-shadow:0 5px 18px rgba(0,0,0,.06);
        }

        .stat-label {
            color:#64748b;
            font-size:13px;
            margin-bottom:8px;
        }

        .stat-value {
            font-size:28px;
            font-weight:700;
        }

        .section {
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:13px;
            padding:20px;
            margin-bottom:20px;
        }

        .section h2 {
            margin:0 0 16px;
            font-size:19px;
        }

        .profile-grid {
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:0 20px;
        }

        .profile-item {
            padding:13px 5px;
            border-bottom:1px solid #f1f5f9;
        }

        .profile-item label {
            display:block;
            color:#64748b;
            font-size:12px;
            margin-bottom:5px;
        }

        .profile-item strong {
            font-size:14px;
        }


        .section-grid {
            display:grid;
            grid-template-columns:repeat(5,1fr);
            gap:12px;
        }

        .section-card {
            display:block;
            text-decoration:none;
            color:#0f172a;
            background:#f8fafc;
            border:1px solid #e2e8f0;
            border-radius:11px;
            padding:16px;
        }

        .section-card:hover {
            border-color:#2563eb;
            background:#eff6ff;
        }

        .section-name {
            font-weight:700;
            font-size:16px;
        }

        .section-class {
            color:#64748b;
            font-size:12px;
            margin-top:4px;
        }

        .section-count {
            font-size:25px;
            font-weight:700;
            margin-top:12px;
        }

        .actions {
            display:flex;
            gap:10px;
            flex-wrap:wrap;
        }

        .action {
            display:inline-block;
            padding:12px 17px;
            border-radius:8px;
            text-decoration:none;
            font-weight:600;
            font-size:14px;
        }

        .primary {
            background:#2563eb;
            color:#fff;
        }

        .secondary {
            background:#e2e8f0;
            color:#334155;
        }

        @media(max-width:900px) {
            .stats {
                grid-template-columns:repeat(2,1fr);
            }

            .section-grid {
                grid-template-columns:repeat(3,1fr);
            }
        }

        @media(max-width:700px) {
            .profile-grid {
                grid-template-columns:1fr;
            }

            .layout {
                display:block;
            }

            .sidebar {
                width:100%;
                border-right:0;
                border-bottom:1px solid #e2e8f0;
            }

            .content {
                padding:16px;
            }

            .section-grid {
                grid-template-columns:repeat(2,1fr);
            }
        }

        @media(max-width:430px) {
            .stats,
            .section-grid {
                grid-template-columns:1fr;
            }

            .welcome h1 {
                font-size:22px;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="brand">
        ARSP School Portal
        <small>RTSE Student Registry</small>
    </div>

    <form method="POST"
          action="/arsp/school/logout"
          onsubmit="return confirm('Logout from the School Portal?');">
        <button class="logout" type="submit">Logout</button>
    </form>
</header>

<div class="layout">

    <aside class="sidebar">

        <div class="school-box">
            <strong><%= school.school_name %></strong>
            <span><%= school.school_code %></span>
        </div>

        <div class="nav-title">RTSE</div>

        <a href="/arsp/school/dashboard"
           class="nav-link active">
            Student Registry
        </a>

        <a href="/arsp/school/rtse-register"
           class="nav-link">
            Register Student
        </a>

        <a href="/arsp/school/rtse-students"
           class="nav-link">
            All Students
        </a>

        <div class="nav-title">School</div>

        <a href="#school-profile"
           class="nav-link">
            School Profile
        </a>

        <a href="#account"
           class="nav-link">
            School Account
        </a>

        <div class="nav-title">Security</div>

        <a href="/arsp/school/change-password"
           class="nav-link">
            Change Password
        </a>

        <form method="POST"
              action="/arsp/school/logout"
              style="margin:3px 0;">
            <button type="submit"
                    class="nav-link"
                    style="width:100%;border:0;background:transparent;text-align:left;cursor:pointer;">
                Logout
            </button>
        </form>

    </aside>

    <main class="content">

        <div class="welcome">
            <h1>RTSE Student Registry</h1>
            <p>
                <strong><%= school.school_name %></strong> —
                manage students registered by your school.
            </p>
        </div>

        <!-- STATUS STATISTICS -->

        <div class="stats">

            <a class="stat"
               href="/arsp/school/rtse-students">
                <div class="stat-label">All Students</div>
                <div class="stat-value">
                    <%= Number(stats.all_students || 0) %>
                </div>
            </a>

            <a class="stat"
               href="/arsp/school/rtse-students?status=Pending">
                <div class="stat-label">Pending</div>
                <div class="stat-value">
                    <%= Number(stats.pending || 0) %>
                </div>
            </a>

            <a class="stat"
               href="/arsp/school/rtse-students?status=Approved">
                <div class="stat-label">Approved</div>
                <div class="stat-value">
                    <%= Number(stats.approved || 0) %>
                </div>
            </a>

            <a class="stat"
               href="/arsp/school/rtse-students?status=Rejected">
                <div class="stat-label">Rejected</div>
                <div class="stat-value">
                    <%= Number(stats.rejected || 0) %>
                </div>
            </a>

        </div>

        <!-- SECTION STATISTICS -->

        <section class="section">

            <h2>Section-wise Students</h2>

            <div class="section-grid">

                <a class="section-card"
                   href="/arsp/school/rtse-students?section=A">
                    <div class="section-name">Section A</div>
                    <div class="section-class">Classes 4–5</div>
                    <div class="section-count">
                        <%= Number(stats.section_a || 0) %>
                    </div>
                </a>

                <a class="section-card"
                   href="/arsp/school/rtse-students?section=B">
                    <div class="section-name">Section B</div>
                    <div class="section-class">Classes 6–7</div>
                    <div class="section-count">
                        <%= Number(stats.section_b || 0) %>
                    </div>
                </a>

                <a class="section-card"
                   href="/arsp/school/rtse-students?section=C">
                    <div class="section-name">Section C</div>
                    <div class="section-class">Class 8</div>
                    <div class="section-count">
                        <%= Number(stats.section_c || 0) %>
                    </div>
                </a>

                <a class="section-card"
                   href="/arsp/school/rtse-students?section=D">
                    <div class="section-name">Section D</div>
                    <div class="section-class">Class 9</div>
                    <div class="section-count">
                        <%= Number(stats.section_d || 0) %>
                    </div>
                </a>

                <a class="section-card"
                   href="/arsp/school/rtse-students?section=E">
                    <div class="section-name">Section E</div>
                    <div class="section-class">Class 10</div>
                    <div class="section-count">
                        <%= Number(stats.section_e || 0) %>
                    </div>
                </a>

            </div>

        </section>

        <!-- SCHOOL PROFILE -->

        <section class="section" id="school-profile">

            <h2>School Profile</h2>

            <div class="profile-grid">

                <div class="profile-item">
                    <label>School Name</label>
                    <strong><%= school.school_name %></strong>
                </div>

                <div class="profile-item">
                    <label>School Code</label>
                    <strong><%= school.school_code %></strong>
                </div>

                <div class="profile-item">
                    <label>School Type</label>
                    <strong><%= school.school_type || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Head / Principal</label>
                    <strong><%= school.head_name || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Mobile</label>
                    <strong><%= school.mobile || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Email</label>
                    <strong><%= school.email || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Village</label>
                    <strong><%= school.village || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Post Office</label>
                    <strong><%= school.post_office || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>District</label>
                    <strong><%= school.district || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>State</label>
                    <strong><%= school.state || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Pincode</label>
                    <strong><%= school.pincode || "-" %></strong>
                </div>

                <div class="profile-item">
                    <label>Approval Status</label>
                    <strong><%= school.status || "-" %></strong>
                </div>

            </div>

        </section>

        <!-- SCHOOL ACCOUNT -->

        <section class="section" id="account">

            <h2>School Account</h2>

            <div class="profile-grid">

                <div class="profile-item">
                    <label>Login ID</label>
                    <strong><%= school.school_code %></strong>
                </div>

                <div class="profile-item">
                    <label>Account Status</label>
                    <strong>Active</strong>
                </div>

                <div class="profile-item">
                    <label>Portal Role</label>
                    <strong>School Administrator</strong>
                </div>

                <div class="profile-item">
                    <label>Access Level</label>
                    <strong>School Portal Only</strong>
                </div>

            </div>

            <div class="actions" style="margin-top:18px;">
                <a href="/arsp/school/change-password"
                   class="action primary">
                    Change Password
                </a>
            </div>

        </section>

        <!-- ACTIONS -->

        <section class="section">

            <h2>RTSE Student Management</h2>

            <div class="actions">

                <a href="/arsp/school/rtse-register"
                   class="action primary">
                    + Register RTSE Student
                </a>

                <a href="/arsp/school/rtse-students"
                   class="action secondary">
                    View Complete Registry
                </a>

            </div>

        </section>

    </main>
</div>

<script>
(function () {
    "use strict";

    /*
 * ROOT SCHOOL DASHBOARD
 *
 * The dashboard is the ROOT page after school login.
 *
 * Internal dashboard links such as:
 *   #school-profile
 *   #account
 *
 * must NEVER trigger logout.
 *
 * Android/browser Back from the ROOT dashboard logs the
 * school session out immediately and opens a fresh login page.
 */

(function () {
    "use strict";

    const rootState = "arsp-school-dashboard-root";

    /*
     * Store the current dashboard URL without creating
     * an additional browser history entry.
     */
    history.replaceState(
        { arspSchoolRoot: rootState },
        "",
        window.location.href
    );

    /*
     * Internal anchor navigation is normal dashboard navigation.
     * Do not interfere with it.
     */
    document.querySelectorAll('a[href^="#"]').forEach(function (link) {
        link.addEventListener("click", function (event) {
            event.stopPropagation();
        });
    });

    /*
     * Android/browser Back from the ROOT dashboard:
     *
     * Dashboard
     *    ↓ Back
     * destroy session
     *    ↓
     * fresh login page
     */
    window.addEventListener("popstate", function () {

        /*
         * Immediately move the browser back onto the dashboard
         * while the logout request is being processed.
         */
        history.pushState(
            { arspSchoolRoot: rootState },
            "",
            window.location.href
        );

        /*
         * Destroy the server-side school session.
         */
        window.location.replace(
            "/arsp/school/logout"
        );
    });

    /*
     * Never allow BFCache to restore an authenticated dashboard.
     */
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });

})();
</script>

</body>
</html>
