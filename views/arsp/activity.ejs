<%- include("../partials/arsp-member-top") %>

<link rel="stylesheet" href="/css/arsp.css">

<section class="arsp-member-page arsp-member-page-activity">
<h2>

Activity History

</h2>

<% if(activities.length===0){ %>

<div class="notice-card">

No activity found.

</div>

<% } %>

<% activities.forEach(activity=>{ %>

<div class="notice-card">

<h3>

<%= activity.activity %>

</h3>

<p>

IP Address :
<%= activity.ip_address || "-" %>

</p>

<small>

<%= new Date(activity.created_at).toLocaleString("en-GB") %>

</small>

</div>

<% }) %>
</section>

<%- include("../partials/arsp-member-bottom") %>
