<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Chairman's Messages</h1>

                    <p>Manage chairman messages displayed on the website.</p>

                </div>

                <a href="/admin/chairman-message/add"
                   class="btn btn-primary">

                    + Add Chairman

                </a>

            </div>

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>Photo</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                <% if(messages.length){ %>

                    <% messages.forEach(message=>{ %>

                        <tr>

                            <td>

                                <% if(message.image){ %>

                                    <img
                                        src="/uploads/chairman/<%= message.image %>"
                                        width="70"
                                        style="border-radius:8px;">

                                <% } %>

                            </td>

                            <td><%= message.name %></td>

                            <td><%= message.designation %></td>

                            <td><%= message.display_order %></td>

                            <td>

                                <% if(message.status==="Active"){ %>

                                    <span class="badge badge-success">

                                        Active

                                    </span>

                                <% }else{ %>

                                    <span class="badge badge-danger">

                                        Inactive

                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <div class="action-buttons">

                                    <a
                                        href="/admin/chairman-message/<%= message.id %>/edit"
                                        class="btn btn-success">

                                        Edit

                                    </a>

                                    <form
                                        action="/admin/chairman-message/<%= message.id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Delete this chairman?')">

                                        <button
                                            class="btn btn-danger">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="6" class="text-center">

                            No Chairman Messages Found.

                        </td>

                    </tr>

                <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
