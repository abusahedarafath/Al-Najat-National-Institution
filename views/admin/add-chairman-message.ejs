<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Add Chairman Message</h1>

                    <p>Create a new Chairman profile.</p>

                </div>

                <a
                    href="/admin/chairman-messages"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <form
                action="/admin/chairman-message/add"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form">

                <div class="form-grid">

                    <div class="form-group">

                        <label>Chairman's Name</label>

                        <input
                            type="text"
                            name="name"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Display Order</label>

                        <input
                            type="number"
                            name="display_order"
                            value="1"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option value="Active">Active</option>

                            <option value="Inactive">Inactive</option>

                        </select>

                    </div>

                </div>

                <div class="form-group">

                    <label>Chairman's Photo</label>

                    <input
                        type="file"
                        name="image"
                        accept=".jpg,.jpeg,.png,.webp">

                </div>

                <div class="form-group">

                    <label>Chairman's Message</label>

                    <textarea
                        name="message"
                        rows="8"
                        required></textarea>

                </div>

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Save Chairman

                    </button>

                    <a
                        href="/admin/chairman-messages"
                        class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
