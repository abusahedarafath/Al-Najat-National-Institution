<script>
(function () {
    "use strict";

    const popup =
        document.getElementById("anviVisitorPopup");

    const dragHandle =
        document.getElementById(
            "anviVisitorDragHandle"
        );

    const closeButton =
        document.getElementById(
            "anviVisitorClose"
        );

    const lastMonth =
        document.getElementById("anviLastMonth");

    const lastWeek =
        document.getElementById("anviLastWeek");

    const today =
        document.getElementById("anviToday");

    const live =
        document.getElementById("anviLive");

    const status =
        document.getElementById("anviVisitorStatus");

    if (
        !popup ||
        !dragHandle ||
        !closeButton ||
        !lastMonth ||
        !lastWeek ||
        !today ||
        !live
    ) {
        return;
    }

    let statisticsRequestInFlight = false;

    async function loadVisitorStatistics() {
        if (statisticsRequestInFlight) {
            return;
        }

        statisticsRequestInFlight = true;

        try {
            const response = await fetch(
                "/admin/visitor-statistics",
                {
                    method: "GET",
                    credentials: "same-origin",
                    cache: "no-store"
                }
            );

            if (!response.ok) {
                throw new Error(
                    "Statistics request failed."
                );
            }

            const data = await response.json();

            if (
                !data ||
                !data.success ||
                !data.statistics
            ) {
                throw new Error(
                    "Invalid statistics response."
                );
            }

            lastMonth.textContent =
                Number(
                    data.statistics.last_month || 0
                ).toLocaleString();

            lastWeek.textContent =
                Number(
                    data.statistics.last_week || 0
                ).toLocaleString();

            today.textContent =
                Number(
                    data.statistics.today || 0
                ).toLocaleString();

            live.textContent =
                Number(
                    data.statistics.live || 0
                ).toLocaleString();

            const now = new Date();

            status.textContent =
                "Updated " +
                now.toLocaleTimeString(
                    [],
                    {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit"
                    }
                );
        } catch (error) {
            status.textContent =
                "Unable to update statistics";
        } finally {
            statisticsRequestInFlight = false;
        }
    }

    closeButton.addEventListener(
        "click",
        function (event) {
            event.preventDefault();
            event.stopPropagation();

            popup.style.display = "none";
        }
    );

    let dragging = false;
    let pointerId = null;
    let offsetX = 0;
    let offsetY = 0;
    let dragStartedX = 0;
    let dragStartedY = 0;
    let didDrag = false;


    popup.addEventListener(
        "pointerdown",
        function (event) {
            if (
                event.target.closest(
                    "#anviVisitorClose"
                )
            ) {
                return;
            }

            dragging = true;
            pointerId = event.pointerId;
            didDrag = false;
            dragStartedX = event.clientX;
            dragStartedY = event.clientY;

            const rect =
                popup.getBoundingClientRect();

            offsetX =
                event.clientX - rect.left;

            offsetY =
                event.clientY - rect.top;

            popup.style.right = "auto";
            popup.style.bottom = "auto";
            popup.style.left =
                rect.left + "px";
            popup.style.top =
                rect.top + "px";

            try {
                popup.setPointerCapture(
                    pointerId
                );
            } catch (error) {}

            event.preventDefault();
        }
    );

    popup.addEventListener(
        "pointermove",
        function (event) {
            if (
                !dragging ||
                event.pointerId !== pointerId
            ) {
                return;
            }

            if (
                Math.abs(event.clientX - dragStartedX) > 5 ||
                Math.abs(event.clientY - dragStartedY) > 5
            ) {
                didDrag = true;
            }

            const rect =
                popup.getBoundingClientRect();

            const maxLeft =
                Math.max(
                    5,
                    window.innerWidth -
                        rect.width -
                        5
                );

            const maxTop =
                Math.max(
                    5,
                    window.innerHeight -
                        rect.height -
                        5
                );

            let left =
                event.clientX - offsetX;

            let top =
                event.clientY - offsetY;

            left = Math.max(
                5,
                Math.min(left, maxLeft)
            );

            top = Math.max(
                5,
                Math.min(top, maxTop)
            );

            popup.style.left =
                left + "px";

            popup.style.top =
                top + "px";
        }
    );

    function stopDragging(event) {
        if (
            !dragging ||
            event.pointerId !== pointerId
        ) {
            return;
        }

        dragging = false;

        try {
            popup.releasePointerCapture(
                pointerId
            );
        } catch (error) {}

        pointerId = null;
    }

    popup.addEventListener(
        "click",
        function (event) {
            if (
                event.target.closest(
                    "#anviVisitorClose"
                )
            ) {
                return;
            }

            if (didDrag) {
                didDrag = false;
                return;
            }

            popup.classList.toggle("anvi-expanded");
        }
    );

    popup.addEventListener(
        "pointerup",
        stopDragging
    );

    popup.addEventListener(
        "pointercancel",
        stopDragging
    );

    window.addEventListener(
        "resize",
        function () {
            if (
                popup.style.left &&
                popup.style.top &&
                popup.style.display !== "none"
            ) {
                const rect =
                    popup.getBoundingClientRect();

                const maxLeft =
                    window.innerWidth -
                    rect.width;

                const maxTop =
                    window.innerHeight -
                    rect.height;

                popup.style.left =
                    Math.max(
                        5,
                        Math.min(
                            rect.left,
                            maxLeft - 5
                        )
                    ) + "px";

                popup.style.top =
                    Math.max(
                        5,
                        Math.min(
                            rect.top,
                            maxTop - 5
                        )
                    ) + "px";
            }
        }
    );

    loadVisitorStatistics();

    window.setInterval(
        loadVisitorStatistics,
        5000
    );
})();
</script>

