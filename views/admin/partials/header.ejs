<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Al-Najat ERP - Admin Panel</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

<link
    rel="stylesheet"
    href="/css/admin.css">

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>




<header class="topbar">

    <div class="topbar-left">

        <button
            class="menu-toggle"
            id="menuToggle"
            type="button">

            <i class="fas fa-bars"></i>

        </button>

        <h2>

            <%= arspSettings && arspSettings.short_name
                ? arspSettings.short_name
                : "Al-Najat ERP" %>

        </h2>

    </div>

    <div class="topbar-right">

        <button
            class="top-icon"
            type="button">

            <i class="fas fa-bell"></i>

        </button>

        <div class="admin-profile">

            <% if (arspSettings && arspSettings.logo) { %>

                <img
                    src="/uploads/arsp-settings/<%= arspSettings.logo %>"
                    alt="ARSP Logo">

            <% } else if (siteSettings && siteSettings.logo) { %>

                <img
                    src="/uploads/site-settings/<%= siteSettings.logo %>"
                    alt="Website Logo">

            <% } else { %>

                <img
                    src="/images/logo.png"
                    alt="Logo">

            <% } %>

            <div>

                <strong>Administrator</strong>

                <br>

                <small>Admin Panel</small>

            </div>

        </div>

    </div>

</header>
