<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Vehicle Details</h1>

                    <p>View complete vehicle information.</p>

                </div>

                <a
                    href="/admin/vehicles"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th>Vehicle Name</th>

                            <td>

                                <%= vehicle.vehicle_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>Vehicle Number</th>

                            <td>

                                <%= vehicle.vehicle_number %>

                            </td>

                        </tr>

                        <tr>

                            <th>Vehicle Type</th>

                            <td>

                                <%= vehicle.vehicle_type %>

                            </td>

                        </tr>

                        <tr>

                            <th>Seating Capacity</th>

                            <td>

                                <%= vehicle.capacity %>

                            </td>

                        </tr>

                        <tr>

                            <th>Assigned Route</th>

                            <td>

                                <%= vehicle.route_name || "-" %>

                            </td>

                        </tr>

                        <tr>

                            <th>Driver Name</th>

                            <td>

                                <%= vehicle.driver_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>Driver Mobile</th>

                            <td>

                                <%= vehicle.driver_mobile %>

                            </td>

                        </tr>

                        <tr>

                            <th>Status</th>

                            <td>

                                <% if (vehicle.status === "Active") { %>

                                    <span class="badge badge-success">

                                        Active

                                    </span>

                                <% } else { %>

                                    <span class="badge badge-danger">

                                        Inactive

                                    </span>

                                <% } %>

                            </td>

                        </tr>

                        <tr>

                            <th>Created At</th>

                            <td>

                                <%= vehicle.created_at ? new Date(vehicle.created_at).toLocaleString() : "-" %>

                            </td>

                        </tr>

                        <tr>

                            <th>Updated At</th>

                            <td>

                                <%= vehicle.updated_at ? new Date(vehicle.updated_at).toLocaleString() : "-" %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <div class="form-actions" style="margin-top:25px;">

                    <a
                        href="/admin/vehicle/<%= vehicle.id %>/edit"
                        class="btn btn-primary">

                        Edit

                    </a>

                    <form
                        action="/admin/vehicle/<%= vehicle.id %>/delete"
                        method="POST"
                        style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this vehicle?');">

                        <button
                            type="submit"
                            class="btn btn-danger">

                            Delete

                        </button>

                    </form>

                    <a
                        href="/admin/vehicles"
                        class="btn btn-secondary">

                        Back to List

                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
