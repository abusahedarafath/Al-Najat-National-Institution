<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Edit Welcome Section</h1>

                    <p>Update homepage welcome content.</p>

                </div>

                <a
                    href="/admin/welcome-sections"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <form
                    action="/admin/welcome-section/<%= section.id %>/edit"
                    method="POST"
                    class="admin-form">

                    <div class="form-group">

                        <label>Small Title</label>

                        <input
                            type="text"
                            name="small_title"
                            value="<%= section.small_title %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Title</label>

                        <input
                            type="text"
                            name="title"
                            value="<%= section.title %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            name="description"
                            rows="6"
                            required><%= section.description %></textarea>

                    </div>

                    <div class="form-group">

                        <label>Image Filename</label>

                        <input
                            type="text"
                            name="image"
                            value="<%= section.image %>">

                    </div>

                    <div class="form-group">

                        <label>Button Text</label>

                        <input
                            type="text"
                            name="button_text"
                            value="<%= section.button_text %>">

                    </div>

                    <div class="form-group">

                        <label>Button Link</label>

                        <input
                            type="text"
                            name="button_link"
                            value="<%= section.button_link %>">

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option
                                value="Active"
                                <%= section.status==="Active" ? "selected" : "" %>>

                                Active

                            </option>

                            <option
                                value="Inactive"
                                <%= section.status==="Inactive" ? "selected" : "" %>>

                                Inactive

                            </option>

                        </select>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Welcome Section

                        </button>

                        <a
                            href="/admin/welcome-sections"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
