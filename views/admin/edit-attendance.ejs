<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Edit Attendance</h1>

                    <p>Update the attendance record.</p>

                </div>

                <a
                    href="/admin/attendance"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <form
                    action="/admin/attendance/<%= attendance.id %>/edit"
                    method="POST">

                    <div class="form-group">

                        <label>Student</label>

                        <select
                            name="student_id"
                            required>

                            <% students.forEach(student => { %>

                                <option
                                    value="<%= student.id %>"
                                    <%= attendance.student_id == student.id ? "selected" : "" %>>

                                    <%= student.name %> (Roll: <%= student.roll_number %>)

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Class</label>

                        <select
                            name="class_id"
                            required>

                            <% classes.forEach(cls => { %>

                                <option
                                    value="<%= cls.id %>"
                                    <%= attendance.class_id == cls.id ? "selected" : "" %>>

                                    <%= cls.class_name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Attendance Date</label>

                        <input
                            type="date"
                            name="attendance_date"
                            value="<%= attendance.attendance_date ? attendance.attendance_date.toISOString().split('T')[0] : '' %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select
                            name="status"
                            required>

                            <option
                                value="Present"
                                <%= attendance.status === "Present" ? "selected" : "" %>>

                                Present

                            </option>

                            <option
                                value="Absent"
                                <%= attendance.status === "Absent" ? "selected" : "" %>>

                                Absent

                            </option>

                            <option
                                value="Leave"
                                <%= attendance.status === "Leave" ? "selected" : "" %>>

                                Leave

                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Remarks</label>

                        <textarea
                            name="remarks"
                            rows="4"><%= attendance.remarks || "" %></textarea>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Attendance

                        </button>

                        <a
                            href="/admin/attendance/<%= attendance.id %>"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
