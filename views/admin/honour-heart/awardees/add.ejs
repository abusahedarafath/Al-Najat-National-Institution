<%- include("../../partials/header") %>

<div class="admin-layout">

    <%- include("../../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Add Honour Heart Awardee</h1>

                    <p>ARSP Honour Heart Award</p>

                </div>

                <a
                    href="/admin/honour-heart/awardees"
                    class="btn btn-secondary">

                    <i class="fas fa-arrow-left"></i>

                    Back

                </a>

            </div>

            <form
                action="/admin/honour-heart/awardees/add"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form">

                <div class="form-grid">

                    <div class="form-group">

                        <label>Award Year</label>

                        <input
                            type="text"
                            name="award_year"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Photo</label>

                        <input
                            type="file"
                            name="photo"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Name</label>

                        <input
                            type="text"
                            name="name"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            required>

                    </div>

                    <div class="form-group">

                        <label>State</label>

                        <input
                            type="text"
                            name="state">

                    </div>

                    <div class="form-group">

                        <label>Country</label>

                        <input
                            type="text"
                            name="country"
                            value="India">

                    </div>

                    <div class="form-group">

                        <label>Award Category</label>

                        <input
                            type="text"
                            name="award_category">

                    </div>

                    <div class="form-group">

                        <label>Named After</label>

                        <select name="legend_id">

                            <% legends.forEach(legend => { %>

                                <option value="<%= legend.id %>">

                                    <%= legend.name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Ceremony Date</label>

                        <input
                            type="date"
                            name="ceremony_date">

                    </div>

                    <div class="form-group">

                        <label>Venue</label>

                        <input
                            type="text"
                            name="venue">

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option value="Upcoming">

                                Upcoming

                            </option>

                            <option value="Previous">

                                Previous

                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Popup</label>

                        <select name="popup">

                            <option value="No">

                                No

                            </option>

                            <option value="Yes">

                                Yes

                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Published</label>

                        <select name="published">

                            <option value="Yes">

                                Yes

                            </option>

                            <option value="No">

                                No

                            </option>

                        </select>

                    </div>

                </div>

                <div class="form-group">

                    <label>Biography</label>

                    <textarea
                        name="biography"
                        rows="8"></textarea>

                </div>

                <div class="form-group">

                    <label>Achievements</label>

                    <textarea
                        name="achievements"
                        rows="8"></textarea>

                </div>

                <div class="form-group">

                    <label>Citation</label>

                    <textarea
                        name="citation"
                        rows="6"></textarea>

                </div>

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-success">

                        <i class="fas fa-save"></i>

                        Save Awardee

                    </button>

                    <a
                        href="/admin/honour-heart/awardees"
                        class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </main>

</div>

<%- include("../../partials/footer") %>
