<%- include("../../partials/header") %>

<div class="admin-layout">

    <%- include("../../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Edit Legendary Personality</h1>

                    <p>ARSP Honour Heart Award</p>

                </div>

                <a
                    href="/admin/honour-heart/legends"
                    class="btn btn-secondary">

                    <i class="fas fa-arrow-left"></i>

                    Back

                </a>

            </div>

            <form
                action="/admin/honour-heart/legends/edit/<%= legend.id %>"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form">

                <div class="form-grid">

                    <div class="form-group">

                        <label>Current Photo</label>

                        <img
                            src="/uploads/honour-heart/legends/<%= legend.photo %>"
                            style="width:180px;height:180px;object-fit:cover;border-radius:12px;border:1px solid #ddd;margin-top:10px;">

                    </div>

                    <div class="form-group">

                        <label>Change Photo</label>

                        <input
                            type="file"
                            name="photo">

                    </div>

                    <div class="form-group">

                        <label>Name</label>

                        <input
                            type="text"
                            name="name"
                            value="<%= legend.name %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            value="<%= legend.designation %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Slug</label>

                        <input
                            type="text"
                            name="slug"
                            value="<%= legend.slug %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Display Order</label>

                        <input
                            type="number"
                            name="display_order"
                            value="<%= legend.display_order %>">

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option
                                value="Active"
                                <%= legend.status === "Active" ? "selected" : "" %>>

                                Active

                            </option>

                            <option
                                value="Inactive"
                                <%= legend.status === "Inactive" ? "selected" : "" %>>

                                Inactive

                            </option>

                        </select>

                    </div>

                </div>

                <div class="form-group">

                    <label>Biography</label>

                    <textarea
                        name="biography"
                        rows="12"
                        required><%= legend.biography %></textarea>

                </div>

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-success">

                        <i class="fas fa-save"></i>

                        Update Personality

                    </button>

                    <a
                        href="/admin/honour-heart/legends"
                        class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </main>

</div>

<%- include("../../partials/footer") %>
