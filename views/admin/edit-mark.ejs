<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Edit Marks</h1>

                    <p>Update the student's examination marks.</p>

                </div>

                <a
                    href="/admin/marks"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <form
                    action="/admin/mark/<%= mark.id %>/edit"
                    method="POST">

                    <div class="form-group">

                        <label>Student</label>

                        <select
                            name="student_id"
                            required>

                            <% students.forEach(student => { %>

                                <option
                                    value="<%= student.id %>"
                                    <%= mark.student_id == student.id ? "selected" : "" %>>

                                    <%= student.name %> (Roll: <%= student.roll_number %>)

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Class</label>

                        <select
                            name="class_id"
                            required>

                            <% classes.forEach(cls => { %>

                                <option
                                    value="<%= cls.id %>"
                                    <%= mark.class_id == cls.id ? "selected" : "" %>>

                                    <%= cls.class_name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Examination</label>

                        <select
                            name="exam_id"
                            required>

                            <% exams.forEach(exam => { %>

                                <option
                                    value="<%= exam.id %>"
                                    <%= mark.exam_id == exam.id ? "selected" : "" %>>

                                    <%= exam.exam_name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Subject</label>

                        <select
                            name="subject_id"
                            required>

                            <% subjects.forEach(subject => { %>

                                <option
                                    value="<%= subject.id %>"
                                    <%= mark.subject_id == subject.id ? "selected" : "" %>>

                                    <%= subject.subject_name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Obtained Marks</label>

                        <input
                            type="number"
                            name="obtained_marks"
                            min="0"
                            value="<%= mark.obtained_marks %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Total Marks</label>

                        <input
                            type="number"
                            name="total_marks"
                            min="1"
                            value="<%= mark.total_marks %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Grade</label>

                        <input
                            type="text"
                            name="grade"
                            value="<%= mark.grade %>"
                            placeholder="e.g. A+">

                    </div>

                    <div class="form-group">

                        <label>GPA</label>

                        <input
                            type="number"
                            name="gpa"
                            step="0.01"
                            min="0"
                            max="10"
                            value="<%= mark.gpa %>"
                            placeholder="e.g. 4.00">

                    </div>

                    <div class="form-group">

                        <label>Remarks</label>

                        <textarea
                            name="remarks"
                            rows="4"><%= mark.remarks || "" %></textarea>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Marks

                        </button>

                        <a
                            href="/admin/mark/<%= mark.id %>"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
