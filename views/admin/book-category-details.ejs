<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Book Category Details</h1>

                    <p>View complete information about the selected book category.</p>

                </div>

                <a
                    href="/admin/book-categories"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th>ID</th>

                            <td>

                                <%= category.id %>

                            </td>

                        </tr>

                        <tr>

                            <th>Category Name</th>

                            <td>

                                <%= category.category_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>Description</th>

                            <td>

                                <%= category.description || "No description available." %>

                            </td>

                        </tr>

                        <tr>

                            <th>Status</th>

                            <td>

                                <% if (category.status === "Active") { %>

                                    <span class="badge badge-success">

                                        Active

                                    </span>

                                <% } else { %>

                                    <span class="badge badge-danger">

                                        Inactive

                                    </span>

                                <% } %>

                            </td>

                        </tr>

                        <tr>

                            <th>Created At</th>

                            <td>

                                <%= category.created_at ? new Date(category.created_at).toLocaleString() : "-" %>

                            </td>

                        </tr>

                        <tr>

                            <th>Updated At</th>

                            <td>

                                <%= category.updated_at ? new Date(category.updated_at).toLocaleString() : "-" %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <div class="form-actions" style="margin-top:25px;">

                    <a
                        href="/admin/book-category/<%= category.id %>/edit"
                        class="btn btn-primary">

                        Edit

                    </a>

                    <form
                        action="/admin/book-category/<%= category.id %>/delete"
                        method="POST"
                        style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this category?');">

                        <button
                            type="submit"
                            class="btn btn-danger">

                            Delete

                        </button>

                    </form>

                    <a
                        href="/admin/book-categories"
                        class="btn btn-secondary">

                        Back to List

                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
