<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>Edit Teacher</h1>
                    <p>Update teacher information.</p>
                </div>

            </div>

            <div class="card">

                <form
                    action="/admin/teacher/<%= teacher.id %>/edit"
                    method="POST"
                    enctype="multipart/form-data">

                    <input
                        type="hidden"
                        name="old_photo"
                        value="<%= teacher.photo %>">

                    <div class="form-group">

                        <label>Teacher Photo</label>

                        <% if (teacher.photo) { %>

                            <img
                                src="/uploads/teachers/<%= teacher.photo %>"
                                alt="Teacher Photo"
                                style="width:120px;height:120px;border-radius:10px;object-fit:cover;display:block;margin-bottom:12px;">

                        <% } %>

                        <input
                            type="file"
                            name="photo"
                            accept=".jpg,.jpeg,.png">

                    </div>

                    <div class="form-group">

                        <label>Teacher ID</label>

                        <input
                            type="text"
                            name="teacher_id"
                            value="<%= teacher.teacher_id %>"
                            readonly>

                    </div>

                    <div class="form-group">

                        <label>Full Name</label>

                        <input
                            type="text"
                            name="full_name"
                            value="<%= teacher.full_name %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Father's Name</label>

                        <input
                            type="text"
                            name="father_name"
                            value="<%= teacher.father_name %>">

                    </div>

                    <div class="form-group">

                        <label>Mother's Name</label>

                        <input
                            type="text"
                            name="mother_name"
                            value="<%= teacher.mother_name %>">

                    </div>

                    <div class="form-group">

                        <label>Date of Birth</label>

                        <input
                            type="date"
                            name="dob"
                            value="<%= teacher.dob ? teacher.dob.toISOString().split('T')[0] : '' %>">

                    </div>

                    <div class="form-group">

                        <label>Gender</label>

                        <select name="gender">

                            <option value="Male" <%= teacher.gender === "Male" ? "selected" : "" %>>
                                Male
                            </option>

                            <option value="Female" <%= teacher.gender === "Female" ? "selected" : "" %>>
                                Female
                            </option>

                            <option value="Other" <%= teacher.gender === "Other" ? "selected" : "" %>>
                                Other
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Mobile</label>

                        <input
                            type="text"
                            name="mobile"
                            value="<%= teacher.mobile %>">

                    </div>

                    <div class="form-group">

                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            value="<%= teacher.email %>">

                    </div>

                    <div class="form-group">

                        <label>Address</label>

                        <textarea name="address"><%= teacher.address %></textarea>

                    </div>

                    <div class="form-group">

                        <label>Qualification</label>

                        <input
                            type="text"
                            name="qualification"
                            value="<%= teacher.qualification %>">

                    </div>

                    <div class="form-group">

                        <label>Subject</label>

                        <input
                            type="text"
                            name="subject"
                            value="<%= teacher.subject %>">

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            value="<%= teacher.designation %>">

                    </div>

                    <div class="form-group">

                        <label>Joining Date</label>

                        <input
                            type="date"
                            name="joining_date"
                            value="<%= teacher.joining_date ? teacher.joining_date.toISOString().split('T')[0] : '' %>">

                    </div>

                    <div class="form-group">

                        <label>Salary</label>

                        <input
                            type="number"
                            name="salary"
                            min="0"
                            step="0.01"
                            value="<%= teacher.salary %>">

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option value="Active" <%= teacher.status === "Active" ? "selected" : "" %>>
                                Active
                            </option>

                            <option value="Inactive" <%= teacher.status === "Inactive" ? "selected" : "" %>>
                                Inactive
                            </option>

                        </select>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">
                            Save Changes
                        </button>

                        <a
                            href="/admin/teacher/<%= teacher.id %>"
                            class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
