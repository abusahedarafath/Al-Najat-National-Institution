<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>Students</h1>
                    <p>Manage all admitted students.</p>
                </div>

            </div>

            <div class="card">

                <input
                    type="text"
                    class="form-control"
                    placeholder="Search by Student ID, Name or Mobile">

                <br>

                <table class="admin-table">

                    <thead>

                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Course</th>
                            <th>Mobile</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if (students && students.length > 0) { %>

                            <% students.forEach(student => { %>

                                <tr>

                                    <td>
                                        <%= student.student_id %>
                                    </td>

                                    <td>
                                        <%= student.full_name %>
                                    </td>

                                    <td>
                                        <%= student.course || "-" %>
                                    </td>

                                    <td>
                                        <%= student.mobile %>
                                    </td>

                                    <td>

                                        <% if (student.status === "Active") { %>

                                            <span class="badge badge-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge badge-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <a
                                                href="/admin/student/<%= student.id %>"
                                                class="btn btn-primary">
                                                View
                                            </a>

                                            <a
                                                href="/admin/student/<%= student.id %>/edit"
                                                class="btn btn-warning">
                                                Edit
                                            </a>

                                            <form
                                                action="/admin/student/<%= student.id %>/delete"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to permanently delete this student?');">

                                                <button
                                                    type="submit"
                                                    class="btn btn-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td colspan="6" style="text-align:center;">
                                    No students found.
                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
