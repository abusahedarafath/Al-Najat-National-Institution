<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Certificate Management</h1>

                    <p>Generate and manage student certificates.</p>

                </div>

                <a
                    href="/admin/certificate/add"
                    class="btn btn-primary">

                    + Generate Certificate

                </a>

            </div>

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>Certificate No.</th>
                        <th>Student Name</th>
                        <th>Student ID</th>
                        <th>Class</th>
                        <th>Certificate Type</th>
                        <th>Issue Date</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% if (certificates && certificates.length > 0) { %>

                        <% certificates.forEach(certificate => { %>

                            <tr>

                                <td>

                                    <%= certificate.certificate_no %>

                                </td>

                                <td>

                                    <%= certificate.full_name %>

                                </td>

                                <td>

                                    <%= certificate.student_id %>

                                </td>

                                <td>

                                    <%= certificate.class_name || "-" %>

                                </td>

                                <td>

                                    <%= certificate.certificate_type %>

                                </td>

                                <td>

                                    <%= certificate.issue_date ? new Date(certificate.issue_date).toLocaleDateString() : "-" %>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/admin/certificate/<%= certificate.id %>"
                                            class="btn btn-primary">

                                            View

                                        </a>

                                        <a
                                            href="/admin/certificate/<%= certificate.id %>/edit"
                                            class="btn btn-success">

                                            Edit

                                        </a>


<a href="/admin/certificate/<%= certificate.id %>/print" class="btn btn-primary">
    Print
</a>
                                       

                                        <form
                                            action="/admin/certificate/<%= certificate.id %>/delete"
                                            method="POST"
                                            style="display:inline;"
                                            onsubmit="return confirm('Delete this certificate?');">

                                            <button
                                                type="submit"
                                                class="btn btn-danger">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td
                                colspan="7"
                                style="text-align:center;">

                                No certificates found.

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
