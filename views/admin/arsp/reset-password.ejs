<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Reset Member Password</h1>

                    <p>
                        Reset the login password for this ARSP member.
                    </p>

                </div>

            </div>

            <div class="admin-form">

                <div class="form-group">

                    <label>

                        Member Name

                    </label>

                    <input
                        type="text"
                        value="<%= member.full_name %>"
                        readonly>

                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label>

                            Member ID

                        </label>

                        <input
                            type="text"
                            value="<%= member.member_id %>"
                            readonly>

                    </div>

                    <div class="form-group">

                        <label>

                            Status

                        </label>

                        <input
                            type="text"
                            value="<%= member.status %>"
                            readonly>

                    </div>

                </div>

                <hr style="margin:25px 0;">

                <form
                    action="/admin/arsp/member/<%= member.id %>/reset-password"
                    method="POST">

                    <div class="form-group">

                        <label>

                            Reset Method

                        </label>

                        <select
                            id="passwordType"
                            name="type">

                            <option value="auto">

                                Generate Secure Password

                            </option>

                            <option value="custom">

                                Set Custom Password

                            </option>

                        </select>

                    </div>

                    <div id="customPasswordBox" style="display:none;">

                        <div class="form-group">

                            <label>

                                New Password

                            </label>

                            <input
                                type="password"
                                name="new_password">

                        </div>

                        <div class="form-group">

                            <label>

                                Confirm Password

                            </label>

                            <input
                                type="password"
                                name="confirm_password">

                        </div>

                    </div>

                    <div class="form-actions">

                        <button
                            type="submit"
                            class="btn-save">

                            <i class="fas fa-key"></i>

                            Reset Password

                        </button>

                        <a
                            href="/admin/arsp/members"
                            class="btn-view">

                            <i class="fas fa-arrow-left"></i>

                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<script>

const passwordType =
document.getElementById("passwordType");

const customPasswordBox =
document.getElementById("customPasswordBox");

function togglePasswordBox(){

    if(passwordType.value==="custom"){

        customPasswordBox.style.display="block";

    }else{

        customPasswordBox.style.display="none";

    }

}

togglePasswordBox();

passwordType.addEventListener(

    "change",

    togglePasswordBox

);

</script>

<%- include("../partials/footer") %>
