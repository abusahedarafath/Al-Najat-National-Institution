<%- include("../../partials/header") %>

<div class="admin-layout">
    <%- include("../../partials/sidebar") %>

    <main class="admin-content">


<style>
    .centre-form-page {
        padding:20px;
        max-width:1100px;
        margin:auto;
    }

    .form-header {
        margin-bottom:20px;
    }

    .form-header h1 {
        margin:0;
        font-size:24px;
    }

    .form-header p {
        color:#64748b;
        font-size:13px;
        margin:5px 0 0;
    }

    .form-card {
        background:#fff;
        border:1px solid #e2e8f0;
        border-radius:13px;
        padding:22px;
    }

    .form-section {
        margin-bottom:25px;
    }

    .form-section h2 {
        font-size:16px;
        margin:0 0 15px;
        padding-bottom:10px;
        border-bottom:1px solid #e2e8f0;
    }

    .form-grid {
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:15px;
    }

    .field.full {
        grid-column:1 / -1;
    }

    label {
        display:block;
        font-size:12px;
        font-weight:700;
        color:#475569;
        margin-bottom:6px;
    }

    input,
    select,
    textarea {
        width:100%;
        padding:11px 12px;
        border:1px solid #cbd5e1;
        border-radius:8px;
        font:inherit;
        font-size:14px;
        outline:none;
    }

    input:focus,
    select:focus,
    textarea:focus {
        border-color:#2563eb;
        box-shadow:0 0 0 3px rgba(37,99,235,.1);
    }

    textarea {
        min-height:100px;
        resize:vertical;
    }

    .form-actions {
        display:flex;
        gap:10px;
        justify-content:flex-end;
        flex-wrap:wrap;
        border-top:1px solid #e2e8f0;
        padding-top:18px;
    }

    .btn {
        display:inline-block;
        border:0;
        padding:11px 17px;
        border-radius:8px;
        font-weight:700;
        text-decoration:none;
        cursor:pointer;
        font-size:13px;
    }

    .btn-primary {
        background:#2563eb;
        color:#fff;
    }

    .btn-secondary {
        background:#e2e8f0;
        color:#334155;
    }

    .required {
        color:#dc2626;
    }

    @media(max-width:700px) {
        .centre-form-page {
            padding:14px;
        }

        .form-card {
            padding:16px;
        }

        .form-grid {
            grid-template-columns:1fr;
        }

        .field.full {
            grid-column:auto;
        }
    }
</style>

<div class="centre-form-page">

    <div class="form-header">
        <h1>
            <%= mode === "edit" ? "Edit RTSE Centre" : "Add RTSE Centre" %>
        </h1>

        <p>
            Register and maintain an examination centre for RTSE.
        </p>
    </div>

    <form
        method="POST"
        action="<%= mode === 'edit'
            ? '/admin/arsp/centre/' + centre.id + '/edit'
            : '/admin/arsp/centres/add' %>"
        class="form-card"
    >

        <div class="form-section">
            <h2>Centre Information</h2>

            <div class="form-grid">

                <% if (mode === "edit") { %>
                <div class="field">
                    <label>
                        Centre ID
                    </label>

                    <input
                        type="text"
                        value="<%= centre?.centre_id || '' %>"
                        readonly
                        style="background:#f8fafc;color:#64748b;cursor:not-allowed;"
                    >

                    <small style="display:block;margin-top:5px;color:#64748b;">
                        System-generated Centre ID.
                    </small>
                </div>

                <div class="field">
                    <label>
                        Centre Code
                    </label>

                    <input
                        type="text"
                        value="<%= centre?.centre_code || '' %>"
                        readonly
                        style="background:#f8fafc;color:#64748b;cursor:not-allowed;"
                    >

                    <small style="display:block;margin-top:5px;color:#64748b;">
                        System-generated Centre Code.
                    </small>
                </div>
                <% } else { %>
                <div class="field full">
                    <div style="padding:14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;color:#1e40af;">
                        <strong>Centre ID &amp; Centre Code</strong>
                        <div style="margin-top:5px;font-size:12px;">
                            Both will be generated automatically after the centre is registered.
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="field">
                    <label>
                        Centre Name <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        name="centre_name"
                        required
                        value="<%= centre?.centre_name || '' %>"
                        placeholder="Examination centre name"
                    >
                </div>

                <div class="field">
                    <label>Centre Type</label>

                    <select name="centre_type">
                        <% const types = [
                            "School",
                            "Madrasa",
                            "College",
                            "Institution",
                            "Other"
                        ]; %>

                        <% types.forEach(type => { %>
                            <option
                                value="<%= type %>"
                                <%= (centre?.centre_type || "School") === type
                                    ? "selected"
                                    : "" %>
                            >
                                <%= type %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="field">
                    <label>Examination Capacity</label>

                    <input
                        type="number"
                        name="capacity"
                        min="0"
                        value="<%= centre?.capacity || 0 %>"
                        placeholder="Maximum students"
                    >
                </div>

            </div>
        </div>

        <div class="form-section">
            <h2>Head / Contact Information</h2>

            <div class="form-grid">

                <div class="field">
                    <label>Head of Institution / Centre In-Charge</label>

                    <input
                        type="text"
                        name="head_name"
                        value="<%= centre?.head_name || '' %>"
                    >
                </div>

                <div class="field">
                    <label>Mobile Number</label>

                    <input
                        type="text"
                        name="mobile"
                        value="<%= centre?.mobile || '' %>"
                    >
                </div>

                <div class="field">
                    <label>Email</label>

                    <input
                        type="email"
                        name="email"
                        value="<%= centre?.email || '' %>"
                    >
                </div>

            </div>
        </div>

        <div class="form-section">
            <h2>Address</h2>

            <div class="form-grid">

                <div class="field full">
                    <label>Address</label>

                    <textarea name="address"><%= centre?.address || '' %></textarea>
                </div>

                <div class="field">
                    <label>Village / Town</label>

                    <input
                        type="text"
                        name="village"
                        value="<%= centre?.village || '' %>"
                    >
                </div>

                <div class="field">
                    <label>Post Office</label>

                    <input
                        type="text"
                        name="post_office"
                        value="<%= centre?.post_office || '' %>"
                    >
                </div>

                <div class="field">
                    <label>District</label>

                    <input
                        type="text"
                        name="district"
                        value="<%= centre?.district || '' %>"
                    >
                </div>

                <div class="field">
                    <label>State</label>

                    <input
                        type="text"
                        name="state"
                        value="<%= centre?.state || 'Assam' %>"
                    >
                </div>

                <div class="field">
                    <label>PIN Code</label>

                    <input
                        type="text"
                        name="pincode"
                        value="<%= centre?.pincode || '' %>"
                    >
                </div>

            </div>
        </div>

        <div class="form-section">
            <h2>Administrative Notes</h2>

            <div class="form-grid">

                <div class="field full">
                    <label>Remarks</label>

                    <textarea
                        name="remarks"
                        placeholder="Internal administrative remarks"
                    ><%= centre?.remarks || '' %></textarea>
                </div>

            </div>
        </div>

        <div class="form-actions">

            <a
                href="/admin/arsp/centres"
                class="btn btn-secondary"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="btn btn-primary"
            >
                <%= mode === "edit"
                    ? "Update Centre"
                    : "Create Centre" %>
            </button>

        </div>

    </form>

</div>

    </main>
</div>

<%- include("../../partials/footer") %>
