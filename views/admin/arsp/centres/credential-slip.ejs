<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f7;
            font-family: Arial, sans-serif;
            padding: 25px;
        }

        .actions {
            max-width: 760px;
            margin: 0 auto 15px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .actions button {
            border: 0;
            padding: 11px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
        }

        .print {
            background: #2563eb;
            color: white;
        }

        .close {
            background: #64748b;
            color: white;
        }

        .slip {
            width: 100%;
            max-width: 760px;
            margin: auto;
            background: white;
            border: 2px solid #1e3a8a;
            padding: 35px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 18px;
            margin-bottom: 25px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
        }

        .header h2 {
            margin: 8px 0;
            font-size: 19px;
        }

        .header p {
            margin: 0;
            color: #64748b;
        }

        .title {
            text-align: center;
            margin-bottom: 25px;
        }

        .title span {
            display: inline-block;
            padding: 8px 18px;
            border: 1px solid #1e3a8a;
            border-radius: 20px;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 13px;
            border: 1px solid #dbe1e8;
            text-align: left;
            word-break: break-word;
        }

        th {
            width: 38%;
            background: #f8fafc;
        }

        .password {
            font-family: monospace;
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .warning {
            margin-top: 25px;
            padding: 15px;
            border: 1px solid #f59e0b;
            background: #fffbeb;
            color: #92400e;
            border-radius: 8px;
            line-height: 1.5;
        }

        .footer {
            margin-top: 35px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .signature {
            text-align: center;
            min-width: 180px;
            padding-top: 30px;
            border-top: 1px solid #333;
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .slip {
                padding: 20px;
            }

            th,
            td {
                padding: 10px;
                font-size: 14px;
            }

            .password {
                font-size: 17px;
            }

            .footer {
                flex-direction: column;
            }

            .signature {
                margin-top: 25px;
            }
        }

        @media print {
            @page {
                size: A4;
                margin: 12mm;
            }

            body {
                background: white;
                padding: 0;
            }

            .actions {
                display: none;
            }

            .slip {
                max-width: none;
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="actions">

        <button
            class="print"
            type="button"
            onclick="window.print()"
        >
            🖨️ Print / Save as PDF
        </button>

        <form
            method="POST"
            action="/admin/arsp/centre/<%= centre.id %>/credential-slip/close"
            style="margin:0;"
        >
            <button
                class="close"
                type="submit"
            >
                Close
            </button>
        </form>

    </div>

    <div class="slip">

        <div class="header">
            <h1>ARSP</h1>
            <h2>Active Rural Social Progress</h2>
            <p>RTSE Centre Portal</p>
        </div>

        <div class="title">
            <span>CENTRE PORTAL CREDENTIAL SLIP</span>
        </div>

        <table>

            <tr>
                <th>Centre Name</th>
                <td><%= centre.centre_name %></td>
            </tr>

            <tr>
                <th>Centre ID</th>
                <td>
                    <strong><%= centre.centre_id %></strong>
                </td>
            </tr>

            <tr>
                <th>Centre Code</th>
                <td>
                    <strong><%= centre.centre_code %></strong>
                </td>
            </tr>

            <tr>
                <th>Portal Login ID</th>
                <td>
                    <strong><%= credentials.username %></strong>
                </td>
            </tr>

            <tr>
                <th>Temporary Password</th>
                <td>
                    <span class="password">
                        <%= credentials.temporaryPassword %>
                    </span>
                </td>
            </tr>

            <tr>
                <th>Portal Login</th>
                <td><%= portalUrl %></td>
            </tr>

            <tr>
                <th>Account Status</th>
                <td><strong>Active</strong></td>
            </tr>

            <tr>
                <th>Issued Date</th>
                <td>
                    <%= new Date().toLocaleDateString("en-IN") %>
                </td>
            </tr>

        </table>

        <div class="warning">
            <strong>Important:</strong>
            This is a temporary password. The Centre must change
            the password immediately after the first successful login.
            Keep this credential slip confidential.
        </div>

        <div class="footer">

            <div>
                RTSE Centre Portal<br>
                <strong>ARSP</strong>
            </div>

            <div class="signature">
                Authorized Administrator
            </div>

        </div>

    </div>

</body>
</html>
