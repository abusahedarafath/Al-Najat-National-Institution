<%- include("../../partials/header") %>

<div class="admin-layout">
    <%- include("../../partials/sidebar") %>

    <main class="admin-content">
<div class="container-fluid" style="padding:24px;">

    <div style="display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;margin-bottom:20px;">
        <div>
            <h1 style="margin:0;">ARSP School Registry</h1>
            <p style="margin:6px 0 0;color:#666;">
                Manage registered schools and educational institutions.
            </p>
        </div>

        <a href="/admin/arsp/schools/add"
           style="background:#2563eb;color:#fff;padding:11px 18px;border-radius:8px;text-decoration:none;font-weight:600;">
            + Add School
        </a>
    </div>

    <!-- Statistics -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px;">

        <div style="padding:18px;border-radius:10px;background:#f8fafc;border:1px solid #e5e7eb;">
            <div style="font-size:13px;color:#64748b;">Total</div>
            <strong style="font-size:28px;"><%= counts.total || 0 %></strong>
        </div>

        <div style="padding:18px;border-radius:10px;background:#fffbeb;border:1px solid #fde68a;">
            <div style="font-size:13px;color:#92400e;">Pending</div>
            <strong style="font-size:28px;"><%= counts.pending || 0 %></strong>
        </div>

        <div style="padding:18px;border-radius:10px;background:#f0fdf4;border:1px solid #bbf7d0;">
            <div style="font-size:13px;color:#166534;">Approved</div>
            <strong style="font-size:28px;"><%= counts.approved || 0 %></strong>
        </div>

        <div style="padding:18px;border-radius:10px;background:#fef2f2;border:1px solid #fecaca;">
            <div style="font-size:13px;color:#991b1b;">Rejected</div>
            <strong style="font-size:28px;"><%= counts.rejected || 0 %></strong>
        </div>

        <div style="padding:18px;border-radius:10px;background:#f8fafc;border:1px solid #cbd5e1;">
            <div style="font-size:13px;color:#475569;">Inactive</div>
            <strong style="font-size:28px;"><%= counts.inactive || 0 %></strong>
        </div>

    </div>

    <!-- Search -->
    <form method="GET"
          action="/admin/arsp/schools"
          style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">

        <input
            type="text"
            name="search"
            value="<%= search %>"
            placeholder="Search school, code, head, mobile or district"
            style="flex:1;min-width:220px;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
        >

        <select
            name="status"
            style="padding:11px;border:1px solid #d1d5db;border-radius:8px;"
        >
            <option value="">All Status</option>
            <option value="Pending" <%= status === "Pending" ? "selected" : "" %>>Pending</option>
            <option value="Approved" <%= status === "Approved" ? "selected" : "" %>>Approved</option>
            <option value="Rejected" <%= status === "Rejected" ? "selected" : "" %>>Rejected</option>
            <option value="Inactive" <%= status === "Inactive" ? "selected" : "" %>>Inactive</option>
        </select>

        <button
            type="submit"
            style="background:#111827;color:#fff;border:0;padding:11px 18px;border-radius:8px;">
            Search
        </button>

        <a
            href="/admin/arsp/schools"
            style="padding:11px 18px;border:1px solid #d1d5db;border-radius:8px;text-decoration:none;color:#374151;">
            Reset
        </a>

    </form>

    <!-- Registry -->
    <div style="overflow-x:auto;background:#fff;border:1px solid #e5e7eb;border-radius:10px;">

        <table style="width:100%;border-collapse:collapse;min-width:900px;">

            <thead>
                <tr style="background:#f8fafc;">
                    <th style="padding:13px;text-align:left;">Code</th>
                    <th style="padding:13px;text-align:left;">School</th>
                    <th style="padding:13px;text-align:left;">Type</th>
                    <th style="padding:13px;text-align:left;">Head</th>
                    <th style="padding:13px;text-align:left;">District</th>
                    <th style="padding:13px;text-align:left;">Status</th>
                    <th style="padding:13px;text-align:left;">Action</th>
                </tr>
            </thead>

            <tbody>

                <% if (!schools.length) { %>
                    <tr>
                        <td colspan="7" style="padding:35px;text-align:center;color:#6b7280;">
                            No schools found.
                        </td>
                    </tr>
                <% } %>

                <% schools.forEach(school => { %>

                    <tr style="border-top:1px solid #eee;">

                        <td style="padding:13px;font-weight:600;">
                            <%= school.school_code %>
                        </td>

                        <td style="padding:13px;">
                            <strong><%= school.school_name %></strong>
                        </td>

                        <td style="padding:13px;">
                            <%= school.school_type %>
                        </td>

                        <td style="padding:13px;">
                            <%= school.head_name || "-" %>
                        </td>

                        <td style="padding:13px;">
                            <%= school.district || "-" %>
                        </td>

                        <td style="padding:13px;">
                            <span style="
                                display:inline-block;
                                padding:5px 9px;
                                border-radius:20px;
                                font-size:12px;
                                font-weight:600;
                                background:
                                    <%= school.status === 'Approved'
                                        ? '#dcfce7'
                                        : school.status === 'Pending'
                                        ? '#fef3c7'
                                        : school.status === 'Rejected'
                                        ? '#fee2e2'
                                        : '#e2e8f0' %>;
                                color:
                                    <%= school.status === 'Approved'
                                        ? '#166534'
                                        : school.status === 'Pending'
                                        ? '#92400e'
                                        : school.status === 'Rejected'
                                        ? '#991b1b'
                                        : '#475569' %>;
                            ">
                                <%= school.status %>
                            </span>
                        </td>

                        <td style="padding:13px;white-space:nowrap;">

                            <a
                                href="/admin/arsp/school/<%= school.id %>"
                                style="text-decoration:none;margin-right:8px;">
                                View
                            </a>

                            <a
                                href="/admin/arsp/school/<%= school.id %>/edit"
                                style="text-decoration:none;">
                                Edit
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

    </main>
</div>

<%- include("../../partials/footer") %>
