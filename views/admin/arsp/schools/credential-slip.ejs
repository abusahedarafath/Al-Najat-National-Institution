<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f7;
            font-family: Arial, sans-serif;
            padding: 25px;
        }

        .actions {
            max-width: 760px;
            margin: 0 auto 15px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .actions button,
        .actions a {
            border: 0;
            padding: 11px 16px;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
            font-weight: 600;
        }

        .print {
            background: #2563eb;
            color: white;
        }

        .close {
            background: #64748b;
            color: white;
        }

        .slip {
            width: 100%;
            max-width: 760px;
            margin: auto;
            background: white;
            border: 2px solid #1e3a8a;
            padding: 35px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 18px;
            margin-bottom: 25px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
        }

        .header h2 {
            margin: 8px 0;
            font-size: 19px;
        }

        .header p {
            margin: 0;
            color: #64748b;
        }

        .title {
            text-align: center;
            margin-bottom: 25px;
        }

        .title span {
            display: inline-block;
            padding: 8px 18px;
            border: 1px solid #1e3a8a;
            border-radius: 20px;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 13px;
            border: 1px solid #dbe1e8;
            text-align: left;
        }

        th {
            width: 38%;
            background: #f8fafc;
        }

        .password {
            font-family: monospace;
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .warning {
            margin-top: 25px;
            padding: 15px;
            border: 1px solid #f59e0b;
            background: #fffbeb;
            color: #92400e;
            border-radius: 8px;
        }

        .footer {
            margin-top: 35px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .signature {
            text-align: center;
            min-width: 180px;
            padding-top: 30px;
            border-top: 1px solid #333;
        }

        @media print {

            body {
                background: white;
                padding: 0;
            }

            .actions {
                display: none;
            }

            .slip {
                border: 2px solid #1e3a8a;
                max-width: none;
                width: 100%;
            }

        }

    </style>

</head>

<body>

<div class="actions">

    <button
        class="print"
        onclick="window.print()"
    >
        🖨️ Print / Save as PDF
    </button>

    <form
        method="POST"
        action="/admin/arsp/school/<%= school.id %>/credential-slip/close"
        style="margin:0;"
    >
        <button
            class="close"
            type="submit"
        >
            Close
        </button>
    </form>

</div>

<div class="slip">

    <div class="header">

        <h1>ARSP</h1>

        <h2>Active Rural Social Progress</h2>

        <p>
            School Portal
        </p>

    </div>

    <div class="title">
        <span>
            SCHOOL PORTAL CREDENTIAL SLIP
        </span>
    </div>

    <table>

        <tr>
            <th>School Name</th>
            <td>
                <%= school.school_name %>
            </td>
        </tr>

        <tr>
            <th>School Code</th>
            <td>
                <strong>
                    <%= school.school_code %>
                </strong>
            </td>
        </tr>

        <tr>
            <th>Portal Login ID</th>
            <td>
                <strong>
                    <%= credentials.username %>
                </strong>
            </td>
        </tr>

        <tr>
            <th>Temporary Password</th>
            <td>

                <% if (credentials.temporaryPassword) { %>

                    <span class="password">
                        <%= credentials.temporaryPassword %>
                    </span>

                <% } else { %>

                    <strong>
                        Password already exists.
                    </strong>

                <% } %>

            </td>
        </tr>

        <tr>
            <th>Portal Login</th>
            <td>
                <%= portalUrl %>
            </td>
        </tr>

        <tr>
            <th>Account Status</th>
            <td>
                <strong>Active</strong>
            </td>
        </tr>

        <tr>
            <th>Issued Date</th>
            <td>
                <%= new Date().toLocaleDateString("en-IN") %>
            </td>
        </tr>

    </table>

    <div class="warning">

        <strong>Important:</strong>

        This is a temporary password.
        The school must change the password
        immediately after the first successful login.

        Keep this slip confidential.

    </div>

    <div class="footer">

        <div>
            School Portal<br>
            <strong>ARSP</strong>
        </div>

        <div class="signature">
            Authorized Administrator
        </div>

    </div>

</div>

</body>
</html>
