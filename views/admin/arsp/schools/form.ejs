<%- include("../../partials/header") %>

<div class="admin-layout">
    <%- include("../../partials/sidebar") %>

    <main class="admin-content">
<div class="container-fluid" style="padding:24px;max-width:1000px;">

    <div style="margin-bottom:20px;">
        <h1 style="margin:0;">
            <%= isEdit ? "Edit ARSP School" : "Add ARSP School" %>
        </h1>

        <p style="color:#666;margin-top:6px;">
            <%= isEdit
                ? "Update school registration information."
                : "Register a school or educational institution with ARSP." %>
        </p>
    </div>

    <form
        method="POST"
        action="<%= isEdit
            ? '/admin/arsp/school/' + school.id + '/edit'
            : '/admin/arsp/schools/add' %>"
        style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:22px;">

        <% if (isEdit) { %>

            <div style="margin-bottom:18px;">
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    School Code
                </label>

                <input
                    type="text"
                    value="<%= school.school_code %>"
                    readonly
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;background:#f3f4f6;"
                >
            </div>

        <% } %>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;">

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    School Name *
                </label>

                <input
                    type="text"
                    name="school_name"
                    value="<%= school.school_name || '' %>"
                    required
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    School Type
                </label>

                <select
                    name="school_type"
                    style="width:100%;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
                    <% const types = [
                        "School",
                        "Madrasa",
                        "School & Madrasa",
                        "College",
                        "Other"
                    ]; %>

                    <% types.forEach(type => { %>
                        <option
                            value="<%= type %>"
                            <%= (school.school_type || "School") === type ? "selected" : "" %>>
                            <%= type %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Head / Principal
                </label>

                <input
                    type="text"
                    name="head_name"
                    value="<%= school.head_name || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Mobile
                </label>

                <input
                    type="text"
                    name="mobile"
                    value="<%= school.mobile || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    value="<%= school.email || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Village
                </label>

                <input
                    type="text"
                    name="village"
                    value="<%= school.village || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Post Office
                </label>

                <input
                    type="text"
                    name="post_office"
                    value="<%= school.post_office || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    District
                </label>

                <input
                    type="text"
                    name="district"
                    value="<%= school.district || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    State
                </label>

                <input
                    type="text"
                    name="state"
                    value="<%= school.state || 'Assam' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:6px;">
                    Pincode
                </label>

                <input
                    type="text"
                    name="pincode"
                    value="<%= school.pincode || '' %>"
                    style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
                >
            </div>

        </div>

        <div style="margin-top:16px;">
            <label style="display:block;font-weight:600;margin-bottom:6px;">
                Address
            </label>

            <textarea
                name="address"
                rows="4"
                style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
            ><%= school.address || '' %></textarea>
        </div>


        <% if (isEdit && activeExam) { %>

        <div style="margin-top:22px;padding:18px;border:1px solid #dbeafe;border-radius:10px;background:#eff6ff;">

            <div style="margin-bottom:14px;">

                <h3 style="margin:0 0 6px 0;">
                    RTSE Examination Centre
                </h3>

                <p style="margin:0;color:#475569;font-size:14px;">
                    Examination Year:
                    <strong><%= activeExam.exam_year %></strong>
                </p>

            </div>

            <label style="display:block;font-weight:600;margin-bottom:6px;">
                Examination Centre
            </label>

            <select
                name="rtse_centre_id"
                style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;"
            >

                <option value="">
                    -- Select Examination Centre --
                </option>

                <% centres.forEach(centre => { %>

                    <option
                        value="<%= centre.id %>"
                        <%= currentAssignment && Number(currentAssignment.centre_id) === Number(centre.id) ? "selected" : "" %>
                    >
                        <%= centre.centre_name %>
                        <% if (centre.centre_code) { %>
                            — <%= centre.centre_code %>
                        <% } %>
                    </option>

                <% }) %>

            </select>

            <% if (currentAssignment) { %>

                <div style="margin-top:10px;padding:10px 12px;background:#fff;border:1px solid #dbeafe;border-radius:8px;font-size:13px;color:#334155;">

                    <strong>Current Centre:</strong>
                    <%= currentAssignment.centre_name %>

                    <% if (currentAssignment.centre_code) { %>
                        (<%= currentAssignment.centre_code %>)
                    <% } %>

                </div>

            <% } else { %>

                <div style="margin-top:10px;padding:10px 12px;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;font-size:13px;color:#9a3412;">

                    This school does not currently have an examination-centre assignment for
                    <strong><%= activeExam.exam_year %></strong>.

                    Selecting a centre will create the assignment.

                </div>

            <% } %>

            <div style="margin-top:12px;padding:11px 13px;background:#fff;border-left:4px solid #2563eb;border-radius:6px;color:#334155;font-size:13px;line-height:1.6;">

                <strong>Important:</strong>
                Changing this centre moves the school's RTSE examination-centre
                assignment for <%= activeExam.exam_year %>.
                Student application records, roll numbers, school information,
                and uploaded documents will remain unchanged.

            </div>

        </div>

        <% } %>

        <div style="margin-top:16px;">
            <label style="display:block;font-weight:600;margin-bottom:6px;">
                Remarks
            </label>

            <textarea
                name="remarks"
                rows="3"
                style="width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:8px;"
            ><%= school.remarks || '' %></textarea>
        </div>

        <div style="display:flex;gap:10px;margin-top:22px;flex-wrap:wrap;">

            <button
                type="submit"
                style="background:#2563eb;color:#fff;border:0;padding:12px 20px;border-radius:8px;font-weight:600;">
                <%= isEdit ? "Update School" : "Register School" %>
            </button>

            <a
                href="/admin/arsp/schools"
                style="padding:12px 20px;border:1px solid #d1d5db;border-radius:8px;text-decoration:none;color:#374151;">
                Cancel
            </a>

        </div>

    </form>

</div>

    </main>
</div>

<%- include("../../partials/footer") %>
