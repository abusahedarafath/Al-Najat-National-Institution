<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">
                <h1>
                    <%= isEdit ? "Edit ARSP Member" : "Register ARSP Member" %>
                </h1>
            </div>

            <div class="card">

                <form
                    action="<%= isEdit ? '/admin/arsp/member/' + member.id + '/edit' : '/admin/arsp/register' %>"
                    method="POST"
                    enctype="multipart/form-data"
                    class="admin-form">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input
                            type="text"
                            name="full_name"
                            value="<%= isEdit ? member.full_name : '' %>"
                            required>
                    </div>

                    <div class="form-group">
                        <label>Father's Name</label>
                        <input
                            type="text"
                            name="father_name"
                            value="<%= isEdit ? member.father_name : '' %>">
                    </div>

                    <div class="form-group">
                        <label>Mother's Name</label>
                        <input
                            type="text"
                            name="mother_name"
                            value="<%= isEdit ? member.mother_name : '' %>">
                    </div>

                    <div class="form-group">
                        <label>Gender</label>

                        <select name="gender">

                            <option
                                value="Male"
                                <%= isEdit && member.gender==="Male" ? "selected" : "" %>>
                                Male
                            </option>

                            <option
                                value="Female"
                                <%= isEdit && member.gender==="Female" ? "selected" : "" %>>
                                Female
                            </option>

                            <option
                                value="Other"
                                <%= isEdit && member.gender==="Other" ? "selected" : "" %>>
                                Other
                            </option>

                        </select>

                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>

                        <input
                            type="date"
                            name="dob"
                            value="<%= isEdit && member.dob ? member.dob.toISOString().split('T')[0] : '' %>">
                    </div>

                    <div class="form-group">

                        <label>Blood Group</label>

                        <select name="blood_group">

                            <% const groups=['A+','A-','B+','B-','AB+','AB-','O+','O-']; %>

                            <% groups.forEach(group=>{ %>

                            <option
                                value="<%= group %>"
                                <%= isEdit && member.blood_group===group ? "selected" : "" %>>

                                <%= group %>

                            </option>

                            <% }) %>

                        </select>

                    </div>





<h3 style="margin-top:30px;margin-bottom:15px;">
    Contact Information
</h3>

<div class="form-group">
    <label>Mobile Number</label>
    <input
        type="tel"
        name="mobile"
        value="<%= isEdit ? (member.mobile || '') : '' %>"
        inputmode="numeric"
        autocomplete="tel"
        maxlength="20"
        required>
</div>

<div class="form-group">
    <label>Email Address</label>
    <input
        type="email"
        name="email"
        value="<%= isEdit ? (member.email || '') : '' %>"
        autocomplete="email">
</div>

<div class="form-group">
    <label>Address</label>
    <textarea
        name="address"
        rows="3"
        autocomplete="street-address"><%= isEdit ? (member.address || '') : '' %></textarea>
</div>


<h3 style="margin-top:30px;margin-bottom:15px;">
    Professional Information
</h3>

<div class="form-group">

    <label>Occupation</label>

    <input
        type="text"
        name="occupation"
        value="<%= isEdit ? member.occupation : '' %>">

</div>

<div class="form-group">

    <label>Nationality</label>

    <input
        type="text"
        name="nationality"
        value="<%= isEdit ? member.nationality : 'Indian' %>">

</div>





<h3 style="margin-top:30px;margin-bottom:15px;">
    Identity Verification
</h3>

<div class="form-group">

    <label>Identity Proof</label>

    <select name="identity_type">
    <option
        value=""
        <%= !isEdit || !member.identity_type ? "selected" : "" %>>
        Select Identity Proof
    </option>

    <option
        value="Aadhaar"
        <%= isEdit && member.identity_type === "Aadhaar" ? "selected" : "" %>>
        Aadhaar Card
    </option>

    <option
        value="PAN"
        <%= isEdit && member.identity_type === "PAN" ? "selected" : "" %>>
        PAN Card
    </option>

    <option
        value="Voter ID"
        <%= isEdit && member.identity_type === "Voter ID" ? "selected" : "" %>>
        Voter ID
    </option>

    <option
        value="Passport"
        <%= isEdit && member.identity_type === "Passport" ? "selected" : "" %>>
        Passport
    </option>

    <option
        value="Driving Licence"
        <%= isEdit && member.identity_type === "Driving Licence" ? "selected" : "" %>>
        Driving Licence
    </option>

    <option
        value="Bank Passbook"
        <%= isEdit && member.identity_type === "Bank Passbook" ? "selected" : "" %>>
        Bank Passbook
    </option>
</select>

</div>

<div class="form-group">

    <label>Identity Number</label>

    <input
        type="text"
        name="identity_number"
        value="<%= isEdit ? member.identity_number : '' %>">

</div>

<div class="form-group">

    <label>Identity Front</label>

    <% if (isEdit && member.identity_front) { %>
        <div style="margin-bottom:10px;">
            <a
                href="/uploads/arsp-members/<%= member.identity_front %>"
                target="_blank"
                rel="noopener">
                View Existing Identity Front
            </a>
        </div>
    <% } %>

    <input
        type="file"
        name="identity_front"
        accept="image/*,.pdf">

</div>

<div class="form-group">

    <label>Identity Back</label>

    <% if (isEdit && member.identity_back) { %>
        <div style="margin-bottom:10px;">
            <a
                href="/uploads/arsp-members/<%= member.identity_back %>"
                target="_blank"
                rel="noopener">
                View Existing Identity Back
            </a>
        </div>
    <% } %>

    <input
        type="file"
        name="identity_back"
        accept="image/*,.pdf">

</div>






<h3 style="margin-top:30px;margin-bottom:15px;">
    Emergency Contact
</h3>

<div class="form-group">

    <label>Emergency Contact Name</label>

    <input
        type="text"
        name="emergency_contact_name"
        value="<%= isEdit ? member.emergency_contact_name : '' %>">

</div>

<div class="form-group">

    <label>Relationship</label>

    <input
        type="text"
        name="emergency_contact_relation"
        value="<%= isEdit ? member.emergency_contact_relation : '' %>">

</div>

<div class="form-group">

    <label>Emergency Mobile Number</label>

    <input
        type="text"
        name="emergency_contact_mobile"
        value="<%= isEdit ? member.emergency_contact_mobile : '' %>">

</div>





<div class="form-group">

    <label>District</label>

    <input
        type="text"
        name="district"
        value="<%= isEdit ? member.district : '' %>">

</div>

<div class="form-group">

    <label>State</label>

    <input
        type="text"
        name="state"
        value="<%= isEdit ? member.state : 'Assam' %>">

</div>

<div class="form-group">

    <label>Pincode</label>

    <input
        type="text"
        name="pincode"
        value="<%= isEdit ? member.pincode : '' %>">

</div>

<div class="form-group">

    <label>Joining Date</label>

    <input
        type="date"
        name="joining_date"
        value="<%= isEdit && member.joining_date ? member.joining_date.toISOString().split('T')[0] : '' %>">

</div>

<div class="form-group">

    <label>
        Passport Size Photograph
        <span style="color:#dc3545;">*</span>
    </label>

    <% if (isEdit && member.photo) { %>

        <div
            style="
                margin-bottom:12px;
                padding:12px;
                background:#f8f9fa;
                border:1px solid #ddd;
                border-radius:10px;
            "
        >

            <div
                style="
                    font-size:13px;
                    color:#666;
                    margin-bottom:8px;
                "
            >
                Current Photograph
            </div>

            <img
                src="/uploads/arsp-members/<%= member.photo %>"
                alt="Current member photograph"
                style="
                    width:120px;
                    height:150px;
                    object-fit:cover;
                    border-radius:8px;
                    border:1px solid #ddd;
                "
            >

        </div>

    <% } %>

    <input
        type="file"
        name="photo"
        id="adminMemberPhoto"
        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
        <%= !isEdit ? "required" : "" %>
    >

    <div
        id="adminMemberPhotoCropArea"
        style="
            display:none;
            margin-top:18px;
            padding:15px;
            background:#f8f9fa;
            border:1px solid #ddd;
            border-radius:10px;
        "
    >

        <div
            style="
                width:100%;
                max-width:400px;
                margin:0 auto;
                aspect-ratio:4 / 5;
                overflow:hidden;
                background:#222;
                border-radius:8px;
            "
        >

            <img
                id="adminMemberPhotoCropImage"
                alt="Photo crop preview"
                style="
                    display:block;
                    max-width:100%;
                "
            >

        </div>

        <div
            style="
                margin-top:12px;
                text-align:center;
                color:#555;
                font-size:14px;
                line-height:1.6;
            "
        >
            <strong>Position the face inside the frame.</strong>
            <br>
            Move and zoom the photograph as required.
        </div>

        <div
            style="
                display:flex;
                gap:10px;
                justify-content:center;
                flex-wrap:wrap;
                margin-top:15px;
            "
        >

            <button
                type="button"
                id="adminMemberPhotoZoomOut"
                class="btn-submit"
            >
                − Zoom
            </button>

            <button
                type="button"
                id="adminMemberPhotoZoomIn"
                class="btn-submit"
            >
                + Zoom
            </button>

            <button
                type="button"
                id="adminMemberPhotoReset"
                class="btn-submit"
            >
                Reset
            </button>

            <button
                type="button"
                id="adminMemberPhotoApply"
                class="btn-submit"
            >
                Use This Photo
            </button>

        </div>

    </div>

    <img
        id="adminMemberPhotoPreview"
        alt="Prepared passport-size photograph"
        style="
            display:none;
            margin-top:15px;
            width:120px;
            height:150px;
            object-fit:cover;
            border-radius:8px;
            border:1px solid #ddd;
        "
    >

    <% if (isEdit) { %>

        <div
            style="
                margin-top:8px;
                font-size:13px;
                color:#777;
            "
        >
            Leave this field empty to keep the current photograph.
        </div>

    <% } %>

</div>

<div class="form-group">

    <label>Status</label>

    <select name="status">

        <option
            value="Active"
            <%= isEdit && member.status==="Active" ? "selected" : "" %>>
            Active
        </option>

        <option
            value="Inactive"
            <%= isEdit && member.status==="Inactive" ? "selected" : "" %>>
            Inactive
        </option>

    </select>

</div>

<div class="form-actions">

    <button
        type="submit"
        class="btn-save">

        <%= isEdit ? "Update Member" : "Register Member" %>

    </button>

    <a
        href="/admin/arsp/members"
        class="btn-cancel"
        style="text-decoration:none;padding:10px 20px;display:inline-block;">

        Cancel

    </a>

</div>

</form>

</div>

</main>

</div>


<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
>

<script
    src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js">
</script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const photoInput =
        document.getElementById("adminMemberPhoto");

    const cropArea =
        document.getElementById("adminMemberPhotoCropArea");

    const cropImage =
        document.getElementById("adminMemberPhotoCropImage");

    const preview =
        document.getElementById("adminMemberPhotoPreview");

    const zoomIn =
        document.getElementById("adminMemberPhotoZoomIn");

    const zoomOut =
        document.getElementById("adminMemberPhotoZoomOut");

    const resetButton =
        document.getElementById("adminMemberPhotoReset");

    const applyButton =
        document.getElementById("adminMemberPhotoApply");

    const form =
        photoInput?.closest("form");

    if (
        !photoInput ||
        !cropArea ||
        !cropImage ||
        !preview ||
        !form ||
        typeof Cropper === "undefined"
    ) {
        return;
    }

    let cropper = null;
    let selectedObjectUrl = null;
    let preparedPhoto = false;

    photoInput.addEventListener("change", function () {

        const file =
            this.files && this.files[0];

        preparedPhoto = false;

        if (!file) {
            return;
        }

        if (
            !file.type ||
            !file.type.startsWith("image/")
        ) {

            alert("Please select a valid image.");

            this.value = "";

            return;
        }

        if (selectedObjectUrl) {
            URL.revokeObjectURL(selectedObjectUrl);
        }

        selectedObjectUrl =
            URL.createObjectURL(file);

        cropImage.onload = function () {

            if (cropper) {
                cropper.destroy();
            }

            cropper = new Cropper(
                cropImage,
                {
                    aspectRatio: 4 / 5,
                    viewMode: 1,
                    dragMode: "move",
                    autoCropArea: 0.85,
                    responsive: true,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    background: false,
                    movable: true,
                    zoomable: true,
                    rotatable: false,
                    scalable: false
                }
            );

            cropArea.style.display = "block";
            preview.style.display = "none";
        };

        cropImage.src = selectedObjectUrl;
    });

    zoomIn.addEventListener("click", function () {

        if (cropper) {
            cropper.zoom(0.1);
        }

    });

    zoomOut.addEventListener("click", function () {

        if (cropper) {
            cropper.zoom(-0.1);
        }

    });

    resetButton.addEventListener("click", function () {

        if (cropper) {
            cropper.reset();
        }

    });

    applyButton.addEventListener("click", function () {

        if (!cropper) {

            alert(
                "Please select a photograph first."
            );

            return;
        }

        const canvas =
            cropper.getCroppedCanvas({
                width: 400,
                height: 500,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: "high"
            });

        if (!canvas) {

            alert(
                "Unable to prepare the photograph."
            );

            return;
        }

        canvas.toBlob(
            function (blob) {

                if (!blob) {

                    alert(
                        "Unable to prepare the photograph."
                    );

                    return;
                }

                const croppedFile =
                    new File(
                        [blob],
                        "member-photo.jpg",
                        {
                            type: "image/jpeg",
                            lastModified: Date.now()
                        }
                    );

                const dataTransfer =
                    new DataTransfer();

                dataTransfer.items.add(
                    croppedFile
                );

                photoInput.files =
                    dataTransfer.files;

                const previewUrl =
                    URL.createObjectURL(blob);

                preview.src = previewUrl;
                preview.style.display = "block";

                preview.onload = function () {
                    URL.revokeObjectURL(previewUrl);
                };

                cropArea.style.display = "none";

                preparedPhoto = true;

                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }

                if (selectedObjectUrl) {
                    URL.revokeObjectURL(
                        selectedObjectUrl
                    );
                    selectedObjectUrl = null;
                }

            },
            "image/jpeg",
            0.88
        );

    });

    form.addEventListener("submit", function (event) {

        const file =
            photoInput.files &&
            photoInput.files[0];

        <% if (!isEdit) { %>

        if (!file || !preparedPhoto) {

            event.preventDefault();

            alert(
                "Please select, position and prepare the passport-size photograph before submitting."
            );

            return;
        }

        <% } %>

        <% if (isEdit) { %>

        if (file && !preparedPhoto) {

            event.preventDefault();

            alert(
                "Please position the new photograph and click \"Use This Photo\" before updating."
            );

            return;
        }

        <% } %>

    });

});

</script>


<%- include("../partials/footer") %>
