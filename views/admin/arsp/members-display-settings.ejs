<%- include("../partials/header") %>

<div class="admin-layout">
    <%- include("../partials/sidebar") %>

    <main class="admin-content">
        <div class="container arsp-display-page">

            <% if (success && success.length) { %>
                <div class="alert alert-success"><%= success[0] %></div>
            <% } %>

            <% if (error && error.length) { %>
                <div class="alert alert-danger"><%= error[0] %></div>
            <% } %>

            <div class="page-header">
                <div>
                    <h1>Homepage Members Display</h1>
                    <p>Control how ARSP leadership and appointed members appear on the public homepage.</p>
                </div>
                <a href="/admin/arsp" class="btn-save">Back to Dashboard</a>
            </div>

            <form action="/admin/arsp/members-display-settings" method="POST" data-history-fix="off">

                <section class="display-panel">
                    <div class="display-panel-heading">
                        <div>
                            <h2>Section Visibility</h2>
                            <p>Enable or disable the complete ARSP Members section on the homepage.</p>
                        </div>
                        <label class="display-switch">
                            <input
                                type="checkbox"
                                name="is_enabled"
                                <%= Number(settings.is_enabled) === 1 ? "checked" : "" %>>
                            <span class="display-switch-slider"></span>
                            <span class="display-switch-label">Show on Homepage</span>
                        </label>
                    </div>
                </section>

                <section class="display-panel">
                    <div class="display-section-heading">
                        <h2>Choose Display Design</h2>
                        <p>Select one of the four presentation styles.</p>
                    </div>

                    <div class="display-design-grid">

                        <label class="display-design-card">
                            <input type="radio" name="design_key" value="carousel"
                                <%= settings.design_key === "carousel" ? "checked" : "" %> required>
                            <div class="design-preview design-preview-carousel">
                                <div class="preview-title">ARSP MEMBERS</div>
                                <div class="preview-circles">
                                    <span><i></i><b></b></span>
                                    <span><i></i><b></b></span>
                                    <span><i></i><b></b></span>
                                    <span><i></i><b></b></span>
                                    <span><i></i><b></b></span>
                                </div>
                                <div class="preview-line"></div>
                            </div>
                            <div class="design-card-info">
                                <strong>1. Circular Portrait Carousel</strong>
                                <small>Horizontal auto-scrolling circular member portraits.</small>
                            </div>
                        </label>

                        <label class="display-design-card">
                            <input type="radio" name="design_key" value="compact_grid"
                                <%= settings.design_key === "compact_grid" ? "checked" : "" %>>
                            <div class="design-preview design-preview-grid">
                                <div class="preview-title">OUR MEMBERS</div>
                                <div class="preview-grid-items">
                                    <% for (let i = 0; i < 6; i++) { %><i></i><% } %>
                                </div>
                                <div class="preview-more">SEE ALL MEMBERS +</div>
                            </div>
                            <div class="design-card-info">
                                <strong>2. Expandable Member Grid</strong>
                                <small>Two initial rows with See All and Show Less controls.</small>
                            </div>
                        </label>

                        <label class="display-design-card">
                            <input type="radio" name="design_key" value="profile_cards"
                                <%= settings.design_key === "profile_cards" ? "checked" : "" %>>
                            <div class="design-preview design-preview-profiles">
                                <div class="preview-title">OUR LEADERSHIP</div>
                                <div class="preview-profile-items">
                                    <% for (let i = 0; i < 3; i++) { %>
                                        <span><i></i><b></b><small></small></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="design-card-info">
                                <strong>3. Premium Profile Cards</strong>
                                <small>Rectangular portrait cards in a responsive grid.</small>
                            </div>
                        </label>

                        <label class="display-design-card">
                            <input type="radio" name="design_key" value="hierarchy"
                                <%= settings.design_key === "hierarchy" ? "checked" : "" %>>
                            <div class="design-preview design-preview-hierarchy">
                                <div class="preview-title">ORGANISATIONAL STRUCTURE</div>
                                <div class="hierarchy-top"></div>
                                <div class="hierarchy-connector"></div>
                                <div class="hierarchy-branches">
                                    <i></i><i></i><i></i>
                                </div>
                                <div class="hierarchy-bottom">
                                    <% for (let i = 0; i < 4; i++) { %><i></i><% } %>
                                </div>
                            </div>
                            <div class="design-card-info">
                                <strong>4. Organisational Hierarchy</strong>
                                <small>Formal organisational structure by designation and section.</small>
                            </div>
                        </label>

                    </div>
                </section>

                <section class="display-panel">
                    <div class="display-section-heading">
                        <h2>Manage Homepage Members</h2>
                        <p>
                            All active appointed members are listed below. Hiding a member affects
                            homepage display only; it does not remove their appointment or membership.
                        </p>
                    </div>

                    <% if (members && members.length) { %>
                        <div class="member-display-list">
                            <% members.forEach((member, index) => { %>
                                <div class="member-display-row">
                                    <div class="member-display-identity">
                                        <% if (member.photo) { %>
                                            <img
                                                src="/uploads/arsp-members/<%= member.photo %>"
                                                alt="<%= member.full_name %>"
                                                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                                            <span class="member-display-placeholder" style="display:none;">
                                                <i class="fas fa-user"></i>
                                            </span>
                                        <% } else { %>
                                            <span class="member-display-placeholder">
                                                <i class="fas fa-user"></i>
                                            </span>
                                        <% } %>

                                        <div>
                                            <strong><%= member.full_name %></strong>
                                            <span><%= member.designation %></span>
                                            <small><%= member.section %></small>
                                        </div>
                                    </div>

                                    <div class="member-display-controls">
                                        <label class="member-order-control">
                                            <span>Order</span>
                                            <input
                                                type="number"
                                                name="order_<%= member.id %>"
                                                min="1"
                                                step="1"
                                                value="<%= member.display_order %>">
                                        </label>

                                        <label class="member-visible-control">
                                            <input
                                                type="checkbox"
                                                name="visible_<%= member.id %>"
                                                <%= Number(member.is_visible) === 1 ? "checked" : "" %>>
                                            <span>Show</span>
                                        </label>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="display-empty">
                            No active appointed members are currently available.
                        </div>
                    <% } %>
                </section>

                <div class="display-save-bar">
                    <a href="/admin/arsp" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save"></i> Save Display Settings
                    </button>
                </div>

            </form>
        </div>
    </main>
</div>

<style>
.arsp-display-page { max-width: 1250px; margin: 0 auto; padding-bottom: 40px; }
.arsp-display-page .display-panel {
    background: #fff; border: 1px solid #e6eaf0; border-radius: 15px;
    padding: 24px; margin-bottom: 22px;
    box-shadow: 0 5px 20px rgba(20,35,60,.045);
}
.arsp-display-page .display-panel-heading,
.arsp-display-page .display-save-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
}
.arsp-display-page h2 { font-size: 19px; font-weight: 750; color: #172b4d; margin: 0 0 7px; }
.arsp-display-page p { color: #718096; margin: 0; line-height: 1.6; }
.display-section-heading { margin-bottom: 22px; }
.display-design-grid {
    display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px;
}
.display-design-card {
    display: block; border: 2px solid #e6eaf0; border-radius: 13px;
    padding: 12px; cursor: pointer; transition: .2s; min-width: 0;
}
.display-design-card:has(input:checked) {
    border-color: #c49a42; background: #fffcf4;
    box-shadow: 0 0 0 3px rgba(196,154,66,.12);
}
.display-design-card > input { accent-color: #b58a32; margin: 3px 6px 10px 2px; }
.design-preview {
    height: 145px; border-radius: 9px; padding: 13px;
    overflow: hidden; background: #f3f6fa; border: 1px solid #e5eaf0;
}
.preview-title {
    text-align: center; font-size: 10px; font-weight: 850;
    letter-spacing: 1.4px; color: #233957; margin-bottom: 15px;
}
.preview-circles { display: flex; justify-content: space-around; gap: 7px; }
.preview-circles span { text-align: center; display: grid; justify-items: center; gap: 5px; }
.preview-circles i {
    display: block; width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(140deg,#d5dce6,#aebbd0); border: 2px solid #c49a42;
}
.preview-circles b { width: 29px; height: 3px; background: #aab5c5; border-radius: 5px; }
.preview-line { height: 3px; width: 65%; margin: 10px auto; background: #c49a42; }
.preview-grid-items { display: grid; grid-template-columns: repeat(3,1fr); gap: 7px; }
.preview-grid-items i { height: 29px; background: #dce4ef; border-radius: 5px; border-bottom: 3px solid #c49a42; }
.preview-more { text-align: center; color: #9b762e; font-size: 9px; font-weight: 800; margin-top: 9px; }
.preview-profile-items { display: flex; justify-content: center; gap: 12px; }
.preview-profile-items span {
    width: 65px; height: 83px; padding: 6px; background: #fff;
    border: 1px solid #dce2eb; border-radius: 5px; display: flex;
    flex-direction: column; align-items: center; gap: 5px;
}
.preview-profile-items i { width: 37px; height: 43px; background: #cbd5e3; border-radius: 4px; }
.preview-profile-items b { width: 80%; height: 4px; background: #b6c2d2; }
.preview-profile-items small { width: 55%; height: 3px; background: #d5b76f; }
.preview-hierarchy { background: #f8f7f2; }
.hierarchy-top { width: 75px; height: 16px; margin: 0 auto; border-radius: 3px; background: #c6a45a; }
.hierarchy-connector { height: 16px; width: 2px; margin: auto; background: #9daabe; }
.hierarchy-branches { display: flex; justify-content: space-around; }
.hierarchy-branches i { width: 48px; height: 13px; background: #d6dfeb; border-radius: 3px; }
.hierarchy-bottom { display: flex; justify-content: space-around; margin-top: 8px; }
.hierarchy-bottom i { width: 30px; height: 14px; background: #e8d9b5; border-radius: 3px; }
.design-card-info { padding: 13px 4px 3px; display: grid; gap: 5px; }
.design-card-info strong { color: #203653; font-size: 14px; }
.design-card-info small { color: #718096; line-height: 1.5; }
.display-switch { display: flex; align-items: center; gap: 10px; cursor: pointer; flex-wrap: wrap; }
.display-switch input { width: 19px; height: 19px; accent-color: #b58a32; }
.display-switch-label { font-weight: 700; color: #263b58; }
.member-display-list { display: grid; gap: 10px; }
.member-display-row {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 13px; border: 1px solid #e9edf3; border-radius: 10px;
}
.member-display-identity { display: flex; align-items: center; gap: 13px; min-width: 0; }
.member-display-identity img, .member-display-placeholder {
    width: 57px; height: 57px; border-radius: 9px; object-fit: cover;
    border: 1px solid #e0e5ec; flex-shrink: 0;
}
.member-display-placeholder {
    display: flex; align-items: center; justify-content: center;
    background: #edf1f6; color: #8190a5; font-size: 20px;
}
.member-display-identity div { display: grid; gap: 3px; min-width: 0; }
.member-display-identity strong { color: #203653; overflow-wrap: anywhere; }
.member-display-identity span { color: #566981; font-size: 13px; }
.member-display-identity small { color: #9a7a3a; font-size: 11px; }
.member-display-controls { display: flex; align-items: center; gap: 18px; flex-shrink: 0; }
.member-order-control { display: grid; gap: 4px; color: #68788e; font-size: 11px; font-weight: 700; }
.member-order-control input {
    width: 75px; padding: 7px; border: 1px solid #dce3ec;
    border-radius: 6px; color: #263b58;
}
.member-visible-control { display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px; font-weight: 700; color: #334967; }
.member-visible-control input { width: 17px; height: 17px; accent-color: #b58a32; }
.display-empty { padding: 30px; text-align: center; background: #f6f8fb; border-radius: 9px; color: #718096; }
.display-save-bar { justify-content: flex-end; margin-top: 22px; }
.display-save-bar .btn-save, .display-save-bar .btn-cancel {
    padding: 12px 20px; border-radius: 8px; text-decoration: none;
    font-weight: 700; display: inline-flex; align-items: center; gap: 8px;
}
.display-save-bar .btn-cancel { background: #edf1f6; color: #45566d; }
.display-save-bar .btn-save { border: 0; background: #17365d; color: white; cursor: pointer; }
.display-save-bar .btn-save:hover { background: #244b78; }
@media(max-width:700px) {
    .display-design-grid { grid-template-columns: 1fr; }
    .arsp-display-page .display-panel { padding: 16px; }
    .arsp-display-page .display-panel-heading { align-items: flex-start; flex-direction: column; }
    .member-display-row { align-items: flex-start; flex-direction: column; }
    .member-display-controls { width: 100%; justify-content: flex-end; }
    .display-save-bar { flex-wrap: wrap; }
}
</style>

<%- include("../partials/footer") %>
