<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Principal's Message</h1>

                    <p>Manage Principal's Message.</p>

                </div>

                <a
                    href="/admin/principal-message/add"
                    class="btn btn-primary">

                    + Add Principal Message

                </a>

            </div>

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% if(messages && messages.length){ %>

                        <% messages.forEach(message=>{ %>

                            <tr>

                                <td><%= message.id %></td>

                                <td><%= message.name %></td>

                                <td><%= message.designation %></td>

                                <td>

                                    <% if(message.status==="Active"){ %>

                                        <span class="badge badge-success">
                                            Active
                                        </span>

                                    <% }else{ %>

                                        <span class="badge badge-danger">
                                            Inactive
                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/admin/principal-message/<%= message.id %>/edit"
                                            class="btn btn-success">

                                            Edit

                                        </a>

                                        <form
                                            action="/admin/principal-message/<%= message.id %>/delete"
                                            method="POST"
                                            style="display:inline;">

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                                onclick="return confirm('Delete this message?')">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="5" style="text-align:center;">

                                No Principal Message Found.

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
