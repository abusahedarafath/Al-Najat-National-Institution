<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>Website Management</h1>

            </div>

            <div class="dashboard-grid">

                <div class="card">

                    <h2>🖼 Hero Sliders</h2>

                    <p>Manage homepage banners and hero sliders.</p>

                    <a
                        href="/admin/sliders"
                        class="btn btn-primary">
                        Manage Sliders
                    </a>

                </div>

                <div class="card">

                    <h2>📰 News & Events</h2>

                    <p>Create, edit and publish news and events.</p>

                    <a
                        href="/admin/news"
                        class="btn btn-primary">
                        Manage News
                    </a>

                </div>

                <div class="card">

                    <h2>📢 Notices</h2>

                    <p>Publish notices for students and staff.</p>

                    <a
                        href="/admin/notices"
                        class="btn btn-primary">
                        Manage Notices
                    </a>

                </div>

                <div class="card">

                    <h2>🖼 Gallery</h2>

                    <p>Manage albums and gallery images.</p>

                    <a
                        href="/admin/gallery"
                        class="btn btn-primary">
                        Manage Gallery
                    </a>

                </div>

                <div class="card">

                    <h2>📄 Website Pages</h2>

                    <p>Edit About, Contact and other website pages.</p>

                    <a
                        href="/admin/pages"
                        class="btn btn-primary">
                        Manage Pages
                    </a>

                </div>

                <div class="card">

                    <h2>📥 Downloads</h2>

                    <p>Upload and manage downloadable documents.</p>

                    <a
                        href="/admin/downloads"
                        class="btn btn-primary">
                        Manage Downloads
                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
