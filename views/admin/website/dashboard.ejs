<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Management</title>

    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="admin-layout">

    <%- include("../../partials/admin-sidebar") %>

    <main class="admin-content">

        <div class="container">

            <h1>🌐 Website Management</h1>

            <div class="dashboard-grid">

                <div class="card">
                    <h2>🖼 Hero Sliders</h2>
                    <p>Manage homepage slider.</p>
                    <a href="/admin/sliders">Open</a>
                </div>

                <div class="card">
                    <h2>📰 News & Events</h2>
                    <p>Manage news and events.</p>
                </div>

                <div class="card">
                    <h2>📢 Notices</h2>
                    <p>Manage notices.</p>
                </div>

                <div class="card">
                    <h2>🖼 Gallery</h2>
                    <p>Manage gallery.</p>
                </div>

                <div class="card">
                    <h2>📄 Website Pages</h2>
                    <p>Edit About, Contact and other pages.</p>
                </div>

                <div class="card">
                    <h2>📥 Downloads</h2>
                    <p>Manage downloadable files.</p>
                </div>

            </div>

        </div>

    </main>

</div>

</body>
</html>
