<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="admin-dashboard">

    <div class="container">

        <div class="page-header">
            <h2>Edit Application</h2>
        </div>

        <form action="/admin/application/<%= application.id %>/edit" method="POST" class="admin-form">

            <div class="form-group">
                <label for="full_name">Full Name</label>
                <input
                    type="text"
                    id="full_name"
                    name="full_name"
                    value="<%= application.full_name %>"
                    required>
            </div>

            <div class="form-group">
                <label for="father_name">Father's Name</label>
                <input
                    type="text"
                    id="father_name"
                    name="father_name"
                    value="<%= application.father_name %>">
            </div>

            <div class="form-group">
                <label for="mother_name">Mother's Name</label>
                <input
                    type="text"
                    id="mother_name"
                    name="mother_name"
                    value="<%= application.mother_name %>">
            </div>

            <div class="form-group">
                <label for="dob">Date of Birth</label>
                <input
                    type="date"
                    id="dob"
                    name="dob"
                    value="<%= application.dob %>">
            </div>

            <div class="form-group">
                <label for="gender">Gender</label>

                <select id="gender" name="gender">

                    <option value="Male" <%= application.gender === "Male" ? "selected" : "" %>>
                        Male
                    </option>

                    <option value="Female" <%= application.gender === "Female" ? "selected" : "" %>>
                        Female
                    </option>

                    <option value="Other" <%= application.gender === "Other" ? "selected" : "" %>>
                        Other
                    </option>

                </select>

            </div>

            <div class="form-group">
                <label for="mobile">Mobile Number</label>
                <input
                    type="text"
                    id="mobile"
                    name="mobile"
                    value="<%= application.mobile %>">
            </div>

            <div class="form-group">
                <label for="email">Email Address</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= application.email %>">
            </div>

            <div class="form-group">
                <label for="address">Address</label>
                <textarea
                    id="address"
                    name="address"
                    rows="4"><%= application.address %></textarea>
            </div>

            <div class="form-group">
                <label for="course">Course</label>
                <input
                    type="text"
                    id="course"
                    name="course"
                    value="<%= application.course %>">
            </div>

            <div class="form-group">
                <label for="previous_school">Previous School</label>
                <input
                    type="text"
                    id="previous_school"
                    name="previous_school"
                    value="<%= application.previous_school %>">
            </div>

            <div class="form-group">
                <label for="pen_no">PEN Number</label>
                <input
                    type="text"
                    id="pen_no"
                    name="pen_no"
                    value="<%= application.pen_no %>">
            </div>

            <div class="form-group">
                <label for="apaar_id">APAAR ID</label>
                <input
                    type="text"
                    id="apaar_id"
                    name="apaar_id"
                    value="<%= application.apaar_id %>">
            </div>

            <div class="form-group">
                <label for="siksha_setu_id">Siksha Setu ID</label>
                <input
                    type="text"
                    id="siksha_setu_id"
                    name="siksha_setu_id"
                    value="<%= application.siksha_setu_id %>">
            </div>

            <div class="action-buttons">

                <button type="submit" class="btn btn-success">
                    Save Changes
                </button>

                <a href="/admin/application/<%= application.id %>" class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</section>

<%- include('../partials/footer') %>
