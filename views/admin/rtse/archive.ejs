<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>RTSE Application Archive</h1>

                <a
                    href="/admin/rtse"
                    class="btn-cancel">

                    ← Back to Dashboard

                </a>

            </div>

            <% if(applications.length===0){ %>

                <div class="profile-card">

                    <h3>No Archived Applications</h3>

                    <p>
                        There are no archived RTSE applications.
                    </p>

                </div>

            <% }else{ %>

            <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">
        <div>
            <h2 style="margin:0;">Search Archived Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>

        <div style="flex:1;min-width:220px;max-width:500px;position:relative;">
            <i class="fas fa-search"
               style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#777;"></i>

            <input
                type="search"
                id="rtseArchiveSearch"
                placeholder="Search archived applicant..."
                autocomplete="off"
                style="width:100%;padding:12px 15px 12px 42px;border:1px solid #ddd;border-radius:10px;font-size:14px;outline:none;"
            >
        </div>
    </div>

    <div id="rtseArchiveSearchResult"
         style="margin-top:10px;font-size:13px;color:#666;">
    </div>
</div>

<table class="admin-table" id="rtseArchiveTable">

                <thead>

                    <tr>

                        <th>Reg. No.</th>

                        <th>Photo</th>

                        <th>Name</th>

                        <th>School</th>

                        <th>Class</th>

                        <th>Section</th>

                        <th>Archived On</th>

                        <th width="330">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                <% applications.forEach(application=>{ %>

                    <tr>

                        <td>

                            <strong>

                                <%= application.registration_no %>

                            </strong>

                        </td>

                        <td>

                            <img

                                src="/uploads/rtse/<%= application.photo %>"

                                style="width:55px;height:55px;border-radius:50%;object-fit:cover;">

                        </td>

                        <td>

                            <%= application.full_name %>

                        </td>

                        <td>

                            <%= application.school_name %>

                        </td>

                        <td>

                            <%= application.class %>

                        </td>

                        <td>

                            <%= application.section %>

                        </td>

                        <td>

                            <%= application.archived_at %>

                        </td>

                        <td>

                            <a

                                href="/admin/rtse/application/<%= application.id %>"

                                class="btn-view">

                                View

                            </a>

                            <form

                                action="/admin/rtse/application/<%= application.id %>/restore"

                                method="POST"

                                style="display:inline;">

                                <button

                                    type="submit"

                                    class="btn-save"

                                    onclick="return confirm('Restore this application?')">

                                    Restore

                                </button>

                            </form>

                            <form

                                action="/admin/rtse/application/<%= application.id %>/delete"

                                method="POST"

                                style="display:inline;">

                                <button

                                    type="submit"

                                    class="btn-danger"

                                    onclick="return confirm('This will permanently delete the application from the database. Continue?')">

                                    Delete Permanently

                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

            <% } %>

        </div>

    </main>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById("rtseArchiveSearch");
    const resultText = document.getElementById("rtseArchiveSearchResult");
    const table = document.getElementById("rtseArchiveTable");

    if (!searchInput || !table) return;

    const rows = Array.from(
        table.querySelectorAll("tbody tr")
    );

    function filterArchivedApplications() {

        const query = searchInput.value.trim().toLowerCase();

        let visible = 0;

        rows.forEach(row => {

            const text = row.textContent
                .toLowerCase()
                .replace(/\s+/g, " ");

            const match = !query || text.includes(query);

            row.style.display = match ? "" : "none";

            if (match) visible++;
        });

        if (!query) {
            resultText.textContent = "";
        } else {
            resultText.textContent =
                visible +
                (visible === 1
                    ? " application found."
                    : " applications found.");
        }
    }

    searchInput.addEventListener(
        "input",
        filterArchivedApplications
    );

});
</script>

<%- include("../partials/footer") %>
