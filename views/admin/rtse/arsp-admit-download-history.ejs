<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">


<style>
    .arsp-history-page {
        padding: 24px;
        max-width: 1800px;
        margin: 0 auto;
    }

    .arsp-history-header {
        margin-bottom: 20px;
    }

    .arsp-history-header h1 {
        margin: 0;
        font-size: 25px;
        color: #111827;
    }

    .arsp-history-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .arsp-history-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .arsp-history-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #374151;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

    .arsp-history-stat {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 17px;
        box-shadow: 0 3px 12px rgba(0,0,0,.04);
        margin-bottom: 20px;
    }

    .arsp-history-stat-label {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .arsp-history-stat-value {
        color: #111827;
        font-size: 23px;
        font-weight: 800;
    }

    .arsp-history-search {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 17px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(0,0,0,.04);
    }

    .arsp-history-search-label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 12px;
        font-weight: 800;
    }

    .arsp-history-search-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 13px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 13px;
        outline: none;
    }

    .arsp-history-search-input:focus {
        border-color: #64748b;
        box-shadow: 0 0 0 3px rgba(100,116,139,.1);
    }

    .arsp-history-search-info {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
        color: #6b7280;
        font-size: 11px;
    }

    .arsp-history-table-wrap {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: auto;
        box-shadow: 0 3px 12px rgba(0,0,0,.04);
    }

    .arsp-history-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1900px;
    }

    .arsp-history-table th {
        background: #f8fafc;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
        text-align: left;
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .arsp-history-table td {
        padding: 12px;
        border-bottom: 1px solid #f1f5f9;
        color: #374151;
        font-size: 12px;
        vertical-align: top;
    }

    .arsp-history-table tr:last-child td {
        border-bottom: 0;
    }

    .arsp-history-member-name,
    .arsp-history-student-name {
        font-weight: 700;
        color: #111827;
    }

    .arsp-history-muted {
        color: #64748b;
        font-size: 11px;
        margin-top: 3px;
    }

    .arsp-history-email {
        word-break: break-word;
    }

    .arsp-history-no-results {
        display: none;
        padding: 30px;
        text-align: center;
        color: #6b7280;
        font-size: 13px;
    }

    @media (max-width: 700px) {
        .arsp-history-page {
            padding: 15px;
        }

        .arsp-history-header h1 {
            font-size: 21px;
        }
    }
</style>

<div class="arsp-history-page">

    <div class="arsp-history-header">
        <h1>
            ARSP Member Admit Card Download History
        </h1>

        <p>
            Every successful ARSP member admit-card download is recorded as a separate history entry.
        </p>

        <div class="arsp-history-actions">
            <a
                href="/admin/rtse/admit-download-history"
                class="arsp-history-back"
            >
                ← Back to RTSE Admit Card Download History
            </a>
        </div>
    </div>

    <div class="arsp-history-stat">
        <div class="arsp-history-stat-label">
            Admit downloaded by ARSP members
        </div>

        <div
            class="arsp-history-stat-value"
            id="arspHistoryTotal"
        >
            <%= Number(arspStats?.total || 0).toLocaleString() %>
        </div>
    </div>

    <div class="arsp-history-search">

        <label
            for="arspHistorySearch"
            class="arsp-history-search-label"
        >
            Live Search — all member, student and admit-card details
        </label>

        <input
            type="search"
            id="arspHistorySearch"
            class="arsp-history-search-input"
            placeholder="Search Member ID, name, designation, email, mobile, registration number, student, father, school, class, section, year, shift, centre, date..."
            autocomplete="off"
        >

        <div class="arsp-history-search-info">
            <span id="arspHistoryResultCount">
                Showing <%= arspHistory.length %> records
            </span>

            <span>
                Search updates instantly while typing
            </span>
        </div>

    </div>

    <div class="arsp-history-table-wrap">

        <% if (!arspHistory || arspHistory.length === 0) { %>

            <div
                style="padding:30px;text-align:center;color:#6b7280;font-size:13px;"
            >
                No admit cards have been downloaded by ARSP members yet.
            </div>

        <% } else { %>

            <table
                class="arsp-history-table"
                id="arspHistoryTable"
            >

                <thead>
                    <tr>
                        <th>#</th>

                        <th>Member ID</th>
                        <th>Member Name</th>
                        <th>Designation</th>
                        <th>Registered Email</th>
                        <th>Registered Mobile</th>

                        <th>Registration No.</th>
                        <th>Student Name</th>
                        <th>Father Name</th>
                        <th>School Name</th>
                        <th>Class</th>
                        <th>Section</th>

                        <th>Exam Year</th>
                        <th>Exam Shift</th>
                        <th>Exam Centre</th>

                        <th>Verified At</th>
                        <th>Downloaded At</th>
                    </tr>
                </thead>

                <tbody id="arspHistoryBody">

                    <% arspHistory.forEach((record, index) => { %>

                        <tr
                            class="arsp-history-row"
                            data-search="<%= [
                                record.id,
                                record.application_id,
                                record.member_id,
                                record.member_name,
                                record.designation,
                                record.member_email,
                                record.member_mobile,
                                record.registration_no,
                                record.student_name,
                                record.father_name,
                                record.school_name,
                                record.student_class,
                                record.section,
                                record.exam_year,
                                record.exam_shift,
                                record.exam_centre,
                                record.verified_at,
                                record.downloaded_at,
                                record.ip_address
                            ].filter(Boolean).join(' ') %>"
                        >

                            <td>
                                <%= index + 1 %>
                            </td>

                            <td>
                                <%= record.member_id || "-" %>
                            </td>

                            <td>
                                <div class="arsp-history-member-name">
                                    <%= record.member_name || "-" %>
                                </div>
                            </td>

                            <td>
                                <%= record.designation || "-" %>
                            </td>

                            <td class="arsp-history-email">
                                <%= record.member_email || "-" %>
                            </td>

                            <td>
                                <%= record.member_mobile || "-" %>
                            </td>

                            <td>
                                <%= record.registration_no || "-" %>
                            </td>

                            <td>
                                <div class="arsp-history-student-name">
                                    <%= record.student_name || "-" %>
                                </div>
                            </td>

                            <td>
                                <%= record.father_name || "-" %>
                            </td>

                            <td>
                                <%= record.school_name || "-" %>
                            </td>

                            <td>
                                <%= record.student_class || "-" %>
                            </td>

                            <td>
                                <%= record.section || "-" %>
                            </td>

                            <td>
                                <%= record.exam_year || "-" %>
                            </td>

                            <td>
                                <%= record.exam_shift || "-" %>
                            </td>

                            <td>
                                <%= record.exam_centre || "-" %>
                            </td>

                            <td>
                                <%= record.verified_at
                                    ? new Date(record.verified_at).toLocaleString()
                                    : "-"
                                %>
                            </td>

                            <td>
                                <%= record.downloaded_at
                                    ? new Date(record.downloaded_at).toLocaleString()
                                    : "-"
                                %>
                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

            <div
                id="arspHistoryNoResults"
                class="arsp-history-no-results"
            >
                No matching ARSP admit-card download records found.
            </div>

        <% } %>

    </div>

</div>

<script>
(function () {

    const input =
        document.getElementById("arspHistorySearch");

    const rows =
        Array.from(
            document.querySelectorAll(".arsp-history-row")
        );

    const resultCount =
        document.getElementById("arspHistoryResultCount");

    const noResults =
        document.getElementById("arspHistoryNoResults");

    if (!input || !resultCount) {
        return;
    }

    function updateSearch() {

        const term =
            input.value
                .trim()
                .toLowerCase();

        let visible = 0;

        rows.forEach(function (row) {

            const searchable =
                String(
                    row.getAttribute("data-search") || ""
                ).toLowerCase();

            const matches =
                !term ||
                searchable.includes(term);

            row.style.display =
                matches ? "" : "none";

            if (matches) {
                visible++;
            }
        });

        resultCount.textContent =
            "Showing " +
            visible.toLocaleString() +
            " of " +
            rows.length.toLocaleString() +
            " records";

        if (noResults) {
            noResults.style.display =
                visible === 0 ? "block" : "none";
        }
    }

    input.addEventListener(
        "input",
        updateSearch
    );

})();
</script>
<%- include("../partials/footer") %>
