<%- include("../partials/header") %>

<div class="admin-layout rtse-mark-components-page">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>
                        RTSE Result Mark Components
                    </h1>

                    <p>
                        Configure additional mark components for RTSE result entry.
                    </p>

                </div>

                <div>

                    <a
                        href="/admin/rtse/results"
                        class="btn-cancel"
                    >
                        ← Result Dashboard
                    </a>

                </div>

            </div>


            <% if (typeof success !== "undefined" && success) { %>

                <div class="alert alert-success">
                    <%= success %>
                </div>

            <% } %>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="alert alert-danger">
                    <%= error %>
                </div>

            <% } %>


            <div class="profile-card rtse-components-card">

                <div>

                    <div class="rtse-year-summary">

                        <h2>
                            Current RTSE Year:
                            <%= applicationYear %>
                        </h2>

<p>
    OMR remains 100 marks. Enable / Disable controls whether a component is active and visible for result entry.
    Grade Counting controls whether an active component contributes to grade calculation.
    Ranking controls whether an active component contributes to ranking. These controls are independent.
</p>


                    </div>

                    <div>
                        Extra Marks:
                        <%= Number(configuredExtraMarks || 0).toFixed(2) %>
                    </div>

                </div>


                <div class="rtse-add-component-panel">

                    <h3>Add Mark Component</h3>

                    <form
                        class="rtse-add-component-form"
                        method="POST"
                        action="/admin/rtse/results/mark-components"
                    >

                        <div>

                            <div>
                                <label>
                                    Component Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    maxlength="150"
                                    placeholder="Writing Skill Test"
                                    required
                                >
                            </div>


                            <div>
                                <label>
                                    Maximum Marks
                                </label>

                                <input
                                    type="number"
                                    name="maximum_marks"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="10"
                                    required
                                >
                            </div>


                            <div>
                                <label>
                                    Display Order
                                </label>

                                <input
                                    type="number"
                                    name="display_order"
                                    min="0"
                                    step="1"
                                    value="0"
                                >
                            </div>


                            <div>
                                <label>
                                    Grade Counting
                                </label>
                                <select
                                    name="grade_counting"
                                >
                                    <option value="1">Yes</option>
                                    <option value="0">No</option>
                                </select>
                            </div>


<div>
    <label>
        Ranking
    </label>
    <select
        name="ranking_enabled"
    >
        <option value="1">Yes</option>
        <option value="0">No</option>
    </select>
</div>


                            <div>
                                <label>
                                    Status
                                </label>

                                <select
                                    name="enabled"
                                >
                                    <option value="1">
                                        Enabled
                                    </option>

                                    <option value="0">
                                        Disabled
                                    </option>
                                </select>
                            </div>


                            <button
                                type="submit"
                                class="btn-save"
                            >
                                + Add Component
                            </button>

                        </div>

                    </form>

                </div>


                <div>

                    <table class="component-table">

                        <thead>

                            <tr>


                                <th>
                                    Order
                                </th>

                                <th>
                                    Component
                                </th>

                                <th>
                                    Maximum Marks
                                </th>

<th>
    Grade Counting
</th>

<th>
    Ranking
</th>

<th>
    Status
</th>

<th>
    Actions
</th>


                            </tr>

                        </thead>


                        <tbody>

                            <% if (!components || !components.length) { %>

                                <tr>

                                    <td
                                        colspan="7"
                                    >
                                        No additional mark components configured.
                                    </td>

                                </tr>

                            <% } %>


                            <% components.forEach(function(component) { %>

                                <tr>

                                    <td>
                                        <%= component.display_order %>
                                    </td>

                                    <td>

                                        <input
                                            form="edit-component-<%= component.id %>"
                                            type="text"
                                            name="name"
                                            value="<%= component.name %>"
                                            maxlength="150"
                                            required
                                        >

                                    </td>

                                    <td>

                                        <input
                                            form="edit-component-<%= component.id %>"
                                            type="number"
                                            name="maximum_marks"
                                            value="<%= Number(component.maximum_marks || 0) %>"
                                            min="0.01"
                                            step="0.01"
                                            required
                                        >

                                    </td>


                                <td>
                                    <form
                                        method="POST"
                                        class="component-toggle-form"
                                        action="/admin/rtse/results/mark-components/<%= component.id %>/toggle-grade-counting"
                                    >
                                        <button
                                            type="submit"
                                            class="<%= Number(component.grade_counting) === 1 ? 'btn-warning' : 'btn-save' %>"
                                        >
                                            <%= Number(component.grade_counting) === 1 ? "ON" : "OFF" %>
                                        </button>
                                    </form>
                                </td>



<td>
    <select
        form="edit-component-<%= component.id %>"
        name="ranking_enabled"
    >
        <option
            value="1"
            <%= Number(component.ranking_enabled) === 1 ? "selected" : "" %>
        >
            Yes
        </option>
        <option
            value="0"
            <%= Number(component.ranking_enabled) !== 1 ? "selected" : "" %>
        >
            No
        </option>
    </select>
</td>

<td>

                                        <select
                                            form="edit-component-<%= component.id %>"
                                            name="enabled"
                                        >

                                            <option
                                                value="1"
                                                <%= Number(component.enabled) === 1 ? "selected" : "" %>
                                            >
                                                Enabled
                                            </option>

                                            <option
                                                value="0"
                                                <%= Number(component.enabled) !== 1 ? "selected" : "" %>
                                            >
                                                Disabled
                                            </option>

                                        </select>

                                    </td>

                                    <td class="component-actions">
                                        <form class="rtse-edit-form"
                                            id="edit-component-<%= component.id %>"
                                            method="POST"
                                            action="/admin/rtse/results/mark-components/<%= component.id %>/edit"
                                        >

                                            <input
                                                type="hidden"
                                                name="grade_counting"
                                                value="<%= Number(component.grade_counting) === 1 ? 1 : 0 %>"
                                            >

                                            <input
                                                type="number"
                                                name="display_order"
                                                value="<%= Number(component.display_order || 0) %>"
                                                min="0"
                                                step="1"
                                            >

                                            <button
                                                type="submit"
                                                class="btn-view"
                                            >
                                                Save
                                            </button>

                                        </form>


                                        <form
                                            method="POST"
                                            class="component-toggle-form"
                                            action="/admin/rtse/results/mark-components/<%= component.id %>/toggle"
                                        >
                                            <button
                                                type="submit"
                                                class="<%= Number(component.enabled) === 1 ? 'btn-warning' : 'btn-save' %>"
                                            >
                                                <%= Number(component.enabled) === 1 ? "Disable" : "Enable" %>
                                            </button>
                                        </form>


                                        <form
                                            method="POST"
                                            class="component-delete-form"
                                            action="/admin/rtse/results/mark-components/<%= component.id %>/delete"
                                            onsubmit="return confirm('Delete this mark component? Existing saved component marks, if any, must be handled separately.');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-warning"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>


                <div class="rtse-how-it-works">
                    <strong>How this works</strong>

                    <div class="rtse-how-it-works-text">
                        OMR marks remain 100 marks. Every enabled component configured here will later appear automatically in Admin Result Entry and Super Scanner Result Entry.
                    </div>

                    <div class="rtse-how-it-works-example">
                        Example: Writing Skill Test = 10 marks, OMR = 87, Writing Skill Test = 8, Total = 95 / 110.
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


<style>

/* =========================================================
   RTSE RESULT MARK COMPONENTS
   Professional page styling
   ========================================================= */

.rtse-mark-components-page {
    color: #1e293b;
}


/* =========================================================
   Page Header
   ========================================================= */

.rtse-mark-components-page .page-header {
    margin-bottom: 18px;
}

.rtse-mark-components-page .page-header h1 {
    color: #172554;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
}

.rtse-mark-components-page .page-header p {
    color: #64748b;
    font-size: 13px;
}


/* =========================================================
   Main Card
   ========================================================= */

.rtse-mark-components-page .profile-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
}


/* =========================================================
   Year Summary
   ========================================================= */

.rtse-mark-components-page .rtse-year-summary {
    padding: 18px 20px 14px;
}

.rtse-mark-components-page .rtse-year-summary h2 {
    margin: 0 0 12px;
    color: #172554;
    font-size: 21px;
    font-weight: 800;
}

.rtse-mark-components-page .rtse-year-summary p {
    margin: 5px 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.6;
}


/* =========================================================
   Add Component
   ========================================================= */

.rtse-mark-components-page .rtse-add-component-panel {
    margin: 0 0 16px;
    padding: 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

.rtse-mark-components-page .rtse-add-component-panel h3 {
    margin: 0 0 14px;
    color: #334155;
    font-size: 18px;
    font-weight: 800;
}

.rtse-mark-components-page .rtse-add-component-form > div {
    display: grid;
    grid-template-columns:
        minmax(180px, 2fr)
        minmax(125px, 1fr)
        minmax(110px, 1fr)
        minmax(110px, 1fr)
        minmax(110px, 1fr)
        auto;
    gap: 12px;
    align-items: end;
}

.rtse-mark-components-page .rtse-add-component-form label {
    display: block;
    margin-bottom: 5px;
    color: #475569;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.rtse-mark-components-page .rtse-add-component-form input,
.rtse-mark-components-page .rtse-add-component-form select {
    width: 100%;
    height: 40px;
    box-sizing: border-box;
    padding: 0 10px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
    color: #1e293b;
    font-size: 13px;
}

.rtse-mark-components-page .rtse-add-component-form input:focus,
.rtse-mark-components-page .rtse-add-component-form select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
}


/* =========================================================
   Component Table — Desktop
   ========================================================= */

.rtse-mark-components-page .component-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.rtse-mark-components-page .component-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
}

.rtse-mark-components-page .component-table thead {
    display: table-header-group;
    background: #f8fafc;
}

.rtse-mark-components-page .component-table th {
    padding: 11px 10px;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}

.rtse-mark-components-page .component-table td {
    padding: 10px;
    border-bottom: 1px solid #f1f5f9;
    color: #475569;
    vertical-align: middle;
}

.rtse-mark-components-page .component-table tbody tr:last-child td {
    border-bottom: 0;
}

.rtse-mark-components-page .component-table tbody tr:hover {
    background: #f8fafc;
}

.rtse-mark-components-page .component-table td input,
.rtse-mark-components-page .component-table td select {
    width: 100%;
    min-height: 38px;
    box-sizing: border-box;
    padding: 0 9px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: #ffffff;
    color: #1e293b;
    font-size: 12px;
}

.rtse-mark-components-page .component-table td:first-child {
    width: 55px;
    font-weight: 700;
    color: #64748b;
}

.rtse-mark-components-page .component-table td:nth-child(3) {
    width: 120px;
}

.rtse-mark-components-page .component-table td:nth-child(4),
.rtse-mark-components-page .component-table td:nth-child(5) {
    width: 135px;
}

.rtse-mark-components-page .component-actions {
    width: 275px;
    text-align: right;
    white-space: nowrap;
}

.rtse-mark-components-page .rtse-edit-form,
.rtse-mark-components-page .component-toggle-form,
.rtse-mark-components-page .component-delete-form {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 4px 4px;
    vertical-align: middle;
}

.rtse-mark-components-page .rtse-edit-form input {
    width: 70px !important;
    min-width: 70px !important;
}

.rtse-mark-components-page .component-table button {
    min-height: 36px;
    border-radius: 7px;
    padding: 7px 11px;
    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   How It Works
   ========================================================= */

.rtse-mark-components-page .rtse-how-it-works {
    margin-top: 16px;
    padding: 15px 18px;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #c59b45;
    border-radius: 10px;
    background: #f8fafc;
    color: #475569;
    font-size: 13px;
    line-height: 1.65;
}

.rtse-mark-components-page .rtse-how-it-works strong {
    display: block;
    margin: 0 0 7px;
    color: #172554;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
}

.rtse-mark-components-page .rtse-how-it-works-text {
    margin: 0;
    color: #475569;
    font-size: 13px;
    line-height: 1.65;
}

.rtse-mark-components-page .rtse-how-it-works-example {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 12.5px;
    line-height: 1.6;
}


/* =========================================================
   Mobile Component Cards
   ========================================================= */

@media screen and (max-width: 1100px) {

    .rtse-mark-components-page .rtse-add-component-form > div {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .rtse-mark-components-page
    .rtse-add-component-form > div > div:first-child {
        grid-column: 1 / -1;
    }

    .rtse-mark-components-page .rtse-add-component-form > div > div {
        min-width: 0;
    }

    .rtse-mark-components-page .component-table-wrap {
        overflow: visible !important;
    }

    .rtse-mark-components-page .component-table {
        display: block !important;
        width: 100% !important;
        min-width: 0 !important;
        border: 0 !important;
        background: transparent !important;
    }

    .rtse-mark-components-page .component-table thead {
        display: none !important;
    }

    .rtse-mark-components-page .component-table tbody {
        display: block !important;
        width: 100% !important;
    }

    .rtse-mark-components-page .component-table tbody tr {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;

        margin: 0 0 14px !important;
        padding: 15px !important;

        background: #ffffff !important;
        border: 1px solid #dbe3ef !important;
        border-radius: 13px !important;

        box-shadow: 0 3px 12px rgba(15, 23, 42, .06) !important;
    }

    .rtse-mark-components-page .component-table tbody td {
        display: grid !important;
        grid-template-columns: 105px minmax(0, 1fr) !important;

        align-items: center !important;
        gap: 9px !important;

        width: 100% !important;
        box-sizing: border-box !important;

        padding: 6px 0 !important;

        border: 0 !important;
        text-align: left !important;
    }

    .rtse-mark-components-page .component-table tbody td::before {
        display: block !important;
        color: #64748b !important;
        font-size: 9px !important;
        font-weight: 800 !important;
        letter-spacing: .05em !important;
        text-transform: uppercase !important;
    }

    .rtse-mark-components-page .component-table tbody td:nth-child(1)::before {
        content: "Order" !important;
    }

    .rtse-mark-components-page .component-table tbody td:nth-child(2)::before {
        content: "Component" !important;
    }

    .rtse-mark-components-page .component-table tbody td:nth-child(3)::before {
        content: "Maximum Marks" !important;
    }

.rtse-mark-components-page .component-table tbody td:nth-child(4)::before {
    content: "Grade Counting" !important;
}

.rtse-mark-components-page .component-table tbody td:nth-child(5)::before {
    content: "Ranking" !important;
}

.rtse-mark-components-page .component-table tbody td:nth-child(6)::before {
    content: "Status" !important;
}

    .rtse-mark-components-page .component-table tbody td > input,
    .rtse-mark-components-page .component-table tbody td > select {
        width: 100% !important;
        min-width: 0 !important;
        height: 39px !important;
        box-sizing: border-box !important;
    }

    .rtse-mark-components-page .component-table
    tbody td.component-actions {
        display: block !important;

        margin-top: 10px !important;
        padding: 12px 0 0 !important;

        border-top: 1px solid #e5e7eb !important;
    }

    .rtse-mark-components-page .component-table
    tbody td.component-actions::before {
        content: "Actions" !important;
        display: block !important;
        margin-bottom: 9px !important;
    }

    .rtse-mark-components-page .component-actions .rtse-edit-form {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) 68px !important;
        gap: 7px !important;

        width: 100% !important;
        margin: 0 0 8px !important;
    }

    .rtse-mark-components-page .component-actions
    .rtse-edit-form input {
        width: 100% !important;
        min-width: 0 !important;
    }

    .rtse-mark-components-page .component-actions
    .rtse-edit-form button {
        width: 68px !important;
        min-width: 68px !important;
    }

    .rtse-mark-components-page .component-actions
    .component-toggle-form,
    .rtse-mark-components-page .component-actions
    .component-delete-form {
        display: inline-block !important;
        width: auto !important;
        margin: 0 6px 0 0 !important;
        vertical-align: middle !important;
    }

    .rtse-mark-components-page .component-actions
    .component-delete-form {
        margin-right: 0 !important;
    }

    .rtse-mark-components-page .component-actions
    .component-toggle-form button,
    .rtse-mark-components-page .component-actions
    .component-delete-form button {
        width: 105px !important;
        min-width: 105px !important;
        min-height: 40px !important;
        box-sizing: border-box !important;
    }
}


/* =========================================================
   Small Phones
   ========================================================= */

@media screen and (max-width: 600px) {

    .rtse-mark-components-page .profile-card {
        border-radius: 12px;
    }

    .rtse-mark-components-page .rtse-add-component-panel {
        padding: 14px;
    }

    .rtse-mark-components-page .rtse-add-component-form > div {
        grid-template-columns: 1fr;
    }

    .rtse-mark-components-page
    .rtse-add-component-form > div > div:first-child {
        grid-column: auto;
    }

    .rtse-mark-components-page .component-table tbody tr {
        padding: 13px !important;
    }

    .rtse-mark-components-page .component-table tbody td {
        grid-template-columns: 95px minmax(0, 1fr) !important;
        gap: 8px !important;
    }
}



</style>


<%- include("../partials/footer") %>
