<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>
                        RTSE Result Mark Components
                    </h1>

                    <p style="margin:6px 0 0;color:#6b7280;">
                        Configure additional mark components for RTSE result entry.
                    </p>

                </div>

                <div style="display:flex;gap:10px;flex-wrap:wrap;">

                    <a
                        href="/admin/rtse/results"
                        class="btn-cancel"
                        style="text-decoration:none;"
                    >
                        ← Result Dashboard
                    </a>

                </div>

            </div>


            <% if (typeof success !== "undefined" && success) { %>

                <div class="alert alert-success">
                    <%= success %>
                </div>

            <% } %>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="alert alert-danger">
                    <%= error %>
                </div>

            <% } %>


            <div class="profile-card">

                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    gap:15px;
                    flex-wrap:wrap;
                    margin-bottom:20px;
                ">

                    <div>

                        <h2 style="margin:0;">
                            Current RTSE Year:
                            <%= applicationYear %>
                        </h2>

                        <p style="margin:6px 0 0;color:#6b7280;">
                            OMR remains 100 marks. Enabled components are added to the total result marks.
                        </p>

                    </div>

                    <div style="
                        padding:9px 14px;
                        border-radius:20px;
                        background:#eef2ff;
                        color:#3730a3;
                        font-weight:600;
                    ">
                        Extra Marks:
                        <%= Number(configuredExtraMarks || 0).toFixed(2) %>
                    </div>

                </div>


                <div style="
                    margin-bottom:25px;
                    padding:18px;
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    background:#f9fafb;
                ">

                    <h3 style="margin-top:0;">
                        Add Mark Component
                    </h3>

                    <form
                        method="POST"
                        action="/admin/rtse/results/mark-components"
                    >

                        <div style="
                            display:grid;
                            grid-template-columns:
                                minmax(180px,2fr)
                                minmax(130px,1fr)
                                minmax(120px,1fr)
                                minmax(110px,auto)
                                auto;
                            gap:12px;
                            align-items:end;
                        ">

                            <div>
                                <label>
                                    Component Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    maxlength="150"
                                    placeholder="Writing Skill Test"
                                    required
                                    style="width:100%;"
                                >
                            </div>


                            <div>
                                <label>
                                    Maximum Marks
                                </label>

                                <input
                                    type="number"
                                    name="maximum_marks"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="10"
                                    required
                                    style="width:100%;"
                                >
                            </div>


                            <div>
                                <label>
                                    Display Order
                                </label>

                                <input
                                    type="number"
                                    name="display_order"
                                    min="0"
                                    step="1"
                                    value="0"
                                    style="width:100%;"
                                >
                            </div>


                            <div>
                                <label>
                                    Status
                                </label>

                                <select
                                    name="enabled"
                                    style="width:100%;"
                                >
                                    <option value="1">
                                        Enabled
                                    </option>

                                    <option value="0">
                                        Disabled
                                    </option>
                                </select>
                            </div>


                            <button
                                type="submit"
                                class="btn-save"
                            >
                                + Add Component
                            </button>

                        </div>

                    </form>

                </div>


                <div style="overflow-x:auto;">

                    <table style="
                        width:100%;
                        border-collapse:collapse;
                        min-width:850px;
                    ">

                        <thead>

                            <tr style="
                                border-bottom:2px solid #e5e7eb;
                                text-align:left;
                            ">

                                <th style="padding:13px 10px;">
                                    Order
                                </th>

                                <th style="padding:13px 10px;">
                                    Component
                                </th>

                                <th style="padding:13px 10px;">
                                    Maximum Marks
                                </th>

                                <th style="padding:13px 10px;">
                                    Status
                                </th>

                                <th style="
                                    padding:13px 10px;
                                    text-align:right;
                                ">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% if (!components || !components.length) { %>

                                <tr>

                                    <td
                                        colspan="5"
                                        style="
                                            padding:35px 15px;
                                            text-align:center;
                                            color:#6b7280;
                                        "
                                    >
                                        No additional mark components configured.
                                    </td>

                                </tr>

                            <% } %>


                            <% components.forEach(function(component) { %>

                                <tr style="
                                    border-bottom:1px solid #f1f5f9;
                                ">

                                    <td style="padding:12px 10px;">
                                        <%= component.display_order %>
                                    </td>

                                    <td style="padding:12px 10px;">

                                        <input
                                            form="edit-component-<%= component.id %>"
                                            type="text"
                                            name="name"
                                            value="<%= component.name %>"
                                            maxlength="150"
                                            required
                                        >

                                    </td>

                                    <td style="padding:12px 10px;">

                                        <input
                                            form="edit-component-<%= component.id %>"
                                            type="number"
                                            name="maximum_marks"
                                            value="<%= Number(component.maximum_marks || 0) %>"
                                            min="0.01"
                                            step="0.01"
                                            required
                                        >

                                    </td>

                                    <td style="padding:12px 10px;">

                                        <select
                                            form="edit-component-<%= component.id %>"
                                            name="enabled"
                                        >

                                            <option
                                                value="1"
                                                <%= Number(component.enabled) === 1 ? "selected" : "" %>
                                            >
                                                Enabled
                                            </option>

                                            <option
                                                value="0"
                                                <%= Number(component.enabled) !== 1 ? "selected" : "" %>
                                            >
                                                Disabled
                                            </option>

                                        </select>

                                    </td>

                                    <td style="
                                        padding:12px 10px;
                                        text-align:right;
                                    ">

                                        <form
                                            id="edit-component-<%= component.id %>"
                                            method="POST"
                                            action="/admin/rtse/results/mark-components/<%= component.id %>/edit"
                                        >

                                            <input
                                                type="number"
                                                name="display_order"
                                                value="<%= Number(component.display_order || 0) %>"
                                                min="0"
                                                step="1"
                                                style="width:90px;"
                                            >

                                            <button
                                                type="submit"
                                                class="btn-view"
                                                style="margin-left:6px;"
                                            >
                                                Save
                                            </button>

                                        </form>


                                        <form
                                            method="POST"
                                            action="/admin/rtse/results/mark-components/<%= component.id %>/delete"
                                            style="display:inline-block;margin-top:8px;"
                                            onsubmit="return confirm('Delete this mark component? Existing saved component marks, if any, must be handled separately.');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-warning"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>


                <div style="
                    margin-top:20px;
                    padding:14px 16px;
                    border-left:4px solid #4f46e5;
                    background:#eef2ff;
                    border-radius:6px;
                ">

                    <strong>How this works</strong>

                    <div style="margin-top:6px;color:#4b5563;">

                        OMR marks remain 100 marks.
                        Every enabled component configured here will later appear automatically
                        in Admin Result Entry and Super Scanner Result Entry.

                    </div>

                    <div style="margin-top:6px;color:#4b5563;">

                        Example:
                        Writing Skill Test = 10 marks,
                        OMR = 87,
                        Writing Skill Test = 8,
                        Total = 95 / 110.

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

<style>

@media (max-width: 900px) {

    .profile-card form > div {
        grid-template-columns:1fr !important;
    }

}

</style>
