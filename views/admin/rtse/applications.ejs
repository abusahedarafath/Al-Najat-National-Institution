<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>
                        <%= status ? `RTSE ${status} Applications` : "RTSE Student Applications" %>
                    </h1>
                    <p style="margin:5px 0;color:#777;">
                        <%= applicationCount %>
                        <%= status ? `${status.toLowerCase()} applications` : "total applications" %>
                    </p>
                </div>

                <a href="/admin/rtse" class="btn-view">
                    <i class="fas fa-arrow-left"></i>
                    RTSE Dashboard
                </a>

            </div>

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                gap:15px;
                flex-wrap:wrap;
                margin:20px 0;
            ">

                <input
                    type="search"
                    id="rtseApplicationSearch"
                    name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Search applications..."
                    style="
                        min-width:240px;
                        max-width:420px;
                        width:100%;
                        padding:10px 14px;
                        border:1px solid #ddd;
                        border-radius:8px;
                    "
                >

                <div>

                    <label for="rtsePerPage">
                        Applications per page:
                    </label>

                    <select
                        id="rtsePerPage"
                        onchange="changeRtsePerPage(this.value)"
                        style="
                            padding:8px 12px;
                            border:1px solid #ddd;
                            border-radius:6px;
                        "
                    >

                        <% [10,25,50,100].forEach(function(size){ %>

                            <option
                                value="<%= size %>"
                                <%= perPage === size ? "selected" : "" %>
                            >
                                <%= size %>
                            </option>

                        <% }) %>

                    </select>

                </div>

            </div>

            <div class="profile-card">

                <div style="overflow-x:auto;">

                    <table
                        class="admin-table"
                        id="rtseApplicationTable"
                    >

                        <thead>
                            <tr>
                                <th>Registration</th>
                                <th>Student</th>
                                <th>School</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% applications.forEach(application => { %>

                                <tr>

                                    <td>
                                        <strong>
                                            <%= application.registration_no %>
                                        </strong>
                                    </td>



                                    <td>

                                        <strong>
                                            <%= application.full_name %>
                                        </strong>

                                        <br>

                                        <small>
                                            <%= application.mobile %>
                                        </small>

                                    </td>

                                    <td>
                                        <%= application.school_name %>
                                    </td>

                                    <td>
                                        <%= application.class %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= application.section %>
                                        </strong>
                                    </td>

                                    <td>

                                        <% if(application.status === "Approved"){ %>

                                            <span class="badge badge-success">
                                                Approved
                                            </span>

                                        <% } else if(application.status === "Rejected"){ %>

                                            <span class="badge badge-danger">
                                                Rejected
                                            </span>

                                        <% } else { %>

                                            <span class="badge badge-warning">
                                                Pending
                                            </span>

                                        <% } %>

                                        <% if(application.roll_no){ %>

                                            <br>

                                            <small>
                                                <strong>
                                                    <%= application.roll_no %>
                                                </strong>
                                            </small>

                                        <% } %>

                                    </td>

                                    <td style="white-space:nowrap;">

                                        <a
                                            href="/admin/rtse/application/<%= application.id %>?returnPage=<%= page %>&returnPerPage=<%= perPage %>&returnSearch=<%= encodeURIComponent(search || "") %>&returnStatus=<%= encodeURIComponent(status || "") %>"
                                            class="btn-view">
                                            View
                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                            <% if(!applications.length){ %>

                                <tr>
                                    <td colspan="7" style="text-align:center;padding:30px;">
                                        No applications found.
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

            <div id="rtsePagination">
            <% if(totalPages > 1){ %>

                <div style="
                    display:flex;
                    justify-content:center;
                    align-items:center;
                    gap:10px;
                    flex-wrap:wrap;
                    margin:20px 0;
                ">

                    <% if(page > 1){ %>

                        <a
                            href="/admin/rtse/applications?page=<%= page-1 %>&perPage=<%= perPage %>&search=<%= encodeURIComponent(search || "") %>&status=<%= encodeURIComponent(status || "") %>"
                            class="btn btn-secondary"
                        >
                            Previous
                        </a>

                    <% } %>

                    <span style="padding:8px 14px;font-weight:600;">
                        Page <%= page %> of <%= totalPages %>
                    </span>

                    <% if(page < totalPages){ %>

                        <a
                            href="/admin/rtse/applications?page=<%= page+1 %>&perPage=<%= perPage %>&search=<%= encodeURIComponent(search || "") %>&status=<%= encodeURIComponent(status || "") %>"
                            class="btn btn-primary"
                        >
                            Next
                        </a>

                    <% } %>

                </div>

            <% } %>

        </div>

    </main>

</div>

<script>
function changeRtsePerPage(value) {

    const searchInput =
        document.getElementById("rtseApplicationSearch");

    const search =
        searchInput
            ? searchInput.value.trim()
            : "";

    const params =
        new URLSearchParams();

    params.set("perPage", value);

    if (search) {
        params.set("search", search);
    }

    window.location.href =
        "/admin/rtse/applications?" +
        params.toString();
}


document.addEventListener("DOMContentLoaded", function () {

    const input =
        document.getElementById("rtseApplicationSearch");

    const table =
        document.getElementById("rtseApplicationTable");

    const tbody =
        table ? table.querySelector("tbody") : null;

    const totalText =
        document.querySelector(".page-header p");

    const perPageSelect =
        document.getElementById("rtsePerPage");

    if (!input || !tbody) return;

    let searchTimer = null;
    let controller = null;

    function escapeHtml(value) {
        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function renderApplications(applications) {

        if (!applications.length) {

            tbody.innerHTML = `
                <tr>
                    <td
                        colspan="7"
                        style="text-align:center;padding:30px;">
                        No applications found.
                    </td>
                </tr>
            `;

            return;
        }

        tbody.innerHTML = applications.map(function (application) {

            let statusHtml = "";

            if (application.status === "Approved") {

                statusHtml = `
                    <span class="badge badge-success">
                        Approved
                    </span>
                `;

            } else if (application.status === "Rejected") {

                statusHtml = `
                    <span class="badge badge-danger">
                        Rejected
                    </span>
                `;

            } else {

                statusHtml = `
                    <span class="badge badge-warning">
                        Pending
                    </span>
                `;
            }

            if (application.roll_no) {

                statusHtml += `
                    <br>
                    <small>
                        <strong>
                            ${escapeHtml(application.roll_no)}
                        </strong>
                    </small>
                `;
            }

            return `
                <tr>

                    <td>
                        <strong>
                            ${escapeHtml(application.registration_no)}
                        </strong>
                    </td>

                    <td>
                        <strong>
                            ${escapeHtml(application.full_name)}
                        </strong>
                        <br>
                        <small>
                            ${escapeHtml(application.mobile)}
                        </small>
                    </td>

                    <td>
                        ${escapeHtml(application.school_name)}
                    </td>

                    <td>
                        ${escapeHtml(application.class)}
                    </td>

                    <td>
                        <strong>
                            ${escapeHtml(application.section)}
                        </strong>
                    </td>

                    <td>
                        ${statusHtml}
                    </td>

                    <td style="white-space:nowrap;">
                        <a
                            href="/admin/rtse/application/${encodeURIComponent(application.id)}?returnPage=${encodeURIComponent(new URLSearchParams(window.location.search).get("page") || "1")}&returnPerPage=${encodeURIComponent(perPageSelect ? perPageSelect.value : "<%= perPage %>")}&returnSearch=${encodeURIComponent(input ? input.value.trim() : "")}&returnStatus=${encodeURIComponent("<%= typeof status !== 'undefined' ? status : '' %>")}"
                            class="btn-view">
                            View
                        </a>
                    </td>

                </tr>
            `;

        }).join("");
    }

    function renderPagination(applicationCount, perPage, search, status) {

        const pagination =
            document.getElementById("rtsePagination");

        if (!pagination) return;

        const totalPages = Math.max(
            1,
            Math.ceil(
                (Number(applicationCount) || 0) /
                Number(perPage || 10)
            )
        );

        const currentPage = 1;

        if (totalPages <= 1) {
            pagination.innerHTML = "";
            return;
        }

        const searchParam =
            encodeURIComponent(search || "");

        const statusParam =
            encodeURIComponent(status || "");

        const perPageParam =
            encodeURIComponent(perPage || 10);

        let html = `
            <div style="
                display:flex;
                justify-content:center;
                align-items:center;
                gap:10px;
                flex-wrap:wrap;
                margin:20px 0;
            ">
        `;

        html += `
            <span style="padding:8px 14px;font-weight:600;">
                Page ${currentPage} of ${totalPages}
            </span>
        `;

        if (currentPage < totalPages) {

            const nextPage =
                currentPage + 1;

            html += `
                <a
                    href="/admin/rtse/applications?page=${nextPage}&perPage=${perPageParam}&search=${searchParam}&status=${statusParam}"
                    class="btn btn-primary"
                >
                    Next
                </a>
            `;
        }

        html += `
            </div>
        `;

        pagination.innerHTML = html;
    }

    async function performLiveSearch() {

        const query =
            input.value.trim();

        if (controller) {
            controller.abort();
        }

        controller =
            new AbortController();

        try {

            const perPage =
                perPageSelect
                    ? perPageSelect.value
                    : "<%= perPage %>";

            const status =
                  "<%= typeof status !== 'undefined' ? status : '' %>";

              // Keep live-search state in the current URL
              // without creating a new browser-history entry.
              const browserParams =
                  new URLSearchParams(window.location.search);

              if (query) {
                  browserParams.set("search", query);
              } else {
                  browserParams.delete("search");
              }

              browserParams.set("perPage", perPage);

              if (status) {
                  browserParams.set("status", status);
              } else {
                  browserParams.delete("status");
              }

              browserParams.set("page", "1");

              window.history.replaceState(
                  null,
                  "",
                  "/admin/rtse/applications?" +
                  browserParams.toString()
              );

              const url =
                  "/admin/rtse/applications/live-search" +
                  "?search=" +
                  encodeURIComponent(query) +
                  "&perPage=" +
                  encodeURIComponent(perPage) +
                  "&status=" +
                  encodeURIComponent(status);

            const response =
                await fetch(
                    url,
                    {
                        headers: {
                            "Accept": "application/json"
                        },
                        signal: controller.signal
                    }
                );

            if (!response.ok) {
                throw new Error("Search request failed.");
            }

            const data =
                await response.json();

            if (!data.success) {
                throw new Error(
                    data.message ||
                    "Unable to search."
                );
            }

            renderApplications(
                data.applications || []
            );
              const currentStatusForPagination =
                  "<%= typeof status !== 'undefined' ? status : '' %>";

              renderPagination(
                  data.applicationCount || 0,
                  perPage,
                  query,
                  currentStatusForPagination
              );



            if (totalText) {

                  const currentStatus =
                      "<%= typeof status !== 'undefined' ? status : '' %>";

                  totalText.textContent =
                      currentStatus
                          ? `${data.applicationCount || 0} ${currentStatus.toLowerCase()} applications`
                          : `${data.applicationCount || 0} total applications`;
              }

        } catch (error) {

            if (error.name === "AbortError") {
                return;
            }

            console.error(
                "RTSE live search error:",
                error
            );
        }
    }

    input.addEventListener("input", function () {

        clearTimeout(searchTimer);

        searchTimer = setTimeout(
            performLiveSearch,
            150
        );

    });

});

</script>

<%- include("../partials/footer") %>
