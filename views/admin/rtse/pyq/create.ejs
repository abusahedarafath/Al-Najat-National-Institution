<%- include("../../partials/header") %>
<link rel="stylesheet" href="/css/rtse-pyq-admin.css">
<script src="/js/rtse-pyq-admin.js" defer></script>

<div class="admin-layout">
    <%- include("../../partials/sidebar") %>

    <main class="admin-content">
        <div class="container">
            <div class="page-header">
                <div>
                    <h1>Add RTSE PYQ</h1>
                    <p>Publish a previous year question paper.</p>
                </div>

                <a
                    href="<%= category ? `/admin/rtse/pyq?category_id=${category.id}` : '/admin/rtse/pyq' %>"
                    class="btn-view"
                >← Back</a>
            </div>

            <div class="profile-card">
                <form
                    action="/admin/rtse/pyq"
                    method="POST"
                    enctype="multipart/form-data"
                >
                    <div class="rtse-pyq-admin-grid">
                        <label>
                            <span>Year Category</span>
                            <select name="category_id">
                                <option value="">No category</option>

                                <% (categories || []).forEach(item => { %>
                                    <option
                                        value="<%= item.id %>"
                                        <%= categoryId && Number(categoryId) === Number(item.id) ? "selected" : "" %>
                                    >
                                        <%= item.year %> — <%= item.title %>
                                        <% if (!item.is_active) { %> (Hidden) <% } %>
                                    </option>
                                <% }) %>
                            </select>

                            <small>
                                Select the year category that should contain this PYQ.
                            </small>
                        </label>

                        <label>
                            <span>Year</span>
                            <input
                                type="number"
                                name="year"
                                min="2000"
                                max="2100"
                                required
                                value="<%= category ? category.year : '' %>"
                                placeholder="2025"
                            >
                        </label>

                        <label>
                            <span>Class</span>
                            <input
                                type="text"
                                name="class_name"
                                required
                                placeholder="10"
                            >
                        </label>

                        <label>
                            <span>PDF File</span>
                            <input
                                type="file"
                                name="pdf"
                                accept="application/pdf,.pdf"
                                required
                            >
                        </label>

                        <label>
                            <span>Display Order</span>
                            <input
                                type="number"
                                name="display_order"
                                value="0"
                            >
                        </label>
                    </div>

                    <label class="rtse-pyq-admin-switch">
                        <input type="checkbox" name="is_active" value="1" checked>
                        <span>Publish this PYQ immediately</span>
                    </label>

                    <div class="rtse-pyq-admin-actions">
                        <a
                            href="<%= category ? `/admin/rtse/pyq?category_id=${category.id}` : '/admin/rtse/pyq' %>"
                            class="btn-cancel"
                        >Cancel</a>
                        <button type="submit" class="btn-save">Save PYQ</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<%- include("../../partials/footer") %>
