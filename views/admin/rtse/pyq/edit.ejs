<%- include("../../partials/header") %>
<link rel="stylesheet" href="/css/rtse-pyq-admin.css">
<script src="/js/rtse-pyq-admin.js" defer></script>

<div class="admin-layout">
    <%- include("../../partials/sidebar") %>

    <main class="admin-content">
        <div class="container">
            <div class="page-header">
                <div>
                    <h1>Edit RTSE PYQ</h1>
                    <p>Update year, class, PDF, order or visibility.</p>
                </div>

                <a
                    href="<%= pyq.category_id ? `/admin/rtse/pyq?category_id=${pyq.category_id}` : '/admin/rtse/pyq' %>"
                    class="btn-view"
                >← Back</a>
            </div>

            <div class="profile-card">
                <form
                    action="/admin/rtse/pyq/<%= pyq.id %>"
                    method="POST"
                    enctype="multipart/form-data"
                >
                    <div class="rtse-pyq-admin-grid">
                        <label>
                            <span>Year Category</span>
                            <select name="category_id">
                                <option value="">No category</option>

                                <% (categories || []).forEach(item => { %>
                                    <option
                                        value="<%= item.id %>"
                                        <%= pyq.category_id && Number(pyq.category_id) === Number(item.id) ? "selected" : "" %>
                                    >
                                        <%= item.year %> — <%= item.title %>
                                        <% if (!item.is_active) { %> (Hidden) <% } %>
                                    </option>
                                <% }) %>
                            </select>

                            <small>
                                Select the year category that should contain this PYQ.
                            </small>
                        </label>

                        <label>
                            <span>Year</span>
                            <input
                                type="number"
                                name="year"
                                min="2000"
                                max="2100"
                                required
                                value="<%= pyq.year %>"
                            >
                        </label>

                        <label>
                            <span>Class</span>
                            <input
                                type="text"
                                name="class_name"
                                required
                                value="<%= pyq.class_name %>"
                            >
                        </label>

                        <label>
                            <span>Replace PDF <small>(optional)</small></span>
                            <input
                                type="file"
                                name="pdf"
                                accept="application/pdf,.pdf"
                            >
                        </label>

                        <label>
                            <span>Display Order</span>
                            <input
                                type="number"
                                name="display_order"
                                value="<%= pyq.display_order %>"
                            >
                        </label>
                    </div>

                    <p>
                        Current PDF:
                        <a href="<%= pyq.pdf_path %>" target="_blank" rel="noopener">
                            View current PDF
                        </a>
                    </p>

                    <label class="rtse-pyq-admin-switch">
                        <input
                            type="checkbox"
                            name="is_active"
                            value="1"
                            <%= pyq.is_active ? "checked" : "" %>
                        >
                        <span>Published</span>
                    </label>

                    <div class="rtse-pyq-admin-actions">
                        <a
                            href="<%= pyq.category_id ? `/admin/rtse/pyq?category_id=${pyq.category_id}` : '/admin/rtse/pyq' %>"
                            class="btn-cancel"
                        >Cancel</a>
                        <button type="submit" class="btn-save">Update PYQ</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<%- include("../../partials/footer") %>
