<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>
                        Approved Students —
                        Section <%= section %>
                    </h1>

                    <p>
                        Only approved RTSE students of
                        Section <%= section %> are shown here.
                    </p>

                </div>

                <div
                    style="display:flex;gap:10px;flex-wrap:wrap;">

                    <a
                        href="/admin/rtse"
                        class="btn-view">

                        ← RTSE Dashboard

                    </a>

                    <a
                        href="/admin/rtse/export/<%= section %>"
                        class="btn-save">

                        📊 Section <%= section %> Excel

                    </a>

                </div>

            </div>


            <div class="dashboard-grid">

                <div class="dashboard-card">

                    <h3>
                        Approved Students
                    </h3>

                    <h1>
                        <%= students.length %>
                    </h1>

                </div>

                <div class="dashboard-card">

                    <h3>
                        Roll Generated
                    </h3>

                    <h1>

                        <%= students.filter(
                            s => s.roll_number
                        ).length %>

                    </h1>

                </div>

                <div class="dashboard-card">

                    <h3>
                        Admit Generated
                    </h3>

                    <h1>

                        <%= students.filter(
                            s => Number(s.admit_generated) === 1
                        ).length %>

                    </h1>

                </div>

            </div>


            <div class="profile-card">

                <div
                    style="overflow-x:auto;">

                    <!-- =====================================================
     SECTION STUDENT SEARCH
===================================================== -->

<div class="profile-card rtse-search-card" style="margin-bottom:20px;">

    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">
                Search Section <%= section %> Students
            </h2>

            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>

        <div style="flex:1;min-width:220px;max-width:500px;position:relative;">

            <i
                class="fas fa-search"
                style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#777;">
            </i>

            <input
                type="search"
                id="rtseApprovedSearch"
                placeholder="Search student..."
                autocomplete="off"
                style="width:100%;padding:12px 15px 12px 42px;border:1px solid #ddd;border-radius:10px;font-size:14px;outline:none;">

        </div>

    </div>

    <div
        id="rtseApprovedSearchResult"
        style="margin-top:10px;font-size:13px;color:#666;">
    </div>

</div>

<table id="rtseApprovedTable" class="admin-table">

                        <thead>

                            <tr>

                                <th>Reg. No.</th>

                                <th>Student</th>

                                <th>Class</th>

                                <th>Roll</th>

                                <th>Number</th>

                                <th>Admit</th>

                                <th>Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% if(!students.length){ %>

                                <tr>

                                    <td
                                        colspan="7"
                                        style="text-align:center;padding:30px;">

                                        No approved students
                                        found in Section
                                        <%= section %>.

                                    </td>

                                </tr>

                            <% } %>


                            <% students.forEach(student => { %>

                                <tr>

                                    <td>

                                        <strong>
                                            <%= student.registration_no %>
                                        </strong>

                                    </td>


                                    <td>

                                        <strong>
                                            <%= student.full_name %>
                                        </strong>

                                        <br>

                                        <small>
                                            <%= student.school_name %>
                                        </small>

                                    </td>


                                    <td>

                                        <%= student.class %>

                                    </td>


                                    <td>

                                        <% if(student.roll_no){ %>

                                            <strong>
                                                <%= student.roll_no.split("-")[0] %>
                                            </strong>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <td>

                                        <strong>
                                            <%= student.roll_number || (student.roll_no ? student.roll_no.split("-").pop() : "-") %>
                                        </strong>

                                    </td>


                                    <td>

                                        <% if(Number(student.admit_generated) === 1){ %>

                                            <span
                                                class="badge badge-success">

                                                Generated

                                            </span>

                                        <% } else { %>

                                            <span
                                                class="badge badge-warning">

                                                Not Generated

                                            </span>

                                        <% } %>

                                    </td>


                                    <td>

                                        <div
                                            style="
                                                display:flex;
                                                gap:6px;
                                                flex-wrap:wrap;
                                            ">

                                            <a
                                                href="/admin/rtse/application/<%= student.id %>"
                                                class="btn-view">

                                                View

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>

</div>


<script>

document.addEventListener("DOMContentLoaded", function () {

    const input =
        document.getElementById("rtseApprovedSearch");

    const table =
        document.getElementById("rtseApprovedTable");

    const tbody =
        table
            ? table.querySelector("tbody")
            : null;

    const resultText =
        document.getElementById("rtseApprovedSearchResult");

    if (!input || !tbody) {
        return;
    }

    const section =
        "<%= section %>";

    let searchTimer = null;
    let controller = null;

    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }

    function renderStudents(students) {

        if (!students.length) {

            tbody.innerHTML = `
                <tr>
                    <td
                        colspan="7"
                        style="text-align:center;padding:30px;">
                        No approved students found in
                        Section ${escapeHtml(section)}.
                    </td>
                </tr>
            `;

            return;
        }

        tbody.innerHTML =
            students.map(function (student) {

                let roll = "-";

                if (student.roll_no) {

                    roll =
                        escapeHtml(
                            String(student.roll_no).split("-")[0]
                        );

                }

                const admit =
                    Number(student.admit_generated) === 1
                        ? `
                            <span class="badge badge-success">
                                Generated
                            </span>
                          `
                        : `
                            <span class="badge badge-warning">
                                Not Generated
                            </span>
                          `;

                return `
                    <tr>

                        <td>
                            <strong>
                                ${escapeHtml(student.registration_no)}
                            </strong>
                        </td>

                        <td>

                            <strong>
                                ${escapeHtml(student.full_name)}
                            </strong>

                            <br>

                            <small>
                                ${escapeHtml(student.school_name)}
                            </small>

                        </td>

                        <td>
                            ${escapeHtml(student.class)}
                        </td>

                        <td>
                            <strong>
                                ${roll}
                            </strong>
                        </td>

                        <td>
                            <strong>
                                ${escapeHtml(
                                    student.roll_number || (student.roll_no ? String(student.roll_no).split("-").pop() : "-")
                                )}
                            </strong>
                        </td>

                        <td>
                            ${admit}
                        </td>

                        <td style="white-space:nowrap;">

                            <a
                                href="/admin/rtse/application/${encodeURIComponent(student.id)}"
                                class="btn-view">

                                View

                            </a>

                        </td>

                    </tr>
                `;

            }).join("");

    }

    async function performApprovedSearch() {

        const query =
            input.value.trim();

        if (controller) {
            controller.abort();
        }

        controller =
            new AbortController();

        try {

            const url =
                "/admin/rtse/approved/" +
                encodeURIComponent(section) +
                "/live-search?search=" +
                encodeURIComponent(query);

            const response =
                await fetch(
                    url,
                    {
                        headers: {
                            "Accept": "application/json"
                        },
                        signal: controller.signal
                    }
                );

            if (!response.ok) {
                throw new Error(
                    "Search request failed."
                );
            }

            const data =
                await response.json();

            if (!data.success) {
                throw new Error(
                    data.message ||
                    "Unable to search students."
                );
            }

            renderStudents(
                data.students || []
            );

            if (resultText) {

                if (query) {

                    resultText.textContent =
                        `${data.students.length} matching student(s)`;

                } else {

                    resultText.textContent =
                        `${data.students.length} approved student(s) in Section ${section}`;

                }

            }

        } catch (error) {

            if (error.name === "AbortError") {
                return;
            }

            console.error(
                "RTSE approved section search error:",
                error
            );

            if (resultText) {
                resultText.textContent =
                    "Unable to search students.";
            }

        }

    }

    input.addEventListener(
        "input",
        function () {

            clearTimeout(searchTimer);

            searchTimer =
                setTimeout(
                    performApprovedSearch,
                    150
                );

        }
    );

    /*
     * Initial state.
     * The server-rendered approved students remain visible.
     * No additional request is made until the administrator searches.
     */

});

</script>

<%- include("../partials/footer") %>
