<%- include("../partials/header") %>

<div class="admin-layout">
    <%- include("../partials/sidebar") %>

    <main class="admin-content">
        <div class="container">

            <div class="page-header">
                <div>
                    <h1>RTSE Students Without School</h1>
                    <p>
                        Students with no school name in their submitted RTSE
                        application for examination year
                        <strong><%= applicationYear %></strong>.
                    </p>
                </div>

                <div class="rtse-header-actions">
                    <a
                        href="/admin/rtse"
                        class="btn-view"
                    >
                        ← RTSE Dashboard
                    </a>
                </div>
            </div>


            <div
                class="rtse-statistics-grid"
                style="margin-bottom:20px;"
            >
                <div class="rtse-stat-card">
                    <h3>Students Without School</h3>
                    <h1>
                        <%= studentCount %>
                    </h1>
                </div>
            </div>


            <div class="profile-card">

                <div
                    style="
                        display:flex;
                        justify-content:space-between;
                        align-items:center;
                        gap:15px;
                        flex-wrap:wrap;
                        margin-bottom:18px;
                    "
                >

                    <div>
                        <h2 style="margin:0;">
                            Student Directory
                        </h2>

                        <p
                            style="
                                margin:6px 0 0;
                                color:#666;
                            "
                        >
                            Only applications without a school are listed.
                        </p>
                    </div>


                    <div
                        style="
                            width:100%;
                            max-width:500px;
                        "
                    >
                        <input
                            type="search"
                            id="studentSearch"
                            placeholder="🔎 Search students..."
                            autocomplete="off"
                            aria-label="Search students without school"
                            value="<%= search %>"
                            style="
                                width:100%;
                                padding:12px 15px;
                                border:1px solid #d1d5db;
                                border-radius:8px;
                                font-size:15px;
                                box-sizing:border-box;
                            "
                        >
                    </div>

                </div>


                <div
                    style="
                        display:flex;
                        gap:10px;
                        align-items:center;
                        flex-wrap:wrap;
                        margin-bottom:15px;
                    "
                >

                    <select
                        id="studentStatus"
                        aria-label="Filter by status"
                        style="
                            padding:10px 12px;
                            border:1px solid #d1d5db;
                            border-radius:8px;
                            font-size:14px;
                        "
                    >
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>

                    <span
                        style="
                            color:#666;
                            font-size:14px;
                        "
                    >
                        Showing
                        <strong id="visibleStudentCount">
                            <%= studentCount %>
                        </strong>
                        of
                        <strong><%= studentCount %></strong>
                        students
                    </span>

                </div>


                <div style="overflow-x:auto;">

                    <table
                        class="admin-table"
                        id="studentsWithoutSchoolTable"
                        style="width:100%;"
                    >

                        <thead>
                            <tr>
                                <th>Sl. No.</th>
                                <th>Registration No.</th>
                                <th>Student Name</th>
                                <th>Father Name</th>
                                <th>Mobile</th>
                                <th>District</th>
                                <th>Class</th>
                                <th>Roll No.</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (!students.length) { %>

                                <tr>
                                    <td
                                        colspan="10"
                                        style="
                                            text-align:center;
                                            padding:35px;
                                        "
                                    >
                                        No students without a school found
                                        for <%= applicationYear %>.
                                    </td>
                                </tr>

                            <% } else { %>

                                <% students.forEach((student, index) => { %>

                                    <tr
                                        class="student-without-school-row"
                                        data-search="<%= [
                                            student.registration_no,
                                            student.full_name,
                                            student.father_name,
                                            student.mobile,
                                            student.district,
                                            student.class,
                                            student.section,
                                            student.roll_no,
                                            student.status
                                        ].join(' ').toLowerCase() %>"
                                        data-status="<%= student.status || '' %>"
                                    >

                                        <td>
                                            <%= index + 1 %>
                                        </td>

                                        <td>
                                            <strong>
                                                <%= student.registration_no || '—' %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= student.full_name || '—' %>
                                        </td>

                                        <td>
                                            <%= student.father_name || '—' %>
                                        </td>

                                        <td>
                                            <%= student.mobile || '—' %>
                                        </td>

                                        <td>
                                            <%= student.district || '—' %>
                                        </td>

                                        <td>
                                            <%= student.class || '—' %>
                                            <% if (student.section) { %>
                                                - <%= student.section %>
                                            <% } %>
                                        </td>

                                        <td>
                                            <%= student.roll_no || '—' %>
                                        </td>

                                        <td>
                                            <%= student.status || '—' %>
                                        </td>

                                        <td>
                                            <a
                                                href="/admin/rtse/application/<%= student.id %>"
                                                class="btn-view"
                                                style="
                                                    white-space:nowrap;
                                                    display:inline-block;
                                                "
                                            >
                                                👁 View Application
                                            </a>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <div
                    id="studentNoResults"
                    style="
                        display:none;
                        text-align:center;
                        padding:35px;
                        color:#666;
                    "
                >
                    No students match your search.
                </div>

            </div>

        </div>
    </main>
</div>


<script>
(function () {

    const searchInput =
        document.getElementById("studentSearch");

    const statusSelect =
        document.getElementById("studentStatus");

    const rows =
        Array.from(
            document.querySelectorAll(
                ".student-without-school-row"
            )
        );

    const noResults =
        document.getElementById(
            "studentNoResults"
        );

    const visibleCount =
        document.getElementById(
            "visibleStudentCount"
        );

    if (!searchInput) {
        return;
    }

    function filterStudents() {

        const query =
            searchInput.value
                .trim()
                .toLowerCase();

        const selectedStatus =
            statusSelect
                ? statusSelect.value
                : "";

        let visible = 0;

        rows.forEach(row => {

            const matchesSearch =
                !query ||
                (row.dataset.search || "")
                    .includes(query);

            const matchesStatus =
                !selectedStatus ||
                row.dataset.status === selectedStatus;

            const show =
                matchesSearch &&
                matchesStatus;

            row.style.display =
                show ? "" : "none";

            if (show) {
                visible++;
            }
        });

        if (visibleCount) {
            visibleCount.textContent = visible;
        }

        if (noResults) {
            noResults.style.display =
                rows.length > 0 && visible === 0
                    ? "block"
                    : "none";
        }
    }

    searchInput.addEventListener(
        "input",
        filterStudents
    );

    if (statusSelect) {
        statusSelect.addEventListener(
            "change",
            filterStudents
        );
    }

    filterStudents();

})();
</script>
