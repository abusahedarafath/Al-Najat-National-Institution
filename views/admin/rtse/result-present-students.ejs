<%- include("../partials/header") %>
<script src="/js/rtse-counted-omr.js"></script>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>
                    RTSE — Present Students
                </h1>

                <a
                    href="/admin/rtse/results"
                    class="btn-cancel"
                >
                    ← Back
                </a>

            </div>


            <div class="profile-card">

                <h2>
                    Gate Entry Confirmed
                </h2>

                <p>
                    RTSE <%= applicationYear %>
                    · All Sections
                </p>

                <p>
                    <strong><%= students.length %></strong>
                    student(s) successfully confirmed through Super Scanner.
                </p>



                <div
                    class="rtse-live-search"
                    style="margin:20px 0;"
                >
                    <div
                        style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;"
                    >
                        <div style="flex:1;min-width:240px;">
                            <label
                                for="rtseStudentLiveSearch"
                                style="display:block;font-weight:600;margin-bottom:7px;"
                            >
                                🔎 Search Students
                            </label>

                            <input
                                type="search"
                                id="rtseStudentLiveSearch"
                                placeholder="Search by name, registration, roll, mobile, father, school, district, address, marks, grade, etc."
                                autocomplete="off"
                                style="width:100%;box-sizing:border-box;padding:11px 13px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;"
                            >
                        </div>

                        <button
                            type="button"
                            id="rtseStudentLiveSearchClear"
                            style="padding:11px 16px;border:1px solid #d1d5db;border-radius:8px;background:#fff;cursor:pointer;"
                        >
                            Clear
                        </button>
                    </div>

                    <div
                        id="rtseStudentLiveSearchCount"
                        style="margin-top:8px;font-size:13px;color:#6b7280;"
                    ></div>
                </div>

                <% if (!students || students.length === 0) { %>

                    <div style="text-align:center;padding:30px;">

                        <h3>
                            No Present Students
                        </h3>

                        <p>
                            No eligible RTSE student has completed
                            confirmed gate entry yet.
                        </p>

                    </div>

                <% } else { %>

                    <div style="overflow-x:auto;">

                        <table class="admin-table">

                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Roll No.
                                    </th>

                                    <th>
                                        Registration
                                    </th>

                                    <th>
                                        Student
                                    </th>

                                    <th>
                                        Section
                                    </th>

                                    <th>
                                        Attendance
                                    </th>

                                    <th>
                                        Result
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% students.forEach(function(student, index) { %>

                                    <tr data-rtse-search-row="<%= JSON.stringify(student) %>">

                                        <td>
                                            <%= index + 1 %>
                                        </td>

                                        <td>
                                            <strong>
                                                <%= student.roll_no || "-" %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= student.registration_no || "-" %>
                                        </td>

                                        <td>

                                            <strong>
                                                <%= student.full_name || "-" %>
                                            </strong>

                                            <br>

                                            <small>
                                                <%= student.school_name || "-" %>
                                            </small>

                                        </td>

                                        <td>
                                            <%= student.section || "-" %>
                                        </td>

                                        <td>

                                            <span class="badge badge-success">
                                                PRESENT
                                            </span>

                                        </td>

                                        <td>

                                            <% if (student.result_id) { %>

                                                <span class="badge badge-success">
                                                    <%= student.result_status || "Entered" %>
                                                </span>

                                                <% if (student.marks !== null && student.marks !== undefined) { %>

                                                    <br>

                                                    <small>
                                                        OMR:
                                                        <%= student.marks %> / 100

                                                        <% (markComponents || []).forEach(function(component) { %>
                                                            · <%= component.name %>:
                                                            <%= student.component_marks && student.component_marks[component.id] != null
                                                                ? student.component_marks[component.id]
                                                                : 0 %> / <%= component.maximum_marks %>
                                                        <% }); %>

                                                        <% if (student.total_marks !== null && student.total_marks !== undefined) { %>
                                                            · Total:
                                                            <%= student.total_marks %> / <%= student.total_full_marks %>
                                                        <% } else { %>
                                                            · Total:
                                                            <%= student.marks %> / 100
                                                        <% } %>

                                                        <% if (student.percentage !== null && student.percentage !== undefined) { %>
                                                            · <%= student.percentage %>%
                                                        <% } %>

                                                        <% if (student.grade) { %>
                                                            · Grade <%= student.grade %>
                                                        <% } %>
                                                    </small>

                                                <% } %>



                                            <% } else { %>
                                                <span class="badge badge-warning">
                                                    Pending
                                                </span>

                                            <% } %>

                                        </td>

                                        <td>

                                            <a
                                                href="/admin/rtse/result/<%= student.application_id %>"
                                                class="btn-save rtse-result-popup-trigger"
                                                data-result-url="/admin/rtse/result/<%= student.application_id %>?popup=1"
                                            >
                                                <%= student.result_id
                                                    ? "Edit Result"
                                                    : "Enter Result" %>
                                            </a>


                                            <%
                                            const countedOmr =
                                                countedOmrByApplication &&
                                                countedOmrByApplication[
                                                    Number(
                                                        student.application_id
                                                    )
                                                ];
                                            %>

                                            <% if (countedOmr) { %>
                                                <a
                                                    href="/admin/rtse/counted-omr/<%= student.application_id %>"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="btn-save rtse-counted-omr-view-btn"
                                                    style="margin-left:6px;"
                                                >
                                                    See Counted OMR
                                                </a>
                                                <button
                                                    type="button"
                                                    class="btn-save rtse-counted-omr-delete-btn"
                                                    style="margin-left:6px;"
                                                    data-application-id="<%= student.application_id %>"
                                                >
                                                    Delete Counted OMR
                                                </button>
                                            <% } %>
</td>

                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </div>

    </main>

</div>


<!-- RTSE Result Entry Modal -->
<div id="rtseResultPopup" class="rtse-result-modal">

    <div class="rtse-result-modal-card">

        <div class="rtse-result-modal-header">

            <div>
                <div class="rtse-result-modal-title">
                    Enter Result
                </div>

                <div class="rtse-result-modal-subtitle">
                    RTSE Student Result
                </div>
            </div>

            <button
                type="button"
                id="rtseResultPopupClose"
                class="rtse-result-modal-close"
                aria-label="Close"
            >×</button>

        </div>


        <div
            id="rtseResultPopupContent"
            class="rtse-result-modal-content"
        ></div>

    </div>

</div>


<style>

.rtse-result-modal {
    display:none;
    position:fixed;
    inset:0;
    z-index:99999;
    box-sizing:border-box;
    padding:12px;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    background:rgba(15,23,42,.58);
    backdrop-filter:blur(3px);
}

.rtse-result-modal.is-open {
    display:flex;
}

.rtse-result-modal-card {
    width:min(500px,94vw);
    max-height:min(560px,88vh);
    display:flex;
    flex-direction:column;
    overflow:hidden;
    box-sizing:border-box;
    background:#fff;
    border-radius:13px;
    box-shadow:0 18px 55px rgba(0,0,0,.30);
}

.rtse-result-modal-header {
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:11px 14px;
    border-bottom:1px solid #e5e7eb;
}

.rtse-result-modal-title {
    font-size:17px;
    line-height:1.2;
    font-weight:700;
    color:#172033;
}

.rtse-result-modal-subtitle {
    margin-top:2px;
    font-size:10px;
    color:#6b7280;
}

.rtse-result-modal-close {
    width:30px;
    height:30px;
    flex:0 0 30px;
    padding:0;
    border:0;
    border-radius:50%;
    background:#f1f3f5;
    color:#374151;
    font-size:20px;
    line-height:30px;
    cursor:pointer;
}

.rtse-result-modal-content {
    flex:1 1 auto;
    min-height:0;
    overflow-y:auto;
    overflow-x:hidden;
    padding:11px 12px 12px;
    box-sizing:border-box;
}

@media (max-width:600px) {

    .rtse-result-modal {
        padding:8px;
    }

    .rtse-result-modal-card {
        width:94vw;
        max-height:82vh;
        border-radius:11px;
    }

    .rtse-result-modal-header {
        padding:9px 11px;
    }

    .rtse-result-modal-title {
        font-size:15px;
    }

    .rtse-result-modal-content {
        padding:9px;
    }
}

</style>


<script>
(function () {

    const popup =
        document.getElementById("rtseResultPopup");

    const content =
        document.getElementById("rtseResultPopupContent");

    const closeButton =
        document.getElementById("rtseResultPopupClose");


    if (!popup || !content || !closeButton) {
        return;
    }


    function closePopup() {

        popup.classList.remove("is-open");

        content.innerHTML = "";

        document.body.style.overflow = "";

    }


    function calculateResult() {
        const marks =
            content.querySelector("#marks");

        const totalMarks =
            content.querySelector("#total_marks");

        const totalFullMarks =
            content.querySelector("#total_full_marks");

        const percentage =
            content.querySelector("#percentage");

        const grade =
            content.querySelector("#grade");

        const componentInputs =
            content.querySelectorAll("[data-rtse-component-mark]");


        if (
            !marks ||
            !totalMarks ||
            !totalFullMarks ||
            !percentage ||
            !grade
        ) {
            return;
        }


        function calculate() {
            const omrObtained =
                parseFloat(marks.value) || 0;

            let configuredObtained = 0;
            let configuredFullMarks = 0;


            componentInputs.forEach(function (input) {
                const maximum =
                    parseFloat(input.dataset.componentMax) || 0;

                const obtained =
                    parseFloat(input.value) || 0;

                configuredObtained += obtained;
                configuredFullMarks += maximum;
            });


            const total =
                omrObtained + configuredObtained;

            const totalFull =
                100 + configuredFullMarks;

            const per =
                totalFull > 0
                    ? ((total / totalFull) * 100).toFixed(2)
                    : "0.00";


            totalMarks.value =
                Number(total.toFixed(2));

            totalFullMarks.value =
                Number(totalFull.toFixed(2));

            percentage.value = per;


            const percentageNumber =
                parseFloat(per) || 0;


            if (percentageNumber >= 90) {
                grade.value = "A+";
            } else if (percentageNumber >= 80) {
                grade.value = "A";
            } else if (percentageNumber >= 70) {
                grade.value = "B+";
            } else if (percentageNumber >= 60) {
                grade.value = "B";
            } else if (percentageNumber >= 50) {
                grade.value = "C";
            } else if (percentageNumber >= 40) {
                grade.value = "D";
            } else {
                grade.value = "F";
            }
        }


        marks.addEventListener("input", calculate);

        componentInputs.forEach(function (input) {
            input.addEventListener("input", calculate);
        });


        calculate();
    }


    function initializeForms() {

        calculateResult();


        content
            .querySelectorAll("form")
            .forEach(function (form) {

                form.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();


                        const submitter =
                            event.submitter;


                        let action =
                            form.getAttribute("action");

                        if (
                            submitter &&
                            submitter.hasAttribute("formaction")
                        ) {
                            action =
                                submitter.getAttribute("formaction");
                        }


                        if (!action) {
                            return;
                        }


                        if (
                            form.id ===
                            "rtseResetResultForm"
                        ) {

                            if (
                                !confirm(
                                    "Reset this result to Pending? The student will remain PRESENT and stay in the Result Dashboard."
                                )
                            ) {
                                return;
                            }

                        }


                        if (
                            form.id ===
                            "rtseAttendanceResetForm"
                        ) {

                            if (
                                !confirm(
                                    "Reset Attendance Status?\n\nThe student will become NOT SCANNED, leave the Result Dashboard, have the existing result removed, and can be scanned again using the same admit card QR."
                                )
                            ) {
                                return;
                            }

                        }


                        let requestOptions = {
                            method:"POST",
                            credentials:"same-origin",
                            redirect:"follow",
                            headers:{
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        };

                        if (form.id === "rtseResultForm") {
                            const marksInput =
                                form.querySelector("#marks");

                            const componentInputs =
                                form.querySelectorAll(
                                    "[data-rtse-component-mark]"
                                );

                            const omrMarks =
                                Number(
                                    marksInput
                                        ? marksInput.value
                                        : NaN
                                );

                            const componentMarks = {};

                            componentInputs.forEach(
                                function(input) {
                                    const componentId =
                                        Number(
                                            input.dataset.componentId
                                        );

                                    if (
                                        Number.isInteger(componentId) &&
                                        componentId > 0
                                    ) {
                                        componentMarks[componentId] =
                                            input.value === ""
                                                ? 0
                                                : Number(input.value);
                                    }
                                }
                            );

                            requestOptions.headers["Content-Type"] =
                                "application/json";

                            requestOptions.body =
                                JSON.stringify({
                                    marks: omrMarks,
                                    component_marks: componentMarks
                                });
                        } else {
                            const formData =
                                new FormData(form);

                            requestOptions.body =
                                new URLSearchParams(formData);
                        }

                        try {

                            const response =
                                await fetch(
                                    action,
                                    requestOptions
                                );

                            if (!response.ok) {
                                throw new Error(
                                    "Request failed."
                                );
                            }


                            closePopup();

                            window.location.reload();


                        } catch (error) {

                            console.error(error);

                            alert(
                                "Unable to save the result. Please try again."
                            );

                        }

                    }
                );

            });


        const saveResultButton =
            content.querySelector("#rtseSaveResultButton");

        const resultForm =
            content.querySelector("#rtseResultForm");

        if (saveResultButton && resultForm) {
            saveResultButton.addEventListener(
                "click",
                function () {
                    if (typeof resultForm.requestSubmit === "function") {
                        resultForm.requestSubmit();
                    } else {
                        resultForm.submit();
                    }
                }
            );
        }

        content
            .querySelectorAll("[data-rtse-popup-close]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    closePopup
                );

            });

    }


    async function openPopup(url) {

        if (!url) {
            return;
        }


        popup.classList.add("is-open");

        document.body.style.overflow = "hidden";


        content.innerHTML =
            '<div style="padding:35px;text-align:center;font-size:13px;color:#6b7280;">Loading...</div>';


        try {

            const response =
                await fetch(
                    url,
                    {
                        credentials:"same-origin",
                        headers:{
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );


            if (!response.ok) {
                throw new Error(
                    "Unable to load Result Entry."
                );
            }


            content.innerHTML =
                await response.text();



                            if (
                                typeof window.initializeRtseCountedOmr ===
                                "function"
                            ) {
                                const resultForm =
                                    content.querySelector("#rtseResultForm");

                                const resultAction =
                                    resultForm
                                        ? resultForm.getAttribute("action")
                                        : "";

                                const match =
                                    resultAction.match(/\/result\/(\d+)(?:$|[?#])/);

                                const applicationId =
                                    match
                                        ? Number(match[1])
                                        : 0;

                                if (applicationId > 0) {
                                    window.initializeRtseCountedOmr(
                                        content,
                                        applicationId
                                    );
                                }
                            }

                            initializeForms();



            content.scrollTop = 0;


        } catch (error) {

            console.error(error);

            content.innerHTML =
                '<div style="padding:35px;text-align:center;color:#dc2626;font-size:13px;">Unable to load Result Entry.</div>';

        }

    }


    document
        .querySelectorAll(
            ".rtse-result-popup-trigger"
        )
        .forEach(function (link) {

            link.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    const url =
                        this.getAttribute(
                            "data-result-url"
                        ) ||
                        this.getAttribute("href");


                    openPopup(url);

                }
            );

        });


    closeButton.addEventListener(
        "click",
        closePopup
    );


    popup.addEventListener(
        "click",
        function (event) {

            if (event.target === popup) {
                closePopup();
            }

        }
    );


    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                popup.classList.contains("is-open")
            ) {
                closePopup();
            }

        }
    );

})();
</script>


<%- include("../partials/footer") %>


<script>
document.addEventListener("click", async function (event) {
    const button = event.target.closest(".rtse-counted-omr-delete-btn");
    if (!button) return;

    const applicationId = button.dataset.applicationId;

    if (!confirm(
        "Delete this student's Counted OMR?\n\n" +
        "This will delete only the Counted OMR. " +
        "The original/generated OMR and other student files will not be affected."
    )) {
        return;
    }

    button.disabled = true;
    const originalText = button.textContent;
    button.textContent = "Deleting...";

    try {
        const response = await fetch(
            "/admin/rtse/counted-omr/" + encodeURIComponent(applicationId) + "/delete",
            {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(
                data.message || "Unable to delete Counted OMR."
            );
        }

        window.location.reload();
    } catch (error) {
        alert(error.message || "Unable to delete Counted OMR.");
        button.disabled = false;
        button.textContent = originalText;
    }
});
</script>

<script>
(function () {
    const searchInput =
        document.getElementById("rtseStudentLiveSearch");

    const clearButton =
        document.getElementById("rtseStudentLiveSearchClear");

    const countElement =
        document.getElementById("rtseStudentLiveSearchCount");

    if (!searchInput || !clearButton || !countElement) {
        return;
    }

    const rows = Array.from(
        document.querySelectorAll(
            "tr[data-rtse-search-row]"
        )
    );

    const searchableRows = rows.map(function (row) {
        let searchableText = "";

        try {
            const student =
                JSON.parse(
                    row.getAttribute(
                        "data-rtse-search-row"
                    ) || "{}"
                );

            searchableText =
                Object.keys(student)
                    .map(function (key) {
                        const value = student[key];

                        if (
                            value &&
                            typeof value === "object"
                        ) {
                            return JSON.stringify(value);
                        }

                        return String(
                            value == null ? "" : value
                        );
                    })
                    .join(" ");
        } catch (error) {
            console.error(
                "Unable to prepare RTSE student search data.",
                error
            );
        }

        return {
            row: row,
            text: searchableText.toLowerCase()
        };
    });

    function updateSearch() {
        const query =
            String(searchInput.value || "")
                .trim()
                .toLowerCase();

        const terms =
            query
                ? query.split(/\s+/).filter(Boolean)
                : [];

        let visibleCount = 0;

        searchableRows.forEach(function (item) {
            const matches =
                terms.length === 0 ||
                terms.every(function (term) {
                    return item.text.includes(term);
                });

            item.row.style.display =
                matches ? "" : "none";

            if (matches) {
                visibleCount++;
            }
        });

        countElement.textContent =
            "Showing " +
            visibleCount +
            " of " +
            searchableRows.length +
            " student(s)";
    }

    searchInput.addEventListener(
        "input",
        updateSearch
    );

    clearButton.addEventListener(
        "click",
        function () {
            searchInput.value = "";
            searchInput.focus();
            updateSearch();
        }
    );

    updateSearch();
})();
</script>
