<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>Edit RTSE Application</h1>

                <a href="/admin/rtse" class="btn-view">
                    Back
                </a>

            </div>

            <form
                action="/admin/rtse/application/<%= application.id %>/edit"
                method="POST"
                enctype="multipart/form-data"
                data-history-fix="off">

                <div class="profile-card">

                    <div class="form-grid">

                        <div class="form-group">
                            <label>Full Name</label>
                            <input
                                type="text"
                                name="full_name"
                                value="<%= application.full_name %>"
                                required>
                        </div>

                        <div class="form-group">
                            <label>Father Name</label>
                            <input
                                type="text"
                                name="father_name"
                                value="<%= application.father_name %>">
                        </div>

                        <div class="form-group">
                            <label>Mother Name</label>
                            <input
                                type="text"
                                name="mother_name"
                                value="<%= application.mother_name %>">
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select name="gender" required>
                                <option value="">Select</option>
                                <option value="Male" <%= application.gender === "Male" ? "selected" : "" %>>Male</option>
                                <option value="Female" <%= application.gender === "Female" ? "selected" : "" %>>Female</option>
                                <option value="Other" <%= application.gender === "Other" ? "selected" : "" %>>Other</option>
                            </select>
                        </div>


                        <div class="form-group">
                            <label>Date of Birth</label>
                            <input
                                type="date"
                                name="dob"
                                value="<%= application.dob ? new Date(application.dob).toISOString().split('T')[0] : '' %>">
                        </div>

                        <div class="form-group">
                            <label>Mobile</label>
                            <input
                                type="text"
                                name="mobile"
                                value="<%= application.mobile %>">
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input
                                type="email"
                                name="email"
                                value="<%= application.email %>">
                        </div>

                        <div class="form-group">
                              <label>Registered School</label>
                              <select name="school_id" required>
                                  <option value="">Select Registered School</option>

                                  <% (schools || []).forEach(school => { %>
                                      <option
                                          value="<%= school.id %>"
                                          <%= Number(application.school_id) === Number(school.id) ? "selected" : "" %>>
                                          <%= school.school_name %>
                                          <% if (school.school_code) { %>
                                              — <%= school.school_code %>
                                          <% } %>
                                      </option>
                                  <% }) %>
                              </select>
                          </div>

                        <div class="form-group">
                            <label>District</label>
                            <input
                                type="text"
                                name="district"
                                value="<%= application.district %>">
                        </div>

                        <div class="form-group">
                            <label>State</label>
                            <input
                                type="text"
                                name="state"
                                value="<%= application.state %>">
                        </div>
                        <div class="form-group">
                            <label>Pincode</label>
                            <input
                                type="text"
                                name="pincode"
                                value="<%= application.pincode || '' %>"
                                maxlength="6"
                                inputmode="numeric"
                                required
                            >
                        </div>


                        <div class="form-group">
                            <label>Class</label>
                            <input
                                type="number"
                                name="class"
                                value="<%= application.class %>">
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label>Address</label>
                            <textarea
                                name="address"
                                rows="4"
                                required
                            ><%= application.address || '' %></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label>Candidate Photo</label>

                            <% if (application.photo) { %>
                                <div style="margin:8px 0 12px;">
                                    <img
                                        id="currentRtsePhoto"
                                        src="/uploads/rtse/<%= application.photo %>"
                                        alt="Current candidate photo"
                                        style="
                                            width:120px;
                                            height:150px;
                                            object-fit:cover;
                                            border:1px solid #ddd;
                                            border-radius:8px;
                                            display:block;
                                            background:#f5f5f5;
                                        "
                                    >
                                    <small style="display:block;margin-top:6px;color:#555;">
                                        Current photo
                                    </small>
                                </div>
                            <% } %>

                            <input
                                type="file"
                                name="photo"
                                id="adminRtsePhoto"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            >

                            <div
                                id="adminRtsePhotoInfo"
                                style="
                                    margin-top:8px;
                                    color:#555;
                                    font-size:13px;
                                    line-height:1.5;
                                "
                            >
                                Optional — upload a new photo only if you want to replace the current photo.
                                The system will automatically resize and compress it to reduce file size.
                                Maximum upload size: 5 MB.
                            </div>

                            <img
                                id="adminRtsePhotoPreview"
                                alt="New candidate photo preview"
                                style="
                                    display:none;
                                    margin-top:12px;
                                    width:120px;
                                    height:150px;
                                    object-fit:cover;
                                    border:1px solid #ddd;
                                    border-radius:8px;
                                    background:#f5f5f5;
                                "
                            >
                        </div>



                        <div class="form-group">
                            <label>Status</label>

                            <select name="status">

                                <option
                                    value="Pending"
                                    <%= application.status==="Pending"?"selected":"" %>>

                                    Pending

                                </option>

                                <option
                                    value="Approved"
                                    <%= application.status==="Approved"?"selected":"" %>>

                                    Approved

                                </option>

                                <option
                                    value="Rejected"
                                    <%= application.status==="Rejected"?"selected":"" %>>

                                    Rejected

                                </option>

                            </select>

                        </div>

                    </div>

                    <br>

                    <button
                        type="submit"
                        class="btn-save">

                        Update Application

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>

<script>
(function () {
    const input = document.getElementById("adminRtsePhoto");
    const preview = document.getElementById("adminRtsePhotoPreview");
    const info = document.getElementById("adminRtsePhotoInfo");

    if (!input || !preview || !info) {
        return;
    }

    input.addEventListener("change", function () {
        const file = input.files && input.files[0];

        if (!file) {
            preview.removeAttribute("src");
            preview.style.display = "none";
            info.textContent =
                "Optional — upload a new photo only if you want to replace the current photo. The system will automatically resize and compress it to reduce file size. Maximum upload size: 5 MB.";
            return;
        }

        const sizeMb = file.size / (1024 * 1024);

        if (sizeMb > 5) {
            input.value = "";
            preview.removeAttribute("src");
            preview.style.display = "none";
            info.textContent =
                "Selected image is larger than 5 MB. Please choose a smaller image.";
            return;
        }

        info.textContent =
            "Selected: " +
            file.name +
            " (" +
            sizeMb.toFixed(2) +
            " MB). It will be automatically resized and compressed when saved.";

        const reader = new FileReader();

        reader.onload = function (event) {
            preview.src = event.target.result;
            preview.style.display = "block";
        };

        reader.readAsDataURL(file);
    });
})();
</script>

<%- include("../partials/footer") %>
