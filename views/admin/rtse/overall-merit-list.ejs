<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>Overall Merit List</title>

<style>

body{

    font-family:Arial,sans-serif;

    margin:20px;

    background:#f5f5f5;

}

.container{

    background:#fff;

    padding:20px;

    border:2px solid #000;

}

.header{

    text-align:center;

    border-bottom:2px solid #000;

    margin-bottom:20px;

    padding-bottom:15px;

}

.header h1{

    margin:0;

}

.header h2{

    margin:8px 0;

}

table{

    width:100%;

    border-collapse:collapse;

}

th,

td{

    border:1px solid #000;

    padding:8px;

    text-align:center;

}



.rank{

    font-size:18px;

    font-weight:bold;

}

.print{

    margin-bottom:20px;

    text-align:center;

}

@media print{

.print{

display:none;

}

body{

background:#fff;

}

}

</style>

</head>

<body>

<div class="print">

<button onclick="window.print()">

🖨 Print Merit List

</button>

</div>

<div class="container">

<div class="header">

<h1>

Ratabari Talent Search Examination

</h1>

<h2>

Overall Merit List

</h2>

</div>

<table>

<thead>

<tr>

<th>

Rank

</th>



<th>

Roll No.

</th>

<th>

Registration

</th>

<th>

  OMR Obtained Mark

  </th>

  <% (markComponents || []).forEach(component=>{ %>

  

  <% }) %>

  

  <% (markComponents || []).forEach(component=>{ %>
    <th>
    <%= component.name %> (<%= component.maximum_marks %>)
    </th>
<% }) %>




</tr>

</thead>

<tbody>

<% students.forEach(student=>{ %>

<tr>

<td class="rank">

<%= student.overall_rank %>

</td>



<td>

<%= student.roll_no %>

</td>

<td>

<%= student.registration_no %>

</td>

<td>
  <strong>

  <%= student.marks %>

  </strong>

  </td>

  <% (markComponents || []).forEach(component=>{ %>
    <td>
      <%
        const overallComponentMarks =
          student.component_marks && student.component_marks[component.id] != null
            ? Number(student.component_marks[component.id])
            : 0;

        const overallComponentMaximum = Number(component.maximum_marks || 0);
        const overallComponentPercentage =
          overallComponentMaximum > 0
            ? (overallComponentMarks / overallComponentMaximum) * 100
            : 0;

        let overallComponentGrade = "F";
        if (overallComponentPercentage >= 90) overallComponentGrade = "A+";
        else if (overallComponentPercentage >= 80) overallComponentGrade = "A";
        else if (overallComponentPercentage >= 70) overallComponentGrade = "B+";
        else if (overallComponentPercentage >= 60) overallComponentGrade = "B";
        else if (overallComponentPercentage >= 50) overallComponentGrade = "C+";
        else if (overallComponentPercentage >= 40) overallComponentGrade = "C";
      %>
      
     <% if (Number(component.grade_counting) === 1) { %>
    <strong><%= overallComponentGrade %></strong>
<% } %>

    </td>
  <% }) %>

  

  



</tr>

<% }) %>

</tbody>

</table>

</div>

</body>

</html>

