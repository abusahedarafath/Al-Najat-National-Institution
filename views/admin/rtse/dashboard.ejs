<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">
<%
    // RTSE sections MUST always remain in fixed order.
    // Never sort this list based on generated rolls/admit cards.
    const RTSE_FIXED_SECTION_ORDER = ["A", "B", "C", "D", "E"];

    const RTSE_SECTION_MAP = {};
    (Array.isArray(sectionStats) ? sectionStats : []).forEach(function(item) {
        RTSE_SECTION_MAP[String(item.section || "").toUpperCase()] = item;
    });

    const RTSE_SECTIONS_FIXED = RTSE_FIXED_SECTION_ORDER.map(function(section) {
        return RTSE_SECTION_MAP[section] || {
            section: section,
            application_open: false,
            roll_generated: 0,
            admit_generated: 0,
              omr_generated: 0
        };
    });
%>


        <div class="container">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-header rtse-examination-page-header">

                <h1>
                    RTSE Examination Dashboard
                </h1>

                <div class="rtse-header-actions">

                    <% if(setting.application_open){ %>

                        <a
                            href="/admin/rtse/close-applications"
                            class="btn-danger"
                            data-rtse-confirm-title="Close RTSE Applications"
                            data-rtse-confirm-message="Close RTSE Applications?\n\nApplicants will no longer be able to submit applications."
                        >
                            🔒 Close Applications
                        </a>

                    <% } else { %>

                        <a
                            href="/admin/rtse/open-applications"
                            class="btn-save"
                            data-rtse-confirm-title="Open RTSE Applications"
                            data-rtse-confirm-message="Open RTSE Applications?\n\nApplicants will be able to submit applications again."
                        >
                            🔓 Open Applications
                        </a>

                    <% } %>

<% if(admitGenerated){ %>
    <a
        href="/admin/rtse/admit-cards/pdf/all"
        class="btn-save"
    >
        🖨️ Print / Save All Generated Admit Cards
    </a>
<% } %>


                    <% if(admitGenerated){ %>

                        <% if(setting.admit_publish){ %>

                            <a
                                href="/admin/rtse/hide-admit"
                                class="btn-warning"
                                data-rtse-confirm-title="Hide Admit Cards"
                            data-rtse-confirm-message="Hide Admit Cards?\n\nPublished Admit Cards will no longer be visible to students."
                            >
                                🙈 Hide Admit Cards
                            </a>

                        <% } else { %>

                            <a
                                href="/admin/rtse/publish-admit"
                                class="btn-save"
                                data-rtse-confirm-title="Publish Admit Cards"
                            data-rtse-confirm-message="Publish Admit Cards?\n\nThe generated Admit Cards will become available to students."
                            >
                                📢 Publish Admit Cards
                            </a>

                        <% } %>

                    <% } %>


                    <a
                        href="/admin/rtse/export"
                        class="btn-view"
                    >
                        📊 Export All Students
                    </a>
                            <a
                                href="/admin/rtse/export/approved"
                                class="btn-save"
                            >
                                ✅ Export Approved Students
                            </a>


                    <a
                        href="/admin/rtse/archive"
                        class="btn-warning"
                    >
                        🗂 Archive
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 OVERALL STATISTICS
            ====================================================== -->

            <div class="rtse-statistics-grid">

                <!-- Total -->

                <a
                    href="/admin/rtse/applications"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Total Applications</h3>

                    <h1>
                        <%= total %>
                    </h1>
                </a>


                <!-- Pending -->

                <a
                    href="/admin/rtse/applications?status=Pending"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Pending</h3>

                    <h1 class="rtse-stat-pending">
                        <%= pending %>
                    </h1>
                </a>


                <!-- Approved -->

                <a
                    href="/admin/rtse/applications?status=Approved"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Approved</h3>

                    <h1 class="rtse-stat-approved">
                        <%= approved %>
                    </h1>
                </a>


                <!-- Rejected -->

                <a
                    href="/admin/rtse/applications?status=Rejected"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Rejected</h3>

                    <h1 class="rtse-stat-rejected">
                        <%= rejected %>
                    </h1>
                </a>


                    <!-- Invited Schools -->
<a
    href="/admin/rtse/invited-schools"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Invited Schools</h3>

    <h1>
        <%= invitedSchoolCount || 0 %>
    </h1>
</a>

<!-- Students Without School -->
<a
    href="/admin/rtse/students-without-school"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Students Without School</h3>

    <h1>
        <%= studentsWithoutSchoolCount || 0 %>
    </h1>
</a>

<!-- Students Not Sent To Centre -->
<a
    href="/admin/rtse/students-not-sent-to-centre"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Students Not Sent to Centre</h3>

    <h1>
        <%= studentsNotSentToCentreCount || 0 %>
    </h1>
</a>

<!-- Gender Statistics -->
                    <div class="rtse-stat-card rtse-gender-stat-card">
                        <h3>Gender Statistics</h3>
                        <div class="rtse-gender-stat-values">
                            <div>
                                <span>Male</span>
                                <strong><%= male %></strong>
                            </div>
                            <div>
                                <span>Female</span>
                                <strong><%= female %></strong>
                            </div>
                        </div>
                    </div>
</div>

            <!-- =====================================================
                 ROLL & ADMIT MANAGEMENT
            ====================================================== -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Roll Number & Admit Card Management
                </h2>


                <!-- =================================================
                     SECTION A-E GRID
                ================================================== -->

                <div class="rtse-section-grid">


        <% RTSE_FIXED_SECTION_ORDER.forEach(section=>{ %>

                        <% const data =
                            RTSE_SECTION_MAP[section] || {};
                        %>


                        <!-- ==============================
                             SECTION CARD
                        =============================== -->

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= section %>
                            </h3>

                            <hr>


                            <p>
                                Total Applications
                            </p>

                            <h2>
                                <%= data.total || 0 %>
                            </h2>


                            <p>
                                Approved :
                                <strong>
                                    <%= data.approved || 0 %>
                                </strong>
                            </p>


                            <p>
                                Pending :
                                <strong>
                                    <%= data.pending || 0 %>
                                </strong>
                            </p>



                            <p class="rtse-section-gender">
                                Approved Male :
                                <strong>
                                    <%= Number(data.approved_male || 0) %>
                                </strong>
                            </p>

                            <p class="rtse-section-gender">
                                Approved Female :
                                <strong>
                                    <%= Number(data.approved_female || 0) %>
                                </strong>
                            </p>
                            <p>
                                Roll Generated :
                                <strong>
                                    <%= Number(data.roll_generated || 0) %>
                                </strong>
                            </p>


                            <p>
                                Admit Generated :
                                <strong>
                                    <%= Number(data.admit_generated || 0) %>
                                </strong>
                            </p>
            <p>
                OMR Generated :
                <strong><%= Number(data.omr_generated || 0) %></strong>
            </p>


                            <!-- SECTION ACTIONS -->

                            <div class="rtse-section-actions">

                                <a
                                    href="/admin/rtse/approved/<%= section %>"
                                    class="btn-view"
                                >
                                    👥 Manage Approved Students
                                </a>


                                <a
                                    href="/admin/rtse/export/<%= section %>"
                                    class="btn-save"
                                >
                                    📊 Section Excel
                                </a>

                                <% if(Number(data.admit_generated || 0) > 0){ %>
                                    <a
                                        href="/admin/rtse/admit-cards/pdf/<%= section %>"
                                        class="btn-save"
                                    >
                                        🖨️ Print / Save All Admit Cards
                                    </a>
                                      <% if(Number(data.omr_generated || 0) > 0){ %>
                            <a
                                href="/admin/rtse/omr/pdf/<%= section %>"
                                class="btn-save">
                                📝 Download Section OMR
                            </a>
                                      <% } %>
                                <a
                                    href="/admin/rtse/seat-plan/<%= section %>"
                                    class="btn-view"
                                >
                                    🪑 View Seat Plan
                                </a>

                                <a
                                    href="/admin/rtse/attendance-sheet/<%= section %>"
                                    class="btn-view"
                                >
                                    📋 View Attendance Sheet
                                </a>
                                <% } %>

                            </div>


                            <!-- INDEPENDENT OMR LIFECYCLE -->
<div class="rtse-generation-action">
    <% if(Number(data.admit_generated || 0) > 0 && !setting.admit_publish){ %>
        <% if(Number(data.omr_generated || 0) === 0){ %>
            <form
                method="POST"
                action="/admin/rtse/omr/generate/<%= section %>"
                style="display:inline;"
                data-rtse-confirm-title="Generate OMR Sheets"
                data-rtse-confirm-message="Generate OMR sheets for Section <%= section %>?\n\nThis will refresh each student Result QR token. Attendance and PRESENT status will not be changed."
            >
                <button type="submit" class="btn-save">
                    📝 Generate OMR
                </button>
            </form>
        <% } else { %>
            <span class="badge badge-success">
                ✔ OMR Generated
            </span>
            <form
                method="POST"
                action="/admin/rtse/omr/reset/<%= section %>"
                style="display:inline;"
                data-rtse-confirm-title="Reset OMR Generation"
                data-rtse-confirm-message="Reset OMR generation for Section <%= section %>?\n\nAdmit Cards, Roll Numbers, Attendance and PRESENT status will remain unchanged."
            >
                <button type="submit" class="btn-warning">
                    ↩ Reset OMR
                </button>
            </form>
        <% } %>
    <% } %>
</div>

<!-- GENERATION ACTION -->

                            <div class="rtse-generation-action">

                                <% if(setting.application_open){ %>

                                    <button
                                        class="btn-warning"
                                        disabled
                                    >
                                        Applications Open
                                    </button>


                                <% } else { %>
                                    <% if(Number(data.roll_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/generate-roll/<%= section %>"
                                            class="btn-save"
                                            data-rtse-confirm-title="Generate Roll Numbers"
                                        data-rtse-confirm-message="Generate Roll Numbers for Section <%= section %>?"
                                        >
                                            Generate Roll Number
                                        </a>

                                    <% } else if(Number(data.admit_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/admit-generator/<%= section %>"
                                            class="btn-view"
                                        >
                                            Generate Admit Cards
                                        </a>


                                        <% if(!setting.admit_publish){ %>
<form
                                                method="POST"
                                                action="/admin/rtse/reset-roll/<%= section %>"
                                                style="display:inline;"
                                                data-rtse-confirm-title="Reset Roll Number & Admit"
                                                data-rtse-confirm-message="Reset Roll No. for Section <%= section %>?\n\nThis will reset generated roll numbers and admit-card status for this section. Existing attendance records are protected."
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn-warning"
                                                >
                                                    ↩ Reset Roll No.
                                                </button>
                                            </form>

                                        <% } %>

                                    <% } else { %>

                                        <span class="badge badge-success">
                                            ✔ Admit Cards Generated
                                        </span>

                                        <% if(!setting.admit_publish){ %>
                                        <form
                                                method="POST"
                                                action="/admin/rtse/reset-roll/<%= section %>"
                                                style="display:inline;"
                                                data-rtse-confirm-title="Reset Roll Number & Admit"
                                                data-rtse-confirm-message="Reset Roll No. for Section <%= section %>?\n\nThis will reset generated roll numbers and admit-card status for this section. Existing attendance records are protected."
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn-warning"
                                                >
                                                    ↩ Reset Roll No.
                                                </button>
                                            </form>
                                        <% } %>

                                    <% } %>
<% } %>

                            </div>
                            <div
                            class="rtse-login-information-pdf-action"
                            data-rtse-login-pdf-section="<%= section %>"
                            style="margin-top:10px;"
                        >
                            <button
                                type="button"
                                class="btn-view"
                                style="border:0;cursor:pointer;"
                                onclick="prepareRtseLoginInformationPdf('<%= section %>', this)"
                            >
                                Prepare Login Information PDF
                            </button>
                        </div>
</div>

                    <% }) %>

                </div>

            </div>


            <!-- =====================================================
                 APPLICATION REGISTRY
            ====================================================== -->

            <div class="profile-card">

                <div class="rtse-table-wrapper">

                    <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">Search Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>



    </div>



            </div>

        </div>



<!-- =========================================================
     RTSE RESET CONFIRMATION MODAL
     ========================================================= -->
<div
    id="rtseConfirmOverlay"
    class="rtse-confirm-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rtseConfirmTitle"
    aria-describedby="rtseConfirmMessage"
>
    <div class="rtse-confirm-modal">
        <div class="rtse-confirm-header">
            <div class="rtse-confirm-icon" aria-hidden="true">!</div>
            <h3 id="rtseConfirmTitle" class="rtse-confirm-title">
                Confirm Action
            </h3>
        </div>

        <div class="rtse-confirm-body">
            <p id="rtseConfirmMessage" class="rtse-confirm-message"></p>

            <div class="rtse-confirm-warning">
                Please confirm before continuing. Choosing Cancel will leave
                the current RTSE state completely unchanged.
            </div>
        </div>

        <div class="rtse-confirm-actions">
            <button
                type="button"
                id="rtseConfirmCancel"
                class="rtse-confirm-btn rtse-confirm-cancel"
            >
                Cancel
            </button>

            <button
                type="button"
                id="rtseConfirmContinue"
                class="rtse-confirm-btn rtse-confirm-continue"
            >
                OK, Continue
            </button>
        </div>
    </div>
</div>


<style>
/* =========================================================
   RTSE CONFIRMATION MODAL
   Isolated from the existing RTSE dashboard components.
   ========================================================= */

.rtse-confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(15, 23, 42, 0.68);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
}

.rtse-confirm-overlay.is-visible {
    display: flex;
}

.rtse-confirm-modal {
    width: min(460px, 100%);
    background: #ffffff;
    border-radius: 18px;
    box-shadow:
        0 24px 70px rgba(0, 0, 0, 0.28),
        0 8px 24px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    animation: rtseConfirmModalIn 0.18s ease-out;
}

@keyframes rtseConfirmModalIn {
    from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.rtse-confirm-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 22px 16px;
    border-bottom: 1px solid #e5e7eb;
}

.rtse-confirm-icon {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff7ed;
    color: #c2410c;
    font-size: 21px;
    font-weight: 700;
}

.rtse-confirm-title {
    margin: 0;
    color: #111827;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
}

.rtse-confirm-body {
    padding: 20px 22px 8px;
}

.rtse-confirm-message {
    margin: 0;
    color: #4b5563;
    font-size: 14px;
    line-height: 1.65;
    white-space: pre-line;
}

.rtse-confirm-warning {
    margin-top: 15px;
    padding: 11px 13px;
    border-left: 4px solid #f59e0b;
    border-radius: 7px;
    background: #fffbeb;
    color: #92400e;
    font-size: 13px;
    line-height: 1.5;
}

.rtse-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 18px 22px 22px;
}

.rtse-confirm-btn {
    min-width: 105px;
    min-height: 42px;
    padding: 9px 17px;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    transition:
        transform 0.12s ease,
        box-shadow 0.12s ease,
        opacity 0.12s ease;
}

.rtse-confirm-btn:hover {
    transform: translateY(-1px);
}

.rtse-confirm-btn:active {
    transform: translateY(0);
}

.rtse-confirm-cancel {
    background: #f3f4f6;
    color: #374151;
}

.rtse-confirm-cancel:hover {
    background: #e5e7eb;
}

.rtse-confirm-continue {
    background: #b91c1c;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(185, 28, 28, 0.22);
}

.rtse-confirm-continue:hover {
    background: #991b1b;
}

.rtse-confirm-overlay.rtse-confirm-omr .rtse-confirm-icon {
    background: #eff6ff;
    color: #1d4ed8;
}

.rtse-confirm-overlay.rtse-confirm-omr .rtse-confirm-continue {
    background: #1d4ed8;
    box-shadow: 0 4px 12px rgba(29, 78, 216, 0.22);
}

.rtse-confirm-overlay.rtse-confirm-omr .rtse-confirm-continue:hover {
    background: #1e40af;
}

@media (max-width: 520px) {
    .rtse-confirm-overlay {
        padding: 14px;
    }

    .rtse-confirm-modal {
        border-radius: 15px;
    }

    .rtse-confirm-header {
        padding: 18px 18px 14px;
    }

    .rtse-confirm-body {
        padding: 18px 18px 6px;
    }

    .rtse-confirm-actions {
        padding: 16px 18px 18px;
    }

    .rtse-confirm-btn {
        flex: 1;
        min-width: 0;
    }
}
</style>

<script>
(function () {
    "use strict";

    const overlay = document.getElementById("rtseConfirmOverlay");
    const title = document.getElementById("rtseConfirmTitle");
    const message = document.getElementById("rtseConfirmMessage");
    const cancelButton = document.getElementById("rtseConfirmCancel");
    const continueButton = document.getElementById("rtseConfirmContinue");

    if (!overlay || !title || !message || !cancelButton || !continueButton) {
        console.warn("RTSE confirmation modal could not be initialized.");
        return;
    }

    let pendingForm = null;
    let pendingTrigger = null;
    let pendingResolve = null;

    function closeRtseConfirmModal(result) {
        const resolve = pendingResolve;

        pendingForm = null;
        pendingTrigger = null;
        pendingResolve = null;

        overlay.classList.remove("is-visible");
        overlay.classList.remove("rtse-confirm-omr");
        overlay.classList.remove("rtse-confirm-danger");
        overlay.classList.remove("rtse-confirm-action");
        document.body.style.overflow = "";

        if (typeof resolve === "function") {
            resolve(Boolean(result));
        }
    }

    function openRtseConfirmModal(form, trigger) {
        pendingForm = form || null;
        pendingTrigger = trigger || null;

        const source = form || trigger;

        const confirmTitle =
            source.getAttribute("data-rtse-confirm-title") ||
            "Confirm Action";

        const confirmMessage = (
            source.getAttribute("data-rtse-confirm-message") ||
            "Are you sure you want to continue?"
        ).replace(/\\n/g, "\n");

        title.textContent = confirmTitle;
        message.textContent = confirmMessage;

        const action = String(source.getAttribute("action") || "")
            .toLowerCase();

        const titleText = confirmTitle.toLowerCase();

        const isOmr =
            action.includes("/admin/rtse/omr/") ||
            titleText.includes("omr");

        const isDanger =
            titleText.includes("reset") ||
            titleText.includes("close") ||
            titleText.includes("hide");

        overlay.classList.toggle("rtse-confirm-omr", isOmr);
        overlay.classList.toggle("rtse-confirm-danger", isDanger);
        overlay.classList.toggle("rtse-confirm-action", !isDanger);

        overlay.classList.add("is-visible");
        document.body.style.overflow = "hidden";

        window.setTimeout(function () {
            continueButton.focus();
        }, 0);
    }

    function requestRtseConfirmation(source) {
        return new Promise(function (resolve) {
            pendingForm = source instanceof HTMLFormElement ? source : null;
            pendingTrigger = source instanceof HTMLElement ? source : null;
            pendingResolve = resolve;

            openRtseConfirmModal(
                pendingForm,
                pendingTrigger
            );
        });
    }

    // --------------------------------------------------------
    // Forms: stop submission BEFORE the browser can submit.
    // --------------------------------------------------------
    document.addEventListener("click", function (event) {
        const button = event.target.closest(
            'form[data-rtse-confirm-title] button[type="submit"]'
        );

        if (!button) {
            return;
        }

        const form = button.form;

        if (!form) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        pendingForm = form;
        pendingTrigger = button;
        pendingResolve = null;

        openRtseConfirmModal(form, button);
    }, true);

    // --------------------------------------------------------
    // Links: intercept all dashboard confirmation links.
    // --------------------------------------------------------
    document.addEventListener("click", function (event) {
        const link = event.target.closest(
            'a[data-rtse-confirm-title]'
        );

        if (!link) {
            return;
        }

        if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
        ) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        pendingForm = null;
        pendingTrigger = link;
        pendingResolve = null;

        openRtseConfirmModal(null, link);
    }, true);

    cancelButton.addEventListener("click", function () {
        closeRtseConfirmModal(false);
    });

    continueButton.addEventListener("click", function () {
        const form = pendingForm;
        const link = pendingTrigger;
        const resolve = pendingResolve;

        if (typeof resolve === "function") {
            closeRtseConfirmModal(true);
            return;
        }

        closeRtseConfirmModal(false);

        if (form) {
            if (typeof form.requestSubmit === "function") {
                form.requestSubmit();
            } else {
                HTMLFormElement.prototype.submit.call(form);
            }
            return;
        }

        if (link) {
            window.location.href = link.href;
        }
    });

    overlay.addEventListener("click", function (event) {
        if (event.target === overlay) {
            closeRtseConfirmModal(false);
        }
    });

    document.addEventListener("keydown", function (event) {
        if (!overlay.classList.contains("is-visible")) {
            return;
        }

        if (event.key === "Escape") {
            event.preventDefault();
            closeRtseConfirmModal(false);
            return;
        }

        if (event.key === "Enter") {
            if (
                document.activeElement === cancelButton ||
                document.activeElement === continueButton
            ) {
                event.preventDefault();
                continueButton.click();
            }
        }
    });

    // --------------------------------------------------------
    // Public helper for async JavaScript actions.
    // --------------------------------------------------------
    window.rtseConfirm = function (titleText, messageText, options) {
        options = options || {};

        return new Promise(function (resolve) {
            pendingForm = null;
            pendingTrigger = null;
            pendingResolve = resolve;

            title.textContent = titleText || "Confirm Action";
            message.textContent = String(
                messageText || "Are you sure you want to continue?"
            ).replace(/\\n/g, "\n");

            const lowerTitle = String(titleText || "").toLowerCase();

            const isOmr =
                lowerTitle.includes("omr") ||
                options.omr === true;

            const isDanger =
                lowerTitle.includes("reset") ||
                lowerTitle.includes("close") ||
                lowerTitle.includes("hide") ||
                options.danger === true;

            overlay.classList.toggle("rtse-confirm-omr", isOmr);
            overlay.classList.toggle("rtse-confirm-danger", isDanger);
            overlay.classList.toggle("rtse-confirm-action", !isDanger);

            overlay.classList.add("is-visible");
            document.body.style.overflow = "hidden";

            window.setTimeout(function () {
                continueButton.focus();
            }, 0);
        });
    };
})();
</script>>
<script>
(function () {
    const RTSE_DASHBOARD_SCROLL_POSITION_KEY =
        "rtse_dashboard_scroll_position";

    function saveRtseDashboardScrollPosition() {
        try {
            sessionStorage.setItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY,
                String(window.scrollY || window.pageYOffset || 0)
            );
        } catch (error) {
            console.warn(
                "RTSE scroll position could not be saved:",
                error
            );
        }
    }

    function restoreRtseDashboardScrollPosition() {
        try {
            const saved = sessionStorage.getItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY
            );

            if (saved === null) return;

            sessionStorage.removeItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY
            );

            const scrollY = Number(saved);

            if (!Number.isFinite(scrollY)) return;

            requestAnimationFrame(function () {
                window.scrollTo(0, scrollY);

                requestAnimationFrame(function () {
                    window.scrollTo(0, scrollY);
                });
            });
        } catch (error) {
            console.warn(
                "RTSE scroll position could not be restored:",
                error
            );
        }
    }

    document.addEventListener("submit", function (event) {
        const form = event.target;

        if (!form || !(form instanceof HTMLFormElement)) {
            return;
        }

        const action =
            String(form.getAttribute("action") || "");

        if (
            action.includes("/admin/rtse/reset-roll/")
        ) {
            saveRtseDashboardScrollPosition();
        }
    }, true);

    document.addEventListener("click", function (event) {
        const link = event.target.closest("a");

        if (!link) return;

        const href =
            String(link.getAttribute("href") || "");

        if (
            href.includes("/admin/rtse/generate-roll/") ||
            href.includes("/admin/rtse/admit-generator/")
        ) {
            saveRtseDashboardScrollPosition();
        }
    }, true);

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            restoreRtseDashboardScrollPosition
        );
    } else {
        restoreRtseDashboardScrollPosition();
    }
})();
</script>

</main>

