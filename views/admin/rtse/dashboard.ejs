<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-header">

                <h1>
                    RTSE Examination Dashboard
                </h1>

                <div class="rtse-header-actions">

                    <% if(setting.application_open){ %>

                        <a
                            href="/admin/rtse/close-applications"
                            class="btn-danger"
                            onclick="return confirm('Close RTSE Applications?');"
                        >
                            🔒 Close Applications
                        </a>

                    <% } else { %>

                        <a
                            href="/admin/rtse/open-applications"
                            class="btn-save"
                            onclick="return confirm('Open RTSE Applications?');"
                        >
                            🔓 Open Applications
                        </a>

                    <% } %>


                    <% if(admitGenerated){ %>

                        <% if(setting.admit_publish){ %>

                            <a
                                href="/admin/rtse/hide-admit"
                                class="btn-warning"
                                onclick="return confirm('Hide Admit Cards?');"
                            >
                                🙈 Hide Admit Cards
                            </a>

                        <% } else { %>

                            <a
                                href="/admin/rtse/publish-admit"
                                class="btn-save"
                                onclick="return confirm('Publish Admit Cards?');"
                            >
                                📢 Publish Admit Cards
                            </a>

                        <% } %>

                    <% } %>


                    <a
                        href="/admin/rtse/export"
                        class="btn-view"
                    >
                        📊 Export All Students
                    </a>
                            <a
                                href="/admin/rtse/export/approved"
                                class="btn-save"
                            >
                                ✅ Export Approved Students
                            </a>


                    <a
                        href="/admin/rtse/archive"
                        class="btn-warning"
                    >
                        🗂 Archive
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 OVERALL STATISTICS
            ====================================================== -->

            <div class="rtse-statistics-grid">

                <!-- Total -->

                <div class="rtse-stat-card">

                    <h3>Total Applications</h3>

                    <h1>
                        <%= total %>
                    </h1>

                </div>


                <!-- Pending -->

                <div class="rtse-stat-card">

                    <h3>Pending</h3>

                    <h1 class="rtse-stat-pending">
                        <%= pending %>
                    </h1>

                </div>


                <!-- Approved -->

                <div class="rtse-stat-card">

                    <h3>Approved</h3>

                    <h1 class="rtse-stat-approved">
                        <%= approved %>
                    </h1>

                </div>


                <!-- Rejected -->

                <div class="rtse-stat-card">

                    <h3>Rejected</h3>

                    <h1 class="rtse-stat-rejected">
                        <%= rejected %>
                    </h1>

                </div>

            </div>


            <!-- =====================================================
                 ROLL & ADMIT MANAGEMENT
            ====================================================== -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Roll Number & Admit Card Management
                </h2>


                <!-- =================================================
                     SECTION A-E GRID
                ================================================== -->

                <div class="rtse-section-grid">

                    <% ["A","B","C","D","E"].forEach(section=>{ %>

                        <% const data =
                            sectionStats.find(
                                s => s.section === section
                            ) || {};
                        %>


                        <!-- ==============================
                             SECTION CARD
                        =============================== -->

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= section %>
                            </h3>

                            <hr>


                            <p>
                                Total Applications
                            </p>

                            <h2>
                                <%= data.total || 0 %>
                            </h2>


                            <p>
                                Approved :
                                <strong>
                                    <%= data.approved || 0 %>
                                </strong>
                            </p>


                            <p>
                                Pending :
                                <strong>
                                    <%= data.pending || 0 %>
                                </strong>
                            </p>


                            <p>
                                Roll Generated :
                                <strong>
                                    <%= Number(data.roll_generated || 0) %>
                                </strong>
                            </p>


                            <p>
                                Admit Generated :
                                <strong>
                                    <%= Number(data.admit_generated || 0) %>
                                </strong>
                            </p>


                            <!-- SECTION ACTIONS -->

                            <div class="rtse-section-actions">

                                <a
                                    href="/admin/rtse/approved/<%= section %>"
                                    class="btn-view"
                                >
                                    👥 Manage Approved Students
                                </a>


                                <a
                                    href="/admin/rtse/export/<%= section %>"
                                    class="btn-save"
                                >
                                    📊 Section Excel
                                </a>

                            </div>


                            <!-- GENERATION ACTION -->

                            <div class="rtse-generation-action">

                                <% if(setting.application_open){ %>

                                    <button
                                        class="btn-warning"
                                        disabled
                                    >
                                        Applications Open
                                    </button>


                                <% } else { %>


                                    <% if(Number(data.roll_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/generate-roll/<%= section %>"
                                            class="btn-save"
                                            onclick="return confirm('Generate Roll Numbers for Section <%= section %>?')"
                                        >
                                            Generate Roll Number
                                        </a>


                                    <% } else if(Number(data.admit_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/admit-generator/<%= section %>"
                                            class="btn-view"
                                        >
                                            Generate Admit Cards
                                        </a>


                                    <% } else { %>

                                        <span class="badge badge-success">
                                            ✔ Admit Cards Generated
                                        </span>

                                    <% } %>


                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>


            <!-- =====================================================
                 APPLICATION REGISTRY
            ====================================================== -->

            <div class="profile-card">

                <div class="rtse-table-wrapper">

                    <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">Search Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>

        <div style="flex:1;min-width:220px;max-width:500px;position:relative;">
            <i class="fas fa-search"
               style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#777;"></i>

            <input
                type="search"
                id="rtseDashboardSearch"
                placeholder="Search applicant..."
                autocomplete="off"
                style="width:100%;padding:12px 15px 12px 42px;border:1px solid #ddd;border-radius:10px;font-size:14px;outline:none;">
        </div>

    </div>

    

            </div>

        </div>

    <!-- RTSE-LIGHT-APPLICATION-LIST -->

    <div class="profile-card" style="margin-top:25px;">

        <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:15px;
            flex-wrap:wrap;
            margin-bottom:20px;
        ">

            <h2 style="margin:0;">
                RTSE Student Applications
            </h2>

            <input
                type="search"
                id="rtseDashboardSearch"
                placeholder="Search applicant..."
                autocomplete="off"
                style="
                    width:280px;
                    max-width:100%;
                    padding:10px 14px;
                    border:1px solid #ddd;
                    border-radius:8px;
                "
            >

        </div>

        <div style="overflow-x:auto;">

            <table class="admin-table" id="rtseApplicationTable">

                <thead>

                    <tr>
                        <th>Registration No.</th>
                        <th>Student</th>
                        <th>School</th>
                        <th>Class</th>
                        <th>Section</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% applications.forEach(application => { %>

                        <tr>

                            <td>
                                <strong>
                                    <%= application.registration_no %>
                                </strong>
                            </td>

                            <td>
                                <strong>
                                    <%= application.full_name %>
                                </strong>
                            </td>

                            <td>
                                <%= application.school_name || "-" %>
                            </td>

                            <td>
                                <%= application.class || "-" %>
                            </td>

                            <td>
                                <strong>
                                    <%= application.section || "-" %>
                                </strong>
                            </td>

                            <td>

                                <% if(application.status === "Approved"){ %>

                                    <span class="badge badge-success">
                                        Approved
                                    </span>

                                <% } else if(application.status === "Rejected"){ %>

                                    <span class="badge badge-danger">
                                        Rejected
                                    </span>

                                <% } else { %>

                                    <span class="badge badge-warning">
                                        Pending
                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <a
                                    href="/admin/rtse/application/<%= application.id %>"
                                    class="btn-view">
                                    View
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                    <% if(!applications.length){ %>

                        <tr>
                            <td colspan="7" style="text-align:center;padding:25px;">
                                No RTSE applications found.
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("rtseDashboardSearch");

        const table =
            document.getElementById("rtseApplicationTable");

        if (!searchInput || !table) return;

        const rows =
            Array.from(
                table.querySelectorAll("tbody tr")
            );

        searchInput.addEventListener("input", function () {

            const query =
                this.value.trim().toLowerCase();

            rows.forEach(function (row) {

                const text =
                    row.textContent
                        .toLowerCase()
                        .replace(/\s+/g, " ");

                row.style.display =
                    !query || text.includes(query)
                        ? ""
                        : "none";

            });

        });

    });
    </script>

    <div
        style="
            display:flex;
            justify-content:center;
            margin:30px 0;
        ">

        <a
            href="/admin/rtse/applications"
            class="btn-save"
            style="
                display:inline-flex;
                align-items:center;
                gap:10px;
                padding:14px 24px;
                font-size:16px;
            ">

            <i class="fas fa-users"></i>
            RTSE Student Applications
            <i class="fas fa-arrow-right"></i>

        </a>

    </div>

    </main>

</div>




<%- include("../partials/footer") %>
