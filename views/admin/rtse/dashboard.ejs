<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-header">

                <h1>
                    RTSE Examination Dashboard
                </h1>

                <div class="rtse-header-actions">

                    <% if(setting.application_open){ %>

                        <a
                            href="/admin/rtse/close-applications"
                            class="btn-danger"
                            onclick="return confirm('Close RTSE Applications?');"
                        >
                            🔒 Close Applications
                        </a>

                    <% } else { %>

                        <a
                            href="/admin/rtse/open-applications"
                            class="btn-save"
                            onclick="return confirm('Open RTSE Applications?');"
                        >
                            🔓 Open Applications
                        </a>

                    <% } %>


                    <% if(admitGenerated){ %>

                        <% if(setting.admit_publish){ %>

                            <a
                                href="/admin/rtse/hide-admit"
                                class="btn-warning"
                                onclick="return confirm('Hide Admit Cards?');"
                            >
                                🙈 Hide Admit Cards
                            </a>

                        <% } else { %>

                            <a
                                href="/admin/rtse/publish-admit"
                                class="btn-save"
                                onclick="return confirm('Publish Admit Cards?');"
                            >
                                📢 Publish Admit Cards
                            </a>

                        <% } %>

                    <% } %>


                    <a
                        href="/admin/rtse/export"
                        class="btn-view"
                    >
                        📊 Export All Students
                    </a>
                            <a
                                href="/admin/rtse/export/approved"
                                class="btn-save"
                            >
                                ✅ Export Approved Students
                            </a>


                    <a
                        href="/admin/rtse/archive"
                        class="btn-warning"
                    >
                        🗂 Archive
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 OVERALL STATISTICS
            ====================================================== -->

            <div class="rtse-statistics-grid">

                <!-- Total -->

                <a
                    href="/admin/rtse/applications"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Total Applications</h3>

                    <h1>
                        <%= total %>
                    </h1>
                </a>


                <!-- Pending -->

                <a
                    href="/admin/rtse/applications?status=Pending"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Pending</h3>

                    <h1 class="rtse-stat-pending">
                        <%= pending %>
                    </h1>
                </a>


                <!-- Approved -->

                <a
                    href="/admin/rtse/applications?status=Approved"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Approved</h3>

                    <h1 class="rtse-stat-approved">
                        <%= approved %>
                    </h1>
                </a>


                <!-- Rejected -->

                <a
                    href="/admin/rtse/applications?status=Rejected"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Rejected</h3>

                    <h1 class="rtse-stat-rejected">
                        <%= rejected %>
                    </h1>
                </a>

            </div>

            <!-- =====================================================
                 ROLL & ADMIT MANAGEMENT
            ====================================================== -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Roll Number & Admit Card Management
                </h2>


                <!-- =================================================
                     SECTION A-E GRID
                ================================================== -->

                <div class="rtse-section-grid">

                    <% ["A","B","C","D","E"].forEach(section=>{ %>

                        <% const data =
                            sectionStats.find(
                                s => s.section === section
                            ) || {};
                        %>


                        <!-- ==============================
                             SECTION CARD
                        =============================== -->

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= section %>
                            </h3>

                            <hr>


                            <p>
                                Total Applications
                            </p>

                            <h2>
                                <%= data.total || 0 %>
                            </h2>


                            <p>
                                Approved :
                                <strong>
                                    <%= data.approved || 0 %>
                                </strong>
                            </p>


                            <p>
                                Pending :
                                <strong>
                                    <%= data.pending || 0 %>
                                </strong>
                            </p>


                            <p>
                                Roll Generated :
                                <strong>
                                    <%= Number(data.roll_generated || 0) %>
                                </strong>
                            </p>


                            <p>
                                Admit Generated :
                                <strong>
                                    <%= Number(data.admit_generated || 0) %>
                                </strong>
                            </p>


                            <!-- SECTION ACTIONS -->

                            <div class="rtse-section-actions">

                                <a
                                    href="/admin/rtse/approved/<%= section %>"
                                    class="btn-view"
                                >
                                    👥 Manage Approved Students
                                </a>


                                <a
                                    href="/admin/rtse/export/<%= section %>"
                                    class="btn-save"
                                >
                                    📊 Section Excel
                                </a>

                            </div>


                            <!-- GENERATION ACTION -->

                            <div class="rtse-generation-action">

                                <% if(setting.application_open){ %>

                                    <button
                                        class="btn-warning"
                                        disabled
                                    >
                                        Applications Open
                                    </button>


                                <% } else { %>


                                    <% if(Number(data.roll_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/generate-roll/<%= section %>"
                                            class="btn-save"
                                            onclick="return confirm('Generate Roll Numbers for Section <%= section %>?')"
                                        >
                                            Generate Roll Number
                                        </a>


                                    <% } else if(Number(data.admit_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/admit-generator/<%= section %>"
                                            class="btn-view"
                                        >
                                            Generate Admit Cards
                                        </a>


                                    <% } else { %>

                                        <span class="badge badge-success">
                                            ✔ Admit Cards Generated
                                        </span>

                                    <% } %>


                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>


            <!-- =====================================================
                 APPLICATION REGISTRY
            ====================================================== -->

            <div class="profile-card">

                <div class="rtse-table-wrapper">

                    <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">Search Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>

        

    </div>

    

            </div>

        </div>

    </main>

</div>




<%- include("../partials/footer") %>
