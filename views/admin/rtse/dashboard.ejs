<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-header">

                <h1>
                    RTSE Examination Dashboard
                </h1>

                <div class="rtse-header-actions">

                    <% if(setting.application_open){ %>

                        <a
                            href="/admin/rtse/close-applications"
                            class="btn-danger"
                            onclick="return confirm('Close RTSE Applications?');"
                        >
                            🔒 Close Applications
                        </a>

                    <% } else { %>

                        <a
                            href="/admin/rtse/open-applications"
                            class="btn-save"
                            onclick="return confirm('Open RTSE Applications?');"
                        >
                            🔓 Open Applications
                        </a>

                    <% } %>


                    <% if(admitGenerated){ %>

                        <% if(setting.admit_publish){ %>

                            <a
                                href="/admin/rtse/hide-admit"
                                class="btn-warning"
                                onclick="return confirm('Hide Admit Cards?');"
                            >
                                🙈 Hide Admit Cards
                            </a>

                        <% } else { %>

                            <a
                                href="/admin/rtse/publish-admit"
                                class="btn-save"
                                onclick="return confirm('Publish Admit Cards?');"
                            >
                                📢 Publish Admit Cards
                            </a>

                        <% } %>

                    <% } %>


                    <a
                        href="/admin/rtse/export"
                        class="btn-view"
                    >
                        📊 Export All Students
                    </a>
                            <a
                                href="/admin/rtse/export/approved"
                                class="btn-save"
                            >
                                ✅ Export Approved Students
                            </a>


                    <a
                        href="/admin/rtse/archive"
                        class="btn-warning"
                    >
                        🗂 Archive
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 OVERALL STATISTICS
            ====================================================== -->

            <div class="rtse-statistics-grid">

                <!-- Total -->

                <div class="rtse-stat-card">

                    <h3>Total Applications</h3>

                    <h1>
                        <%= total %>
                    </h1>

                </div>


                <!-- Pending -->

                <div class="rtse-stat-card">

                    <h3>Pending</h3>

                    <h1 class="rtse-stat-pending">
                        <%= pending %>
                    </h1>

                </div>


                <!-- Approved -->

                <div class="rtse-stat-card">

                    <h3>Approved</h3>

                    <h1 class="rtse-stat-approved">
                        <%= approved %>
                    </h1>

                </div>


                <!-- Rejected -->

                <div class="rtse-stat-card">

                    <h3>Rejected</h3>

                    <h1 class="rtse-stat-rejected">
                        <%= rejected %>
                    </h1>

                </div>

            </div>


            <!-- =====================================================
                 ROLL & ADMIT MANAGEMENT
            ====================================================== -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Roll Number & Admit Card Management
                </h2>


                <!-- =================================================
                     SECTION A-E GRID
                ================================================== -->

                <div class="rtse-section-grid">

                    <% ["A","B","C","D","E"].forEach(section=>{ %>

                        <% const data =
                            sectionStats.find(
                                s => s.section === section
                            ) || {};
                        %>


                        <!-- ==============================
                             SECTION CARD
                        =============================== -->

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= section %>
                            </h3>

                            <hr>


                            <p>
                                Total Applications
                            </p>

                            <h2>
                                <%= data.total || 0 %>
                            </h2>


                            <p>
                                Approved :
                                <strong>
                                    <%= data.approved || 0 %>
                                </strong>
                            </p>


                            <p>
                                Pending :
                                <strong>
                                    <%= data.pending || 0 %>
                                </strong>
                            </p>


                            <p>
                                Roll Generated :
                                <strong>
                                    <%= Number(data.roll_generated || 0) %>
                                </strong>
                            </p>


                            <p>
                                Admit Generated :
                                <strong>
                                    <%= Number(data.admit_generated || 0) %>
                                </strong>
                            </p>


                            <!-- SECTION ACTIONS -->

                            <div class="rtse-section-actions">

                                <a
                                    href="/admin/rtse/approved/<%= section %>"
                                    class="btn-view"
                                >
                                    👥 Manage Approved Students
                                </a>


                                <a
                                    href="/admin/rtse/export/<%= section %>"
                                    class="btn-save"
                                >
                                    📊 Section Excel
                                </a>

                            </div>


                            <!-- GENERATION ACTION -->

                            <div class="rtse-generation-action">

                                <% if(setting.application_open){ %>

                                    <button
                                        class="btn-warning"
                                        disabled
                                    >
                                        Applications Open
                                    </button>


                                <% } else { %>


                                    <% if(Number(data.roll_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/generate-roll/<%= section %>"
                                            class="btn-save"
                                            onclick="return confirm('Generate Roll Numbers for Section <%= section %>?')"
                                        >
                                            Generate Roll Number
                                        </a>


                                    <% } else if(Number(data.admit_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/admit-generator/<%= section %>"
                                            class="btn-view"
                                        >
                                            Generate Admit Cards
                                        </a>


                                    <% } else { %>

                                        <span class="badge badge-success">
                                            ✔ Admit Cards Generated
                                        </span>

                                    <% } %>


                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>


            <!-- =====================================================
                 APPLICATION REGISTRY
            ====================================================== -->

            <div class="profile-card">

                <div class="rtse-table-wrapper">

                    <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">Search Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>

        <div style="flex:1;min-width:220px;max-width:500px;position:relative;">
            <i class="fas fa-search"
               style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#777;"></i>

            <input
                type="search"
                id="rtseDashboardSearch"
                placeholder="Search applicant..."
                autocomplete="off"
                style="width:100%;padding:12px 15px 12px 42px;border:1px solid #ddd;border-radius:10px;font-size:14px;outline:none;">
        </div>

    </div>

    <div id="rtseDashboardSearchResult"
         style="margin-top:10px;font-size:13px;color:#666;">
    </div>
</div>

<table class="admin-table" id="rtseApplicationTable">

                        <thead>

                            <tr>

                                <th>
                                    Reg. No.
                                </th>

                                <th>
                                    Photo
                                </th>

                                <th>
                                    Student
                                </th>

                                <th>
                                    School
                                </th>

                                <th>
                                    Class
                                </th>

                                <th>
                                    Section
                                </th>

                                <th>
                                    Status
                                </th>

                                <th width="380">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% applications.forEach(application=>{ %>

                                <tr>

                                    <!-- REGISTRATION -->

                                    <td>

                                        <strong>
                                            <%= application.registration_no %>
                                        </strong>

                                    </td>


                                    <!-- PHOTO -->

                                    <td>

                                        <% if(application.photo){ %>

                                            <img
                                                src="/uploads/rtse/<%= application.photo %>"
                                                style="width:60px;height:60px;border-radius:50%;object-fit:cover;"
                                            >

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <!-- STUDENT -->

                                    <td>

                                        <strong>
                                            <%= application.full_name %>
                                        </strong>

                                        <br>

                                        <small>
                                            <%= application.mobile %>
                                        </small>

                                    </td>


                                    <!-- SCHOOL -->

                                    <td>
                                        <%= application.school_name %>
                                    </td>


                                    <!-- CLASS -->

                                    <td>
                                        <%= application.class %>
                                    </td>


                                    <!-- SECTION -->

                                    <td>

                                        <strong>
                                            <%= application.section %>
                                        </strong>

                                    </td>


                                    <!-- STATUS -->
                                    <td>
                                        <% if(application.status === "Approved"){ %>
                                            <span class="badge badge-success">
                                                Approved
                                            </span>

                                        <% } else if(application.status === "Rejected"){ %>
                                            <span class="badge badge-danger">
                                                Rejected
                                            </span>

                                        <% } else { %>
                                            <span class="badge badge-warning">
                                                Pending
                                            </span>
                                        <% } %>

                                        <% if(application.roll_no){ %>
                                            <br>
                                            <small>
                                                <strong>
                                                    <%= application.roll_no %>
                                                </strong>
                                            </small>
                                        <% } %>
                                    </td>

                                    <td>

                                        <a
                                            href="/admin/rtse/application/<%= application.id %>"
                                            class="btn-view">
                                            View
                                        </a>

                                        <a
                                            href="/admin/rtse/application/<%= application.id %>/edit"
                                            class="btn-save">
                                            Edit
                                        </a>

                                        <% if(application.status === "Pending"){ %>

                                            <a
                                                href="/admin/rtse/application/<%= application.id %>/approve"
                                                class="btn-save">
                                                Approve
                                            </a>

                                            <a
                                                href="/admin/rtse/application/<%= application.id %>/reject"
                                                class="btn-warning">
                                                Reject
                                            </a>

                                        <% } else if(application.status === "Approved"){ %>

                                            <span
                                                class="btn-save"
                                                style="cursor:default;background:#28a745;">
                                                ✓ Approved
                                            </span>

                                            <% if(application.roll_no && application.admit_generated == 1){ %>

                                                <a
                                                    href="/admin/rtse/application/<%= application.id %>/admit-card"
                                                    class="btn-view">
                                                    Admit Card
                                                </a>

                                            <% } %>

                                        <% } else if(application.status === "Rejected"){ %>

                                            <a
                                                href="/admin/rtse/application/<%= application.id %>/approve"
                                                class="btn-save"
                                                onclick="return confirm('Approve this rejected application?');">
                                                Approve
                                            </a>

                                            <span
                                                class="btn-danger"
                                                style="cursor:default;">
                                                ✗ Rejected
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                    <!-- RTSE-DASHBOARD-PER-PAGE -->
                    <div
                        style="
                            display:flex;
                            justify-content:flex-end;
                            align-items:center;
                            gap:8px;
                            flex-wrap:wrap;
                            margin:15px 0;
                        ">

                        <label
                            for="rtsePerPage"
                            style="font-weight:600;">
                            Applications per page:
                        </label>

                        <select
                            id="rtsePerPage"
                            onchange="changeRtsePerPage(this.value)"
                            style="
                                padding:7px 12px;
                                border:1px solid #ddd;
                                border-radius:6px;
                                background:#fff;
                            ">

                            <% [10, 25, 50, 100].forEach(function(size) { %>
                                <option
                                    value="<%= size %>"
                                    <%= perPage === size ? "selected" : "" %>>
                                    <%= size %>
                                </option>
                            <% }) %>

                        </select>

                    </div>

                    <script>
                        function changeRtsePerPage(value) {
                            window.location.href =
                                "/admin/rtse?perPage=" +
                                encodeURIComponent(value);
                        }
                    </script>

                    <!-- RTSE-DASHBOARD-PAGINATION -->
                    <% if (typeof totalPages !== "undefined" && totalPages > 1) { %>

                        <div
                            style="
                                display:flex;
                                justify-content:center;
                                align-items:center;
                                gap:10px;
                                flex-wrap:wrap;
                                margin:20px 0;
                            ">

                            <% if (page > 1) { %>
                                <a
                                    href="/admin/rtse?page=<%= page - 1 %>"
                                    class="btn btn-secondary">
                                    <i class="fas fa-chevron-left"></i>
                                    Previous
                                </a>
                            <% } %>

                            <span
                                style="
                                    padding:8px 14px;
                                    font-weight:600;
                                ">
                                Page <%= page %> of <%= totalPages %>
                            </span>

                            <% if (page < totalPages) { %>
                                <a
                                    href="/admin/rtse?page=<%= page + 1 %>"
                                    class="btn btn-primary">
                                    Next
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            <% } %>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </main>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById("rtseDashboardSearch");
    const resultText = document.getElementById("rtseDashboardSearchResult");
    const table = document.getElementById("rtseApplicationTable");

    if (!searchInput || !table) return;

    const rows = Array.from(
        table.querySelectorAll("tbody tr")
    );

    function filterApplications() {

        const query = searchInput.value.trim().toLowerCase();
        let visible = 0;

        rows.forEach(row => {

            const text = row.textContent
                .toLowerCase()
                .replace(/\s+/g, " ");

            const match = !query || text.includes(query);

            row.style.display = match ? "" : "none";

            if (match) visible++;
        });

        if (!query) {
            resultText.textContent = "";
        } else {
            resultText.textContent =
                visible + (visible === 1
                    ? " application found."
                    : " applications found.");
        }
    }

    searchInput.addEventListener("input", filterApplications);

});
</script>

<%- include("../partials/footer") %>
