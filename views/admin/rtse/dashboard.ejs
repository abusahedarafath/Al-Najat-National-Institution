<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">
<%
    // RTSE sections MUST always remain in fixed order.
    // Never sort this list based on generated rolls/admit cards.
    const RTSE_FIXED_SECTION_ORDER = ["A", "B", "C", "D", "E"];

    const RTSE_SECTION_MAP = {};
    (Array.isArray(sectionStats) ? sectionStats : []).forEach(function(item) {
        RTSE_SECTION_MAP[String(item.section || "").toUpperCase()] = item;
    });

    const RTSE_SECTIONS_FIXED = RTSE_FIXED_SECTION_ORDER.map(function(section) {
        return RTSE_SECTION_MAP[section] || {
            section: section,
            application_open: false,
            roll_generated: 0,
            admit_generated: 0
        };
    });
%>


        <div class="container">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-header">

                <h1>
                    RTSE Examination Dashboard
                </h1>

                <div class="rtse-header-actions">

                    <% if(setting.application_open){ %>

                        <a
                            href="/admin/rtse/close-applications"
                            class="btn-danger"
                            onclick="return confirm('Close RTSE Applications?');"
                        >
                            🔒 Close Applications
                        </a>

                    <% } else { %>

                        <a
                            href="/admin/rtse/open-applications"
                            class="btn-save"
                            onclick="return confirm('Open RTSE Applications?');"
                        >
                            🔓 Open Applications
                        </a>

                    <% } %>

<% if(admitGenerated){ %>
    <a
        href="/admin/rtse/admit-cards/pdf/all"
        class="btn-save"
    >
        🖨️ Print / Save All Generated Admit Cards
    </a>
<% } %>


                    <% if(admitGenerated){ %>

                        <% if(setting.admit_publish){ %>

                            <a
                                href="/admin/rtse/hide-admit"
                                class="btn-warning"
                                onclick="return confirm('Hide Admit Cards?');"
                            >
                                🙈 Hide Admit Cards
                            </a>

                        <% } else { %>

                            <a
                                href="/admin/rtse/publish-admit"
                                class="btn-save"
                                onclick="return confirm('Publish Admit Cards?');"
                            >
                                📢 Publish Admit Cards
                            </a>

                        <% } %>

                    <% } %>


                    <a
                        href="/admin/rtse/export"
                        class="btn-view"
                    >
                        📊 Export All Students
                    </a>
                            <a
                                href="/admin/rtse/export/approved"
                                class="btn-save"
                            >
                                ✅ Export Approved Students
                            </a>


                    <a
                        href="/admin/rtse/archive"
                        class="btn-warning"
                    >
                        🗂 Archive
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 OVERALL STATISTICS
            ====================================================== -->

            <div class="rtse-statistics-grid">

                <!-- Total -->

                <a
                    href="/admin/rtse/applications"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Total Applications</h3>

                    <h1>
                        <%= total %>
                    </h1>
                </a>


                <!-- Pending -->

                <a
                    href="/admin/rtse/applications?status=Pending"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Pending</h3>

                    <h1 class="rtse-stat-pending">
                        <%= pending %>
                    </h1>
                </a>


                <!-- Approved -->

                <a
                    href="/admin/rtse/applications?status=Approved"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Approved</h3>

                    <h1 class="rtse-stat-approved">
                        <%= approved %>
                    </h1>
                </a>


                <!-- Rejected -->

                <a
                    href="/admin/rtse/applications?status=Rejected"
                    class="rtse-stat-card rtse-stat-card-link"
                >
                    <h3>Rejected</h3>

                    <h1 class="rtse-stat-rejected">
                        <%= rejected %>
                    </h1>
                </a>


                    <!-- Invited Schools -->
<a
    href="/admin/rtse/invited-schools"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Invited Schools</h3>

    <h1>
        <%= invitedSchoolCount || 0 %>
    </h1>
</a>

<!-- Students Without School -->
<a
    href="/admin/rtse/students-without-school"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Students Without School</h3>

    <h1>
        <%= studentsWithoutSchoolCount || 0 %>
    </h1>
</a>

<!-- Students Not Sent To Centre -->
<a
    href="/admin/rtse/students-not-sent-to-centre"
    class="rtse-stat-card rtse-stat-card-link"
>
    <h3>Students Not Sent to Centre</h3>

    <h1>
        <%= studentsNotSentToCentreCount || 0 %>
    </h1>
</a>

<!-- Gender Statistics -->
                    <div class="rtse-stat-card rtse-gender-stat-card">
                        <h3>Gender Statistics</h3>
                        <div class="rtse-gender-stat-values">
                            <div>
                                <span>Male</span>
                                <strong><%= male %></strong>
                            </div>
                            <div>
                                <span>Female</span>
                                <strong><%= female %></strong>
                            </div>
                        </div>
                    </div>
</div>

            <!-- =====================================================
                 ROLL & ADMIT MANAGEMENT
            ====================================================== -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Roll Number & Admit Card Management
                </h2>


                <!-- =================================================
                     SECTION A-E GRID
                ================================================== -->

                <div class="rtse-section-grid">


        <% RTSE_FIXED_SECTION_ORDER.forEach(section=>{ %>

                        <% const data =
                            RTSE_SECTION_MAP[section] || {};
                        %>


                        <!-- ==============================
                             SECTION CARD
                        =============================== -->

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= section %>
                            </h3>

                            <hr>


                            <p>
                                Total Applications
                            </p>

                            <h2>
                                <%= data.total || 0 %>
                            </h2>


                            <p>
                                Approved :
                                <strong>
                                    <%= data.approved || 0 %>
                                </strong>
                            </p>


                            <p>
                                Pending :
                                <strong>
                                    <%= data.pending || 0 %>
                                </strong>
                            </p>



                            <p class="rtse-section-gender">
                                Approved Male :
                                <strong>
                                    <%= Number(data.approved_male || 0) %>
                                </strong>
                            </p>

                            <p class="rtse-section-gender">
                                Approved Female :
                                <strong>
                                    <%= Number(data.approved_female || 0) %>
                                </strong>
                            </p>
                            <p>
                                Roll Generated :
                                <strong>
                                    <%= Number(data.roll_generated || 0) %>
                                </strong>
                            </p>


                            <p>
                                Admit Generated :
                                <strong>
                                    <%= Number(data.admit_generated || 0) %>
                                </strong>
                            </p>


                            <!-- SECTION ACTIONS -->

                            <div class="rtse-section-actions">

                                <a
                                    href="/admin/rtse/approved/<%= section %>"
                                    class="btn-view"
                                >
                                    👥 Manage Approved Students
                                </a>


                                <a
                                    href="/admin/rtse/export/<%= section %>"
                                    class="btn-save"
                                >
                                    📊 Section Excel
                                </a>

                                <% if(Number(data.admit_generated || 0) > 0){ %>
                                    <a
                                        href="/admin/rtse/admit-cards/pdf/<%= section %>"
                                        class="btn-save"
                                    >
                                        🖨️ Print / Save All Admit Cards
                                    </a>
                            <a
                                href="/admin/rtse/omr/pdf/<%= section %>"
                                class="btn-save">
                                📝 Download Section OMR
                            </a>
                                <a
                                    href="/admin/rtse/attendance-sheet/<%= section %>"
                                    class="btn-view"
                                >
                                    📋 View Attendance Sheet
                                </a>
                                <% } %>

                            </div>


                            <!-- GENERATION ACTION -->

                            <div class="rtse-generation-action">

                                <% if(setting.application_open){ %>

                                    <button
                                        class="btn-warning"
                                        disabled
                                    >
                                        Applications Open
                                    </button>


                                <% } else { %>
                                    <% if(Number(data.roll_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/generate-roll/<%= section %>"
                                            class="btn-save"
                                            onclick="return confirm('Generate Roll Numbers for Section <%= section %>?')"
                                        >
                                            Generate Roll Number
                                        </a>

                                    <% } else if(Number(data.admit_generated || 0) === 0){ %>

                                        <a
                                            href="/admin/rtse/admit-generator/<%= section %>"
                                            class="btn-view"
                                        >
                                            Generate Admit Cards
                                        </a>


                                        <% if(!setting.admit_publish){ %>
<form
                                                method="POST"
                                                action="/admin/rtse/reset-roll/<%= section %>"
                                                style="display:inline;"
                                                onsubmit="return confirm('Reset Roll No. for Section <%= section %>?\\n\\nThis will reset generated roll numbers and admit-card status for this section. Existing attendance records are protected. Continue?')"
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn-warning"
                                                >
                                                    ↩ Reset Roll No.
                                                </button>
                                            </form>

                                        <% } %>

                                    <% } else { %>

                                        <span class="badge badge-success">
                                            ✔ Admit Cards Generated
                                        </span>

                                        <% if(!setting.admit_publish){ %>
                                        <form
                                                method="POST"
                                                action="/admin/rtse/reset-roll/<%= section %>"
                                                style="display:inline;"
                                                onsubmit="return confirm('Reset Roll No. for Section <%= section %>?\\n\\nThis will reset generated roll numbers and admit-card status for this section. Existing attendance records are protected. Continue?')"
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn-warning"
                                                >
                                                    ↩ Reset Roll No.
                                                </button>
                                            </form>
                                        <% } %>

                                    <% } %>
<% } %>

                            </div>
                            <div
                            class="rtse-login-information-pdf-action"
                            data-rtse-login-pdf-section="<%= section %>"
                            style="margin-top:10px;"
                        >
                            <button
                                type="button"
                                class="btn-view"
                                style="border:0;cursor:pointer;"
                                onclick="prepareRtseLoginInformationPdf('<%= section %>', this)"
                            >
                                Prepare Login Information PDF
                            </button>
                        </div>
</div>

                    <% }) %>

                </div>

            </div>


            <!-- =====================================================
                 APPLICATION REGISTRY
            ====================================================== -->

            <div class="profile-card">

                <div class="rtse-table-wrapper">

                    <div class="profile-card rtse-search-card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;">

        <div>
            <h2 style="margin:0;">Search Applications</h2>
            <p style="margin:5px 0 0;color:#666;font-size:13px;">
                Search by Name, Registration No., Mobile, School, Class or Section
            </p>
        </div>



    </div>



            </div>

        </div>


<script>
(function () {
    const RTSE_DASHBOARD_SCROLL_POSITION_KEY =
        "rtse_dashboard_scroll_position";

    function saveRtseDashboardScrollPosition() {
        try {
            sessionStorage.setItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY,
                String(window.scrollY || window.pageYOffset || 0)
            );
        } catch (error) {
            console.warn(
                "RTSE scroll position could not be saved:",
                error
            );
        }
    }

    function restoreRtseDashboardScrollPosition() {
        try {
            const saved = sessionStorage.getItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY
            );

            if (saved === null) return;

            sessionStorage.removeItem(
                RTSE_DASHBOARD_SCROLL_POSITION_KEY
            );

            const scrollY = Number(saved);

            if (!Number.isFinite(scrollY)) return;

            requestAnimationFrame(function () {
                window.scrollTo(0, scrollY);

                requestAnimationFrame(function () {
                    window.scrollTo(0, scrollY);
                });
            });
        } catch (error) {
            console.warn(
                "RTSE scroll position could not be restored:",
                error
            );
        }
    }

    document.addEventListener("submit", function (event) {
        const form = event.target;

        if (!form || !(form instanceof HTMLFormElement)) {
            return;
        }

        const action =
            String(form.getAttribute("action") || "");

        if (
            action.includes("/admin/rtse/reset-roll/")
        ) {
            saveRtseDashboardScrollPosition();
        }
    }, true);

    document.addEventListener("click", function (event) {
        const link = event.target.closest("a");

        if (!link) return;

        const href =
            String(link.getAttribute("href") || "");

        if (
            href.includes("/admin/rtse/generate-roll/") ||
            href.includes("/admin/rtse/admit-generator/")
        ) {
            saveRtseDashboardScrollPosition();
        }
    }, true);

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            restoreRtseDashboardScrollPosition
        );
    } else {
        restoreRtseDashboardScrollPosition();
    }
})();
</script>

</main>

</div>





<script>
async function getRtseLoginInformationPdfStatus(section) {
    const response = await fetch(
        "/admin/rtse/login-information-pdf/status/" +
        encodeURIComponent(section),
        {
            method: "GET",
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        }
    );

    const result = await response.json().catch(() => ({
        success: false
    }));

    if (!response.ok || !result.success) {
        throw new Error(
            result.message ||
            "Unable to check Login Information PDF status."
        );
    }

    return result;
}

const rtseAdmitCardsPublished = <%= Number(setting?.admit_publish || 0) === 1 ? "true" : "false" %>;

function renderRtseLoginInformationPdfActions(section, prepared) {
    const container = document.querySelector(
        '[data-rtse-login-pdf-section="' +
        section +
        '"]'
    );

    if (!container) return;

    if (prepared) {
        container.innerHTML = `
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <a
                    href="/admin/rtse/login-information-pdf/view/${encodeURIComponent(section)}"
                    class="btn-view"
                    style="display:inline-block;text-decoration:none;"
                >
                    View Login Information PDF
                </a>

                ${!rtseAdmitCardsPublished ? `
                <button
                    type="button"
                    class="btn-warning"
                    style="border:0;cursor:pointer;"
                    onclick="resetRtseLoginInformationPdf('${section}', this)"
                >
                    Reset Login Information
                </button>
                ` : ""}
            </div>
        `;
    } else {
        container.innerHTML = `
            <button
                type="button"
                class="btn-view"
                style="border:0;cursor:pointer;"
                onclick="prepareRtseLoginInformationPdf('${section}', this)"
            >
                Prepare Login Information PDF
            </button>
        `;
    }
}

async function refreshRtseLoginInformationPdfStatus(section) {
    try {
        const result =
            await getRtseLoginInformationPdfStatus(section);

        renderRtseLoginInformationPdfActions(
            section,
            Boolean(result.prepared)
        );
    } catch (error) {
        console.error(
            "RTSE Login Information PDF status error:",
            error
        );
    }
}

async function prepareRtseLoginInformationPdf(section, button) {
    if (!section || !button) return;

    if (!confirm(
        "Prepare Login Information PDFs for Section " +
        section +
        "?\n\n" +
        "The saved Login Information PDF settings will be used.\n" +
        "Roll numbers, admit cards, applications, and uploaded files will not be changed."
    )) {
        return;
    }

    const originalText = button.textContent;

    button.disabled = true;
    button.textContent = "Preparing...";

    try {
        const response = await fetch(
            "/admin/rtse/login-information-pdf/prepare/" +
            encodeURIComponent(section),
            {
                method: "POST",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }
        );

        const result = await response.json().catch(() => ({
            success: false,
            message: "Unexpected server response."
        }));

        if (!response.ok || !result.success) {
            throw new Error(
                result.message ||
                "Unable to prepare Login Information PDFs."
            );
        }

        renderRtseLoginInformationPdfActions(
            section,
            true
        );

        alert(
            result.message +
            "\n\nPrepared: " +
            result.preparedCount +
            " section PDF." +
            "\nStudents included: " +
            result.studentCount
        );
    } catch (error) {
        console.error(
            "RTSE Login Information PDF preparation error:",
            error
        );

        button.disabled = false;
        button.textContent = originalText;

        alert(
            error.message ||
            "Unable to prepare Login Information PDFs."
        );
    }
}

async function resetRtseLoginInformationPdf(section, button) {
    if (!section || !button) return;

    if (!confirm(
        "Reset Login Information PDF preparation for Section " +
        section +
        "?\n\n" +
        "Only the generated Login Information PDFs will be removed.\n" +
        "Applications, uploaded files, roll numbers, and admit cards will not be changed."
    )) {
        return;
    }

    const originalText = button.textContent;

    button.disabled = true;
    button.textContent = "Resetting...";

    try {
        const response = await fetch(
            "/admin/rtse/login-information-pdf/reset/" +
            encodeURIComponent(section),
            {
                method: "POST",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }
        );

        const result = await response.json().catch(() => ({
            success: false,
            message: "Unexpected server response."
        }));

        if (!response.ok || !result.success) {
            throw new Error(
                result.message ||
                "Unable to reset Login Information PDFs."
            );
        }

        renderRtseLoginInformationPdfActions(
            section,
            false
        );

        alert(
            result.message +
            "\n\nReset: " +
            result.resetCount +
            " section PDF."
        );
    } catch (error) {
        console.error(
            "RTSE Login Information PDF reset error:",
            error
        );

        button.disabled = false;
        button.textContent = originalText;

        alert(
            error.message ||
            "Unable to reset Login Information PDFs."
        );
    }
}

document.addEventListener(
    "DOMContentLoaded",
    function () {
        document
            .querySelectorAll(
                "[data-rtse-login-pdf-section]"
            )
            .forEach(function (container) {
                const section =
                    container.getAttribute(
                        "data-rtse-login-pdf-section"
                    );

                if (section) {
                    refreshRtseLoginInformationPdfStatus(
                        section
                    );
                }
            });
    }
);
</script>

