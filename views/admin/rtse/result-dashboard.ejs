<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>

                    RTSE Result Dashboard

                </h1>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse"
        class="btn-cancel">

        ← Dashboard

    </a>

    <a
        href="/admin/rtse/results/generate-rankings"
        class="btn-save">

        🏆 Generate Rankings

    </a>

    <a
        href="/admin/rtse/results/merit-list"
        class="btn-view">

        📋 Merit List

    </a>

    <% if(setting.result_publish){ %>

        <a
            href="/admin/rtse/results/hide"
            class="btn-warning">

            🙈 Hide Results

        </a>

    <% } else { %>

        <a
            href="/admin/rtse/results/publish"
            class="btn-save">

            📢 Publish Results

        </a>

    <% } %>



<% if(setting.certificate_publish){ %>

<a

    href="/admin/rtse/certificates/hide"

    class="btn-warning">

    🙈 Hide Certificates

</a>

<% } else { %>

<a

    href="/admin/rtse/certificates/publish"

    class="btn-save">

    🎓 Publish Certificates

</a>

<% } %>


<a
    href="/admin/rtse/certificates/generate-all"
    class="btn-save"
    onclick="return confirm('Generate certificates for all eligible students?')">

    🎓 Generate All Certificates

</a>

<hr>

<h3>

Certificate PDF Downloads

</h3>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse/certificates/section/A"
        class="btn-view">

        📄 Section A PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/B"
        class="btn-view">

        📄 Section B PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/C"
        class="btn-view">

        📄 Section C PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/D"
        class="btn-view">

        📄 Section D PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/E"
        class="btn-view">

        📄 Section E PDF

    </a>

</div>

<br>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse/certificates/all"
        class="btn-save">

        📦 All Certificates

    </a>

</div>



<a
    href="/admin/rtse/certificates/generate/A"
    class="btn-view">

    Section A

</a>

<a
    href="/admin/rtse/certificates/generate/B"
    class="btn-view">

    Section B

</a>

<a
    href="/admin/rtse/certificates/generate/C"
    class="btn-view">

    Section C

</a>

<a
    href="/admin/rtse/certificates/generate/D"
    class="btn-view">

    Section D

</a>

<a
    href="/admin/rtse/certificates/generate/E"
    class="btn-view">

    Section E

</a>


</div>




            </div>

            <!-- Attendance Statistics -->

            <div class="rtse-statistics-grid">

                <a
                    href="/admin/rtse/results/present"
                    style="display:block;text-decoration:none;color:inherit;"
                >
                    <div class="rtse-stat-card">

                        <h3>PRESENT</h3>

                        <h1 class="rtse-stat-approved">
                            <%= Number(attendanceStats?.overall?.present || 0) %>
                        </h1>

                        <p>
                            Gate Entry Confirmed
                        </p>

                    </div>
                </a>

                <a
                    href="/admin/rtse/results/absent"
                    style="display:block;text-decoration:none;color:inherit;"
                >
                    <div class="rtse-stat-card">

                        <h3>ABSENT</h3>

                        <h1 class="rtse-stat-pending">
                            <%= Number(attendanceStats?.overall?.absent || 0) %>
                        </h1>

                        <p>
                            Gate Entry Not Completed
                        </p>

                    </div>
                </a>

            </div>

            <!-- Section-wise Attendance -->

            <div class="profile-card rtse-management-card">

                <h2>
                    Section-wise Attendance
                </h2>

                <div class="rtse-section-grid">

                    <% (attendanceStats?.sections || []).forEach(function(sectionData) { %>

                        <div class="rtse-section-card">

                            <h3>
                                SECTION <%= sectionData.section %>
                            </h3>

                            <hr>

                            <p>
                                Eligible :
                                <strong>
                                    <%= Number(sectionData.eligible || 0) %>
                                </strong>
                            </p>

                            <p>
                                Present :
                                <strong class="rtse-stat-approved">
                                    <%= Number(sectionData.present || 0) %>
                                </strong>
                            </p>

                            <p>
                                Absent :
                                <strong class="rtse-stat-pending">
                                    <%= Number(sectionData.absent || 0) %>
                                </strong>
                            </p>

                            <div style="margin-top:15px;">
                                <a
                                    href="/admin/rtse/results/section/<%= encodeURIComponent(sectionData.section) %>"
                                    class="btn-view"
                                >
                                    See Present Students
                                </a>
                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
