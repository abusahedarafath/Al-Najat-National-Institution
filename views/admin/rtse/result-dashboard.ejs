<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>

                    RTSE Result Dashboard

                </h1>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse"
        class="btn-cancel">

        ← Dashboard

    </a>

    <a
        href="/admin/rtse/results/generate-rankings"
        class="btn-save">

        🏆 Generate Rankings

    </a>

    <a
        href="/admin/rtse/results/merit-list"
        class="btn-view">

        📋 Merit List

    </a>

    <% if(setting.result_publish){ %>

        <a
            href="/admin/rtse/results/hide"
            class="btn-warning">

            🙈 Hide Results

        </a>

    <% } else { %>

        <a
            href="/admin/rtse/results/publish"
            class="btn-save">

            📢 Publish Results

        </a>

    <% } %>



<% if(setting.certificate_publish){ %>

<a

    href="/admin/rtse/certificates/hide"

    class="btn-warning">

    🙈 Hide Certificates

</a>

<% } else { %>

<a

    href="/admin/rtse/certificates/publish"

    class="btn-save">

    🎓 Publish Certificates

</a>

<% } %>


<a
    href="/admin/rtse/certificates/generate-all"
    class="btn-save"
    onclick="return confirm('Generate certificates for all eligible students?')">

    🎓 Generate All Certificates

</a>

<hr>

<h3>

Certificate PDF Downloads

</h3>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse/certificates/section/A"
        class="btn-view">

        📄 Section A PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/B"
        class="btn-view">

        📄 Section B PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/C"
        class="btn-view">

        📄 Section C PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/D"
        class="btn-view">

        📄 Section D PDF

    </a>

    <a
        href="/admin/rtse/certificates/section/E"
        class="btn-view">

        📄 Section E PDF

    </a>

</div>

<br>

<div
    style="display:flex;gap:10px;flex-wrap:wrap;">

    <a
        href="/admin/rtse/certificates/all"
        class="btn-save">

        📦 All Certificates

    </a>

</div>



<a
    href="/admin/rtse/certificates/generate/A"
    class="btn-view">

    Section A

</a>

<a
    href="/admin/rtse/certificates/generate/B"
    class="btn-view">

    Section B

</a>

<a
    href="/admin/rtse/certificates/generate/C"
    class="btn-view">

    Section C

</a>

<a
    href="/admin/rtse/certificates/generate/D"
    class="btn-view">

    Section D

</a>

<a
    href="/admin/rtse/certificates/generate/E"
    class="btn-view">

    Section E

</a>


</div>




            </div>

            <!-- Result Statistics -->

            <div
                style="
                    display:grid;
                    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
                    gap:15px;
                    margin-bottom:20px;
                ">

                <div class="profile-card">

                    <h3>
                        <%= stats.total %>
                    </h3>

                    <p>
                        Total Students
                    </p>

                </div>

                <div class="profile-card">

                    <h3>
                        <%= stats.entered %>
                    </h3>

                    <p>
                        Results Entered
                    </p>

                </div>

                <div class="profile-card">

                    <h3>
                        <%= stats.pending %>
                    </h3>

                    <p>
                        Pending
                    </p>

                </div>







            </div>

            <!-- Search -->

            <div class="profile-card">

                <form
                    method="GET"
                    action="/admin/rtse/results">

                    <div class="form-grid">

                        <div class="form-group">

                            <label>

                                Search Student

                            </label>

                            <input
                                type="text"
                                name="search"
                                placeholder="Registration No / Roll No / Name / School">

                        </div>

                        <div class="form-group">

                            <label>

                                Section

                            </label>

                            <select name="section">

                                <option value="">

                                    All Sections

                                </option>

                                <option value="A">

                                    Section A

                                </option>

                                <option value="B">

                                    Section B

                                </option>

                                <option value="C">

                                    Section C

                                </option>

                                <option value="D">

                                    Section D

                                </option>

                                <option value="E">

                                    Section E

                                </option>

                            </select>

                        </div>

                    </div>

                    <button
                        class="btn-save">

                        Search

                    </button>

                </form>

            </div>

            <!-- Student List -->

            <div class="profile-card">

                <table class="admin-table">

                    <thead>

    <tr>

        <th>
            Roll No.
        </th>

        <th>
            Registration
        </th>

        <th>
            Student
        </th>

        <th>
            Section
        </th>

        <th>
            Marks
        </th>

        <th>
            Percentage
        </th>

        <th>
            Grade
        </th>

        <th>
            Result
        </th>

        <th>
            Section Rank
        </th>

        <th>
            Overall Rank
        </th>

        <th>
            Action
        </th>

    </tr>

</thead>

<tbody>

<% students.forEach(student => { %>

    <tr>

        <td>
            <strong>
                <%= student.roll_no || "-" %>
            </strong>
        </td>

        <td>
            <%= student.registration_no || "-" %>
        </td>

        <td>

            <strong>
                <%= student.full_name %>
            </strong>

            <br>

            <small>
                <%= student.school_name || "-" %>
            </small>

        </td>

        <td>
            <%= student.section || "-" %>
        </td>

        <td>
            <%= student.marks != null
                ? student.marks
                : "-" %>
        </td>

        <td>
            <%= student.percentage != null
                ? student.percentage + "%"
                : "-" %>
        </td>

        <td>
            <%= student.grade || "-" %>
        </td>

        <td>

    <% if (!student.result_id) { %>

        <span class="badge badge-warning">
            Pending
        </span>

    <% } else { %>

        <span class="badge badge-success">
            Entered
        </span>

    <% } %>

</td>

        <td>
            <%= student.section_rank || "-" %>
        </td>

        <td>
            <%= student.overall_rank || "-" %>
        </td>

        <td>

            <a
                href="/admin/rtse/result/<%= student.application_id %>"
                class="btn-save">

                <%= student.result_id
                    ? "Edit Result"
                    : "Enter Result" %>

            </a>

            <% if (student.result_id) { %>

                <a
                    href="/admin/rtse/certificate/<%= student.application_id %>"
                    class="btn-view">

                    Certificate

                </a>

            <% } %>

        </td>

    </tr>

<% }) %>

<% if (!students.length) { %>

    <tr>

        <td
            colspan="11"
            style="text-align:center;padding:30px;">

            No students found.

        </td>

    </tr>

<% } %>

</tbody>

                </table>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
