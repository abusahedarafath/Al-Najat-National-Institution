<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

<style>
    .group-page {
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .group-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .group-header h1 {
        margin-bottom: 8px;
    }

    .group-header p {
        color: #666;
    }

    .group-actions {
        margin-bottom: 20px;
    }

    .bulk-print-action {
        margin: 0 0 20px;
        text-align: right;
    }

    .bulk-print-action a {
        display: inline-block;
        padding: 11px 18px;
        border-radius: 8px;
        background: #7c3aed;
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(124, 58, 237, .18);
    }

    .bulk-print-action a:hover {
        background: #6d28d9;
    }

    .group-actions a {
        text-decoration: none;
        font-weight: 600;
    }

    .student-table-wrap {
        overflow-x: auto;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

    th,
    td {
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        text-align: left;
    }

    th {
        background: #f3f4f6;
        font-weight: 700;
    }

    .view-button {
        display: inline-block;
        padding: 8px 13px;
        border-radius: 7px;
        color: #fff;
        background: #315f9b;
        text-decoration: none;
        font-weight: 600;
    }

    .empty {
        padding: 30px;
        text-align: center;
        color: #666;
    }
</style>

<div class="group-page">

    <div class="group-actions">

        <a
            href="/admin/rtse/new-certificates/section/<%= encodeURIComponent(section) %>"
        >
            ← Back to Section Certificates
        </a>

    </div>

    <div class="bulk-print-action">

        <a
            href="/admin/rtse/certificates/section/<%= encodeURIComponent(section) %>/print"
        >
            🖨️ Print All Appreciation Certificates
        </a>

    </div>

    <div class="group-header">

        <h1>
            🏅 Appreciation Certificates
        </h1>

        <p>
            Section <strong><%= section %></strong>
            —
            <%= certificates.length %> certificate(s)
        </p>

    </div>

    <% if (certificates.length) { %>

        <div class="student-table-wrap">

            <table>

                <thead>
                    <tr>
                        <th>Sl.</th>
                        <th>Student Name</th>
                        <th>Registration No.</th>
                        <th>Roll No.</th>
                        <th>Section Rank</th>
                        <th>Certificate</th>
                    </tr>
                </thead>

                <tbody>

                    <% certificates.forEach(function(certificate, index) { %>

                        <tr>

                            <td>
                                <%= index + 1 %>
                            </td>

                            <td>
                                <strong>
                                    <%= certificate.full_name %>
                                </strong>
                            </td>

                            <td>
                                <%= certificate.registration_no %>
                            </td>

                            <td>
                                <%= certificate.roll_no %>
                            </td>

                            <td>
                                <strong>
                                    <%= certificate.section_rank %>
                                </strong>
                            </td>

                            <td>

                                <a
                                    href="/admin/rtse/certificates/<%= encodeURIComponent(certificate.application_id) %>/print"
                                    class="view-button"
                                >
                                    View Certificate
                                </a>

                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    <% } else { %>

        <div class="student-table-wrap">
            <div class="empty">
                No Appreciation Certificates found.
            </div>
        </div>

    <% } %>

</div>

    </main>

</div>

<%- include("../partials/footer") %>
