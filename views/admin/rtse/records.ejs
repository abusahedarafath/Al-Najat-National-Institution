<%- include("../partials/header") %>

<div class="admin-layout">
    <%- include("../partials/sidebar") %>

    <main class="admin-content">
        <div class="container records-page">

            <div class="records-header">
                <div>
                    <h1>RTSE RECORDS DASHBOARD</h1>
                    <p>Historical RTSE student records, attendance and examination history.</p>
                </div>
            </div>

            <div class="records-filter-card">
                <div class="records-search-wrap">
                    <label for="recordsSearch">Search Records</label>
                    <input
                        type="search"
                        id="recordsSearch"
                        value="<%= filters.search %>"
                        placeholder="Search by student name, registration, roll, school, centre, section, gender..."
                        autocomplete="off"
                    >
                </div>

                <div class="records-filter">
                    <label for="recordsYear">Year</label>
                    <select id="recordsYear">
                        <option value="">All Years</option>
                        <% years.forEach(function(year) { %>
                            <option
                                value="<%= year %>"
                                <%= String(filters.year) === String(year) ? "selected" : "" %>
                            >
                                <%= year %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="records-filter">
                    <label for="recordsCentre">Centre</label>
                    <select id="recordsCentre">
                        <option value="">All Centres</option>
                        <% centres.forEach(function(centre) { %>
                            <option
                                value="<%= centre.id %>"
                                <%= String(filters.centreId) === String(centre.id) ? "selected" : "" %>
                            >
                                <%= centre.centre_name || centre.centre_code || ("Centre " + centre.id) %>
                                <% if (centre.centre_code) { %>
                                    — <%= centre.centre_code %>
                                <% } %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <button type="button" id="recordsClear" class="records-clear">
                    Clear
                </button>
            </div>

            <div id="recordsLoading" class="records-loading" hidden>
                Loading records...
            </div>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>SECTION-WISE STUDENTS</h2>
                    <span id="recordsScopeText"></span>
                </div>

                <div id="recordsSections" class="records-section-grid"></div>
            </section>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>SCHOOL-WISE STUDENTS</h2>
                </div>

                <div id="recordsSchools" class="records-school-list"></div>
            </section>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>STUDENTS</h2>
                    <span id="recordsStudentCount"></span>
                </div>

                <div class="records-student-live-search">
                    <label for="recordsStudentLiveSearch">
                        Search Students
                    </label>

                    <input
                        type="search"
                        id="recordsStudentLiveSearch"
                        placeholder="Search by any available student information..."
                        autocomplete="off"
                    >

                    <span id="recordsStudentLiveSearchCount"></span>
                </div>

                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Roll No.</th>
                                <th>Registration</th>
                                <th>Student</th>
                                <th>School</th>
                                <th>Centre</th>
                                <th>Year</th>
                                <th>Section</th>
                                <th>Gender</th>
                                <th>Attendance</th>
                                <th>Result</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="recordsStudents"></tbody>
                    </table>
                </div>
            </section>

            <section
                class="records-section records-drilldown"
                id="recordsDrilldown"
                hidden
            >
                <div class="records-section-heading">
                    <h2 id="recordsDrilldownTitle">STUDENT DRILL-DOWN</h2>
                    <button type="button" id="recordsDrilldownClose" class="records-close">
                        Close
                    </button>
                </div>

                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Roll No.</th>
                                <th>Registration</th>
                                <th>Student</th>
                                <th>School</th>
                                <th>Section</th>
                                <th>Year</th>
                                <th>Attendance</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody id="recordsDrilldownStudents"></tbody>
                    </table>
                </div>
            </section>

        </div>
    </main>
</div>

<style>
.records-page {
    max-width: 1500px;
    margin: 0 auto;
}

.records-header {
    margin-bottom: 18px;
}

.records-header h1 {
    margin: 0;
    color: #17213a;
    font-size: 28px;
    font-weight: 850;
}

.records-header p {
    margin: 7px 0 0;
    color: #667085;
}

.records-filter-card {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 180px 260px auto;
    gap: 14px;
    align-items: end;
    padding: 18px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    margin-bottom: 20px;
}

.records-filter-card label,
.records-search-wrap label {
    display: block;
    margin-bottom: 7px;
    font-size: 13px;
    font-weight: 750;
    color: #344054;
}

.records-filter-card input,
.records-filter-card select {
    width: 100%;
    height: 43px;
    box-sizing: border-box;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    padding: 0 12px;
    background: #fff;
    font-size: 14px;
}

.records-clear,
.records-close {
    height: 43px;
    padding: 0 16px;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    background: #fff;
    cursor: pointer;
    font-weight: 700;
}

.records-loading {
    margin-bottom: 14px;
    padding: 10px 14px;
    border-radius: 9px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 13px;
}

.records-section {
    margin-top: 20px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 18px;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
}

.records-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.records-section-heading h2 {
    margin: 0;
    font-size: 18px;
    color: #17213a;
}

.records-section-heading span {
    color: #667085;
    font-size: 13px;
}

.records-section-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(180px, 1fr));
    gap: 14px;
}

.records-section-card {
    border: 1px solid #e4e7ec;
    border-radius: 12px;
    padding: 15px;
    background: #fafafa;
}

.records-section-card h3 {
    margin: 0 0 12px;
    font-size: 16px;
}

.records-stat {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 0;
    color: #475467;
    font-size: 13px;
}

.records-stat strong {
    color: #17213a;
}

.records-section-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 13px;
}

.records-action {
    border: 0;
    border-radius: 7px;
    padding: 8px 10px;
    cursor: pointer;
    background: #315f9b;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.records-action.absent {
    background: #b42318;
}

.records-school-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 12px;
}

.records-school-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
}

.records-school-name {
    font-weight: 750;
    color: #17213a;
}

.records-school-count {
    margin-top: 3px;
    font-size: 12px;
    color: #667085;
}

.records-view-school {
    flex-shrink: 0;
    border: 0;
    border-radius: 7px;
    padding: 8px 10px;
    cursor: pointer;
    background: #315f9b;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.records-student-live-search {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto;
    gap: 8px 14px;
    align-items: center;
    padding: 14px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #eaecf0;
}

.records-student-live-search label {
    grid-column: 1 / -1;
    color: #344054;
    font-size: 13px;
    font-weight: 800;
}

.records-student-live-search input {
    width: 100%;
    min-height: 42px;
    padding: 9px 12px;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    background: #fff;
    color: #101828;
    box-sizing: border-box;
    outline: none;
}

.records-student-live-search input:focus {
    border-color: #667085;
    box-shadow: 0 0 0 3px rgba(16, 24, 40, .06);
}

#recordsStudentLiveSearchCount {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.records-table-wrap {
    overflow-x: auto;
}

.records-table {
    width: 100%;
    min-width: 1100px;
    border-collapse: collapse;
}

.records-table th,
.records-table td {
    padding: 11px 12px;
    border-bottom: 1px solid #eaecf0;
    text-align: left;
    vertical-align: top;
    font-size: 13px;
}

.records-table th {
    background: #f8fafc;
    color: #344054;
    font-weight: 800;
}

.records-student-name {
    font-weight: 750;
    color: #17213a;
}

.records-muted {
    color: #667085;
    font-size: 12px;
}

.records-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
}

.records-badge.present {
    background: #dcfce7;
    color: #166534;
}

.records-badge.absent {
    background: #fee4e2;
    color: #b42318;
}

.records-badge.not-scanned {
    background: #f2f4f7;
    color: #475467;
}

.records-badge.result {
    background: #eff6ff;
    color: #1d4ed8;
}

.records-empty {
    text-align: center;
    padding: 28px;
    color: #667085;
}

.records-student-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 300px;
}

.records-student-action {
    border: 0;
    border-radius: 7px;
    padding: 7px 9px;
    cursor: pointer;
    background: #315f9b;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
}

.records-student-action.result {
    background: #166534;
}

.records-student-action.documents {
    background: #6941c6;
}

.records-student-action:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.records-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(16, 24, 40, .62);
}

.records-modal[hidden] {
    display: none;
}

.records-modal-dialog {
    width: min(980px, 100%);
    max-height: calc(100vh - 40px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(16, 24, 40, .24);
}

.records-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 18px;
    border-bottom: 1px solid #eaecf0;
}

.records-modal-header h2 {
    margin: 0;
    color: #17213a;
    font-size: 18px;
}

.records-modal-close {
    border: 0;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #f2f4f7;
    color: #344054;
    cursor: pointer;
    font-size: 20px;
    font-weight: 800;
}

.records-modal-body {
    overflow-y: auto;
    padding: 18px;
}

.records-modal-loading,
.records-modal-error,
.records-modal-empty {
    padding: 30px 20px;
    text-align: center;
    color: #667085;
}

.records-modal-error {
    color: #b42318;
}

.records-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.records-detail-card {
    border: 1px solid #e4e7ec;
    border-radius: 11px;
    padding: 14px;
    background: #fff;
}

.records-detail-card.full {
    grid-column: 1 / -1;
}

.records-detail-card h3 {
    margin: 0 0 12px;
    color: #17213a;
    font-size: 15px;
}

.records-detail-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid #f2f4f7;
}

.records-detail-row:last-child {
    border-bottom: 0;
}

.records-detail-label {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.records-detail-value {
    color: #17213a;
    font-size: 13px;
    font-weight: 650;
    word-break: break-word;
}

.records-status-present {
    color: #166534;
    font-weight: 850;
}

.records-status-absent {
    color: #b42318;
    font-weight: 850;
}

.records-qr-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.records-qr-card {
    border: 1px solid #e4e7ec;
    border-radius: 11px;
    padding: 14px;
    text-align: center;
}

.records-qr-card img {
    display: block;
    width: 180px;
    max-width: 100%;
    height: auto;
    margin: 10px auto 0;
}

.records-result-table {
    width: 100%;
    border-collapse: collapse;
}

.records-result-table th,
.records-result-table td {
    padding: 9px 10px;
    border-bottom: 1px solid #eaecf0;
    text-align: left;
    font-size: 12px;
}

.records-result-table th {
    background: #f8fafc;
    color: #344054;
    font-weight: 800;
}

.records-document-list {
    display: grid;
    gap: 10px;
}

.records-document-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 13px 14px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
}

.records-document-name {
    color: #17213a;
    font-size: 13px;
    font-weight: 800;
}

.records-document-status {
    color: #667085;
    font-size: 12px;
}

.records-document-link {
    flex-shrink: 0;
    display: inline-block;
    padding: 7px 10px;
    border-radius: 7px;
    background: #315f9b;
    color: #fff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
}

.records-document-link.disabled {
    background: #eaecf0;
    color: #98a2b3;
    pointer-events: none;
}

@media (max-width: 700px) {
    .records-student-actions {
        min-width: 220px;
    }

    .records-detail-grid,
    .records-qr-grid {
        grid-template-columns: 1fr;
    }

    .records-detail-card.full {
        grid-column: auto;
    }

    .records-detail-row {
        grid-template-columns: 1fr;
        gap: 3px;
    }

    .records-document-item {
        align-items: flex-start;
        flex-direction: column;
    }
}


@media (max-width: 1100px) {
    .records-filter-card {
        grid-template-columns: 1fr 1fr;
    }

    .records-search-wrap {
        grid-column: 1 / -1;
    }

    .records-section-grid {
        grid-template-columns: repeat(3, minmax(180px, 1fr));
    }

    .records-school-list {
        grid-template-columns: repeat(2, minmax(220px, 1fr));
    }
}

@media (max-width: 700px) {
    .records-filter-card,
    .records-section-grid,
    .records-school-list {
        grid-template-columns: 1fr;
    }
}
</style>


<div
    class="records-modal"
    id="recordsStudentModal"
    hidden
    aria-hidden="true"
>
    <div
        class="records-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="recordsStudentModalTitle"
    >
        <div class="records-modal-header">
            <h2 id="recordsStudentModalTitle">
                RTSE Student Record
            </h2>

            <button
                type="button"
                class="records-modal-close"
                id="recordsStudentModalClose"
                aria-label="Close"
            >
                &times;
            </button>
        </div>

        <div
            class="records-modal-body"
            id="recordsStudentModalBody"
        >
            <div class="records-modal-loading">
                Select a student action to view the record.
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const searchInput = document.getElementById("recordsSearch");
    const yearSelect = document.getElementById("recordsYear");
    const centreSelect = document.getElementById("recordsCentre");
    const clearButton = document.getElementById("recordsClear");
    const loading = document.getElementById("recordsLoading");

    const sectionsContainer = document.getElementById("recordsSections");
    const schoolsContainer = document.getElementById("recordsSchools");
    const studentsContainer = document.getElementById("recordsStudents");
    const studentCount = document.getElementById("recordsStudentCount");
    const scopeText = document.getElementById("recordsScopeText");

    const studentLiveSearch =
        document.getElementById("recordsStudentLiveSearch");

    const studentLiveSearchCount =
        document.getElementById("recordsStudentLiveSearchCount");

    const drilldown = document.getElementById("recordsDrilldown");
    const drilldownTitle = document.getElementById("recordsDrilldownTitle");
    const drilldownStudents = document.getElementById("recordsDrilldownStudents");
    const drilldownClose = document.getElementById("recordsDrilldownClose");

    const studentModal =
        document.getElementById("recordsStudentModal");
    const studentModalClose =
        document.getElementById("recordsStudentModalClose");
    const studentModalTitle =
        document.getElementById("recordsStudentModalTitle");
    const studentModalBody =
        document.getElementById("recordsStudentModalBody");

    let searchTimer = null;
    let requestSequence = 0;
    let currentStudents = [];

    function escapeHtml(value) {
        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function attendanceBadge(status) {
        const normalized = String(status || "").toUpperCase();

        if (normalized === "PRESENT") {
            return '<span class="records-badge present">PRESENT</span>';
        }

        if (normalized === "ABSENT") {
            return '<span class="records-badge absent">ABSENT</span>';
        }

        return '<span class="records-badge not-scanned">NOT SCANNED</span>';
    }

    function resultBadge(student) {
        if (!student.result_id) {
            return '<span class="records-badge not-scanned">NO RESULT</span>';
        }

        const status = student.result_status || "Entered";
        const percentage = student.percentage !== null &&
            student.percentage !== undefined
            ? ` · ${escapeHtml(student.percentage)}%`
            : "";

        return `
            <span class="records-badge result">
                ${escapeHtml(status)}${percentage}
            </span>
        `;
    }

    function openStudentModal(title = "RTSE Student Record") {
        studentModalTitle.textContent = title;
        studentModal.hidden = false;
        studentModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeStudentModal() {
        studentModal.hidden = true;
        studentModal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    function setStudentModalLoading(message = "Loading student record...") {
        studentModalBody.innerHTML = `
            <div class="records-modal-loading">
                ${escapeHtml(message)}
            </div>
        `;
    }

    function setStudentModalError(message) {
        studentModalBody.innerHTML = `
            <div class="records-modal-error">
                ${escapeHtml(message)}
            </div>
        `;
    }


    function formatRecordValue(value) {
        if (value === null || value === undefined || value === "") {
            return "-";
        }

        return escapeHtml(value);
    }

    function formatDateValue(value) {
        if (!value) {
            return "-";
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return escapeHtml(value);
        }

        return escapeHtml(
            date.toLocaleDateString("en-IN", {
                day: "2-digit",
                month: "short",
                year: "numeric"
            })
        );
    }

    function attendanceStatusHtml(status) {
        const normalized =
            String(status || "").trim().toUpperCase();

        if (normalized === "PRESENT") {
            return '<span class="records-status-present">PRESENT</span>';
        }

        if (normalized === "ABSENT") {
            return '<span class="records-status-absent">ABSENT</span>';
        }

        return '<span>NOT SCANNED</span>';
    }

    function componentGrade(marks, maximumMarks, gradeCounting) {
        if (!Number(gradeCounting)) {
            return "-";
        }

        const obtained = Number(marks);
        const maximum = Number(maximumMarks);

        if (
            !Number.isFinite(obtained) ||
            !Number.isFinite(maximum) ||
            maximum <= 0
        ) {
            return "-";
        }

        const percentage = (obtained / maximum) * 100;

        if (percentage >= 90) return "A+";
        if (percentage >= 80) return "A";
        if (percentage >= 70) return "B+";
        if (percentage >= 60) return "B";
        if (percentage >= 50) return "C+";
        if (percentage >= 40) return "C";

        return "F";
    }

    function renderDetailRows(rows) {
        return rows.map(row => `
            <div class="records-detail-row">
                <div class="records-detail-label">
                    ${row.label}
                </div>
                <div class="records-detail-value">
                    ${row.value}
                </div>
            </div>
        `).join("");
    }

    function renderBasicStudentRecord(record) {
        const application = record.application || {};
        const centre = record.centre || {};
        const attendance = record.attendance || {};

        const attendanceStatus =
            String(attendance.status || "").toUpperCase();

        const admitQr =
            attendance.admit_qr_data_url
                ? `
                    <div class="records-qr-card">
                        <strong>Admit Card QR</strong>
                        <img
                            src="${attendance.admit_qr_data_url}"
                            alt="Admit Card QR"
                        >
                    </div>
                `
                : `
                    <div class="records-qr-card">
                        <strong>Admit Card QR</strong>
                        <div class="records-modal-empty">
                            QR not available
                        </div>
                    </div>
                `;

        const resultQr =
