    async function loadStudentRecord(applicationId, action) {
        const id = Number(applicationId);

        if (!Number.isInteger(id) || id <= 0) {
            setStudentModalError("Invalid student record.");
            return;
        }

        openStudentModal();
        setStudentModalLoading("Loading student record...");

        const params = new URLSearchParams();

        if (searchInput.value.trim()) {
            params.set("search", searchInput.value.trim());
        }

        if (yearSelect.value) {
            params.set("year", yearSelect.value);
        }

        if (centreSelect.value) {
            params.set("centre", centreSelect.value);
        }

        try {
            const response = await fetch(
                `/admin/rtse/records/student/${encodeURIComponent(id)}?${params.toString()}`,
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success || !data.record) {
                throw new Error(
                    data.message ||
                    "Unable to load this student record."
                );
            }

            const record = data.record;

            if (action === "basic") {
                studentModalTitle.textContent =
                    "BASIC & EXAM — " +
                    (record.application?.full_name || "Student");

                renderBasicStudentRecord(record);
                return;
            }

            if (action === "result") {
                if (
                    String(record.attendance?.status || "")
                        .toUpperCase() !== "PRESENT"
                ) {
                    setStudentModalError(
                        "Result & Certificate details are available only for PRESENT students."
                    );
                    return;
                }

                studentModalTitle.textContent =
                    "RESULT & CERTIFICATE — " +
                    (record.application?.full_name || "Student");

                renderResultCertificateRecord(record);
                return;
            }

            if (action === "documents") {
                studentModalTitle.textContent =
                    "DOCUMENTS — " +
                    (record.application?.full_name || "Student");

                renderDocumentsRecord(record);
                return;
            }

            setStudentModalError("Unknown student action.");
        } catch (error) {
            console.error(
                "RTSE Records student popup error:",
                error
            );

            setStudentModalError(
                error.message ||
                "Unable to load this student record."
            );
        }
    }

    function updateUrl() {
        const params = new URLSearchParams();

        const search = searchInput.value.trim();
        const year = yearSelect.value;
        const centre = centreSelect.value;

        if (search) params.set("search", search);
        if (year) params.set("year", year);
        if (centre) params.set("centre", centre);

        const query = params.toString();
        window.history.replaceState(
            null,
            "",
            window.location.pathname + (query ? "?" + query : "")
        );
    }

