<%- include("../partials/header") %>

<div class="admin-layout">
    <%- include("../partials/sidebar") %>

    <main class="admin-content">
        <div class="container records-page">

            <div class="records-header">
                <div>
                    <h1>RTSE RECORDS DASHBOARD</h1>
                    <p>Historical RTSE student records, attendance and examination history.</p>
                </div>
            </div>

            <div class="records-filter-card">
                <div class="records-search-wrap">
                    <label for="recordsSearch">Search Records</label>
                    <input
                        type="search"
                        id="recordsSearch"
                        value="<%= filters.search %>"
                        placeholder="Search by student name, registration, roll, school, centre, section, gender..."
                        autocomplete="off"
                    >
                </div>

                <div class="records-filter">
                    <label for="recordsYear">Year</label>
                    <select id="recordsYear">
                        <option value="">All Years</option>
                        <% years.forEach(function(year) { %>
                            <option
                                value="<%= year %>"
                                <%= String(filters.year) === String(year) ? "selected" : "" %>
                            >
                                <%= year %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="records-filter">
                    <label for="recordsCentre">Centre</label>
                    <select id="recordsCentre">
                        <option value="">All Centres</option>
                        <% centres.forEach(function(centre) { %>
                            <option
                                value="<%= centre.id %>"
                                <%= String(filters.centreId) === String(centre.id) ? "selected" : "" %>
                            >
                                <%= centre.centre_name || centre.centre_code || ("Centre " + centre.id) %>
                                <% if (centre.centre_code) { %>
                                    — <%= centre.centre_code %>
                                <% } %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <button type="button" id="recordsClear" class="records-clear">
                    Clear
                </button>
            </div>

            <div id="recordsLoading" class="records-loading" hidden>
                Loading records...
            </div>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>SECTION-WISE STUDENTS</h2>
                    <span id="recordsScopeText"></span>
                </div>

                <div id="recordsSections" class="records-section-grid"></div>
            </section>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>SCHOOL-WISE STUDENTS</h2>
                </div>

                <div id="recordsSchools" class="records-school-list"></div>
            </section>

            <section class="records-section">
                <div class="records-section-heading">
                    <h2>STUDENTS</h2>
                    <span id="recordsStudentCount"></span>
                </div>

                <div class="records-student-live-search">
                    <label for="recordsStudentLiveSearch">
                        Search Students
                    </label>

                    <input
                        type="search"
                        id="recordsStudentLiveSearch"
                        placeholder="Search by any available student information..."
                        autocomplete="off"
                    >

                    <span id="recordsStudentLiveSearchCount"></span>
                </div>

                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Roll No.</th>
                                <th>Registration</th>
                                <th>Student</th>
                                <th>School</th>
                                <th>Centre</th>
                                <th>Year</th>
                                <th>Section</th>
                                <th>Gender</th>
                                <th>Attendance</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody id="recordsStudents"></tbody>
                    </table>
                </div>
            </section>

            <section
                class="records-section records-drilldown"
                id="recordsDrilldown"
                hidden
            >
                <div class="records-section-heading">
                    <h2 id="recordsDrilldownTitle">STUDENT DRILL-DOWN</h2>
                    <button type="button" id="recordsDrilldownClose" class="records-close">
                        Close
                    </button>
                </div>

                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Roll No.</th>
                                <th>Registration</th>
                                <th>Student</th>
                                <th>School</th>
                                <th>Section</th>
                                <th>Year</th>
                                <th>Attendance</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody id="recordsDrilldownStudents"></tbody>
                    </table>
                </div>
            </section>

        </div>
    </main>
</div>

<style>
.records-page {
    max-width: 1500px;
    margin: 0 auto;
}

.records-header {
    margin-bottom: 18px;
}

.records-header h1 {
    margin: 0;
    color: #17213a;
    font-size: 28px;
    font-weight: 850;
}

.records-header p {
    margin: 7px 0 0;
    color: #667085;
}

.records-filter-card {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 180px 260px auto;
    gap: 14px;
    align-items: end;
    padding: 18px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    margin-bottom: 20px;
}

.records-filter-card label,
.records-search-wrap label {
    display: block;
    margin-bottom: 7px;
    font-size: 13px;
    font-weight: 750;
    color: #344054;
}

.records-filter-card input,
.records-filter-card select {
    width: 100%;
    height: 43px;
    box-sizing: border-box;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    padding: 0 12px;
    background: #fff;
    font-size: 14px;
}

.records-clear,
.records-close {
    height: 43px;
    padding: 0 16px;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    background: #fff;
    cursor: pointer;
    font-weight: 700;
}

.records-loading {
    margin-bottom: 14px;
    padding: 10px 14px;
    border-radius: 9px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 13px;
}

.records-section {
    margin-top: 20px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 18px;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
}

.records-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.records-section-heading h2 {
    margin: 0;
    font-size: 18px;
    color: #17213a;
}

.records-section-heading span {
    color: #667085;
    font-size: 13px;
}

.records-section-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(180px, 1fr));
    gap: 14px;
}

.records-section-card {
    border: 1px solid #e4e7ec;
    border-radius: 12px;
    padding: 15px;
    background: #fafafa;
}

.records-section-card h3 {
    margin: 0 0 12px;
    font-size: 16px;
}

.records-stat {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 0;
    color: #475467;
    font-size: 13px;
}

.records-stat strong {
    color: #17213a;
}

.records-section-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 13px;
}

.records-action {
    border: 0;
    border-radius: 7px;
    padding: 8px 10px;
    cursor: pointer;
    background: #315f9b;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.records-action.absent {
    background: #b42318;
}

.records-school-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 12px;
}

.records-school-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
}

.records-school-name {
    font-weight: 750;
    color: #17213a;
}

.records-school-count {
    margin-top: 3px;
    font-size: 12px;
    color: #667085;
}

.records-view-school {
    flex-shrink: 0;
    border: 0;
    border-radius: 7px;
    padding: 8px 10px;
    cursor: pointer;
    background: #315f9b;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.records-student-live-search {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto;
    gap: 8px 14px;
    align-items: center;
    padding: 14px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #eaecf0;
}

.records-student-live-search label {
    grid-column: 1 / -1;
    color: #344054;
    font-size: 13px;
    font-weight: 800;
}

.records-student-live-search input {
    width: 100%;
    min-height: 42px;
    padding: 9px 12px;
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    background: #fff;
    color: #101828;
    box-sizing: border-box;
    outline: none;
}

.records-student-live-search input:focus {
    border-color: #667085;
    box-shadow: 0 0 0 3px rgba(16, 24, 40, .06);
}

#recordsStudentLiveSearchCount {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.records-table-wrap {
    overflow-x: auto;
}

.records-table {
    width: 100%;
    min-width: 1100px;
    border-collapse: collapse;
}

.records-table th,
.records-table td {
    padding: 11px 12px;
    border-bottom: 1px solid #eaecf0;
    text-align: left;
    vertical-align: top;
    font-size: 13px;
}

.records-table th {
    background: #f8fafc;
    color: #344054;
    font-weight: 800;
}

.records-student-name {
    font-weight: 750;
    color: #17213a;
}

.records-muted {
    color: #667085;
    font-size: 12px;
}

.records-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
}

.records-badge.present {
    background: #dcfce7;
    color: #166534;
}

.records-badge.absent {
    background: #fee4e2;
    color: #b42318;
}

.records-badge.not-scanned {
    background: #f2f4f7;
    color: #475467;
}

.records-badge.result {
    background: #eff6ff;
    color: #1d4ed8;
}

.records-empty {
    text-align: center;
    padding: 28px;
    color: #667085;
}

@media (max-width: 1100px) {
    .records-filter-card {
        grid-template-columns: 1fr 1fr;
    }

    .records-search-wrap {
        grid-column: 1 / -1;
    }

    .records-section-grid {
        grid-template-columns: repeat(3, minmax(180px, 1fr));
    }

    .records-school-list {
        grid-template-columns: repeat(2, minmax(220px, 1fr));
    }
}

@media (max-width: 700px) {
    .records-filter-card,
    .records-section-grid,
    .records-school-list {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
(function () {
    const searchInput = document.getElementById("recordsSearch");
    const yearSelect = document.getElementById("recordsYear");
    const centreSelect = document.getElementById("recordsCentre");
    const clearButton = document.getElementById("recordsClear");
    const loading = document.getElementById("recordsLoading");

    const sectionsContainer = document.getElementById("recordsSections");
    const schoolsContainer = document.getElementById("recordsSchools");
    const studentsContainer = document.getElementById("recordsStudents");
    const studentCount = document.getElementById("recordsStudentCount");
    const scopeText = document.getElementById("recordsScopeText");

    const studentLiveSearch =
        document.getElementById("recordsStudentLiveSearch");

    const studentLiveSearchCount =
        document.getElementById("recordsStudentLiveSearchCount");

    const drilldown = document.getElementById("recordsDrilldown");
    const drilldownTitle = document.getElementById("recordsDrilldownTitle");
    const drilldownStudents = document.getElementById("recordsDrilldownStudents");
    const drilldownClose = document.getElementById("recordsDrilldownClose");

    let searchTimer = null;
    let requestSequence = 0;
    let currentStudents = [];

    function escapeHtml(value) {
        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function attendanceBadge(status) {
        const normalized = String(status || "").toUpperCase();

        if (normalized === "PRESENT") {
            return '<span class="records-badge present">PRESENT</span>';
        }

        if (normalized === "ABSENT") {
            return '<span class="records-badge absent">ABSENT</span>';
        }

        return '<span class="records-badge not-scanned">NOT SCANNED</span>';
    }

    function resultBadge(student) {
        if (!student.result_id) {
            return '<span class="records-badge not-scanned">NO RESULT</span>';
        }

        const status = student.result_status || "Entered";
        const percentage = student.percentage !== null &&
            student.percentage !== undefined
            ? ` · ${escapeHtml(student.percentage)}%`
            : "";

        return `
            <span class="records-badge result">
                ${escapeHtml(status)}${percentage}
            </span>
        `;
    }

    function updateUrl() {
        const params = new URLSearchParams();

        const search = searchInput.value.trim();
        const year = yearSelect.value;
        const centre = centreSelect.value;

        if (search) params.set("search", search);
        if (year) params.set("year", year);
        if (centre) params.set("centre", centre);

        const query = params.toString();
        window.history.replaceState(
            null,
            "",
            window.location.pathname + (query ? "?" + query : "")
        );
    }

    function renderSections(sections) {
        sectionsContainer.innerHTML = sections.map(section => `
            <div class="records-section-card">
                <h3>SECTION ${escapeHtml(section.section)}</h3>

                <div class="records-stat">
                    <span>Total Students</span>
                    <strong>${Number(section.total_students || 0)}</strong>
                </div>

                <div class="records-stat">
                    <span>Male</span>
                    <strong>${Number(section.male_students || 0)}</strong>
                </div>

                <div class="records-stat">
                    <span>Female</span>
                    <strong>${Number(section.female_students || 0)}</strong>
                </div>

                <div class="records-stat">
                    <span>Present</span>
                    <strong>${Number(section.present_students || 0)}</strong>
                </div>

                <div class="records-stat">
                    <span>Absent</span>
                    <strong>${Number(section.absent_students || 0)}</strong>
                </div>

                <div class="records-section-actions">
                    <button
                        type="button"
                        class="records-action"
                        data-drill-section="${escapeHtml(section.section)}"
                        data-drill-attendance="PRESENT"
                    >
                        See Present Students
                    </button>

                    <button
                        type="button"
                        class="records-action absent"
                        data-drill-section="${escapeHtml(section.section)}"
                        data-drill-attendance="ABSENT"
                    >
                        See Absent Students
                    </button>
                </div>
            </div>
        `).join("");
    }

    function renderSchools(schools) {
        if (!schools.length) {
            schoolsContainer.innerHTML =
                '<div class="records-empty">No schools found for the selected scope.</div>';
            return;
        }

        schoolsContainer.innerHTML = schools.map(school => `
            <div class="records-school-card">
                <div>
                    <div class="records-school-name">
                        ${escapeHtml(school.school_name || "Unknown School")}
                    </div>

                    <div class="records-school-count">
                        ${Number(school.total_students || 0)} student(s)
                        ${school.school_code
                            ? " · " + escapeHtml(school.school_code)
                            : ""}
                    </div>
                </div>

                <button
                    type="button"
                    class="records-view-school"
                    data-school-id="${escapeHtml(school.school_id)}"
                    data-school-name="${escapeHtml(school.school_name || "School")}"
                >
                    View Students
                </button>
            </div>
        `).join("");
    }

    function getStudentSearchText(student) {
        return Object.values(student || {})
            .map(value => {
                if (value === null || value === undefined) {
                    return "";
                }

                if (typeof value === "object") {
                    try {
                        return JSON.stringify(value);
                    } catch {
                        return String(value);
                    }
                }

                return String(value);
            })
            .join(" ")
            .toLowerCase();
    }

    function renderStudents(students) {
        currentStudents = Array.isArray(students)
            ? students
            : [];

        const query =
            String(studentLiveSearch.value || "")
                .trim()
                .toLowerCase();

        const filteredStudents = query
            ? currentStudents.filter(student =>
                getStudentSearchText(student).includes(query)
            )
            : currentStudents;

        studentCount.textContent =
            `${currentStudents.length.toLocaleString()} student(s)`;

        studentLiveSearchCount.textContent =
            query
                ? `${filteredStudents.length.toLocaleString()} matching`
                : "";

        if (!filteredStudents.length) {
            studentsContainer.innerHTML = `
                <tr>
                    <td colspan="11" class="records-empty">
                        ${
                            query
                                ? "No students found matching the live search."
                                : "No students found for the selected search, year and centre."
                        }
                    </td>
                </tr>
            `;
            return;
        }

        studentsContainer.innerHTML = filteredStudents.map((student, index) => `
            <tr>
                <td>${index + 1}</td>

                <td>
                    <strong>${escapeHtml(student.roll_no || student.roll_number || "-")}</strong>
                </td>

                <td>${escapeHtml(student.registration_no || "-")}</td>

                <td>
                    <div class="records-student-name">
                        ${escapeHtml(student.full_name || "-")}
                    </div>

                    <div class="records-muted">
                        ${escapeHtml(student.father_name || "")}
                    </div>
                </td>

                <td>${escapeHtml(student.school_name || "-")}</td>

                <td>${escapeHtml(student.centre_name || student.centre_code || "-")}</td>

                <td>${escapeHtml(student.application_year || "-")}</td>

                <td>${escapeHtml(student.section || "-")}</td>

                <td>${escapeHtml(student.gender || "-")}</td>

                <td>${attendanceBadge(student.attendance_status)}</td>

                <td>${resultBadge(student)}</td>
            </tr>
        `).join("");
    }

    function renderScope() {
        const yearText = yearSelect.value
            ? `Year ${yearSelect.value}`
            : "All Years";

        const centreText = centreSelect.value
            ? centreSelect.options[centreSelect.selectedIndex].text
            : "All Centres";

        scopeText.textContent = `${yearText} · ${centreText}`;
    }

    async function loadData() {
        const sequence = ++requestSequence;

        loading.hidden = false;

        const params = new URLSearchParams();

        if (searchInput.value.trim()) {
            params.set("search", searchInput.value.trim());
        }

        if (yearSelect.value) {
            params.set("year", yearSelect.value);
        }

        if (centreSelect.value) {
            params.set("centre", centreSelect.value);
        }

        try {
            const response = await fetch(
                "/admin/rtse/records/data?" + params.toString(),
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const data = await response.json();

            if (sequence !== requestSequence) {
                return;
            }

            if (!response.ok || !data.success) {
                throw new Error(data.message || "Unable to load records.");
            }

            renderScope();
            renderSections(data.sections || []);
            renderSchools(data.schools || []);
            renderStudents(data.students || []);
        } catch (error) {
            console.error(error);

            sectionsContainer.innerHTML = "";
            schoolsContainer.innerHTML = "";
            studentsContainer.innerHTML = `
                <tr>
                    <td colspan="11" class="records-empty">
                        Unable to load records. Please try again.
                    </td>
                </tr>
            `;
        } finally {
            if (sequence === requestSequence) {
                loading.hidden = true;
            }
        }
    }

    async function reloadCentres() {
        const year = yearSelect.value;
        const previousCentre = centreSelect.value;

        const params = new URLSearchParams();

        if (year) {
            params.set("year", year);
        }

        try {
            const response = await fetch(
                "/admin/rtse/records/centres?" + params.toString(),
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || "Unable to load centres.");
            }

            centreSelect.innerHTML =
                '<option value="">All Centres</option>';

            (data.centres || []).forEach(centre => {
                const option = document.createElement("option");
                option.value = centre.id;

                option.textContent =
                    (centre.centre_name || centre.centre_code || ("Centre " + centre.id)) +
                    (centre.centre_code
                        ? " — " + centre.centre_code
                        : "");

                if (String(centre.id) === String(previousCentre)) {
                    option.selected = true;
                }

                centreSelect.appendChild(option);
            });

            updateUrl();
            await loadData();
        } catch (error) {
            console.error(error);
            await loadData();
        }
    }

    async function loadDrilldown(options) {
        drilldown.hidden = false;
        drilldownStudents.innerHTML = `
            <tr>
                <td colspan="9" class="records-empty">
                    Loading students...
                </td>
            </tr>
        `;

        const params = new URLSearchParams();

        if (searchInput.value.trim()) {
            params.set("search", searchInput.value.trim());
        }

        if (yearSelect.value) {
            params.set("year", yearSelect.value);
        }

        if (centreSelect.value) {
            params.set("centre", centreSelect.value);
        }

        if (options.section) {
            params.set("section", options.section);
        }

        if (options.schoolId) {
            params.set("school_id", options.schoolId);
        }

        if (options.attendance) {
            params.set("attendance", options.attendance);
        }

        const query = params.toString();

        try {
            const response = await fetch(
                "/admin/rtse/records?" + query,
                {
                    headers: {
                        "Accept": "text/html"
                    }
                }
            );

            if (!response.ok) {
                throw new Error("Unable to load drill-down.");
            }

            const html = await response.text();

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, "text/html");

            const rows = doc.querySelectorAll(
                "#recordsDrilldownStudents tr"
            );

            drilldownStudents.innerHTML = "";

            rows.forEach(row => {
                drilldownStudents.appendChild(
                    document.importNode(row, true)
                );
            });

            const title =
                options.title ||
                (options.section
                    ? `SECTION ${options.section}`
                    : "SCHOOL STUDENTS");

            drilldownTitle.textContent = title;
        } catch (error) {
            console.error(error);

            drilldownStudents.innerHTML = `
                <tr>
                    <td colspan="9" class="records-empty">
                        Unable to load drill-down students.
                    </td>
                </tr>
            `;
        }

        drilldown.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }

    function renderInitialDrilldown() {
        <% if (drilldown) { %>
            const initialStudents = <%- JSON.stringify(drilldown.students || []) %>;

            if (initialStudents.length || <%= drilldown.section ? "true" : "false" %> || <%= drilldown.schoolId ? "true" : "false" %>) {
                drilldown.hidden = false;

                drilldownTitle.textContent =
                    <%- JSON.stringify(
                        drilldown.section
                            ? `SECTION ${drilldown.section}${drilldown.attendance ? " — " + drilldown.attendance : ""}`
                            : "SCHOOL STUDENTS"
                    ) %>;

                if (!initialStudents.length) {
                    drilldownStudents.innerHTML = `
                        <tr>
                            <td colspan="9" class="records-empty">
                                No students found.
                            </td>
                        </tr>
                    `;
                } else {
                    drilldownStudents.innerHTML = initialStudents.map((student, index) => `
                        <tr>
                            <td>${index + 1}</td>
                            <td><strong>${escapeHtml(student.roll_no || student.roll_number || "-")}</strong></td>
                            <td>${escapeHtml(student.registration_no || "-")}</td>
                            <td>
                                <div class="records-student-name">
                                    ${escapeHtml(student.full_name || "-")}
                                </div>
                                <div class="records-muted">
                                    ${escapeHtml(student.father_name || "")}
                                </div>
                            </td>
                            <td>${escapeHtml(student.school_name || "-")}</td>
                            <td>${escapeHtml(student.section || "-")}</td>
                            <td>${escapeHtml(student.application_year || "-")}</td>
                            <td>${attendanceBadge(student.attendance_status)}</td>
                            <td>${resultBadge(student)}</td>
                        </tr>
                    `).join("");
                }
            }
        <% } %>
    }

    searchInput.addEventListener("input", function () {
        clearTimeout(searchTimer);

        searchTimer = setTimeout(function () {
            updateUrl();
            loadData();
        }, 250);
    });

    studentLiveSearch.addEventListener("input", function () {
        renderStudents(currentStudents);
    });

    yearSelect.addEventListener("change", reloadCentres);

    centreSelect.addEventListener("change", function () {
        updateUrl();
        loadData();
    });

    clearButton.addEventListener("click", function () {
        searchInput.value = "";
        yearSelect.value = "";
        centreSelect.value = "";

        reloadCentres();
    });

    drilldownClose.addEventListener("click", function () {
        drilldown.hidden = true;
        drilldownStudents.innerHTML = "";
    });

    document.addEventListener("click", function (event) {
        const sectionButton =
            event.target.closest("[data-drill-section]");

        if (sectionButton) {
            const params = new URLSearchParams();

            if (searchInput.value.trim()) {
                params.set("search", searchInput.value.trim());
            }

            if (yearSelect.value) {
                params.set("year", yearSelect.value);
            }

            if (centreSelect.value) {
                params.set("centre", centreSelect.value);
            }

            params.set(
                "attendance",
                sectionButton.dataset.drillAttendance
            );

            const section = sectionButton.dataset.drillSection;

            window.location.href =
                `/admin/rtse/records/section/${encodeURIComponent(section)}` +
                `?${params.toString()}`;

            return;
        }

        const schoolButton =
            event.target.closest("[data-school-id]");

        if (schoolButton) {
            const params = new URLSearchParams();

            if (searchInput.value.trim()) {
                params.set("search", searchInput.value.trim());
            }

            if (yearSelect.value) {
                params.set("year", yearSelect.value);
            }

            if (centreSelect.value) {
                params.set("centre", centreSelect.value);
            }

            const schoolId = schoolButton.dataset.schoolId;

            window.location.href =
                `/admin/rtse/records/school/${encodeURIComponent(schoolId)}` +
                `?${params.toString()}`;

            return;
        }
    });

    renderInitialDrilldown();
    loadData();
})();
</script>

<%- include("../partials/footer") %>
