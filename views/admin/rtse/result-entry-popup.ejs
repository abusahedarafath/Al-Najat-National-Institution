<style>
/* =========================================
   RTSE Counted OMR
   ========================================= */

.rtse-counted-omr-box {
    border:1px solid #e5e7eb;
    border-radius:10px;
    background:#fff;
    padding:12px;
    margin-bottom:10px;
    box-sizing:border-box;
}

.rtse-counted-omr-note {
    font-size:11px;
    line-height:1.5;
    color:#6b7280;
    margin:-3px 0 9px;
}

.rtse-counted-omr-actions,
.rtse-omr-editor-actions,
.rtse-omr-upload-actions {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:7px;
}

.rtse-omr-btn {
    width:100%;
    min-height:36px;
    border:0;
    border-radius:7px;
    padding:7px 9px;
    font-size:12px;
    font-weight:600;
    cursor:pointer;
    box-sizing:border-box;
}

.rtse-omr-btn:disabled {
    opacity:.65;
    cursor:not-allowed;
}

.rtse-omr-btn-camera {
    background:#2563eb;
    color:#fff;
}

.rtse-omr-btn-choose {
    background:#475569;
    color:#fff;
}

.rtse-omr-btn-crop {
    background:#16a34a;
    color:#fff;
}

.rtse-omr-btn-upload {
    background:#16a34a;
    color:#fff;
}

.rtse-omr-btn-cancel {
    background:#e5e7eb;
    color:#374151;
}

.rtse-omr-editor {
    margin-top:9px;
    border:1px solid #e2e8f0;
    border-radius:9px;
    background:#f8fafc;
    padding:9px;
}

.rtse-omr-editor-title {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    margin-bottom:7px;
    font-size:12px;
    font-weight:700;
    color:#172033;
}

.rtse-omr-editor-title small {
    font-size:9px;
    font-weight:500;
    color:#16a34a;
}

.rtse-omr-crop-stage {
    position:relative;
    width:100%;
    max-height:62vh;
    min-height:180px;
    overflow:hidden;
    border-radius:7px;
    background:#111827;
    touch-action:none;
    user-select:none;
}

.rtse-omr-crop-stage > img {
    display:block;
    width:100%;
    height:auto;
    max-height:62vh;
    object-fit:contain;
    margin:0 auto;
    user-select:none;
    pointer-events:none;
}

.rtse-omr-crop-box {
    position:absolute;
    box-sizing:border-box;
    border:2px solid #16a34a;
    background:rgba(22,163,74,.08);
    box-shadow:0 0 0 9999px rgba(0,0,0,.42);
    touch-action:none;
    cursor:move;
}

.rtse-omr-crop-label {
    position:absolute;
    top:5px;
    left:5px;
    padding:2px 5px;
    border-radius:4px;
    background:#16a34a;
    color:#fff;
    font-size:8px;
    font-weight:700;
    letter-spacing:.3px;
    pointer-events:none;
}

.rtse-omr-handle {
    position:absolute;
    width:15px;
    height:15px;
    border:2px solid #fff;
    background:#16a34a;
    border-radius:3px;
    box-sizing:border-box;
}

.rtse-omr-handle-nw {
    top:-7px;
    left:-7px;
    cursor:nwse-resize;
}

.rtse-omr-handle-ne {
    top:-7px;
    right:-7px;
    cursor:nesw-resize;
}

.rtse-omr-handle-sw {
    bottom:-7px;
    left:-7px;
    cursor:nesw-resize;
}

.rtse-omr-handle-se {
    bottom:-7px;
    right:-7px;
    cursor:nwse-resize;
}

.rtse-omr-editor-help {
    padding:7px 2px;
    color:#64748b;
    font-size:10px;
    line-height:1.4;
}

.rtse-omr-cropped-preview {
    margin-top:9px;
    padding:9px;
    border:1px solid #bbf7d0;
    border-radius:9px;
    background:#f0fdf4;
}

.rtse-omr-cropped-title {
    margin-bottom:7px;
    font-size:11px;
    font-weight:700;
    color:#15803d;
}

.rtse-omr-cropped-preview img {
    display:block;
    width:100%;
    max-height:55vh;
    object-fit:contain;
    border:1px solid #d1d5db;
    border-radius:6px;
    background:#fff;
    margin-bottom:8px;
}

.rtse-omr-upload-status {
    margin-top:7px;
    min-height:16px;
    font-size:10px;
    line-height:1.4;
    color:#475569;
}

.rtse-omr-existing {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-top:9px;
    padding:8px 9px;
    border:1px solid #bbf7d0;
    border-radius:7px;
    background:#f0fdf4;
    color:#15803d;
    font-size:10px;
    font-weight:600;
}

.rtse-omr-see-button {
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:30px;
    padding:5px 8px;
    border-radius:6px;
    background:#16a34a;
    color:#fff;
    text-decoration:none;
    font-size:10px;
    font-weight:700;
}

@media (max-width:600px) {

    .rtse-counted-omr-box {
        padding:9px;
    }

    .rtse-counted-omr-actions,
    .rtse-omr-editor-actions,
    .rtse-omr-upload-actions {
        gap:5px;
    }

    .rtse-omr-btn {
        min-height:34px;
        padding:6px 5px;
        font-size:10px;
    }

    .rtse-omr-editor-title {
        font-size:11px;
    }

    .rtse-omr-editor-title small {
        font-size:8px;
    }

    .rtse-omr-crop-stage {
        max-height:55vh;
    }

    .rtse-omr-crop-stage > img {
        max-height:55vh;
    }

    .rtse-omr-existing {
        align-items:stretch;
        flex-direction:column;
    }

    .rtse-omr-see-button {
        width:100%;
    }
}
</style>

