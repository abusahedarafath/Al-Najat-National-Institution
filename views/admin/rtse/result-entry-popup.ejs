.rtse-omr-modal-header {
    flex: 0 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding: 13px 16px;

    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
}

.rtse-omr-modal-header strong {
    display: block;
    color: #0f172a;
    font-size: 16px;
}

.rtse-omr-modal-header small {
    display: block;
    margin-top: 3px;
    color: #64748b;
    font-size: 12px;
}

.rtse-omr-modal-close {
    width: 34px;
    height: 34px;
    min-width: 34px;

    flex: 0 0 34px;

    border: 0;
    border-radius: 50%;

    background: #e2e8f0;
    color: #334155;

    font-size: 24px;
    line-height: 1;

    cursor: pointer;
}

.rtse-omr-modal-close:hover {
    background: #cbd5e1;
}

.rtse-omr-modal-body {
    min-height: 0;

    overflow: auto;

    padding: 14px;
