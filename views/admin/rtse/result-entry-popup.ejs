<div class="rtse-popup-result">

    <div class="rtse-popup-student">
        <div class="rtse-popup-section-title">
            <span>👤</span>
            <strong>Student Information</strong>
        </div>

        <div class="rtse-popup-student-grid">

            <div class="rtse-popup-info">
                <span>Roll Number</span>
                <strong><%= student.roll_no %></strong>
            </div>

            <div class="rtse-popup-info">
                <span>Registration No.</span>
                <strong><%= student.registration_no %></strong>
            </div>

            <div class="rtse-popup-info">
                <span>Student Name</span>
                <strong><%= student.full_name %></strong>
            </div>

            <div class="rtse-popup-info">
                <span>School</span>
                <strong><%= student.school_name %></strong>
            </div>

            <div class="rtse-popup-info">
                <span>Section</span>
                <strong><%= student.section %></strong>
            </div>

        </div>
    </div>


    <form
        id="rtseResultForm"
        action="/admin/rtse/result/<%= student.id %>"
        method="POST"
        data-history-fix="off"
    >

        <div class="rtse-popup-result-box">
    <div class="rtse-popup-section-title">
        <span>📊</span>
        <strong>Result Details</strong>
    </div>

    <div class="rtse-popup-form-grid">

        <div class="rtse-popup-field">
            <label for="full_marks">OMR Full Marks</label>
            <input
                type="number"
                name="full_marks"
                id="full_marks"
                value="100"
                min="100"
                max="100"
                readonly
            >
        </div>

        <div class="rtse-popup-field">
            <label for="marks">OMR Obtained Marks</label>
            <input
                type="number"
                name="marks"
                id="marks"
                value="<%= result ? result.marks : '' %>"
                min="0"
                max="100"
                step="0.01"
                required
            >
        </div>

        <% (markComponents || []).forEach(function(component) { %>
            <%

                const savedComponent =
                    (resultComponentMarks || []).find(function(item) {
                        return Number(item.component_id) === Number(component.id);
                    });

                const savedMarks =
                    savedComponent &&
                    Number(savedComponent.marks) !== 0
                        ? savedComponent.marks
                        : "";
            %>

            <div class="rtse-popup-field">
                <label for="component_marks_<%= component.id %>">
                    <%= component.name %>
                    <span class="rtse-popup-field-limit">
                        / <%= component.maximum_marks %>
                    </span>
                </label>

                <input
                    type="number"
                    name="component_marks[<%= component.id %>]"
                    id="component_marks_<%= component.id %>"
                    value="<%= savedMarks %>"
                    min="0"
                    max="<%= component.maximum_marks %>"
                    step="0.01"
                    data-rtse-component-mark
                    data-component-id="<%= component.id %>"
                    data-component-max="<%= component.maximum_marks %>"
                >
            </div>
        <% }); %>

        <div class="rtse-popup-field">
            <label for="total_marks">Total Obtained Marks</label>
            <input
                type="number"
                id="total_marks"
                value="<%= result && result.total_marks !== null && result.total_marks !== undefined
                    ? result.total_marks
                    : (result ? result.marks : '') %>"
                readonly
            >
        </div>

        <div class="rtse-popup-field">
            <label for="total_full_marks">Total Full Marks</label>
            <input
                type="number"
                id="total_full_marks"
                value="<%= result && result.total_full_marks !== null && result.total_full_marks !== undefined
                    ? result.total_full_marks
                    : (100 + (markComponents || []).reduce(function(total, component) {
                        return total + Number(component.maximum_marks || 0);
                    }, 0)) %>"
                readonly
            >
        </div>

        <div class="rtse-popup-field">
            <label for="percentage">Percentage</label>
            <input
                type="number"
                name="percentage"
                id="percentage"
                value="<%= result ? result.percentage : '' %>"
                readonly
            >
        </div>

        <div class="rtse-popup-field">
            <label for="grade">Grade</label>
            <input
                type="text"
                name="grade"
                id="grade"
                value="<%= result ? result.grade : '' %>"
                readonly
            >
        </div>

    </div>
</div>

    </form>


    <% if (result) { %>

    <form
        id="rtseResetResultForm"
        action="/admin/rtse/result/<%= student.id %>/reset-pending"
        method="POST"
        data-history-fix="off"
        style="display:none;"
    ></form>

    <% } %>


    <form
        id="rtseAttendanceResetForm"
        action="/admin/rtse/attendance/reset/<%= student.id %>"
        method="POST"
        data-history-fix="off"
        style="display:none;"
    ></form>


    <div class="rtse-popup-actions">

        <button
            type="button"
            id="rtseSaveResultButton"
            class="rtse-popup-btn rtse-popup-btn-save"
        >
            💾 Save Result
        </button>


        <% if (result) { %>

        <button
            type="submit"
            form="rtseResetResultForm"
            class="rtse-popup-btn rtse-popup-btn-pending"
        >
            ↩ Reset to Pending
        </button>

        <% } %>


        <button
            type="submit"
            form="rtseAttendanceResetForm"
            class="rtse-popup-btn rtse-popup-btn-attendance"
        >
            ↻ Attendance Reset
        </button>


        <button
            type="button"
            class="rtse-popup-btn rtse-popup-btn-close"
            data-rtse-popup-close
        >
            × Close
        </button>

    </div>

</div>


<!-- =====================================
     Optional Counted OMR
     ===================================== -->
<div class="rtse-counted-omr-box">
    <div class="rtse-popup-section-title">
        <span>📄</span>
        <strong>Counted OMR</strong>
    </div>

    <div class="rtse-counted-omr-note">
        Optional — capture or choose the counted OMR and save it as supporting evidence for this student's result.
    </div>

    <div class="rtse-counted-omr-actions">
        <button
            type="button"
            id="rtseOmrCameraButton"
            class="rtse-omr-btn rtse-omr-btn-camera"
        >
            📷 Take Photo
        </button>

        <button
            type="button"
            id="rtseOmrChooseButton"
            class="rtse-omr-btn rtse-omr-btn-choose"
        >
            🖼️ Choose Photo
        </button>
    </div>

    <input
        type="file"
        id="rtseOmrCameraInput"
        accept="image/jpeg,image/png,image/webp"
        capture="environment"
        hidden
    >

    <input
        type="file"
        id="rtseOmrChooseInput"
        accept="image/jpeg,image/png,image/webp"
        hidden
    >

    <div
        id="rtseOmrExisting"
        class="rtse-omr-existing"
        hidden
    >
        <span>✓ Counted OMR is already uploaded.</span>

        <a
            id="rtseOmrExistingView"
            href="#"
            target="_blank"
            rel="noopener"
            class="rtse-omr-see-button"
        >
            👁 See Counted OMR
        </a>
    </div>
</div>

<!-- Separate Counted OMR capture/crop popup -->
<div
    id="rtseOmrModal"
    class="rtse-omr-modal"
    hidden
    aria-hidden="true"
>
    <div
        class="rtse-omr-modal-backdrop"
        data-rtse-omr-close
    ></div>

    <div
        class="rtse-omr-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="rtseOmrModalTitle"
    >
        <div class="rtse-omr-modal-header">
            <div>
                <strong id="rtseOmrModalTitle">
                    📄 Counted OMR
                </strong>
                <small>
                    Enhance, crop and optionally upload the counted OMR
                </small>
            </div>

            <button
                type="button"
                class="rtse-omr-modal-close"
                data-rtse-omr-close
                aria-label="Close Counted OMR"
            >
                ×
            </button>
        </div>

        <div class="rtse-omr-modal-body">

            <div
                id="rtseOmrEditor"
                class="rtse-omr-editor"
                hidden
            >
                <div class="rtse-omr-editor-title">
                    <span>✨ Scanner Preview</span>
                    <small>Brightened &amp; clearer preview</small>
                </div>

                <div
                    class="rtse-omr-crop-stage"
                    id="rtseOmrCropStage"
                >
                    <img
                        id="rtseOmrPreviewImage"
                        alt="Counted OMR preview"
                        draggable="false"
                    >

                    <div
                        id="rtseOmrCropBox"
                        class="rtse-omr-crop-box"
                    >
                        <span class="rtse-omr-crop-label">
                            OMR CROP
                        </span>

                        <span class="rtse-omr-handle rtse-omr-handle-nw"></span>
                        <span class="rtse-omr-handle rtse-omr-handle-ne"></span>
                        <span class="rtse-omr-handle rtse-omr-handle-sw"></span>
                        <span class="rtse-omr-handle rtse-omr-handle-se"></span>
                    </div>
                </div>

                <div class="rtse-omr-editor-help">
                    Drag the box over the OMR page. Use the corner handles to fit the page.
                </div>

                <div class="rtse-omr-editor-actions">
                    <button
                        type="button"
                        id="rtseOmrCropButton"
                        class="rtse-omr-btn rtse-omr-btn-crop"
                    >
                        ✂️ Crop OMR
                    </button>

                    <button
                        type="button"
                        id="rtseOmrCancelButton"
                        class="rtse-omr-btn rtse-omr-btn-cancel"
                    >
                        Cancel
                    </button>
                </div>
            </div>

            <div
                id="rtseOmrCroppedPreview"
                class="rtse-omr-cropped-preview"
                hidden
            >
                <div class="rtse-omr-cropped-title">
                    <span>✓ Cropped OMR Ready</span>
                </div>

                <img
                    id="rtseOmrCroppedImage"
                    alt="Cropped counted OMR"
                >

                <div class="rtse-omr-upload-actions">
                    <button
                        type="button"
                        id="rtseOmrUploadButton"
                        class="rtse-omr-btn rtse-omr-btn-upload"
                    >
                        ⬆️ Upload Counted OMR
                    </button>

                    <button
                        type="button"
                        id="rtseOmrRetakeButton"
                        class="rtse-omr-btn rtse-omr-btn-cancel"
                    >
                        🔄 Choose Again
                    </button>
                </div>

                <div
                    id="rtseOmrUploadStatus"
                    class="rtse-omr-upload-status"
                ></div>
            </div>

        </div>
    </div>
</div>

<style>
/* ============================================================
   Separate Counted OMR Popup
   ============================================================ */

.rtse-counted-omr-box {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid #dbe3ea;
    border-radius: 14px;
    background: #f8fafc;
