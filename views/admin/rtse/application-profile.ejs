<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>RTSE Application Profile</h1>

                <a
                    href="javascript:history.back();"
                    class="btn-cancel">

                    ← Back

                </a>

            </div>

            <div class="profile-card">

                <div style="text-align:center;margin-bottom:30px;">

                    <% if (application.photo) { %>

                        <img
                            src="/uploads/rtse/<%= application.photo %>"
                            alt="Student Photo"
                            style="
                                width:170px;
                                height:170px;
                                border-radius:50%;
                                object-fit:cover;
                                border:5px solid #ddd;
                                display:block;
                                margin:0 auto 15px;
                            ">

                        <div style="
                            display:flex;
                            justify-content:center;
                            gap:10px;
                            flex-wrap:wrap;
                        ">

                            <a
                                href="/uploads/rtse/<%= application.photo %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn-view">
                                View Photo
                            </a>

                            <a
                                href="/uploads/rtse/<%= application.photo %>"
                                download="<%= application.photo %>"
                                class="btn-save">
                                Download Photo
                            </a>

                        </div>

                    <% } else { %>

                        <div style="
                            width:170px;
                            height:170px;
                            border-radius:50%;
                            margin:0 auto 15px;
                            border:5px solid #ddd;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:#f5f5f5;
                            color:#777;
                        ">
                            No Photo
                        </div>

                    <% } %>

                </div>

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th width="240">

                                Registration No.

                            </th>

                            <td>

                                <strong>

                                    <%= application.registration_no %>

                                </strong>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Student Name

                            </th>

                            <td>

                                <%= application.full_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Father's Name

                            </th>

                            <td>

                                <%= application.father_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Mother's Name

                            </th>

                            <td>

                                <%= application.mother_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Gender

                            </th>

                            <td>

                                <%= application.gender %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Date of Birth

                            </th>

                            <td>

                                <%= application.dob %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Mobile Number

                            </th>

                            <td>

                                <%= application.mobile %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Email

                            </th>

                            <td>

                                <%= application.email || "-" %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                School Name

                            </th>

                            <td>

                                <%= application.school_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Class

                            </th>

                            <td>

                                <%= application.class %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Section

                            </th>

                            <td>

                                SECTION <%= application.section %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                District

                            </th>

                            <td>

                                <%= application.district %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                State

                            </th>

                            <td>

                                <%= application.state %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                PIN Code

                            </th>

                            <td>

                                <%= application.pincode || "-" %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Address

                            </th>

                            <td>

                                <%= application.address %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                <%= application.status %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Roll Number

                            </th>

                            <td>

                                <%= application.roll_no || "Not Generated" %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Identity Document

                            </th>

                            <td>

                                <% if(application.identity_document){ %>

                                    <div style="
                                        display:flex;
                                        gap:10px;
                                        flex-wrap:wrap;
                                        align-items:center;
                                    ">

                                        <a
                                            href="/uploads/rtse/<%= application.identity_document %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="btn-view">
                                            View Document
                                        </a>

                                        <a
                                            href="/uploads/rtse/<%= application.identity_document %>"
                                            download="<%= application.identity_document %>"
                                            class="btn-save">
                                            Download Document
                                        </a>

                                    </div>

                                <% } else { %>

                                    <span style="color:#777;">
                                        Not Uploaded
                                    </span>

                                <% } %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <div style="margin-top:30px;display:flex;gap:10px;flex-wrap:wrap;">

                    <% if(application.status === "Pending"){ %>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/approve"
                            class="btn-save">
                            Approve
                        </a>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/reject"
                            class="btn-warning">
                            Reject
                        </a>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/edit"
                            class="btn-view">
                            Edit
                        </a>

                        <form
                            action="/admin/rtse/application/<%= application.id %>/archive"
                            method="POST"
                            style="display:inline;">

                            <button
                                type="submit"
                                class="btn-danger"
                                onclick="return confirm('Move this application to Archive?')">
                                Archive
                            </button>

                        </form>

                    <% } else if(application.status === "Approved"){ %>

                        <span
                            class="btn-save"
                            style="cursor:default;background:#28a745;">
                            ✓ Approved
                        </span>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/edit"
                            class="btn-view">
                            Edit
                        </a>

                        <form
                            action="/admin/rtse/application/<%= application.id %>/archive"
                            method="POST"
                            style="display:inline;">

                            <button
                                type="submit"
                                class="btn-danger"
                                onclick="return confirm('Move this application to Archive?')">
                                Archive
                            </button>

                        </form>

                        <% if(application.roll_no && application.admit_generated == 1){ %>

                            <a
                                href="/admin/rtse/application/<%= application.id %>/admit-card"
                                class="btn-view">
                                Admit Card
                            </a>

                        <% } %>

                    <% } else if(application.status === "Rejected"){ %>

                        <span
                            class="btn-danger"
                            style="cursor:default;">
                            ✗ Rejected
                        </span>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/approve"
                            class="btn-save"
                            onclick="return confirm('Approve this rejected application?');">
                            Approve
                        </a>

                        <a
                            href="/admin/rtse/application/<%= application.id %>/edit"
                            class="btn-view">
                            Edit
                        </a>

                        <form
                            action="/admin/rtse/application/<%= application.id %>/archive"
                            method="POST"
                            style="display:inline;">

                            <button
                                type="submit"
                                class="btn-danger"
                                onclick="return confirm('Move this application to Archive?')">
                                Archive
                            </button>

                        </form>

                    <% } %>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
