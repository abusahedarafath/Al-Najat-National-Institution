<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>Section Merit List</title>

<style>

body{

    font-family:Arial,sans-serif;

    margin:20px;

    background:#f5f5f5;

}

.container{

    background:#fff;

    border:2px solid #000;

    padding:20px;

}

.header{

    text-align:center;

    border-bottom:2px solid #000;

    margin-bottom:20px;

    padding-bottom:15px;

}

.header h1{

    margin:0;

}

.header h2{

    margin:6px 0;

}

table{

      width:100%;

      border-collapse:collapse;

      table-layout:auto;

  }

  th,

  td{

      border:1px solid #000;

      padding:8px;

      text-align:center;

      vertical-align:middle;

      white-space:normal;

      overflow-wrap:anywhere;

  }

  .table-wrapper{

      width:100%;

      overflow-x:auto;

      -webkit-overflow-scrolling:touch;

  }

  .table-wrapper table{

      min-width:max-content;

  }



.rank{

    font-size:18px;

    font-weight:bold;

}

.print{

    text-align:center;

    margin-bottom:20px;

}

@media print{

.print{

display:none;

}

body{

background:#fff;

}

}

</style>

</head>

<body>

<div class="print">

<button onclick="window.print()">

🖨 Print Section Merit List

</button>

</div>

<div class="container">

<div class="header">

<h1>

Ratabari Talent Search Examination

</h1>

<h2>

SECTION <%= section %>

</h2>

<h3>

Merit List

</h3>

</div>

<div class="table-wrapper">
  <table>

<thead>

<tr>

<th>

Rank

</th>



<th>

Roll No.

</th>

<th>

Registration

</th>

<th>
  OMR Obtained Mark

  </th>

  <% (markComponents || []).forEach(component=>{ %>

  <th>

  <%= component.name %> (<%= component.maximum_marks %>)

  </th>

  <% }) %>

  

  



</tr>

</thead>

<tbody>

<% students.forEach(student=>{ %>

<tr>

<td class="rank">

<%= student.section_rank %>

</td>



<td>

<%= student.roll_no %>

</td>

<td>

<%= student.registration_no %>

</td>

<td>

  <strong>

  <%= student.marks %>

  </strong>

  </td>

  <% (markComponents || []).forEach(component=>{ %>
    <td>
      <%
        const sectionMeritComponentMarks =
          student.component_marks && student.component_marks[component.id] != null
            ? Number(student.component_marks[component.id])
            : 0;

        const sectionMeritComponentMaximum = Number(component.maximum_marks || 0);
        const sectionMeritComponentPercentage =
          sectionMeritComponentMaximum > 0
            ? (sectionMeritComponentMarks / sectionMeritComponentMaximum) * 100
            : 0;

        let sectionMeritComponentGrade = "F";
        if (sectionMeritComponentPercentage >= 90) sectionMeritComponentGrade = "A+";
        else if (sectionMeritComponentPercentage >= 80) sectionMeritComponentGrade = "A";
        else if (sectionMeritComponentPercentage >= 70) sectionMeritComponentGrade = "B+";
        else if (sectionMeritComponentPercentage >= 60) sectionMeritComponentGrade = "B";
        else if (sectionMeritComponentPercentage >= 50) sectionMeritComponentGrade = "C+";
        else if (sectionMeritComponentPercentage >= 40) sectionMeritComponentGrade = "C";
      %>
     <% if (Number(component.grade_counting) === 1) { %>
    <strong><%= sectionMeritComponentGrade %></strong>
<% } %>

    </td>
  <% }) %>

  

  



</tr>

<% }) %>

</tbody>

</table>
  </div>

</div>

</body>

</html>
