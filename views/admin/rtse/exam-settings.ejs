<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>

                    RTSE Examination Control Centre

                </h1>

                <a
                    href="/admin/rtse"
                    class="btn-cancel">

                    ← Back to Dashboard

                </a>

            </div>

            <div class="profile-card">

                <form
                    action="/admin/rtse/exam-settings"
                    method="POST">

                    <div class="form-grid">

                        <div class="form-group">

                            <label>

                                Examination Name

                            </label>

                            <input
                                type="text"
                                name="exam_name"
                                value="<%= setting.exam_name || '' %>"
                                required>

                        </div>

                        <div class="form-group">

                            <label>

                                Examination Year

                            </label>

                            <input
                                type="number"
                                name="exam_year"
                                value="<%= setting.exam_year || '' %>"
                                required>

                        </div>

                        <div class="form-group">

                            <label>

                                Application Start Date

                            </label>

                            <input
                                type="date"
                                name="application_start_date"
                                value="<%= setting.application_start_date || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Application End Date

                            </label>

                            <input
                                type="date"
                                name="application_end_date"
                                value="<%= setting.application_end_date || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Examination Date

                            </label>

                            <input
                                type="date"
                                name="exam_date"
                                value="<%= setting.exam_date || '' %>"
                                required>

                        </div>

                        <div class="form-group">

                            <label>

                                Reporting Time

                            </label>

                            <input
                                type="time"
                                name="reporting_time"
                                value="<%= setting.reporting_time || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Examination Start Time

                            </label>

                            <input
                                type="time"
                                name="exam_start_time"
                                value="<%= setting.exam_start_time || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Examination End Time

                            </label>

                            <input
                                type="time"
                                name="exam_end_time"
                                value="<%= setting.exam_end_time || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Result Publish Date

                            </label>

                            <input
                                type="date"
                                name="result_publish_date"
                                value="<%= setting.result_publish_date || '' %>">

                        </div>

                        <div class="form-group">

                            <label>

                                Certificate Publish Date

                            </label>

                            <input
                                type="date"
                                name="certificate_publish_date"
                                value="<%= setting.certificate_publish_date || '' %>">

                        </div>

                        <div
                            class="form-group"
                            style="grid-column:1/-1;">

                            <label>

                                Default Examination Centre

                            </label>

                            <textarea
                                name="exam_centre"
                                rows="3"><%= setting.exam_centre || '' %></textarea>

                        </div>

                        <div
                            class="form-group"
                            style="grid-column:1/-1;">

                            <label>

                                Controller of Examination

                            </label>

                            <input
                                type="text"
                                name="controller_name"
                                value="<%= setting.controller_name || '' %>">

                        </div>

                    </div>

                    <button
                        type="submit"
                        class="btn-save"
                        style="margin-top:25px;">

                        Save Examination Settings

                    </button>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
