<%- include("../partials/header") %>

<div class="admin-layout">
    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <style>
            .school-page {
                max-width: 1200px;
                margin: 30px auto;
                padding: 0 20px;
            }

            .school-header {
                text-align: center;
                margin-bottom: 28px;
            }

            .school-header h1 {
                margin: 0 0 8px;
            }

            .school-header p {
                color: #666;
            }

            .school-actions {
                margin-bottom: 20px;
            }

            .school-actions a {
                text-decoration: none;
                font-weight: 600;
            }

            .school-table-wrap {
                overflow-x: auto;
                background: #fff;
                border-radius: 14px;
                box-shadow: 0 8px 25px rgba(0,0,0,.08);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 650px;
            }

            th,
            td {
                padding: 14px 16px;
                border-bottom: 1px solid #e5e7eb;
                text-align: left;
            }

            th {
                background: #f3f4f6;
                font-weight: 700;
            }

            .view-button {
                display: inline-block;
                padding: 8px 14px;
                border-radius: 7px;
                color: #fff;
                background: #0f766e;
                text-decoration: none;
                font-weight: 600;
            }

            .empty {
                padding: 35px;
                text-align: center;
                color: #666;
            }
        </style>

        <div class="school-page">

            <div class="school-actions">
                <a
                    href="/admin/rtse/new-certificates/section/<%= encodeURIComponent(section) %>"
                >
                    ← Back to Certificate Management
                </a>
            </div>

            <div class="school-header">
                <h1>🏫 School-wise Certificates</h1>

                <p>
                    Section <strong><%= section %></strong>
                    —
                    <%= schools.length %> school(s)
                </p>
            </div>

            <% if (schools.length) { %>

                <div class="school-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Sl.</th>
                                <th>School Name</th>
                                <th>Appreciation Certificates</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% schools.forEach(function(schoolItem, index) { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= schoolItem.school_name %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= schoolItem.certificate_count %>
                                    </td>

                                    <td>
                                        <a
                                            href="/admin/rtse/new-certificates/section/<%= encodeURIComponent(section) %>/schools/<%= encodeURIComponent(schoolItem.school_name) %>"
                                            class="view-button"
                                        >
                                            View Students
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            <% } else { %>

                <div class="school-table-wrap">
                    <div class="empty">
                        No Appreciation Certificates found for this section.
                    </div>
                </div>

            <% } %>

        </div>

    </main>
</div>

<%- include("../partials/footer") %>
