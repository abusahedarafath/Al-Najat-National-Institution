<% const isPopup = String(typeof popup !== "undefined" ? popup : "") === "1"; %>
<% if (!isPopup) { %>
<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>

                    RTSE Result Entry

                </h1>

                <a
                    href="/admin/rtse/results"
                    class="btn-cancel">

                    ← Back

                </a>

            </div>

            <div class="profile-card">

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th width="220">

                                Roll Number

                            </th>

                            <td>

                                <%= student.roll_no %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Registration No.

                            </th>

                            <td>

                                <%= student.registration_no %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Student Name

                            </th>

                            <td>

                                <%= student.full_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                School

                            </th>

                            <td>

                                <%= student.school_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Section

                            </th>

                            <td>

                                <%= student.section %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <hr>

                <form

                    action="/admin/rtse/result/<%= student.id %>"

                      data-history-fix="off"
                    method="POST">

                    <div class="form-grid">

                        <div class="form-group">
                            <label>
                                OMR Full Marks
                            </label>

                            <input
                                type="number"
                                name="full_marks"
                                id="full_marks"
                                value="100"
                                min="100"
                                max="100"
                                readonly
                            >
                        </div>

                        <div class="form-group">
                            <label>
                                OMR Obtained Marks
                            </label>

                            <input
                                type="number"
                                name="marks"
                                id="marks"
                                value="<%= result ? result.marks : '' %>"
                                min="0"
                                max="100"
                                step="0.01"
                                required
                            >
                        </div>

                        <% (markComponents || []).forEach(function(component) { %>
                            <%
                                const savedComponent =
                                    (resultComponentMarks || []).find(function(item) {
                                        return Number(item.component_id) === Number(component.id);
                                    });

                                const savedMarks =
                                    savedComponent
                                        ? savedComponent.marks
                                        : "";
                            %>

                            <div class="form-group">
                                <label for="component_marks_<%= component.id %>">
                                    <%= component.name %>
                                    <span>
                                        / <%= component.maximum_marks %>
                                    </span>
                                </label>

                                <input
                                    type="number"
                                    name="component_marks[<%= component.id %>]"
                                    id="component_marks_<%= component.id %>"
                                    value="<%= savedMarks %>"
                                    min="0"
                                    max="<%= component.maximum_marks %>"
                                    step="0.01"
                                    data-rtse-component-mark
                                    data-component-max="<%= component.maximum_marks %>"
                                >
                            </div>
                        <% }); %>

                        <div class="form-group">
                            <label>
                                Total Obtained Marks
                            </label>

                            <input
                                type="number"
                                id="total_marks"
                                value="<%= result && result.total_marks !== null && result.total_marks !== undefined
                                    ? result.total_marks
                                    : (result ? result.marks : '') %>"
                                readonly
                            >
                        </div>

                        <div class="form-group">
                            <label>
                                Total Full Marks
                            </label>

                            <input
                                type="number"
                                id="total_full_marks"
                                value="<%= result && result.total_full_marks !== null && result.total_full_marks !== undefined
                                    ? result.total_full_marks
                                    : (100 + (markComponents || []).reduce(function(total, component) {
                                        return total + Number(component.maximum_marks || 0);
                                    }, 0)) %>"
                                readonly
                            >
                        </div>

                        <div class="form-group">
                            <label>
                                Percentage
                            </label>

                            <input
                                type="number"
                                name="percentage"
                                id="percentage"
                                value="<%= result ? result.percentage : '' %>"
                                readonly
                            >
                        </div>

                        <div class="form-group">
                            <label>
                                Grade
                            </label>

                            <input
                                type="text"
                                name="grade"
                                id="grade"
                                value="<%= result ? result.grade : '' %>"
                                readonly
                            >
                        </div>

                        <input type="hidden">
                    </div>


                    <div
                        style="
                            display:flex;
                            gap:10px;
                            flex-wrap:wrap;
                            margin-top:20px;
                        ">

                        <button
                            class="btn-save"
                            type="submit">

                            💾 Save Changes

                        </button>

                        <% if (result) { %>

                        <button
                        type="submit"
                        formnovalidate
                        formaction="/admin/rtse/result/<%= student.id %>/reset-pending"
                        formmethod="POST"
                        class="btn-warning"
                        onclick="return confirm('Reset this result to Pending? The student will remain PRESENT and stay in the Result Dashboard.')">

                        ↩ Reset Result to Pending

                    </button>

                        <% } %>


                    </div>

                </form>

                  <form
                      action="/admin/rtse/attendance/reset/<%= student.id %>"
                      method="POST"
                        data-history-fix="off"
                      style="display:inline; margin-top:20px;"
                      onsubmit="return confirm('Reset Attendance Status?\\n\\nThe student will become NOT SCANNED, leave the Result Dashboard, have the existing result removed, and can be scanned again using the same admit card QR.');">

                      <button
                          type="submit"
                          class="btn-warning">
                          ↻ Attendance Status Reset
                      </button>

                  </form>

            </div>

        </div>

    </main>

</div>
<% } %>

<script>

const marks=document.getElementById("marks");
const totalMarks=document.getElementById("total_marks");
const totalFullMarks=document.getElementById("total_full_marks");
const percentage=document.getElementById("percentage");
const grade=document.getElementById("grade");
const componentInputs=document.querySelectorAll("[data-rtse-component-mark]");

function calculate(){

    const omrObtained=parseFloat(marks.value)||0;

    let configuredObtained=0;
    let configuredFullMarks=0;

    componentInputs.forEach(function(input){

        const maximum=parseFloat(input.dataset.componentMax)||0;
        const obtained=parseFloat(input.value)||0;

        configuredObtained+=obtained;
        configuredFullMarks+=maximum;

    });

    const total=omrObtained+configuredObtained;
    const totalFull=100+configuredFullMarks;

    const per=totalFull>0
        ? ((total/totalFull)*100).toFixed(2)
        : "0.00";

    totalMarks.value=Number(total.toFixed(2));
    totalFullMarks.value=Number(totalFull.toFixed(2));
    percentage.value=per;

    const percentageNumber=parseFloat(per)||0;

    if(percentageNumber>=90){
        grade.value="A+";
    }
    else if(percentageNumber>=80){
        grade.value="A";
    }
    else if(percentageNumber>=70){
        grade.value="B+";
    }
    else if(percentageNumber>=60){
        grade.value="B";
    }
    else if(percentageNumber>=50){
        grade.value="C";
    }
    else if(percentageNumber>=40){
        grade.value="D";
    }
    else{
        grade.value="F";
    }

}

if(marks){

    marks.addEventListener("input",calculate);
    marks.addEventListener("keyup",calculate);
    marks.addEventListener("change",calculate);

}

componentInputs.forEach(function(input){

    input.addEventListener("input",calculate);
    input.addEventListener("change",calculate);

});

calculate();

</script>

<% if (!isPopup) { %>
<%- include("../partials/footer") %>
<% } %>
