<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">
                <h1>Identity Card Settings</h1>
                <p>
                    Configure only the layout and appearance of ARSP Identity Cards.
                    Organization branding is managed from <strong>ARSP Settings</strong>.
                </p>
            </div>

            <form
                action="/admin/id-card/settings"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form">

                <!-- ============================= -->
                <!-- Background -->
                <!-- ============================= -->

                <h3>Card Background</h3>

                <input
                    type="hidden"
                    name="old_background"
                    value="<%= settings ? settings.background : '' %>">

                <div class="form-group">

                    <label>Background Image</label>

                    <% if(settings && settings.background){ %>

                        <img
                            src="/uploads/id-card/<%= settings.background %>"
                            style="width:240px;border-radius:8px;display:block;margin-bottom:12px;">

                    <% } %>

                    <input
                        type="file"
                        name="background"
                        accept=".png,.jpg,.jpeg,.webp">

                </div>

                <hr>

                <!-- ============================= -->
                <!-- Card Options -->
                <!-- ============================= -->

                <h3>Card Configuration</h3>

                <div class="form-group">

                    <label>QR Code</label>

                    <select name="qr_enabled">

                        <option
                            value="Yes"
                            <%= settings && settings.qr_enabled==="Yes" ? "selected" : "" %>>
                            Enabled
                        </option>

                        <option
                            value="No"
                            <%= settings && settings.qr_enabled==="No" ? "selected" : "" %>>
                            Disabled
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label>Card Width (px)</label>

                    <input
                        type="number"
                        name="card_width"
                        value="<%= settings ? settings.card_width : 320 %>">

                </div>

                <div class="form-group">

                    <label>Card Height (px)</label>

                    <input
                        type="number"
                        name="card_height"
                        value="<%= settings ? settings.card_height : 520 %>">

                </div>

                <div class="form-actions">

                    <button
                        class="btn-save"
                        type="submit">

                        Save Settings

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
