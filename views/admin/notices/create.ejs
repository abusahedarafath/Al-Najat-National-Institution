<%- include("../partials/header") %>
<div class="admin-layout">

<%- include("../partials/sidebar") %>
    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1 class="page-title">
                    Add New Notice
                </h1>

                <a href="/admin/notices" class="btn btn-secondary">
                    Back
                </a>

            </div>

            <div class="card">

                <form
                    action="/admin/notices/create"
                    method="POST"
                    enctype="multipart/form-data">

                    <div class="form-group">

                        <label>Notice Title</label>

                        <input
                            type="text"
                            name="title"
                            class="form-control"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            name="description"
                            rows="6"
                            class="form-control"></textarea>

                    </div>

                    <div class="form-group">

                        <label>Notice File (PDF/Image)</label>

                        <input
                            type="file"
                            name="file"
                            class="form-control">

                    </div>

                    <div class="form-group">

                        <label>Publish Date</label>

                        <input
                            type="date"
                            name="publish_date"
                            class="form-control"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select
                            name="status"
                            class="form-control">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                    <button
                        type="submit"
                        class="btn btn-success">

                        Save Notice

                    </button>

                    <a
                        href="/admin/notices"
                        class="btn btn-secondary">

                        Cancel

                    </a>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
