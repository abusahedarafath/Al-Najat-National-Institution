<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Examination Details</h1>

                    <p>View complete information about the selected examination.</p>

                </div>

                <a
                    href="/admin/exams"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th>Exam Name</th>

                            <td>

                                <%= exam.exam_name %>

                            </td>

                        </tr>

                        <tr>

                            <th>Class ID</th>

                            <td>

                                <%= exam.class_id %>

                            </td>

                        </tr>

                        <tr>

                            <th>Academic Session ID</th>

                            <td>

                                <%= exam.session_id %>

                            </td>

                        </tr>

                        <tr>

                            <th>Exam Date</th>

                            <td>

                                <%= exam.exam_date ? exam.exam_date.toLocaleDateString() : "" %>

                            </td>

                        </tr>

                        <tr>

                            <th>Total Marks</th>

                            <td>

                                <%= exam.total_marks %>

                            </td>

                        </tr>

                        <tr>

                            <th>Passing Marks</th>

                            <td>

                                <%= exam.passing_marks %>

                            </td>

                        </tr>

                        <tr>

                            <th>Status</th>

                            <td>

                                <% if (exam.status === "Active") { %>

                                    <span class="badge badge-success">

                                        Active

                                    </span>

                                <% } else { %>

                                    <span class="badge badge-danger">

                                        Inactive

                                    </span>

                                <% } %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <div class="action-buttons" style="margin-top:25px;">

                    <a
                        href="/admin/exam/<%= exam.id %>/edit"
                        class="btn btn-success">

                        Edit

                    </a>

                    <form
                        action="/admin/exam/<%= exam.id %>/delete"
                        method="POST"
                        style="display:inline;">

                        <button
                            type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Delete this examination?')">

                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
