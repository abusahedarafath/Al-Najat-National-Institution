<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Edit Principal Message</h1>

                    <p>Update Principal's message.</p>

                </div>

                <a
                    href="/admin/principal-messages"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">



               <form
    action="/admin/principal-message/<%= message.id %>/edit"
    method="POST"
    enctype="multipart/form-data">




                    <div class="form-group">

                        <label>Principal Name</label>

                        <input
                            type="text"
                            name="name"
                            value="<%= message.name %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            value="<%= message.designation %>"
                            required>

                    </div>





                   <div class="form-group">

    <label>Principal Photo</label>

    <% if(message.image){ %>

        <img
            src="/uploads/principal/<%= message.image %>"
            alt="Principal"
            style="width:120px;border-radius:8px;margin-bottom:10px;display:block;">

    <% } %>

    <input
        type="file"
        name="image"
        accept="image/*">

</div>





                    <div class="form-group">

                        <label>Message</label>

                        <textarea
                            name="message"
                            rows="8"
                            required><%= message.message %></textarea>

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option
                                value="Active"
                                <%= message.status=="Active" ? "selected" : "" %>>

                                Active

                            </option>

                            <option
                                value="Inactive"
                                <%= message.status=="Inactive" ? "selected" : "" %>>

                                Inactive

                            </option>

                        </select>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Principal Message

                        </button>

                        <a
                            href="/admin/principal-messages"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
