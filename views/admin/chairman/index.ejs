<%- include("../partials/header") %>

<div class="admin-layout">

    <%- include("../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>Chairman's Message</h1>

            </div>

            <form
                action="/admin/chairman"
                method="POST"
                enctype="multipart/form-data"
                class="admin-form">

                <div class="form-group">

                    <label>Chairman's Name</label>

                    <input
                        type="text"
                        name="name"
                        value="<%= chairman.name %>"
                        required>

                </div>

                <div class="form-group">

                    <label>Designation</label>

                    <input
                        type="text"
                        name="designation"
                        value="<%= chairman.designation %>"
                        required>

                </div>

                <div class="form-group">

                    <label>Chairman's Image</label>

                    <% if(chairman.image){ %>

                        <img
                            src="/uploads/chairman/<%= chairman.image %>"
                            width="150"
                            style="border-radius:10px;margin-bottom:15px;display:block;">

                    <% } %>

                    <input
                        type="file"
                        name="image"
                        accept=".jpg,.jpeg,.png,.webp">

                    <input
                        type="hidden"
                        name="oldImage"
                        value="<%= chairman.image %>">

                </div>

                <div class="form-group">

                    <label>Chairman's Message</label>

                    <textarea
                        name="message"
                        rows="8"
                        required><%= chairman.message %></textarea>

                </div>

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>
