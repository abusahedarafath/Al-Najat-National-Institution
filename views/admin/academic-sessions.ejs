<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Academic Sessions</h1>

                    <p>Manage all academic sessions of the institution.</p>

                </div>

                <a
                    href="/admin/academic-session/add"
                    class="btn btn-primary">

                    + Add Academic Session

                </a>

            </div>

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>Session</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    <% if (sessions && sessions.length > 0) { %>

                        <% sessions.forEach(session => { %>

                            <tr>

                                <td>
                                    <%= session.session_name %>
                                </td>

                                <td>
                                    <%= session.start_date ? session.start_date.toLocaleDateString() : "" %>
                                </td>

                                <td>
                                    <%= session.end_date ? session.end_date.toLocaleDateString() : "" %>
                                </td>

                                <td>

                                    <% if (session.status === "Active") { %>

                                        <span class="badge badge-success">
                                            Active
                                        </span>

                                    <% } else { %>

                                        <span class="badge badge-danger">
                                            Inactive
                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/admin/academic-session/<%= session.id %>"
                                            class="btn btn-primary">

                                            View

                                        </a>

                                        <a
                                            href="/admin/academic-session/<%= session.id %>/edit"
                                            class="btn btn-success">

                                            Edit

                                        </a>

                                        <form
                                            action="/admin/academic-session/<%= session.id %>/delete"
                                            method="POST"
                                            style="display:inline;">

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                                onclick="return confirm('Delete this academic session?')">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td
                                colspan="5"
                                style="text-align:center;">

                                No academic sessions found.

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
