<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>Student Profile</h1>
                    <p>View and manage student information.</p>
                </div>

            </div>

            <div class="card">

                <div style="text-align:center;margin-bottom:25px;">

                    <% if (student.photo) { %>

                        <img
                            src="/uploads/students/<%= student.photo %>"
                            alt="Student Photo"
                            style="width:160px;height:160px;border-radius:50%;object-fit:cover;border:4px solid #0B6B35;">

                    <% } else { %>

                        <div style="font-size:90px;">👨‍🎓</div>

                    <% } %>

                </div>

                <table class="admin-table">

                    <tr>
                        <th>Student ID</th>
                        <td><%= student.student_id %></td>
                    </tr>

                    <tr>
                        <th>Full Name</th>
                        <td><%= student.full_name %></td>
                    </tr>

                    <tr>
                        <th>Father's Name</th>
                        <td><%= student.father_name %></td>
                    </tr>

                    <tr>
                        <th>Mother's Name</th>
                        <td><%= student.mother_name %></td>
                    </tr>

                    <tr>
                        <th>Date of Birth</th>
                        <td><%= student.dob %></td>
                    </tr>

                    <tr>
                        <th>Gender</th>
                        <td><%= student.gender %></td>
                    </tr>

                    <tr>
                        <th>Mobile</th>
                        <td><%= student.mobile %></td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td><%= student.email || "-" %></td>
                    </tr>

                    <tr>
                        <th>Address</th>
                        <td><%= student.address %></td>
                    </tr>

                    <tr>
                        <th>Course</th>
                        <td><%= student.course || "-" %></td>
                    </tr>

                    <tr>
                        <th>Previous School</th>
                        <td><%= student.previous_school || "-" %></td>
                    </tr>

                    <tr>
                        <th>Admission Date</th>
                        <td><%= student.admission_date || "-" %></td>
                    </tr>

                    <tr>
                        <th>Status</th>

                        <td>

                            <% if (student.status === "Active") { %>

                                <span class="badge badge-success">
                                    Active
                                </span>

                            <% } else { %>

                                <span class="badge badge-danger">
                                    Inactive
                                </span>

                            <% } %>

                        </td>

                    </tr>

                </table>

            </div>

            <br>

            <div class="card">

                <h2>Actions</h2>

                <div class="action-buttons">

                    <a
                        href="/admin/student/<%= student.id %>/edit"
                        class="btn btn-warning">
                        Edit Student
                    </a>

                    <form
                        action="/admin/student/<%= student.id %>/deactivate"
                        method="POST">

                        <button
                            type="submit"
                            class="btn btn-danger">
                            Deactivate
                        </button>

                    </form>

                    <a
                        href="/admin/students"
                        class="btn btn-secondary">
                        Back to Students
                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
