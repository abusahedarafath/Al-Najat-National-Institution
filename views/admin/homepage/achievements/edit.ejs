<%- include("../../partials/header") %>

<div class="admin-layout">

    <%- include("../../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>Edit Achievement</h1>

                <a
                    href="/admin/homepage/achievements"
                    class="btn-cancel">

                    ← Back

                </a>

            </div>

            <div class="profile-card">

                <form
                    action="/admin/homepage/achievements/<%= achievement.id %>/edit"
                    method="POST">

                    <div class="form-group">

                        <label>
                            Value
                        </label>

                        <input
                            type="text"
                            name="value"
                            value="<%= achievement.value %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>
                            Title
                        </label>

                        <input
                            type="text"
                            name="title"
                            value="<%= achievement.title %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>
                            Description
                        </label>

                        <input
                            type="text"
                            name="description"
                            value="<%= achievement.description || '' %>">

                    </div>

                    <div class="form-group">

                        <label>
                            Display Order
                        </label>

                        <input
                            type="number"
                            name="display_order"
                            value="<%= achievement.display_order %>"
                            min="0">

                    </div>

                    <div class="form-group">

                        <label>

                            <input
                                type="checkbox"
                                name="is_active"
                                <%= achievement.is_active ? 'checked' : '' %>>

                            Active

                        </label>

                    </div>

                    <br>

                    <button
                        type="submit"
                        class="btn-save">

                        Update Achievement

                    </button>

                    <a
                        href="/admin/homepage/achievements"
                        class="btn-cancel">

                        Cancel

                    </a>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("../../partials/footer") %>
