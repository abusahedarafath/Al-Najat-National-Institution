<%- include("../../partials/header") %>

<div class="admin-layout">

    <%- include("../../partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <h1>Edit Why Choose Us</h1>

                <a
                    href="/admin/homepage/features"
                    class="btn-cancel">

                    ← Back

                </a>

            </div>

            <div class="profile-card">

                <form
                    action="/admin/homepage/features/<%= feature.id %>/edit"
                    method="POST">

                    <div class="form-group">

                        <label>
                            Title
                        </label>

                        <input
                            type="text"
                            name="title"
                            value="<%= feature.title %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>
                            Description
                        </label>

                        <textarea
                            name="description"
                            rows="5"
                            required><%= feature.description %></textarea>

                    </div>

                    <div class="form-group">

                        <label>
                            Font Awesome Icon
                        </label>

                        <input
                            type="text"
                            name="icon"
                            value="<%= feature.icon || '' %>">

                    </div>

                    <div class="form-group">

                        <label>
                            Display Order
                        </label>

                        <input
                            type="number"
                            name="display_order"
                            value="<%= feature.display_order %>"
                            min="0">

                    </div>

                    <div class="form-group">

                        <label>

                            <input
                                type="checkbox"
                                name="is_active"
                                <%= feature.is_active ? 'checked' : '' %>>

                            Active

                        </label>

                    </div>

                    <br>

                    <button
                        type="submit"
                        class="btn-save">

                        Update

                    </button>

                    <a
                        href="/admin/homepage/features"
                        class="btn-cancel">

                        Cancel

                    </a>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("../../partials/footer") %>
