<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>Class Details</h1>
                    <p>View complete information about the selected class.</p>
                </div>

            </div>

            <div class="card">

                <table class="admin-table">

                    <tbody>

                        <tr>
                            <th>Class Name</th>
                            <td><%= classData.class_name %></td>
                        </tr>

                        <tr>
                            <th>Class Code</th>
                            <td><%= classData.class_code %></td>
                        </tr>

                        <tr>
                            <th>Section</th>
                            <td><%= classData.section %></td>
                        </tr>

                        <tr>
                            <th>Academic Session</th>
                            <td><%= classData.academic_session %></td>
                        </tr>

                        <tr>
                            <th>Class Teacher</th>
                            <td>
                                <%= classData.class_teacher || "Not Assigned" %>
                            </td>
                        </tr>

                        <tr>
                            <th>Student Capacity</th>
                            <td><%= classData.capacity %></td>
                        </tr>

                        <tr>
                            <th>Display Order</th>
                            <td><%= classData.sort_order %></td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>

                                <% if (classData.status === "Active") { %>

                                    <span class="badge badge-success">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="badge badge-danger">
                                        Inactive
                                    </span>

                                <% } %>

                            </td>
                        </tr>

                    </tbody>

                </table>

                <div class="action-buttons" style="margin-top:25px;">

                    <a
                        href="/admin/class/<%= classData.id %>/edit"
                        class="btn btn-success">

                        Edit

                    </a>

                    <a
                        href="/admin/classes"
                        class="btn btn-secondary">

                        Back

                    </a>

                    <form
                        action="/admin/class/<%= classData.id %>/delete"
                        method="POST"
                        style="display:inline;">

                        <button
                            type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Delete this class?')">

                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
