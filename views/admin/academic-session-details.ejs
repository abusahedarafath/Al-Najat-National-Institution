<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Academic Session Details</h1>

                    <p>View complete information about the selected academic session.</p>

                </div>

            </div>

            <div class="card">

                <table class="admin-table">

                    <tbody>

                        <tr>

                            <th>Session Name</th>

                            <td><%= session.session_name %></td>

                        </tr>

                        <tr>

                            <th>Start Date</th>

                            <td>

                                <%= session.start_date ? session.start_date.toLocaleDateString() : "" %>

                            </td>

                        </tr>

                        <tr>

                            <th>End Date</th>

                            <td>

                                <%= session.end_date ? session.end_date.toLocaleDateString() : "" %>

                            </td>

                        </tr>

                        <tr>

                            <th>Description</th>

                            <td>

                                <%= session.description || "No description available." %>

                            </td>

                        </tr>

                        <tr>

                            <th>Status</th>

                            <td>

                                <% if (session.status === "Active") { %>

                                    <span class="badge badge-success">

                                        Active

                                    </span>

                                <% } else { %>

                                    <span class="badge badge-danger">

                                        Inactive

                                    </span>

                                <% } %>

                            </td>

                        </tr>

                    </tbody>

                </table>

                <div class="action-buttons" style="margin-top:25px;">

                    <a
                        href="/admin/academic-session/<%= session.id %>/edit"
                        class="btn btn-success">

                        Edit

                    </a>

                    <a
                        href="/admin/academic-sessions"
                        class="btn btn-secondary">

                        Back

                    </a>

                    <form
                        action="/admin/academic-session/<%= session.id %>/delete"
                        method="POST"
                        style="display:inline;">

                        <button
                            type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Delete this academic session?')">

                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
