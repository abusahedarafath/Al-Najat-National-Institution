<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Examination Management</h1>

                    <p>Manage all examinations conducted by the institution.</p>

                </div>

                <a
                    href="/admin/exam/add"
                    class="btn btn-primary">

                    + Add Examination

                </a>

            </div>

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>Exam Name</th>
                        <th>Class</th>
                        <th>Session</th>
                        <th>Exam Date</th>
                        <th>Total Marks</th>
                        <th>Status</th>
                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    <% if (exams && exams.length > 0) { %>

                        <% exams.forEach(exam => { %>

                            <tr>

                                <td>

                                    <%= exam.exam_name %>

                                </td>

                                <td>

                                    <%= exam.class_name %>

                                </td>

                                <td>

                                    <%= exam.session_name %>

                                </td>

                                <td>

                                    <%= exam.exam_date ? exam.exam_date.toLocaleDateString() : "" %>

                                </td>

                                <td>

                                    <%= exam.total_marks %>

                                </td>

                                <td>

                                    <% if (exam.status === "Active") { %>

                                        <span class="badge badge-success">

                                            Active

                                        </span>

                                    <% } else { %>

                                        <span class="badge badge-danger">

                                            Inactive

                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/admin/exam/<%= exam.id %>"
                                            class="btn btn-primary">

                                            View

                                        </a>

                                        <a
                                            href="/admin/exam/<%= exam.id %>/edit"
                                            class="btn btn-success">

                                            Edit

                                        </a>

                                        <form
                                            action="/admin/exam/<%= exam.id %>/delete"
                                            method="POST"
                                            style="display:inline;">

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                                onclick="return confirm('Delete this examination?')">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td
                                colspan="7"
                                style="text-align:center;">

                                No examinations found.

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
