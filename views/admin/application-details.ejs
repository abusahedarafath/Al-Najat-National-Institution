<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">
                <h1>Application Details</h1>
            </div>

            <table class="admin-table">

                <tr>
                    <th>ID</th>
                    <td><%= application.id %></td>
                </tr>

                <tr>
                    <th>Application No</th>
                    <td><%= application.application_no %></td>
                </tr>

                <tr>
                    <th>Full Name</th>
                    <td><%= application.full_name %></td>
                </tr>

                <tr>
                    <th>Father's Name</th>
                    <td><%= application.father_name %></td>
                </tr>

                <tr>
                    <th>Mother's Name</th>
                    <td><%= application.mother_name %></td>
                </tr>

                <tr>
                    <th>Date of Birth</th>
                    <td><%= application.dob %></td>
                </tr>

                <tr>
                    <th>Gender</th>
                    <td><%= application.gender %></td>
                </tr>

                <tr>
                    <th>Mobile</th>
                    <td><%= application.mobile %></td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td><%= application.email || "-" %></td>
                </tr>

                <tr>
                    <th>Address</th>
                    <td><%= application.address %></td>
                </tr>

                <tr>
                    <th>Course</th>
                    <td><%= application.course || "Not Selected" %></td>
                </tr>

                <tr>
                    <th>Previous School</th>
                    <td><%= application.previous_school || "-" %></td>
                </tr>

                <tr>
                    <th>PEN No</th>
                    <td><%= application.pen_no || "-" %></td>
                </tr>

                <tr>
                    <th>APAAR ID</th>
                    <td><%= application.apaar_id || "-" %></td>
                </tr>

                <tr>
                    <th>Siksha Setu ID</th>
                    <td><%= application.siksha_setu_id || "-" %></td>
                </tr>

                <tr>
                    <th>Current Status</th>
                    <td>
                        <% if(application.status==="Approved"){ %>
                            <span class="badge badge-success">Approved</span>
                        <% } else if(application.status==="Rejected"){ %>
                            <span class="badge badge-danger">Rejected</span>
                        <% } else { %>
                            <span class="badge badge-warning">Pending</span>
                        <% } %>
                    </td>
                </tr>

                <tr>
                    <th>Submitted On</th>
                    <td><%= application.created_at %></td>
                </tr>

            </table>

            <br>

            <div class="card">

                <h2>Uploaded Documents</h2>

                <table class="admin-table">

                    <tr>
                        <th>Document</th>
                        <th>Preview / Download</th>
                    </tr>

                    <% documents.forEach(doc => { %>

                    <tr>

                        <td><%= doc.document_type %></td>

                        <td>

                            <% if(doc.document_type==="photo" || doc.document_type==="signature"){ %>

                                <img src="/uploads/applications/<%= doc.file_name %>"
                                     style="width:120px;border:1px solid #ccc;padding:4px;">

                                <br><br>

                                <a class="btn btn-primary"
                                   target="_blank"
                                   href="/uploads/applications/<%= doc.file_name %>">

                                    View

                                </a>

                            <% } else { %>

                                <a class="btn btn-success"
                                   target="_blank"
                                   href="/uploads/applications/<%= doc.file_name %>">


                                    Open Document

                                </a>

                            <% } %>

                        </td>

                    </tr>

                    <% }) %>

                </table>

            </div>

            <br>

            <div class="card">

                <h2>Application Actions</h2>

                <div class="action-buttons">

                    <a href="/admin/application/<%= application.id %>/edit"
                       class="btn btn-primary">

                        Edit Application

                    </a>
                   

                    <% if(application.status !== "Approved"){ %>

                        <form action="/admin/application/<%= application.id %>/approve"
                              method="POST">

                            <button class="btn btn-success" type="submit">
                                Approve Application
                            </button>

                        </form>

                        <form action="/admin/application/<%= application.id %>/reject"
                              method="POST">

                            <button class="btn btn-danger"
                                    type="submit"
                                    onclick="return confirm('Are you sure you want to reject this application?')">

                                Reject Application

                            </button>

                        </form>

                      <form action="/admin/application/<%= application.id %>/delete" method="POST" style="display:inline;">
    <button
        type="submit"
        class="btn btn-danger"
        onclick="return confirm('Are you sure you want to delete this application?')">
        Delete Application
    </button>
</form>

                    <% } %>

                    <a href="/admin/applications"
                       class="btn btn-secondary">

                        Back to Applications

                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
