<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>
                    <h1>Edit Class</h1>
                    <p>Update class information.</p>
                </div>

            </div>

            <div class="card">

                <form
                    action="/admin/class/<%= classData.id %>/edit"
                    method="POST">

                    <div class="form-group">

                        <label>Class Name</label>

                        <input
                            type="text"
                            name="class_name"
                            value="<%= classData.class_name %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Class Code</label>

                        <input
                            type="text"
                            name="class_code"
                            value="<%= classData.class_code %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Section</label>

                        <input
                            type="text"
                            name="section"
                            value="<%= classData.section %>">

                    </div>

                    <div class="form-group">

                        <label>Academic Session</label>

                        <input
                            type="text"
                            name="academic_session"
                            value="<%= classData.academic_session %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Class Teacher</label>

                        <input
                            type="text"
                            name="class_teacher"
                            value="<%= classData.class_teacher %>">

                    </div>

                    <div class="form-group">

                        <label>Student Capacity</label>

                        <input
                            type="number"
                            name="capacity"
                            min="1"
                            value="<%= classData.capacity %>">

                    </div>

                    <div class="form-group">

                        <label>Display Order</label>

                        <input
                            type="number"
                            name="sort_order"
                            min="1"
                            value="<%= classData.sort_order %>">

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option
                                value="Active"
                                <%= classData.status === "Active" ? "selected" : "" %>>
                                Active
                            </option>

                            <option
                                value="Inactive"
                                <%= classData.status === "Inactive" ? "selected" : "" %>>
                                Inactive
                            </option>

                        </select>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Save Changes

                        </button>

                        <a
                            href="/admin/class/<%= classData.id %>"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
