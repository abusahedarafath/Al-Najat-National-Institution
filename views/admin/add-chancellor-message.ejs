<%- include("./partials/header") %>

<div class="admin-layout">

    <%- include("./partials/sidebar") %>

    <main class="admin-content">

        <div class="container">

            <div class="page-header">

                <div>

                    <h1>Add Chancellor Message</h1>

                    <p>Create the Chancellor's message for the homepage.</p>

                </div>

                <a
                    href="/admin/chancellor-messages"
                    class="btn btn-secondary">

                    ← Back

                </a>

            </div>

            <div class="card">

<form
    action="/admin/chancellor-message/add"
    method="POST"
    enctype="multipart/form-data">



                    <div class="form-group">

                        <label>Chancellor Name</label>

                        <input
                            type="text"
                            name="name"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Designation</label>

                        <input
                            type="text"
                            name="designation"
                            value="Chancellor"
                            required>

                    </div>


<div class="form-group">

    <label>Chancellor Photo</label>

    <input
        type="file"
        name="image"
        accept="image/*">

</div>



                    <div class="form-group">

                        <label>Message</label>

                        <textarea
                            name="message"
                            rows="8"
                            required></textarea>

                    </div>

                    <div class="form-group">

                        <label>Status</label>

                        <select name="status">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                    <div class="action-buttons">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Save Chancellor Message

                        </button>

                        <a
                            href="/admin/chancellor-messages"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>

<%- include("./partials/footer") %>
