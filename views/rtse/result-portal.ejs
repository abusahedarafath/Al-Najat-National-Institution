                    position:relative;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    min-width:260px;
                    padding:18px 28px 15px;
                    border:1px solid rgba(74,222,128,.42);
                    border-radius:18px;
                    background:
                        linear-gradient(180deg,rgba(3,18,12,.98),rgba(1,10,7,.98));
                    box-shadow:
                        0 0 0 1px rgba(74,222,128,.08) inset,
                        0 0 28px rgba(74,222,128,.18),
                        0 12px 35px rgba(0,0,0,.30);
                    overflow:hidden;
                "
            >
                <span
                    aria-hidden="true"
                    style="
