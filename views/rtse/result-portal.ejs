<style id="rtse-public-result-download-print-style">
@media print {

    body * {
        visibility: hidden !important;
    }

    #rtseResultModal,
    #rtseResultModal * {
        visibility: visible !important;
    }

    #rtseResultModal {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: auto !important;
        min-height: 100vh !important;
        overflow: visible !important;
        background: white !important;
        display: block !important;
    }

    #rtseResultModal .rtse-result-modal-card {
        position: relative !important;
        width: 100% !important;
        max-width: 760px !important;
        margin: 0 auto !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        page-break-inside: avoid !important;
    }

    #rtseResultModal .rtse-result-close,
    #rtseResultModal .rtse-public-audio-fallback,
    #rtseResultModal .rtse-result-actions,
    #rtseCelebration {
        display: none !important;
    }

    @page {
        size: A4 portrait;
        margin: 10mm;
    }
}
</style>


<div class="rtse-public-result-page">

    <section class="rtse-public-result-hero">
        <h1>RTSE Result Portal</h1>

        <p>
            Search your result and verify your identity securely.
        </p>
    </section>

    <section
        id="rtsePublicationCountdown"
        class="rtse-public-countdown"
        hidden
        aria-live="polite"
    >
        <div class="rtse-public-countdown-badge">
            RTSE 2026 • RESULT DAY
        </div>

        <h2 id="rtsePublicationCountdownTitle">
            Results are almost here
        </h2>

        <p
            id="rtsePublicationCountdownMessage"
            class="rtse-public-countdown-message"
        >
            Please wait while we prepare the official result publication.
        </p>

        <div
            id="rtsePublicationCountdownDisplay"
            class="rtse-public-countdown-display"
            style="
                display:flex;
