                "
            >
                Minutes&nbsp;&nbsp;:&nbsp;&nbsp;Seconds
            </div>
        </div>

        <div class="rtse-countdown-progress">
            <span id="rtseCountdownProgressBar"></span>
        </div>

        <div
            id="rtsePublicationCountdownSchedule"
            class="rtse-public-countdown-schedule"
        ></div>
    </section>

    <section class="rtse-public-result-search">

        <% if (!resultsPublished) { %>

            <div class="rtse-public-empty">
