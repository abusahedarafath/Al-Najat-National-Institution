<%- include("../partials/header") %>

<style>
    .rtse-public-result-page {
        max-width: 1050px;
        margin: 35px auto 60px;
        padding: 0 16px;
    }

    .rtse-public-result-hero {
        background:
            linear-gradient(135deg, #0f2a5f 0%, #174a86 55%, #7c3aed 100%);
        color: #fff;
        border-radius: 24px;
        padding: 35px 24px;
        text-align: center;
        box-shadow: 0 18px 50px rgba(15, 42, 95, .22);
    }

    .rtse-public-result-hero h1 {
        margin: 0 0 10px;
        font-size: clamp(28px, 5vw, 44px);
        font-weight: 800;
    }

    .rtse-public-result-hero p {
        margin: 0;
        opacity: .92;
        font-size: 15px;
    }

    .rtse-public-result-search {
        background: #fff;
        border-radius: 22px;
        padding: 24px;
        margin-top: -20px;
        position: relative;
        z-index: 2;
        box-shadow: 0 15px 45px rgba(0,0,0,.10);
    }

    .rtse-public-result-search-row {
        display: flex;
        gap: 10px;
        align-items: stretch;
    }

    .rtse-public-result-search input {
        flex: 1;
        min-width: 0;
        height: 50px;
        border: 1px solid #d8deea;
        border-radius: 12px;
        padding: 0 15px;
        font-size: 15px;
        outline: none;
    }

    .rtse-public-result-search input:focus {
        border-color: #174a86;
        box-shadow: 0 0 0 3px rgba(23,74,134,.10);
    }

    .rtse-public-result-search button {
        height: 50px;
        border: 0;
        border-radius: 12px;
        padding: 0 22px;
        background: #0f2a5f;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

    .rtse-public-result-search button:disabled {
        opacity: .65;
        cursor: wait;
    }

    .rtse-public-result-status {
        margin-top: 12px;
        font-size: 14px;
        min-height: 20px;
        text-align: center;
    }

    .rtse-public-result-candidates {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }

    .rtse-public-candidate-card {
        background: #fff;
        border: 1px solid #e5e9f1;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,.06);
    }

    .rtse-public-candidate-name {
        font-size: 19px;
        font-weight: 800;
        color: #13213b;
        margin-bottom: 12px;
    }

    .rtse-public-candidate-line {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        border-bottom: 1px solid #f0f2f6;
        font-size: 14px;
    }

    .rtse-public-candidate-line:last-of-type {
        border-bottom: 0;
    }

    .rtse-public-candidate-label {
        color: #68748a;
    }

    .rtse-public-candidate-value {
        color: #17233b;
        font-weight: 700;
        text-align: right;
    }

    .rtse-public-verify-btn {
        width: 100%;
        margin-top: 15px;
        border: 0;
        border-radius: 11px;
        padding: 12px;
        background: #0f2a5f;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
    }

    .rtse-public-empty {
        grid-column: 1 / -1;
        background: #fff;
        border-radius: 18px;
        padding: 30px;
        text-align: center;
        color: #68748a;
        border: 1px solid #e5e9f1;
    }

    /* Verification modal */
    .rtse-public-modal {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(5, 15, 35, .72);
        backdrop-filter: blur(5px);
    }

    .rtse-public-modal.is-open {
        display: flex;
    }

    .rtse-public-modal-card {
        width: min(100%, 470px);
        background: #fff;
        border-radius: 22px;
        padding: 25px;
        box-shadow: 0 25px 80px rgba(0,0,0,.30);
        position: relative;
        max-height: 92vh;
        overflow-y: auto;
    }

    .rtse-public-modal-close {
        position: absolute;
        right: 15px;
        top: 12px;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 50%;
        background: #f1f3f7;
        cursor: pointer;
        font-size: 20px;
    }

    .rtse-public-modal-title {
        font-size: 24px;
        font-weight: 800;
        color: #12213c;
        margin: 0 35px 6px 0;
    }

    .rtse-public-modal-subtitle {
        color: #68748a;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .rtse-public-form-group {
        margin-bottom: 15px;
    }

    .rtse-public-form-group label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 700;
        color: #39465d;
    }

    .rtse-public-form-group input,
    .rtse-public-form-group select {
        width: 100%;
        box-sizing: border-box;
        height: 48px;
        border: 1px solid #d8deea;
        border-radius: 11px;
        padding: 0 13px;
        background: #fff;
        font-size: 15px;
    }

    .rtse-public-form-group input[readonly] {
        background: #f4f6f9;
    }

    .rtse-public-verify-submit {
        width: 100%;
        height: 49px;
        border: 0;
        border-radius: 11px;
        background: #0f2a5f;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        margin-top: 5px;
    }

    .rtse-public-verify-error {
        color: #b42318;
        background: #fff1f0;
        border: 1px solid #ffd2cf;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 12px;
        display: none;
    }

    /* Result popup */
    .rtse-result-modal {
        position: fixed;
        inset: 0;
        z-index: 11000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 15px;
        background: rgba(5, 15, 35, .78);
        backdrop-filter: blur(6px);
    }

    .rtse-result-modal.is-open {
        display: flex;
    }

    .rtse-result-modal-card {
        width: min(100%, 650px);
        max-height: 92vh;
        overflow-y: auto;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 30px 100px rgba(0,0,0,.38);
        position: relative;
        animation: rtseResultPopupIn .35s ease-out;
    }

    @keyframes rtseResultPopupIn {
        from {
            opacity: 0;
            transform: translateY(25px) scale(.94);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .rtse-result-hero {
        background:
            linear-gradient(135deg, #0f2a5f 0%, #174a86 52%, #7c3aed 100%);
        color: #fff;
        text-align: center;
        padding: 28px 20px 24px;
        border-radius: 24px 24px 0 0;
        position: relative;
    }

    .rtse-result-close {
        position: absolute;
        right: 14px;
        top: 12px;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        color: #fff;
        cursor: pointer;
        font-size: 21px;
    }

    .rtse-result-photo-wrap {
        width: 104px;
        height: 104px;
        margin: 0 auto 12px;
        border-radius: 50%;
        overflow: hidden;
        background: rgba(255,255,255,.20);
        border: 4px solid rgba(255,255,255,.75);
        box-shadow: 0 10px 25px rgba(0,0,0,.18);
    }

    .rtse-result-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rtse-result-congrats {
        font-size: 25px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .rtse-result-name {
        font-size: 21px;
        font-weight: 800;
    }

    .rtse-result-body {
        padding: 20px;
    }

    .rtse-result-identity {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 18px;
    }

    .rtse-result-info {
        background: #f7f9fc;
        border-radius: 12px;
        padding: 11px 12px;
    }

    .rtse-result-info small {
        display: block;
        color: #69758a;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .rtse-result-info strong {
        color: #18243b;
        font-size: 14px;
    }

    .rtse-result-summary {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 18px;
    }

    .rtse-result-summary-card {
        border: 1px solid #e5e9f1;
        border-radius: 14px;
        padding: 14px;
        text-align: center;
    }

    .rtse-result-summary-card small {
        display: block;
        color: #69758a;
        margin-bottom: 4px;
        font-size: 11px;
    }

    .rtse-result-summary-card strong {
        font-size: 21px;
        color: #0f2a5f;
    }

    .rtse-result-section-title {
        font-size: 15px;
        font-weight: 800;
        color: #17233b;
        margin: 18px 0 10px;
    }

    .rtse-result-mark-list {
        border: 1px solid #e5e9f1;
        border-radius: 13px;
        overflow: hidden;
    }

    .rtse-result-mark-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 12px;
        border-bottom: 1px solid #edf0f5;
        font-size: 13px;
    }

    .rtse-result-mark-row:last-child {
        border-bottom: 0;
    }

    .rtse-result-mark-row span:first-child {
        color: #4e5b71;
    }

    .rtse-result-mark-row strong {
        color: #17233b;
        text-align: right;
    }

    .rtse-result-rank-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .rtse-result-rank-box {
        padding: 13px;
        border-radius: 13px;
        background: #f7f9fc;
        text-align: center;
    }

    .rtse-result-rank-box small {
        display: block;
        color: #69758a;
        margin-bottom: 4px;
    }

    .rtse-result-rank-box strong {
        font-size: 22px;
        color: #0f2a5f;
    }

    .rtse-result-status {
        text-align: center;
        margin-top: 15px;
        padding: 11px;
        border-radius: 12px;
        background: #eef7f0;
        color: #176b2d;
        font-weight: 800;
    }

    .rtse-result-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    .rtse-result-action {
        flex: 1;
        min-height: 46px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 800;
        cursor: pointer;
        border: 0;
    }

    .rtse-result-action-primary {
        background: #0f2a5f;
        color: #fff;
    }

    .rtse-result-action-secondary {
        background: #eef1f6;
        color: #26344d;
    }

    /* Celebration */
    .rtse-celebration {
        position: fixed;
        inset: 0;
        z-index: 12000;
        pointer-events: none;
        overflow: hidden;
        display: none;
    }

    .rtse-celebration.is-active {
        display: block;
    }

    .rtse-celebration-burst {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 20px;
        height: 20px;
        transform: translate(-50%, -50%);
    }

    .rtse-celebration-particle {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: var(--size);
        transform: translate(-50%, -50%);
        animation: rtseCelebrationParticle 1.5s ease-out forwards;
        animation-delay: var(--delay);
    }

    @keyframes rtseCelebrationParticle {
        0% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(.3) rotate(0deg);
        }
        15% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform:
                translate(
                    calc(-50% + var(--x)),
                    calc(-50% + var(--y))
                )
                scale(1.2)
                rotate(var(--rotate));
        }
    }

    .rtse-celebration-ring {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 35px;
        height: 35px;
        border: 3px solid rgba(255,255,255,.9);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        animation: rtseCelebrationRing 1.2s ease-out forwards;
    }

    @keyframes rtseCelebrationRing {
        0% {
            opacity: .9;
            width: 20px;
            height: 20px;
        }
        100% {
            opacity: 0;
            width: 430px;
            height: 430px;
        }
    }

    .rtse-public-audio-fallback {
        display: none;
        margin: 12px auto 0;
        border: 0;
        border-radius: 10px;
        padding: 9px 14px;
        background: rgba(255,255,255,.18);
        color: #fff;
        cursor: pointer;
        font-weight: 700;
    }

    @media (max-width: 600px) {
        .rtse-public-result-page {
            margin-top: 20px;
            padding-left: 0;
            padding-right: 0;
        }

        .rtse-public-result-search {
            padding: 18px;
            margin-top: -18px;
            border-radius: 24px;
        }

        .rtse-public-result-search-row {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
        }

        .rtse-public-result-search input {
            width: 100%;
            min-width: 0;
            height: 56px;
            box-sizing: border-box;
            padding: 0 17px;
            border: 1.5px solid #d4dbea;
            border-radius: 16px;
            background: #ffffff;
            color: #17213a;
            font-size: 15px;
            font-weight: 500;
            line-height: 1.2;
            -webkit-appearance: none;
            appearance: none;
        }

        .rtse-public-result-search input::placeholder {
            color: #7a8498;
            opacity: 1;
            font-weight: 400;
        }

        .rtse-public-result-search input:focus {
            border-color: #174a86;
            box-shadow: 0 0 0 4px rgba(23, 74, 134, .10);
        }

        .rtse-public-result-search button {
            width: 100%;
            height: 56px;
            min-height: 56px;
            box-sizing: border-box;
            padding: 0 18px;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: .1px;
        }

        .rtse-public-result-status {
            margin-top: 12px;
        }

        .rtse-result-identity,
        .rtse-result-summary,
        .rtse-result-rank-grid {
            grid-template-columns: 1fr;
        }

        .rtse-result-actions {
            flex-direction: column;
        }

        .rtse-result-modal-card {
            max-height: 95vh;
        }
    }

<style id="rtse-public-countdown-styles">
    .rtse-public-countdown {
        position: relative;
        width: min(920px, calc(100% - 32px));
        margin: 24px auto 0;
        padding: 30px 24px 26px;
        box-sizing: border-box;
        overflow: hidden;
        text-align: center;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 24px;
        background:
            radial-gradient(circle at 15% 10%, rgba(255,255,255,.16), transparent 28%),
            radial-gradient(circle at 85% 90%, rgba(255,215,80,.14), transparent 30%),
            linear-gradient(135deg, #071b3a, #0d3b70 55%, #102b52);
        box-shadow:
            0 18px 45px rgba(5,25,55,.20),
            inset 0 1px 0 rgba(255,255,255,.12);
        color: #fff;
    }

    .rtse-public-countdown::before {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        top: -130px;
        right: -90px;
        border-radius: 50%;
        background: rgba(255,215,80,.10);
        pointer-events: none;
    }

    .rtse-public-countdown-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 0 13px;
        border-radius: 999px;
        background: rgba(255,215,80,.14);
        border: 1px solid rgba(255,215,80,.34);
        color: #ffe58a;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .rtse-public-countdown h2 {
        position: relative;
        margin: 12px 0 6px;
        color: #fff;
        font-size: clamp(24px, 4vw, 34px);
        line-height: 1.15;
        font-weight: 850;
    }

    .rtse-public-countdown-message {
        position: relative;
        margin: 0 auto;
        max-width: 680px;
        color: rgba(255,255,255,.78);
        font-size: 14px;
        line-height: 1.6;
    }

    .rtse-public-countdown-display {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin: 25px auto 20px;
    }

    .rtse-countdown-unit {
        width: 105px;
        min-width: 0;
        padding: 14px 8px 12px;
        box-sizing: border-box;
        border-radius: 15px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.13);
        backdrop-filter: blur(8px);
    }

    .rtse-countdown-unit strong {
        display: block;
        color: #fff;
        font-size: clamp(28px, 5vw, 42px);
        line-height: 1;
        font-weight: 850;
        font-variant-numeric: tabular-nums;
    }

    .rtse-countdown-unit span {
        display: block;
        margin-top: 7px;
        color: rgba(255,255,255,.65);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .rtse-countdown-separator {
        color: rgba(255,255,255,.42);
        font-size: 25px;
        font-weight: 800;
        margin-top: -18px;
    }

    .rtse-countdown-progress {
        position: relative;
        width: min(650px, 100%);
        height: 5px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
    }

    .rtse-countdown-progress span {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #ffd75a, #fff0a6);
        transition: width .4s ease;
    }

    .rtse-public-countdown-schedule {
        position: relative;
        margin-top: 13px;
        color: rgba(255,255,255,.60);
        font-size: 12px;
        line-height: 1.5;
    }

    @media (max-width: 600px) {
        .rtse-public-countdown {
            width: calc(100% - 20px);
            margin-top: 16px;
            padding: 23px 12px 20px;
            border-radius: 20px;
        }

        .rtse-public-countdown-display {
            gap: 3px;
        }

        .rtse-countdown-unit {
            width: 72px;
            padding: 12px 4px 10px;
            border-radius: 12px;
        }

        .rtse-countdown-unit strong {
            font-size: 27px;
        }

        .rtse-countdown-unit span {
            font-size: 8px;
        }

        .rtse-countdown-separator {
            font-size: 19px;
            margin-top: -14px;
        }
    }
</style>

</style>
