<script id="rtse-public-countdown-script">
(function () {
    "use strict";

    const card =
        document.getElementById("rtsePublicationCountdown");

    if (!card) {
        return;
    }

    const title =
        document.getElementById("rtsePublicationCountdownTitle");

    const message =
        document.getElementById("rtsePublicationCountdownMessage");

    const schedule =
        document.getElementById("rtsePublicationCountdownSchedule");

    const digitalEl =
        document.getElementById("rtseCountdownDigital");

    const progressBar =
        document.getElementById("rtseCountdownProgressBar");

    if (
        !title ||
        !message ||
        !schedule ||
        !digitalEl ||
        !progressBar
    ) {
        console.error(
            "[RTSE Result] Countdown UI elements are missing."
        );
        return;
    }

    /*
     * Audio
     */
    const countdownAudio =
        new Audio("/audio/rtse-countdown-one-second-beep.mp3");

    const finalCountdownAudio =
        new Audio("/audio/rtse-countdown-final-10.mp3");

    const publicationSuccessAudio =
        new Audio("/audio/super-scanner-success.mp3");

    countdownAudio.preload = "auto";
    finalCountdownAudio.preload = "auto";
    publicationSuccessAudio.preload = "auto";

    countdownAudio.volume = 0.55;
    finalCountdownAudio.volume = 0.75;
    publicationSuccessAudio.volume = 0.85;

    let audioUnlocked = false;

    /*
     * Chrome/Android can block autoplay.
     * We do not show an Enable Sound button.
     * Instead, the first normal interaction with the page
     * unlocks the already-loaded audio elements.
     */
    function unlockAudio() {
        if (audioUnlocked) {
            return;
        }

        audioUnlocked = true;

        const audioList = [
            countdownAudio,
            finalCountdownAudio,
            publicationSuccessAudio
        ];

        audioList.forEach(function (audio) {
            try {
                audio.muted = true;
                audio.currentTime = 0;

                const promise = audio.play();

                if (
                    promise &&
                    typeof promise.then === "function"
                ) {
                    promise
                        .then(function () {
                            audio.pause();
                            audio.currentTime = 0;
                            audio.muted = false;
                        })
                        .catch(function () {
                            audio.muted = false;
                        });
                } else {
                    audio.pause();
                    audio.currentTime = 0;
                    audio.muted = false;
                }
            } catch (err) {
                try {
                    audio.muted = false;
                    audio.pause();
                    audio.currentTime = 0;
                } catch (ignore) {}
            }
        });
    }

    document.addEventListener(
        "pointerdown",
        unlockAudio,
        {
            once: true,
            passive: true
        }
    );

    document.addEventListener(
        "touchstart",
        unlockAudio,
        {
            once: true,
            passive: true
        }
    );

    document.addEventListener(
        "click",
        unlockAudio,
        {
            once: true,
            passive: true
        }
    );

    let finalCountdownStarted = false;
    let publicationSuccessPlayed = false;
    let publicationReachedZero = false;

    let clockOffsetMs = 0;

    let status = null;
    let countdownStartMs = null;
    let publicationMs = null;

    let lastDisplayedSecond = null;

    let animationFrame = null;
    let syncTimer = null;
    let publishCheckTimer = null;

    let refreshStarted = false;

    function getServerNowMs() {
        return Date.now() + clockOffsetMs;
    }

    function pad(value) {
        return String(value).padStart(2, "0");
    }

    function formatIST(timestampMs) {
        if (!Number.isFinite(timestampMs)) {
            return "";
        }

        try {
            return new Intl.DateTimeFormat(
                "en-IN",
                {
                    timeZone: "Asia/Kolkata",
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                    hour12: true
                }
            ).format(new Date(timestampMs));
        } catch (err) {
            return "";
        }
    }

    function stopCountdownAudio() {
        [
            countdownAudio,
            finalCountdownAudio
        ].forEach(function (audio) {
            try {
                audio.pause();
                audio.currentTime = 0;
            } catch (err) {}
        });
    }

    function playCountdownTick() {
        if (
            finalCountdownStarted ||
            publicationReachedZero
        ) {
            return;
        }

        try {
            countdownAudio.pause();
            countdownAudio.currentTime = 0;

            const promise =
                countdownAudio.play();

            if (
                promise &&
                typeof promise.catch === "function"
            ) {
                promise.catch(function (err) {
                    console.warn(
                        "[RTSE Result] Countdown tick audio playback failed:",
                        err
                    );
                });
            }
        } catch (err) {
            console.warn(
                "[RTSE Result] Countdown tick audio playback failed:",
                err
            );
        }
    }

    function playFinalCountdown() {
        if (
            finalCountdownStarted ||
            publicationReachedZero
        ) {
            return;
        }

        finalCountdownStarted = true;

        try {
            /*
             * The normal one-second sound must stop immediately.
             */
            countdownAudio.pause();
            countdownAudio.currentTime = 0;

            /*
             * The final-10-second track is played exactly once
             * and is never restarted on every animation frame.
             */
            finalCountdownAudio.pause();
            finalCountdownAudio.currentTime = 0;

            const promise =
                finalCountdownAudio.play();

            if (
                promise &&
                typeof promise.catch === "function"
            ) {
                promise.catch(function (err) {
                    console.warn(
                        "[RTSE Result] Final countdown audio playback failed:",
                        err
                    );
                });
            }
        } catch (err) {
            console.warn(
                "[RTSE Result] Final countdown audio playback failed:",
                err
            );
        }
    }

    function playPublicationSuccess() {
        if (publicationSuccessPlayed) {
            return;
        }

        publicationSuccessPlayed = true;

        try {
            /*
             * Make absolutely sure no countdown audio remains.
             */
            stopCountdownAudio();

            publicationSuccessAudio.muted = false;
            publicationSuccessAudio.pause();
            publicationSuccessAudio.currentTime = 0;

            const promise =
                publicationSuccessAudio.play();

            if (
                promise &&
                typeof promise.catch === "function"
            ) {
                promise.catch(function (err) {
                    console.warn(
                        "[RTSE Result] Publication success audio playback was blocked:",
                        err
                    );
                });
            }
        } catch (err) {
            console.warn(
                "[RTSE Result] Publication success audio playback failed:",
                err
            );
        }
    }

    function hideCard() {
        card.hidden = true;
    }

    function showCard() {
        card.hidden = false;
    }

    function setUnits(totalSeconds) {
        totalSeconds = Math.max(
            0,
            Math.floor(totalSeconds)
        );

        const days =
            Math.floor(totalSeconds / 86400);

        const hours =
            Math.floor(
                (totalSeconds % 86400) / 3600
            );

        const minutes =
            Math.floor(
                (totalSeconds % 3600) / 60
            );

        const seconds =
            totalSeconds % 60;

        let digitalTime;

        if (days > 0) {
            digitalTime =
                String(days) +
                "D " +
                pad(hours) +
                ":" +
                pad(minutes) +
                ":" +
                pad(seconds);
        } else if (hours > 0) {
            digitalTime =
                pad(hours) +
                ":" +
                pad(minutes) +
                ":" +
                pad(seconds);
        } else {
            digitalTime =
                pad(minutes) +
                ":" +
                pad(seconds);
        }

        digitalEl.textContent = digitalTime;
    }

    function setProgress(currentMs) {
        if (
            !Number.isFinite(countdownStartMs) ||
            !Number.isFinite(publicationMs) ||
            publicationMs <= countdownStartMs
        ) {
            progressBar.style.width = "0%";
            return;
        }

        const elapsed =
            currentMs - countdownStartMs;

        const total =
            publicationMs - countdownStartMs;

        const percentage =
            Math.max(
                0,
                Math.min(
                    100,
                    (elapsed / total) * 100
                )
            );

        progressBar.style.width =
            percentage.toFixed(2) + "%";
    }

    function showBeforeStart(currentMs) {
        showCard();

        title.textContent =
            "Results are scheduled";

        message.textContent =
            "The official result countdown will begin soon.";

        const untilStart =
            Math.max(
                0,
                Math.ceil(
                    (countdownStartMs - currentMs) / 1000
                )
            );

        setUnits(untilStart);

        progressBar.style.width = "0%";

        const startText =
            formatIST(countdownStartMs);

        schedule.textContent =
            startText
                ? "Countdown starts: " +
                  startText +
                  " IST"
                : "";

        lastDisplayedSecond =
            untilStart;
    }

    function showActiveCountdown(currentMs) {
        showCard();

        title.textContent =
            "Results are almost here";

        message.textContent =
            "The official RTSE result will be published when the countdown reaches zero.";

        const remaining =
            Math.max(
                0,
                Math.ceil(
                    (publicationMs - currentMs) / 1000
                )
            );

        setUnits(remaining);
        setProgress(currentMs);

        const publicationText =
            formatIST(publicationMs);

        schedule.textContent =
            publicationText
                ? "Scheduled publication: " +
                  publicationText +
                  " IST"
                : "";

        /*
         * Normal one-second sound is allowed only while
         * there are MORE than 10 seconds remaining.
         */
        if (
            !finalCountdownStarted &&
            lastDisplayedSecond !== null &&
            remaining !== lastDisplayedSecond &&
            remaining > 10
        ) {
            playCountdownTick();
        }

        /*
         * Exactly when the displayed countdown reaches 10,
         * switch permanently to the final countdown track.
         */
        if (
            !finalCountdownStarted &&
            remaining <= 10 &&
            remaining > 0
        ) {
            playFinalCountdown();
        }

        lastDisplayedSecond =
            remaining;
    }

    function showPublishingState() {
        showCard();

        stopCountdownAudio();

        title.textContent =
            "Publishing results...";

        message.textContent =
            "The official result publication is being completed. Please wait a moment.";

        setUnits(0);

        progressBar.style.width = "100%";

        schedule.textContent = "";

        lastDisplayedSecond = 0;
    }

    function stopAnimation() {
        if (animationFrame !== null) {
            cancelAnimationFrame(animationFrame);
            animationFrame = null;
        }
    }

    function stopSync() {
        if (syncTimer !== null) {
            clearInterval(syncTimer);
            syncTimer = null;
        }
    }

    function stopPublicationPolling() {
        if (publishCheckTimer !== null) {
            clearInterval(publishCheckTimer);
            publishCheckTimer = null;
        }
    }

    function showPublishedState() {
        hideCard();

        stopCountdownAudio();
        stopAnimation();
        stopSync();
        stopPublicationPolling();

        /*
         * If zero was reached locally, the publication sound has
         * already been requested. Do not play it twice.
         */
        if (
            publicationReachedZero &&
            !publicationSuccessPlayed
        ) {
            playPublicationSuccess();
        }

        if (refreshStarted) {
            return;
        }

        refreshStarted = true;

        const refreshKey =
            "rtse-result-publication-refresh";

        let alreadyRefreshed = false;

        try {
            alreadyRefreshed =
                sessionStorage.getItem(
                    refreshKey
                ) === "1";
        } catch (err) {}

        if (!alreadyRefreshed) {
            try {
                sessionStorage.setItem(
                    refreshKey,
                    "1"
                );
            } catch (err) {}

            setTimeout(function () {
                window.location.reload();
            }, 350);
        }
    }

    function handlePublicationReachedZero() {
        if (publicationReachedZero) {
            return;
        }

        publicationReachedZero = true;

        stopCountdownAudio();

        /*
         * Publication success sound is triggered immediately
         * at the browser's 00:00 boundary.
         */
        playPublicationSuccess();

        showPublishingState();

        startPublicationPolling();
    }

    function renderCountdown() {
        if (!status || status.published) {
            return;
        }

        if (!status.scheduled) {
            hideCard();
            return;
        }

        const currentMs =
            getServerNowMs();

        if (
            !Number.isFinite(countdownStartMs) ||
            !Number.isFinite(publicationMs)
        ) {
            hideCard();
            return;
        }

        if (currentMs < countdownStartMs) {
            showBeforeStart(currentMs);
            return;
        }

        if (currentMs < publicationMs) {
            showActiveCountdown(currentMs);
            return;
        }

        handlePublicationReachedZero();
    }

    function animationLoop() {
        renderCountdown();

        if (
            !publicationReachedZero &&
            !(
                status &&
                status.published
            )
        ) {
            animationFrame =
                requestAnimationFrame(
                    animationLoop
                );
        }
    }

    function startAnimation() {
        if (animationFrame !== null) {
            return;
        }

        animationFrame =
            requestAnimationFrame(
                animationLoop
            );
    }

    async function loadStatus() {
        try {
            const response =
                await fetch(
                    "/rtse/result/publication-status",
                    {
                        method: "GET",
                        cache: "no-store",
                        headers: {
                            "Accept":
                                "application/json"
                        }
                    }
                );

            if (!response.ok) {
                throw new Error(
                    "Publication status request failed."
                );
            }

            const data =
                await response.json();

            if (
                !data ||
                data.success !== true
            ) {
                throw new Error(
                    "Invalid publication status response."
                );
            }

            status = data;

            const serverNow =
                Number(
                    data.server_now_utc_ms
                );

            if (
                Number.isFinite(serverNow)
            ) {
                clockOffsetMs =
                    serverNow - Date.now();
            }

            if (data.published) {
                showPublishedState();
                return;
            }

            if (!data.scheduled) {
                try {
                    sessionStorage.removeItem(
                        "rtse-result-publication-refresh"
                    );
                } catch (err) {}

                hideCard();

                /*
                 * Keep the browser ready to detect a future
                 * schedule without continuously rendering.
                 */
                return;
            }

            const newPublicationMs =
                Number(
                    data.publish_at_utc_ms
                );

            const newCountdownStartMs =
                Number(
                    data.countdown_start_at_utc_ms
                );

            if (
                !Number.isFinite(
                    newPublicationMs
                ) ||
                !Number.isFinite(
                    newCountdownStartMs
                )
            ) {
                hideCard();
                return;
            }

            const scheduleChanged =
                publicationMs !==
                    newPublicationMs ||
                countdownStartMs !==
                    newCountdownStartMs;

            publicationMs =
                newPublicationMs;

            countdownStartMs =
                newCountdownStartMs;

            if (
                publicationMs <=
                countdownStartMs
            ) {
                countdownStartMs =
                    publicationMs;
            }

            /*
             * Only reset countdown/audio state if the actual
             * server schedule changed.
             */
            if (scheduleChanged) {
                finalCountdownStarted = false;
                publicationReachedZero = false;
                publicationSuccessPlayed = false;
                lastDisplayedSecond = null;

                stopCountdownAudio();
            }

            renderCountdown();

            if (
                getServerNowMs() >=
                publicationMs
            ) {
                startPublicationPolling();
            }
        } catch (err) {
            console.error(
                "RTSE publication countdown error:",
                err
            );
        }
    }

    function startPublicationPolling() {
        if (publishCheckTimer !== null) {
            return;
        }

        publishCheckTimer =
            setInterval(
                async function () {
                    await loadStatus();
                },
                1000
            );
    }

    /*
     * Initial server synchronization.
     */
    loadStatus();

    /*
     * Smooth local countdown.
     * This does NOT reload the page.
     */
    startAnimation();

    /*
     * Periodic server synchronization.
     * This is deliberately much less frequent than the
     * visual countdown and never resets state unless the
     * actual schedule changes.
     */
    syncTimer =
        setInterval(
            loadStatus,
            10000
        );
})();
</script>

<script>
(function () {
    "use strict";

    const searchForm =
        document.getElementById("rtsePublicSearchForm");

    if (!searchForm) {
        return;
    }

    const searchInput =
        document.getElementById("rtsePublicSearchInput");

    const searchButton =
        document.getElementById("rtsePublicSearchButton");

    const searchStatus =
        document.getElementById("rtsePublicSearchStatus");

    const candidatesContainer =
        document.getElementById("rtsePublicCandidates");

    const verifyModal =
        document.getElementById("rtsePublicVerifyModal");

    const verifyForm =
        document.getElementById("rtsePublicVerifyForm");

    const verifyClose =
        document.getElementById("rtsePublicVerifyClose");

    const verifyError =
        document.getElementById("rtsePublicVerifyError");

    const credentialType =
        document.getElementById("rtsePublicCredentialType");

    const credentialLabel =
        document.getElementById("rtsePublicCredentialLabel");

    const credentialValue =
        document.getElementById("rtsePublicCredentialValue");

    const verifyButton =
        document.getElementById("rtsePublicVerifyButton");

    const resultModal =
        document.getElementById("rtseResultModal");

    const resultClose =
        document.getElementById("rtseResultClose");

    const resultDone =
        document.getElementById("rtseResultDone");

    const celebration =
        document.getElementById("rtseCelebration");

    const celebrationBurst =
        document.getElementById("rtseCelebrationBurst");

    const audioFallback =
        document.getElementById("rtsePublicAudioFallback");

    const audio =
        new Audio("/audio/rtse-result-congratulations.mp3");

    audio.preload = "auto";

    let selectedCandidate = null;

    function safeText(value) {
        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return "—";
        }

        return String(value);
    }

    function setText(id, value) {
        const element = document.getElementById(id);

        if (element) {
            element.textContent = safeText(value);
        }
    }

    function closeVerifyModal() {
        verifyModal.classList.remove("is-open");
        verifyModal.setAttribute("aria-hidden", "true");
    }

    function openVerifyModal(candidate) {
        selectedCandidate = candidate;

        document.getElementById(
            "rtsePublicApplicationId"
        ).value = candidate.application_id;

        document.getElementById(
            "rtsePublicRollNo"
        ).value = candidate.roll_no || "";

        verifyError.style.display = "none";
        verifyError.textContent = "";

        credentialType.value = "dob";
        updateCredentialInput();

        verifyModal.classList.add("is-open");
        verifyModal.setAttribute("aria-hidden", "false");

        setTimeout(function () {
            credentialValue.focus();
        }, 80);
    }

    function updateCredentialInput() {
        if (credentialType.value === "mobile") {

            credentialLabel.textContent =
                "Registered Mobile Number";

            credentialValue.type = "tel";
            credentialValue.inputMode = "numeric";
            credentialValue.placeholder =
                "Enter registered mobile number";
            credentialValue.value = "";

        } else {

            credentialLabel.textContent =
                "Date of Birth";

            credentialValue.type = "date";
            credentialValue.inputMode = "numeric";
            credentialValue.placeholder = "";
            credentialValue.value = "";
        }
    }

    credentialType.addEventListener(
        "change",
        updateCredentialInput
    );

    verifyClose.addEventListener(
        "click",
        closeVerifyModal
    );

    verifyModal.addEventListener(
        "click",
        function (event) {
            if (event.target === verifyModal) {
                closeVerifyModal();
            }
        }
    );

    function renderCandidates(candidates) {

        candidatesContainer.innerHTML = "";

        if (!candidates.length) {

            candidatesContainer.innerHTML =
                '<div class="rtse-public-empty">' +
                'No matching candidate was found.' +
                '<div style="margin-top:7px;">' +
                'Check the spelling or enter the Registration No. / Roll No.' +
                '</div>' +
                '</div>';

            return;
        }

        candidates.forEach(function (candidate) {

            const card =
                document.createElement("div");

            card.className =
                "rtse-public-candidate-card";

            const name =
                document.createElement("div");

            name.className =
                "rtse-public-candidate-name";

            name.textContent =
                safeText(candidate.full_name);

            card.appendChild(name);

            function addLine(label, value) {

                const row =
                    document.createElement("div");

                row.className =
                    "rtse-public-candidate-line";

                const left =
                    document.createElement("span");

                left.className =
                    "rtse-public-candidate-label";

                left.textContent = label;

                const right =
                    document.createElement("span");

                right.className =
                    "rtse-public-candidate-value";

                right.textContent =
                    safeText(value);

                row.appendChild(left);
                row.appendChild(right);

                card.appendChild(row);
            }

            addLine(
                "Father's Name",
                candidate.father_name
            );

            addLine(
                "Class",
                candidate.class
            );

            addLine(
                "Roll No.",
                candidate.roll_no
            );

            addLine(
                "Registration No.",
                candidate.registration_no
            );

            const button =
                document.createElement("button");

            button.type = "button";
            button.className =
                "rtse-public-verify-btn";

            button.textContent =
                "VERIFY RESULT";

            button.addEventListener(
                "click",
                function () {
                    openVerifyModal(candidate);
                }
            );

            card.appendChild(button);

            candidatesContainer.appendChild(card);
        });
    }

    searchForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();

            const keyword =
                searchInput.value.trim();

            if (keyword.length < 2) {
                searchStatus.textContent =
                    "Enter at least 2 characters.";
                return;
            }

            searchButton.disabled = true;
            searchStatus.textContent =
                "Searching...";

            candidatesContainer.innerHTML = "";

            try {

                const body =
                    new URLSearchParams();

                body.set(
                    "keyword",
                    keyword
                );

                const response =
                    await fetch(
                        "/rtse/result/search",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded",
                                "Accept":
                                    "application/json"
                            },
                            credentials: "same-origin",
                            cache: "no-store",
                            body
                        }
                    );

                const data =
                    await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(
                        data.message ||
                        "Unable to search results."
                    );
                }

                renderCandidates(
                    data.candidates || []
                );

                searchStatus.textContent =
                    data.candidates &&
                    data.candidates.length
                        ? "Select the correct candidate and verify the result."
                        : "";

            } catch (error) {

                console.error(error);

                searchStatus.textContent =
                    error.message ||
                    "Unable to search results.";

            } finally {

                searchButton.disabled = false;
            }
        }
    );

    function renderResult(result) {

        setText(
            "rtseResultName",
            result.full_name
        );

        setText(
            "rtseResultRegistration",
            result.registration_no
        );

        setText(
            "rtseResultRoll",
            result.roll_no
        );

        setText(
            "rtseResultClass",
            result.class
        );

        setText(
            "rtseResultSection",
            result.section
        );

        setText(
            "rtseResultOmr",
            result.omr_marks
        );

        setText(
            "rtseResultSectionRank",
            result.section_rank
        );

        setText(
            "rtseResultOverallRank",
            result.overall_rank
        );

        const photo =
            document.getElementById(
                "rtseResultPhoto"
            );

        if (result.photo) {

            photo.src =
                "/uploads/rtse/" +
                encodeURIComponent(
                    result.photo
                );

            photo.style.display = "block";

        } else {

            photo.removeAttribute("src");
            photo.style.display = "none";
        }

        const componentContainer =
            document.getElementById(
                "rtseResultComponents"
            );

        componentContainer.innerHTML = "";

        const gradeComponents =
            Array.isArray(result.component_grades)
                ? result.component_grades
                : [];

        if (!gradeComponents.length) {

            componentContainer.innerHTML =
                '<div class="rtse-result-mark-row">' +
                '<span>No grade-counting components configured.</span>' +
                '<strong>—</strong>' +
                '</div>';

        } else {

            gradeComponents.forEach(
                function (component) {

                    const row =
                        document.createElement("div");

                    row.className =
                        "rtse-result-mark-row";

                    const label =
                        document.createElement("span");

                    label.textContent =
                        safeText(component.name);

                    const value =
                        document.createElement("strong");

                    value.textContent =
                        safeText(component.grade);

                    row.appendChild(label);
                    row.appendChild(value);

                    componentContainer.appendChild(row);
                }
            );
        }


    }

    function createCelebration() {

        celebration.classList.add(
            "is-active"
        );

        celebration.setAttribute(
            "aria-hidden",
            "false"
        );

        celebrationBurst.innerHTML = "";

        const emojis = [
            "🎉",
            "🌸",
            "💐",
            "❤️",
            "✨",
            "🎊",
            "🌟",
            "💖"
        ];

        for (let i = 0; i < 32; i++) {

            const particle =
                document.createElement("span");

            particle.className =
                "rtse-celebration-particle";

            particle.textContent =
                emojis[
                    Math.floor(
                        Math.random() *
                        emojis.length
                    )
                ];

            const angle =
                Math.random() *
                Math.PI * 2;

            const maxX =
                Math.max(
                    window.innerWidth * 0.72,
                    420
                );

            const maxY =
                Math.max(
                    window.innerHeight * 0.72,
                    420
                );

            const x =
                Math.cos(angle) *
                (maxX * (0.35 + Math.random() * 0.65));

            const y =
                Math.sin(angle) *
                (maxY * (0.35 + Math.random() * 0.65));

            particle.style.setProperty(
                "--x",
                x + "px"
            );

            particle.style.setProperty(
                "--y",
                y + "px"
            );

            particle.style.setProperty(
                "--size",
                (16 + Math.random() * 16) +
                    "px"
            );

            particle.style.setProperty(
                "--rotate",
                (-360 +
                    Math.random() * 720) +
                    "deg"
            );

            particle.style.setProperty(
                "--delay",
                (Math.random() * .15) +
                    "s"
            );

            celebrationBurst.appendChild(
                particle
            );
        }

        setTimeout(function () {

            celebration.classList.remove(
                "is-active"
            );

            celebration.setAttribute(
                "aria-hidden",
                "true"
            );

            celebrationBurst.innerHTML = "";

        }, 1750);
    }

    async function playCongratulations() {

        audio.currentTime = 0;

        try {

            await audio.play();

            audioFallback.style.display =
                "none";

        } catch (error) {

            console.warn(
                "RTSE result audio autoplay blocked:",
                error
            );

            audioFallback.style.display =
                "inline-block";
        }
    }

    audioFallback.addEventListener(
        "click",
        playCongratulations
    );

    const resultDownload =
        document.getElementById(
            "rtseResultDownload"
        );

    if (resultDownload) {
        resultDownload.addEventListener(
            "click",
            function () {
                window.print();
            }
        );
    }


    verifyForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();

            verifyButton.disabled = true;
            verifyButton.textContent =
                "Verifying...";

            verifyError.style.display =
                "none";

            verifyError.textContent = "";

            try {

                const body =
                    new URLSearchParams(
                        new FormData(verifyForm)
                    );

                const response =
                    await fetch(
                        "/rtse/result/verify",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded",
                                "Accept":
                                    "application/json"
                            },
                            credentials: "same-origin",
                            cache: "no-store",
                            body
                        }
                    );

                const data =
                    await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(
                        data.message ||
                        "Verification failed."
                    );
                }

                closeVerifyModal();

                renderResult(
                    data.result
                );

                resultModal.classList.add(
                    "is-open"
                );

                resultModal.setAttribute(
                    "aria-hidden",
                    "false"
                );

                /*
                 * Celebration starts only after successful
                 * credential verification.
                 */
                createCelebration();

                /*
                 * This is the exact dedicated RTSE public
                 * result congratulations audio.
                 *
                 * It is NOT any Super Scanner audio.
                 */
                playCongratulations();

            } catch (error) {

                console.error(error);

                verifyError.textContent =
                    error.message ||
                    "Verification failed.";

                verifyError.style.display =
                    "block";

            } finally {

                verifyButton.disabled = false;
                verifyButton.textContent =
                    "Verify & View Result";
            }
        }
    );

    function closeResultModal() {

        resultModal.classList.remove(
            "is-open"
        );

        resultModal.setAttribute(
            "aria-hidden",
            "true"
        );
    }

    resultClose.addEventListener(
        "click",
        closeResultModal
    );

    resultDone.addEventListener(
        "click",
        closeResultModal
    );

    resultModal.addEventListener(
        "click",
        function (event) {

            if (
                event.target ===
                resultModal
            ) {
                closeResultModal();
            }
        }
    );

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape"
            ) {
                closeVerifyModal();
                closeResultModal();
            }
        }
    );

})();
</script>

