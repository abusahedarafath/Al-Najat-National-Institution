                        top:12px;
                        left:14px;
                        width:7px;
                        height:7px;
                        border-radius:50%;
                        background:#4ade80;
                        box-shadow:0 0 10px rgba(74,222,128,.95);
                    "
                ></span>

                <strong
                    id="rtseCountdownDigital"
                    style="
                        display:block;
                        color:#4ade80;
                        font-family:'Courier New',monospace;
                        font-size:clamp(46px,10vw,76px);
                        font-weight:800;
                        line-height:1;
                        letter-spacing:.08em;
                        text-shadow:
                            0 0 8px rgba(74,222,128,.72),
                            0 0 22px rgba(74,222,128,.38);
                        font-variant-numeric:tabular-nums;
                        white-space:nowrap;
                    "
                >05:59</strong>
            </div>

            <div
                style="
                    margin-top:10px;
                    color:#4ade80;
                    font-size:11px;
                    font-weight:800;
                    letter-spacing:.28em;
                    text-transform:uppercase;
