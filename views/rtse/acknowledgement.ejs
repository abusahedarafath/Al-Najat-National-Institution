<%- include("../partials/header") %>


<link rel="stylesheet" href="/css/rtse.css">
<link rel="stylesheet" href="/css/rtse-registration-slip.css">

<div class="rtse-slip-page">
<!-- RTSE-FEE-APPROVAL-NOTICE -->
<div class="rtse-fee-approval-notice">
    <div class="notice-title">
        IMPORTANT NOTICE
    </div>

    <div class="notice-text">
        Applicants are requested to contact
        <strong>ABU MD SAHID AHMED</strong><br>President, ARSP<br><strong>+91 70997 39261</strong>
        for submission of the examination fee.
        After submitting the examination fee, please check the
        <strong>Approval Status</strong>
        in the final slip of your RTSE Student Application.
    </div>
</div>


    <div class="rtse-slip">

        <!-- =========================
             HEADER
        ========================== -->
        <div class="slip-header">

            <div class="slip-logo">
                <img
                    src="<%= siteSettings && siteSettings.logo
                        ? '/uploads/site-settings/' + siteSettings.logo
                        : '/images/logo.png' %>"
                    alt="<%= siteSettings && siteSettings.institution_name
                        ? siteSettings.institution_name
                        : 'Al-Najat National Institution' %>"
                >
            </div>

            <div class="slip-title">

                <h1>
                    <%= siteSettings && siteSettings.institution_name
                        ? siteSettings.institution_name
                        : 'AL-NAJAT NATIONAL INSTITUTION' %>
                </h1>

                <h2>
                    Ratabari Talent Search Examination 2026
                </h2>

                <div class="organized-by">
                    Organized by
                    <strong>ARSP</strong>
                    <span>Active Rural Social Progress</span>
                </div>

                <div class="slip-subtitle">
                    ONLINE REGISTRATION SLIP
                </div>

            </div>

        </div>


        <!-- =========================
             SUCCESS BANNER
        ========================== -->
        <div class="success-banner">
            <strong>APPLICATION SUBMITTED SUCCESSFULLY</strong>
            <span>
                Your RTSE application has been successfully registered.
            </span>
        </div>


        <!-- =========================
             REGISTRATION INFORMATION
        ========================== -->
        <div class="registration-box">

            <div>
                <span>Registration Number</span>
                <strong class="registration-number">
                    <%= application.registration_no %>
                </strong>
            </div>

            <div>
                <span>Application Year</span>
                <strong>
                    <%= application.application_year %>
                </strong>
            </div>

            <div>
                <span>Section</span>
                <strong>
                    SECTION <%= application.section %>
                </strong>
            </div>

            <div>
                <span>Status</span>
                <strong class="pending-status">
                    Pending Approval
                </strong>
            </div>

        </div>


        <!-- =========================
             CANDIDATE DETAILS
        ========================== -->
        <div class="slip-section">

            <div class="section-title">
                CANDIDATE DETAILS
            </div>

            <div class="candidate-layout">

                <div class="candidate-photo">

                    <% if (application.photo) { %>

                        <img
                            src="/uploads/rtse/<%= application.photo %>"
                            alt="Candidate Photograph"
                        >

                    <% } else { %>

                        <div class="photo-placeholder">
                            PHOTO
                        </div>

                    <% } %>

                    <div class="photo-caption">
                        Candidate Photograph
                    </div>

                </div>


                <div class="candidate-details">

                    <div class="detail-row">
                        <span>Full Name</span>
                        <strong>
                            <%= application.full_name %>
                        </strong>
                    </div>

                    <div class="detail-row">
                        <span>Father's Name</span>
                        <strong>
                            <%= application.father_name %>
                        </strong>
                    </div>

                    <div class="detail-row">
                        <span>Mother's Name</span>
                        <strong>
                            <%= application.mother_name %>
                        </strong>
                    </div>

                    <div class="detail-row">
                        <span>Date of Birth</span>
                        <strong>
                            <%= application.dob %>
                        </strong>
                    </div>

                    <div class="detail-row">
                        <span>Gender</span>
                        <strong>
                            <%= application.gender %>
                        </strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             EXAMINATION DETAILS
        ========================== -->
        <div class="slip-section">

            <div class="section-title">
                EXAMINATION DETAILS
            </div>

            <div class="two-column">

                <div class="detail-row">
                    <span>School Name</span>
                    <strong>
                        <%= application.school_name %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>Class</span>
                    <strong>
                        Class <%= application.class %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>Section</span>
                    <strong>
                        SECTION <%= application.section %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>District</span>
                    <strong>
                        <%= application.district %>
                    </strong>
                </div>

            </div>

        </div>


        <!-- =========================
             CONTACT DETAILS
        ========================== -->
        <div class="slip-section">

            <div class="section-title">
                CONTACT DETAILS
            </div>

            <div class="two-column">

                <div class="detail-row">
                    <span>Mobile Number</span>
                    <strong>
                        <%= application.mobile %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>Email</span>
                    <strong>
                        <%= application.email || "Not provided" %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>State</span>
                    <strong>
                        <%= application.state %>
                    </strong>
                </div>

                <div class="detail-row">
                    <span>PIN Code</span>
                    <strong>
                        <%= application.pincode || "Not provided" %>
                    </strong>
                </div>

                <div class="detail-row full-width">
                    <span>Address</span>
                    <strong>
                        <%= application.address || "Not provided" %>
                    </strong>
                </div>

            </div>

        </div>


        <!-- =========================
             IMPORTANT INSTRUCTIONS
        ========================== -->
        <div class="instruction-box">

            <h3>Important Instructions</h3>

            <ol>
                <li>
                    Keep this registration slip safely for future reference.
                </li>

                <li>
                    Your registration number will be required for future RTSE services.
                </li>

                <li>
                    Your application is currently pending approval.
                </li>

                <li>
                    Admit card and examination details will be available after approval.
                </li>
            </ol>

        </div>


        <!-- =========================
             FOOTER
        ========================== -->
        <div class="slip-footer">

            <div>
                <strong>Ratabari Talent Search Examination 2026</strong>
                <br>
                Organized by
                <strong class="footer-arsp">ARSP</strong>
                — Active Rural Social Progress
            </div>

            <div class="signature-box">
                Authorized Signatory
            </div>

        </div>


        <!-- =========================
             ACTIONS
        ========================== -->
        <div class="slip-actions">

            <button
                onclick="window.print()"
                class="btn-save"
            >
                Print / Save PDF
            </button>

            <a
                href="/"
                class="btn-view"
            >
                Home
            </a>

        </div>

    </div>

</div>





<%- include("../partials/footer") %>
