<script>
document.addEventListener("DOMContentLoaded", function () {

    const modal =
        document.getElementById("rtseDuplicateModal");

    const okButton =
        document.getElementById("rtseDuplicateModalOk");

    if (!modal || !okButton) {
        return;
    }

    document.body.style.overflow = "hidden";

    function closeDuplicateModal() {
        modal.remove();
        document.body.style.overflow = "";
    }

    okButton.addEventListener(
        "click",
        closeDuplicateModal
    );

    okButton.focus();

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {
                closeDuplicateModal();
            }

        },
        { once: true }
    );

});
</script>

<% } %>

