                        <!-- =================================================
                             RTSE PHOTO CROPPER
                             ================================================= -->

                        <div
                            id="rtsePhotoCropArea"
                            style="
                                display:none;
                                margin-top:18px;
                                padding:15px;
                                background:#f8f9fa;
                                border:1px solid #ddd;
                                border-radius:10px;
                            "
                        >

                            <div
                                style="
                                    width:100%;
                                    max-width:400px;
                                    margin:0 auto;
                                    aspect-ratio:4 / 5;
                                    overflow:hidden;
                                    background:#222;
                                    border-radius:8px;
                                "
