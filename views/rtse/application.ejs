<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/rtse.css">

<%- include("../partials/navbar") %>

<div class="rtse-page">

    <div class="container rtse-application-container">

        <div class="profile-card">

            <div class="rtse-register-header">

                <img
                    src="/uploads/arsp-settings/<%= setting.logo %>"
                    class="rtse-logo"
                    alt="<%= setting && setting.organization_name ? setting.organization_name : 'ARSP Logo' %>"
                >

                <h1>
                    <%= setting && setting.organization_name ? setting.organization_name : "Active Rural Social Progress" %>
                </h1>

                <p>
                    <%= setting && setting.tagline ? setting.tagline : "Assam Rural Social Project" %>
                </p>

                <h2>
                    RTSE 2026 ONLINE APPLICATION
                </h2>

            </div>

            <div class="rtse-form-content">

            <p class="rtse-intro">
                Enter your details carefully before proceeding to review.
            </p>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>
            <div
                id="rtseDuplicateNotice"
                class="rtse-duplicate-notice"
                role="alert"
                aria-live="polite"
                hidden
            >
                <div class="rtse-duplicate-title">
                    Already Registered
                </div>

                <div class="rtse-duplicate-message">
                    This candidate is already registered.
                </div>

                <div class="rtse-duplicate-registration">
                    Registration Number:
                    <strong id="rtseDuplicateRegistration"></strong>
                </div>

                <div class="rtse-duplicate-help">
                    Please contact the authority to know more about the application.
                </div>
            </div>



            <form
                action="/rtse/apply"
                method="POST"
                enctype="multipart/form-data"
                autocomplete="off"
            >

                <div class="form-grid">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input
                            type="text"
                            name="full_name"
                            value="<%= draft && draft.full_name ? draft.full_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Father's Name</label>
                        <input
                            type="text"
                            name="father_name"
                            value="<%= draft && draft.father_name ? draft.father_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Mother's Name</label>
                        <input
                            type="text"
                            name="mother_name"
                            value="<%= draft && draft.mother_name ? draft.mother_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Gender</label>

                        <select name="gender" required>

                            <option value="">
                                Select
                            </option>

                            <option value="Male"
                                <%= draft && draft.gender === "Male" ? "selected" : "" %>>
                                Male
                            </option>

                            <option value="Female"
                                <%= draft && draft.gender === "Female" ? "selected" : "" %>>
                                Female
                            </option>

                            <option value="Other"
                                <%= draft && draft.gender === "Other" ? "selected" : "" %>>
                                Other
                            </option>

                        </select>
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>

                        <input
                            type="date"
                            name="dob"
                            value="<%= draft && draft.dob ? draft.dob : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Mobile Number</label>

                        <input
                            type="number"
                            name="mobile"
                            value="<%= draft && draft.mobile ? draft.mobile : '' %>"
                            inputmode="numeric"
                            pattern="[0-9]*"
                            maxlength="10"
                            minlength="10"
                            autocomplete="tel"
                            oninput="this.value=this.value.replace(/\D/g,'').slice(0,10)"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            value="<%= draft && draft.email ? draft.email : '' %>"
                        >
                    </div>

                    <div class="form-group">
                        <label>School Name *</label>
<div class="rtse-school-picker">

    <button
        type="button"
        class="rtse-school-picker-trigger"
        id="rtseSchoolPickerTrigger"
        aria-expanded="false"
        aria-controls="rtseSchoolPickerPanel"
    >
        <span id="rtseSchoolPickerText">Select your school</span>
        <span class="rtse-school-picker-arrow">▾</span>
    </button>

    <div
        class="rtse-school-picker-panel"
        id="rtseSchoolPickerPanel"
        hidden
    >
        <input
            type="search"
            id="rtseSchoolSearch"
            class="rtse-school-search"
            placeholder="Search school name..."
            autocomplete="off"
            aria-label="Search school name"
        >

        <div
            class="rtse-school-options"
            id="rtseSchoolOptions"
        ></div>
    </div>

    <div class="rtse-school-native-wrapper">
<select
                            name="school_id"
                            id="rtseSchoolSelect"
                            required
                        >
                            <option value="">Select your school</option>

                            <% (schools || []).forEach(function(school) { %>
                                <option
                                    value="<%= school.id %>"
                                    <%= draft && String(draft.school_id || "") === String(school.id) ? "selected" : "" %>
                                >
                                    <%= school.school_name %>
                                </option>
                            <% }); %>

                            <option
                                value="other"
                                <%= draft && !draft.school_id && draft.school_name ? "selected" : "" %>
                            >
                                Other / School not listed
                            </option>
                        </select>
    </div>

</div>
                    </div>

                    <div
                        class="form-group"
                        id="otherSchoolGroup"
                        style="display:none;"
                    >
                        <label>Enter School Name *</label>

                        <input
                            type="text"
                            name="other_school_name"
                            id="otherSchoolName"
                            value="<%= draft && !draft.school_id ? (draft.school_name || '') : '' %>"
                        >

                        <small>
                            If your school is not listed, enter its name here.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>District</label>

                        <input
                            type="text"
                            name="district"
                            value="<%= draft && draft.district ? draft.district : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>State</label>

                        <input
                            type="text"
                            name="state"
                            value="<%= draft && draft.state ? draft.state : 'Assam' %>"
                        >
                    </div>

                    <div class="form-group">
                        <label>PIN Code</label>

                        <input
                            type="number"
                            name="pincode"
                            value="<%= draft && draft.pincode ? draft.pincode : '' %>"
                            inputmode="numeric"
                            pattern="[0-9]*"
                            maxlength="6"
                            autocomplete="postal-code"
                            oninput="this.value=this.value.replace(/\D/g,'').slice(0,6)"
                        >
                    </div>

                    <div class="form-group">

                        <label>Class</label>

                        <select
                            id="studentClass"
                            name="class"
                            required
                        >

                            <option value="">
                                Select Class
                            </option>

                            <option value="4"
                                <%= draft && String(draft.class) === "4" ? "selected" : "" %>>
                                Class IV
                            </option>

                            <option value="5"
                                <%= draft && String(draft.class) === "5" ? "selected" : "" %>>
                                Class V
                            </option>

                            <option value="6"
                                <%= draft && String(draft.class) === "6" ? "selected" : "" %>>
                                Class VI
                            </option>

                            <option value="7"
                                <%= draft && String(draft.class) === "7" ? "selected" : "" %>>
                                Class VII
                            </option>

                            <option value="8"
                                <%= draft && String(draft.class) === "8" ? "selected" : "" %>>
                                Class VIII
                            </option>

                            <option value="9"
                                <%= draft && String(draft.class) === "9" ? "selected" : "" %>>
                                Class IX
                            </option>

                            <option value="10"
                                <%= draft && String(draft.class) === "10" ? "selected" : "" %>>
                                Class X
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Section</label>

                        <input
                            id="section"
                            value="<%= draft && draft.section ? draft.section : '' %>"
                            readonly
                        >

                    </div>

                    <div
                        class="form-group"
                        style="grid-column:1/-1;"
                    >

                        <label>Address</label>

                        <textarea
                            name="address"
                            rows="3"
                        ><%= draft && draft.address ? draft.address : '' %></textarea>

                    </div>

                                        <div class="form-group">

                        <label>
                            Candidate Photo
                            <span style="color:#dc3545;">*</span>
                        </label>

                        <!-- Actual file submitted to the RTSE server -->
                        <input
                            type="file"
                            name="photo"
                            id="photo"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            style="display:none;"
                        >

                        <!-- Gallery picker -->
                        <input
                            type="file"
                            id="photoGallery"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            style="display:none;"
                        >

                        <!-- Camera picker -->
                        <input
                            type="file"
                            id="photoCamera"
                            accept="image/*"
                            capture="user"
                            style="display:none;"
                        >

                        <button
                            type="button"
                            id="selectPhotoButton"
                            style="
                                width:100%;
                                min-height:52px;
                                padding:12px 16px;
                                border:1px solid #ccc;
                                border-radius:8px;
                                background:#fff;
                                color:#222;
                                font-size:16px;
                                font-weight:600;
                                cursor:pointer;
                            "
                        >
                            📷 Select Photo
                        </button>

                        <small
                            id="selectedPhotoName"
                            style="
                                display:block;
                                margin-top:8px;
                                color:#666;
                            "
                        >
                            Select an image from your device or take a new photo.
                        </small>

                        <% if (draft && draft.photo) { %>

                            <small
                                style="
                                    display:block;
                                    margin-top:6px;
                                    color:#555;
                                "
                            >
                                Existing photo is already uploaded.
                                Upload a new photo only if you want to replace it.
                            </small>

                        <% } %>

                        <!-- =================================================
                             RTSE PHOTO CROPPER
                             ================================================= -->

                        <div
                            id="rtsePhotoCropArea"
                            style="
                                display:none;
                                margin-top:18px;
                                padding:15px;
                                background:#f8f9fa;
                                border:1px solid #ddd;
                                border-radius:10px;
                            "
                        >

                            <div
                                style="
                                    width:100%;
                                    max-width:400px;
                                    margin:0 auto;
                                    aspect-ratio:4 / 5;
                                    overflow:hidden;
                                    background:#222;
                                    border-radius:8px;
                                "
                            >
                                <img
                                    id="rtsePhotoCropImage"
                                    alt="Candidate photo crop preview"
                                    style="
                                        display:block;
                                        max-width:100%;
                                    "
                                >
                            </div>

                            <div
                                style="
                                    margin-top:12px;
                                    text-align:center;
                                    color:#555;
                                    font-size:14px;
                                    line-height:1.6;
                                "
                            >
                                <strong>
                                    Position the face inside the frame.
                                </strong>
                                <br>
                                Move and zoom the photograph as required.
                            </div>

                            <div
                                style="
                                    display:flex;
                                    gap:10px;
                                    justify-content:center;
                                    flex-wrap:wrap;
                                    margin-top:15px;
                                "
                            >

                                <button
                                    type="button"
                                    id="rtsePhotoZoomOut"
                                    class="btn-submit"
                                >
                                    − Zoom
                                </button>

                                <button
                                    type="button"
                                    id="rtsePhotoZoomIn"
                                    class="btn-submit"
                                >
                                    + Zoom
                                </button>

                                <button
                                    type="button"
                                    id="rtsePhotoReset"
                                    class="btn-submit"
                                >
                                    Reset
                                </button>

                                <button
                                    type="button"
                                    id="rtsePhotoApply"
                                    class="btn-submit"
                                >
                                    Use This Photo
                                </button>

                            </div>

                        </div>

                        <!-- Prepared 400 x 500 preview -->
                        <img
                            id="rtsePhotoPreview"
                            alt="Prepared candidate photograph"
                            style="
                                display:none;
                                margin-top:15px;
                                width:120px;
                                height:150px;
                                object-fit:cover;
                                border-radius:8px;
                                border:1px solid #ddd;
                            "
                        >

                    </div>

<div class="form-group">

                        <label>Identity Document</label>

                        <input
                            type="file"
                            name="identity_document"
                            accept=".pdf,image/*"
                        >

                        <% if (draft && draft.identity_document) { %>

                            <small style="display:block;margin-top:6px;color:#555;">
                                Existing identity document is saved.
                            </small>

                        <% } %>

                    </div>

                </div>

                <div
                    style="
                        margin-top:25px;
                        padding:15px;
                        background:#f8f9fa;
                        border-radius:8px;
                        border:1px solid #ddd;
                    "
                >

                    <strong>Before proceeding</strong>

                    <p style="margin:8px 0 0;color:#555;">
                        Please review your application carefully on the next page.
                        You will be able to edit your information before final submission.
                    </p>

                </div>

                <div
                    style="
                        margin-top:25px;
                        text-align:center;
                    "
                >

                    <button
                        type="submit"
                        class="btn-save"
                    >
                        Review Application
                    </button>

                </div>

            </form>

            </div>

        </div>

    </div>

</div>


<script>
/*
 * RTSE LIVE DUPLICATE CHECK
 *
 * Identity match:
 * Full Name + Father's Name + Mother's Name + DOB + School Name
 *
 * This is an immediate browser-side warning.
 * The server-side duplicate check remains authoritative.
 */
document.addEventListener("DOMContentLoaded", function () {

    const form = document.querySelector('form[action="/rtse/apply"]');

    if (!form) {
        return;
    }

    const fullName = form.querySelector('[name="full_name"]');
    const fatherName = form.querySelector('[name="father_name"]');
    const motherName = form.querySelector('[name="mother_name"]');
    const dob = form.querySelector('[name="dob"]');
    const schoolSelect = form.querySelector('[name="school_id"]');
    const otherSchoolName = form.querySelector('[name="other_school_name"]');

    const mobile = form.querySelector('[name="mobile"]');
    const pincode = form.querySelector('[name="pincode"]');

    const notice =
        document.getElementById("rtseDuplicateNotice");

    const registration =
        document.getElementById("rtseDuplicateRegistration");

    if (
        !fullName ||
        !fatherName ||
        !motherName ||
        !dob ||
        (!schoolSelect && !otherSchoolName)
    ) {
        return;
    }

    let timer = null;
    let controller = null;
    let requestSequence = 0;
    let duplicateFound = false;

    function normalize(value) {
        return String(value || "")
            .trim()
            .replace(/\s+/g, " ");
    }

    function submitControls() {
        return form.querySelectorAll(
            'button[type="submit"], input[type="submit"]'
        );
    }

    function setSubmitDisabled(disabled) {

        submitControls().forEach(function (button) {

            button.disabled = disabled;

            if (disabled) {
                button.setAttribute("aria-disabled", "true");
            } else {
                button.removeAttribute("aria-disabled");
            }

        });
    }

    function hideDuplicate() {

        duplicateFound = false;

        if (notice) {
            notice.hidden = true;
        }

        if (registration) {
            registration.textContent = "";
        }

        setSubmitDisabled(false);
    }

    function showDuplicate(candidate) {

        duplicateFound = true;

        if (registration) {
            registration.textContent =
                candidate.registration_no ||
                "Already registered";
        }

        if (notice) {
            notice.hidden = false;
        }

        setSubmitDisabled(true);
    }

    function getSchoolName() {

        if (schoolSelect && schoolSelect.value) {
            const option =
                schoolSelect.options[schoolSelect.selectedIndex];

            return normalize(
                option ? option.textContent : ""
            );
        }

        return normalize(
            otherSchoolName ? otherSchoolName.value : ""
        );
    }

    function enoughInformation() {

        return (
            normalize(fullName.value) &&
            normalize(fatherName.value) &&
            normalize(motherName.value) &&
            normalize(dob.value) &&
            getSchoolName()
        );
    }

    async function checkDuplicate() {

        const sequence = ++requestSequence;

        if (controller) {
            controller.abort();
        }

        hideDuplicate();

        if (!enoughInformation()) {
            return;
        }

        controller = new AbortController();

        const params = new URLSearchParams({
            full_name: normalize(fullName.value),
            father_name: normalize(fatherName.value),
            mother_name: normalize(motherName.value),
            dob: normalize(dob.value),
            school_name: getSchoolName()
        });

        try {

            const response = await fetch(
                "/rtse/duplicate-check?" + params.toString(),
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    cache: "no-store",
                    signal: controller.signal
                }
            );

            if (sequence !== requestSequence) {
                return;
            }

            if (!response.ok) {
                return;
            }

            const data = await response.json();

            if (
                sequence === requestSequence &&
                data.duplicate &&
                data.candidate
            ) {
                showDuplicate(data.candidate);
            }

        } catch (error) {

            if (error.name !== "AbortError") {
                console.warn(
                    "RTSE duplicate check unavailable:",
                    error
                );
            }

        }
    }

    function scheduleDuplicateCheck() {

        clearTimeout(timer);

        timer = setTimeout(function () {
            checkDuplicate();
        }, 300);
    }

    [
        fullName,
        fatherName,
        motherName,
        dob,
        schoolSelect,
        otherSchoolName
    ].filter(Boolean).forEach(function (input) {

        input.addEventListener(
            "input",
            scheduleDuplicateCheck
        );

        input.addEventListener(
            "change",
            scheduleDuplicateCheck
        );

        input.addEventListener(
            "blur",
            scheduleDuplicateCheck
        );

    });

    function digitsOnly(input, maxLength) {

        input.addEventListener("input", function () {

            const cleaned =
                String(input.value || "")
                    .replace(/\D/g, "")
                    .slice(0, maxLength);

            if (input.value !== cleaned) {
                input.value = cleaned;
            }

        });

        input.addEventListener("paste", function () {

            setTimeout(function () {

                input.value =
                    String(input.value || "")
                        .replace(/\D/g, "")
                        .slice(0, maxLength);

            }, 0);

        });
    }

    if (mobile) {
        digitsOnly(mobile, 10);
    }

    if (pincode) {
        digitsOnly(pincode, 6);
    }

    form.addEventListener("submit", function (event) {

        if (duplicateFound) {

            event.preventDefault();

            if (notice) {
                notice.hidden = false;
            }

            return;
        }

        if (
            mobile &&
            !/^\d{10}$/.test(mobile.value)
        ) {

            event.preventDefault();

            mobile.focus();

            alert(
                "Please enter a valid 10-digit mobile number."
            );

            return;
        }

        if (
            pincode &&
            pincode.value &&
            !/^\d{1,6}$/.test(pincode.value)
        ) {

            event.preventDefault();

            pincode.focus();

            alert(
                "PIN code can contain a maximum of 6 digits."
            );

            return;
        }

    });

});
</script>

<script>
/*
 * RTSE fresh-form browser restoration protection.
 *
 * The server removes req.session.rtseDraft after successful
 * submission. This guard prevents the browser's back-forward
 * cache from restoring the old form controls.
 */
window.addEventListener("pageshow", function (event) {

    if (!event.persisted) {
        return;
    }

    const form = document.querySelector(
        'form[action="/rtse/apply"]'
    );

    if (!form) {
        return;
    }

    form.reset();

    const photoInput =
        document.getElementById("photo");

    const galleryInput =
        document.getElementById("photoGallery");

    const cameraInput =
        document.getElementById("photoCamera");

    if (photoInput) {
        photoInput.value = "";
    }

    if (galleryInput) {
        galleryInput.value = "";
    }

    if (cameraInput) {
        cameraInput.value = "";
    }

    const selectedPhotoName =
        document.getElementById("selectedPhotoName");

    if (selectedPhotoName) {
        selectedPhotoName.textContent =
            "Select an image from your device or take a new photo.";

        selectedPhotoName.style.color = "#666";
        selectedPhotoName.style.fontWeight = "400";
    }

    const preview =
        document.getElementById("rtsePhotoPreview");

    const cropArea =
        document.getElementById("rtsePhotoCropArea");

    if (preview) {
        preview.removeAttribute("src");
        preview.style.display = "none";
    }

    if (cropArea) {
        cropArea.style.display = "none";
    }
});
</script>
<script>
const schoolSelect =
    document.getElementById("rtseSchoolSelect");

const schoolPickerTrigger =
    document.getElementById("rtseSchoolPickerTrigger");

const schoolPickerPanel =
    document.getElementById("rtseSchoolPickerPanel");

const schoolPickerText =
    document.getElementById("rtseSchoolPickerText");

const schoolSearch =
    document.getElementById("rtseSchoolSearch");

const schoolOptionsContainer =
    document.getElementById("rtseSchoolOptions");

const schoolOptions = Array.from(
    schoolSelect.options
).map(option => ({
    value: option.value,
    text: option.textContent.trim()
}));

function renderSchoolOptions(query = "") {
    const normalizedQuery =
        query.trim().toLowerCase();

    schoolOptionsContainer.innerHTML = "";

    const filteredOptions = schoolOptions.filter(option =>
        option.value === "other" ||
        option.text.toLowerCase().includes(normalizedQuery)
    );

    if (!filteredOptions.length) {
        const empty = document.createElement("div");
        empty.className = "rtse-school-empty";
        empty.textContent = "No school found.";
        schoolOptionsContainer.appendChild(empty);
        return;
    }

    filteredOptions.forEach(option => {
        const item = document.createElement("button");

        item.type = "button";
        item.className = "rtse-school-option";
        item.textContent = option.text;

        if (option.value === schoolSelect.value) {
            item.classList.add("selected");
        }

        item.addEventListener("click", () => {
            schoolSelect.value = option.value;

            schoolPickerText.textContent =
                option.text;

            schoolPickerPanel.hidden = true;

            schoolPickerTrigger.setAttribute(
                "aria-expanded",
                "false"
            );

            schoolSearch.value = "";

            updateSchoolField();
        });

        schoolOptionsContainer.appendChild(item);
    });
}

schoolPickerTrigger.addEventListener(
    "click",
    () => {
        const opening =
            schoolPickerPanel.hidden;

        schoolPickerPanel.hidden = !opening;

        schoolPickerTrigger.setAttribute(
            "aria-expanded",
            String(opening)
        );

        if (opening) {
            renderSchoolOptions();
            schoolSearch.focus();
        }
    }
);

schoolSearch.addEventListener(
    "input",
    () => {
        renderSchoolOptions(
            schoolSearch.value
        );
    }
);

document.addEventListener(
    "click",
    event => {
        if (
            !event.target.closest(
                ".rtse-school-picker"
            )
        ) {
            schoolPickerPanel.hidden = true;

            schoolPickerTrigger.setAttribute(
                "aria-expanded",
                "false"
            );
        }
    }
);

const otherSchoolGroup =
    document.getElementById("otherSchoolGroup");

const otherSchoolInput =
    document.getElementById("otherSchoolName");

function updateSchoolField() {
    const isOther =
        schoolSelect.value === "other";

    const selectedOption =
        schoolSelect.options[
            schoolSelect.selectedIndex
        ];

    if (selectedOption) {
        schoolPickerText.textContent =
            selectedOption.textContent.trim();
    }

    otherSchoolGroup.style.display =
        isOther ? "block" : "none";

    otherSchoolInput.required =
        isOther;

    if (!isOther) {
        otherSchoolInput.value = "";
    }
}

schoolSelect.addEventListener(
    "change",
    updateSchoolField
);

updateSchoolField();

</script>

<script>

const cls = document.getElementById("studentClass");
const sec = document.getElementById("section");

function updateSection() {

    let s = "";

    if (cls.value === "4" || cls.value === "5") {
        s = "A";
    }
    else if (cls.value === "6" || cls.value === "7") {
        s = "B";
    }
    else if (cls.value === "8") {
        s = "C";
    }
    else if (cls.value === "9") {
        s = "D";
    }
    else if (cls.value === "10") {
        s = "E";
    }

    sec.value = s;
}

cls.addEventListener("change", updateSection);

updateSection();

</script>


<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
>

<script
    src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js">
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const photoInput =
        document.getElementById("photo");

    const galleryInput =
        document.getElementById("photoGallery");

    const cameraInput =
        document.getElementById("photoCamera");

    const selectPhotoButton =
        document.getElementById("selectPhotoButton");

    const selectedPhotoName =
        document.getElementById("selectedPhotoName");

    const cropArea =
        document.getElementById("rtsePhotoCropArea");

    const cropImage =
        document.getElementById("rtsePhotoCropImage");

    const preview =
        document.getElementById("rtsePhotoPreview");

    const zoomIn =
        document.getElementById("rtsePhotoZoomIn");

    const zoomOut =
        document.getElementById("rtsePhotoZoomOut");

    const resetButton =
        document.getElementById("rtsePhotoReset");

    const applyButton =
        document.getElementById("rtsePhotoApply");

    const form =
        document.querySelector('form[action="/rtse/apply"]');

    if (
        !photoInput ||
        !galleryInput ||
        !cameraInput ||
        !selectPhotoButton ||
        !selectedPhotoName ||
        !cropArea ||
        !cropImage ||
        !preview ||
        !zoomIn ||
        !zoomOut ||
        !resetButton ||
        !applyButton ||
        !form ||
        typeof Cropper === "undefined"
    ) {
        console.error(
            "RTSE photo cropper could not initialize."
        );
        return;
    }

    let cropper = null;
    let selectedObjectUrl = null;
    let preparedPhoto = false;

    /*
     * Photo choice dialog
     */

    const overlay =
        document.createElement("div");

    overlay.id = "rtsePhotoChoiceOverlay";

    overlay.style.cssText = `
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.55);
        display:none;
        align-items:flex-end;
        justify-content:center;
        z-index:99999;
        padding:16px;
        box-sizing:border-box;
    `;

    overlay.innerHTML = `
        <div
            style="
                width:100%;
                max-width:420px;
                background:#fff;
                border-radius:18px 18px 12px 12px;
                padding:20px;
                box-sizing:border-box;
                box-shadow:0 10px 40px rgba(0,0,0,.25);
            "
        >

            <div
                style="
                    text-align:center;
                    font-size:19px;
                    font-weight:700;
                    margin-bottom:6px;
                "
            >
                Select Photo
            </div>

            <div
                style="
                    text-align:center;
                    color:#666;
                    font-size:14px;
                    margin-bottom:18px;
                "
            >
                Choose how you want to provide the candidate photo.
            </div>

            <button
                type="button"
                id="rtseGalleryChoice"
                style="
                    width:100%;
                    padding:15px;
                    margin-bottom:10px;
                    border:1px solid #ddd;
                    border-radius:10px;
                    background:#f8f9fa;
                    font-size:16px;
                    font-weight:600;
                    text-align:left;
                    cursor:pointer;
                "
            >
                📁 &nbsp; Select Image from Storage
            </button>

            <button
                type="button"
                id="rtseCameraChoice"
                style="
                    width:100%;
                    padding:15px;
                    margin-bottom:10px;
                    border:1px solid #ddd;
                    border-radius:10px;
                    background:#f8f9fa;
                    font-size:16px;
                    font-weight:600;
                    text-align:left;
                    cursor:pointer;
                "
            >
                📷 &nbsp; Take Photo
            </button>

            <button
                type="button"
                id="rtsePhotoCancel"
                style="
                    width:100%;
                    padding:13px;
                    border:0;
                    border-radius:10px;
                    background:#eee;
                    color:#333;
                    font-size:15px;
                    font-weight:600;
                    cursor:pointer;
                "
            >
                Cancel
            </button>

        </div>
    `;

    document.body.appendChild(overlay);

    const galleryChoice =
        document.getElementById("rtseGalleryChoice");

    const cameraChoice =
        document.getElementById("rtseCameraChoice");

    const cancelChoice =
        document.getElementById("rtsePhotoCancel");

    function closePhotoChoice() {
        overlay.style.display = "none";
    }

    function openPhotoChoice() {
        overlay.style.display = "flex";
    }

    /*
     * Start Cropper
     */

    function startCropper(file) {

        if (!file) {
            return;
        }

        if (
            !file.type ||
            !file.type.startsWith("image/")
        ) {
            alert("Please select a valid image.");
            return;
        }

        preparedPhoto = false;

        if (selectedObjectUrl) {
            URL.revokeObjectURL(selectedObjectUrl);
        }

        selectedObjectUrl =
            URL.createObjectURL(file);

        cropImage.onload = function () {

            if (cropper) {
                cropper.destroy();
            }

            cropper = new Cropper(
                cropImage,
                {
                    aspectRatio: 4 / 5,
                    viewMode: 1,
                    dragMode: "move",
                    autoCropArea: 0.85,
                    responsive: true,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    background: false,
                    movable: true,
                    zoomable: true,
                    rotatable: false,
                    scalable: false
                }
            );

            cropArea.style.display = "block";
            preview.style.display = "none";

            selectedPhotoName.textContent =
                "Position the face inside the frame, then tap \"Use This Photo\".";

            selectedPhotoName.style.color = "#555";
            selectedPhotoName.style.fontWeight = "600";
        };

        cropImage.src = selectedObjectUrl;
    }

    /*
     * Source selection
     */

    selectPhotoButton.addEventListener(
        "click",
        openPhotoChoice
    );

    galleryChoice.addEventListener(
        "click",
        function () {

            closePhotoChoice();

            galleryInput.value = "";

            galleryInput.click();
        }
    );

    cameraChoice.addEventListener(
        "click",
        function () {

            closePhotoChoice();

            cameraInput.value = "";

            cameraInput.click();
        }
    );

    cancelChoice.addEventListener(
        "click",
        closePhotoChoice
    );

    overlay.addEventListener(
        "click",
        function (event) {

            if (event.target === overlay) {
                closePhotoChoice();
            }

        }
    );

    galleryInput.addEventListener(
        "change",
        function () {

            startCropper(
                this.files && this.files[0]
            );

        }
    );

    cameraInput.addEventListener(
        "change",
        function () {

            startCropper(
                this.files && this.files[0]
            );

        }
    );

    /*
     * Cropper controls
     */

    zoomIn.addEventListener(
        "click",
        function () {

            if (cropper) {
                cropper.zoom(0.1);
            }

        }
    );

    zoomOut.addEventListener(
        "click",
        function () {

            if (cropper) {
                cropper.zoom(-0.1);
            }

        }
    );

    resetButton.addEventListener(
        "click",
        function () {

            if (cropper) {
                cropper.reset();
            }

        }
    );

    /*
     * Prepare final browser image
     */

    applyButton.addEventListener(
        "click",
        function () {

            if (!cropper) {

                alert(
                    "Please select a photograph first."
                );

                return;
            }

            const canvas =
                cropper.getCroppedCanvas({
                    width: 400,
                    height: 500,
                    imageSmoothingEnabled: true,
                    imageSmoothingQuality: "high"
                });

            if (!canvas) {

                alert(
                    "Unable to prepare the photograph."
                );

                return;
            }

            canvas.toBlob(
                function (blob) {

                    if (!blob) {

                        alert(
                            "Unable to prepare the photograph."
                        );

                        return;
                    }

                    const croppedFile =
                        new File(
                            [blob],
                            "rtse-candidate-photo.jpg",
                            {
                                type: "image/jpeg",
                                lastModified: Date.now()
                            }
                        );

                    const dataTransfer =
                        new DataTransfer();

                    dataTransfer.items.add(
                        croppedFile
                    );

                    photoInput.files =
                        dataTransfer.files;

                    const previewUrl =
                        URL.createObjectURL(blob);

                    preview.src = previewUrl;
                    preview.style.display = "block";

                    preview.onload = function () {
                        URL.revokeObjectURL(previewUrl);
                    };

                    cropArea.style.display = "none";

                    selectedPhotoName.textContent =
                        "Photo prepared successfully (400 × 500).";

                    selectedPhotoName.style.color =
                        "#198754";

                    selectedPhotoName.style.fontWeight =
                        "600";

                    preparedPhoto = true;

                    if (cropper) {
                        cropper.destroy();
                        cropper = null;
                    }

                    if (selectedObjectUrl) {

                        URL.revokeObjectURL(
                            selectedObjectUrl
                        );

                        selectedObjectUrl = null;
                    }

                },
                "image/jpeg",
                0.88
            );
        }
    );

    /*
     * Final validation
     */

    form.addEventListener(
        "submit",
        function (event) {

            const file =
                photoInput.files &&
                photoInput.files[0];

            const hasExistingPhoto =
                <%= draft && draft.photo ? "true" : "false" %>;

            if (!hasExistingPhoto) {

                if (!file || !preparedPhoto) {

                    event.preventDefault();

                    alert(
                        "Please select, position and prepare the candidate photograph before continuing."
                    );

                    selectedPhotoName.textContent =
                        "Please select, position and prepare the candidate photograph.";

                    selectedPhotoName.style.color =
                        "#c62828";

                    selectedPhotoName.style.fontWeight =
                        "600";

                    return;
                }
            }

            if (hasExistingPhoto) {

                if (file && !preparedPhoto) {

                    event.preventDefault();

                    alert(
                        "Please position the new photograph and click \"Use This Photo\" before continuing."
                    );

                    return;
                }
            }

        }
    );

});
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {

    const form =
        document.querySelector('form[action="/rtse/apply"]');

    const photoInput =
        document.getElementById("photo");

    const selectedPhotoName =
        document.getElementById("selectedPhotoName");

    if (!form || !photoInput) {
        return;
    }

    form.addEventListener("submit", function (event) {

        const hasNewPhoto =
            photoInput.files &&
            photoInput.files.length > 0;

        const hasExistingPhoto =
            <%= draft && draft.photo ? "true" : "false" %>;

        if (!hasNewPhoto && !hasExistingPhoto) {

            event.preventDefault();

            if (selectedPhotoName) {
                selectedPhotoName.textContent =
                    "Please select a candidate photograph.";

                selectedPhotoName.style.color =
                    "#c62828";

                selectedPhotoName.style.fontWeight =
                    "600";
            }

            alert(
                "Please select a candidate photograph before continuing."
            );

            return;
        }

        if (selectedPhotoName) {
            selectedPhotoName.style.color = "#666";
            selectedPhotoName.style.fontWeight = "400";
        }

    });

});
</script>

