<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/rtse.css">

<%- include("../partials/navbar") %>

<div class="rtse-page">

    <div class="container rtse-application-container">

        <div class="profile-card">

            <div class="rtse-register-header">

                <img
                    src="/uploads/arsp-settings/<%= setting.logo %>"
                    class="rtse-logo"
                    alt="<%= setting && setting.organization_name ? setting.organization_name : 'ARSP Logo' %>"
                >

                <h1>
                    <%= setting && setting.organization_name ? setting.organization_name : "Active Rural Social Progress" %>
                </h1>

                <p>
                    <%= setting && setting.tagline ? setting.tagline : "Assam Rural Social Project" %>
                </p>

                <h2>
                    RTSE 2026 ONLINE APPLICATION
                </h2>

            </div>

            <div class="rtse-form-content">

            <p class="rtse-intro">
                Enter your details carefully before proceeding to review.
            </p>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/rtse/apply"
                method="POST"
                enctype="multipart/form-data"
                autocomplete="off"
            >

                <div class="form-grid">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input
                            type="text"
                            name="full_name"
                            value="<%= draft && draft.full_name ? draft.full_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Father's Name</label>
                        <input
                            type="text"
                            name="father_name"
                            value="<%= draft && draft.father_name ? draft.father_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Mother's Name</label>
                        <input
                            type="text"
                            name="mother_name"
                            value="<%= draft && draft.mother_name ? draft.mother_name : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Gender</label>

                        <select name="gender" required>

                            <option value="">
                                Select
                            </option>

                            <option value="Male"
                                <%= draft && draft.gender === "Male" ? "selected" : "" %>>
                                Male
                            </option>

                            <option value="Female"
                                <%= draft && draft.gender === "Female" ? "selected" : "" %>>
                                Female
                            </option>

                            <option value="Other"
                                <%= draft && draft.gender === "Other" ? "selected" : "" %>>
                                Other
                            </option>

                        </select>
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>

                        <input
                            type="date"
                            name="dob"
                            value="<%= draft && draft.dob ? draft.dob : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Mobile Number</label>

                        <input
                            type="text"
                            name="mobile"
                            value="<%= draft && draft.mobile ? draft.mobile : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            value="<%= draft && draft.email ? draft.email : '' %>"
                        >
                    </div>

                    <div class="form-group">
                        <label>School Name *</label>
<div class="rtse-school-picker">

    <button
        type="button"
        class="rtse-school-picker-trigger"
        id="rtseSchoolPickerTrigger"
        aria-expanded="false"
        aria-controls="rtseSchoolPickerPanel"
    >
        <span id="rtseSchoolPickerText">Select your school</span>
        <span class="rtse-school-picker-arrow">▾</span>
    </button>

    <div
        class="rtse-school-picker-panel"
        id="rtseSchoolPickerPanel"
        hidden
    >
        <input
            type="search"
            id="rtseSchoolSearch"
            class="rtse-school-search"
            placeholder="Search school name..."
            autocomplete="off"
            aria-label="Search school name"
        >

        <div
            class="rtse-school-options"
            id="rtseSchoolOptions"
        ></div>
    </div>

    <div class="rtse-school-native-wrapper">
<select
                            name="school_id"
                            id="rtseSchoolSelect"
                            required
                        >
                            <option value="">Select your school</option>

                            <% (schools || []).forEach(function(school) { %>
                                <option
                                    value="<%= school.id %>"
                                    <%= draft && String(draft.school_id || "") === String(school.id) ? "selected" : "" %>
                                >
                                    <%= school.school_name %>
                                </option>
                            <% }); %>

                            <option
                                value="other"
                                <%= draft && !draft.school_id && draft.school_name ? "selected" : "" %>
                            >
                                Other / School not listed
                            </option>
                        </select>
    </div>

</div>
                    </div>

                    <div
                        class="form-group"
                        id="otherSchoolGroup"
                        style="display:none;"
                    >
                        <label>Enter School Name *</label>

                        <input
                            type="text"
                            name="other_school_name"
                            id="otherSchoolName"
                            value="<%= draft && !draft.school_id ? (draft.school_name || '') : '' %>"
                        >

                        <small>
                            If your school is not listed, enter its name here.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>District</label>

                        <input
                            type="text"
                            name="district"
                            value="<%= draft && draft.district ? draft.district : '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>State</label>

                        <input
                            type="text"
                            name="state"
                            value="<%= draft && draft.state ? draft.state : 'Assam' %>"
                        >
                    </div>

                    <div class="form-group">
                        <label>PIN Code</label>

                        <input
                            type="text"
                            name="pincode"
                            value="<%= draft && draft.pincode ? draft.pincode : '' %>"
                        >
                    </div>

                    <div class="form-group">

                        <label>Class</label>

                        <select
                            id="studentClass"
                            name="class"
                            required
                        >

                            <option value="">
                                Select Class
                            </option>

                            <option value="4"
                                <%= draft && String(draft.class) === "4" ? "selected" : "" %>>
                                Class IV
                            </option>

                            <option value="5"
                                <%= draft && String(draft.class) === "5" ? "selected" : "" %>>
                                Class V
                            </option>

                            <option value="6"
                                <%= draft && String(draft.class) === "6" ? "selected" : "" %>>
                                Class VI
                            </option>

                            <option value="7"
                                <%= draft && String(draft.class) === "7" ? "selected" : "" %>>
                                Class VII
                            </option>

                            <option value="8"
                                <%= draft && String(draft.class) === "8" ? "selected" : "" %>>
                                Class VIII
                            </option>

                            <option value="9"
                                <%= draft && String(draft.class) === "9" ? "selected" : "" %>>
                                Class IX
                            </option>

                            <option value="10"
                                <%= draft && String(draft.class) === "10" ? "selected" : "" %>>
                                Class X
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Section</label>

                        <input
                            id="section"
                            value="<%= draft && draft.section ? draft.section : '' %>"
                            readonly
                        >

                    </div>

                    <div
                        class="form-group"
                        style="grid-column:1/-1;"
                    >

                        <label>Address</label>

                        <textarea
                            name="address"
                            rows="3"
                        ><%= draft && draft.address ? draft.address : '' %></textarea>

                    </div>

                                        <div class="form-group">

                        <label>
                            Candidate Photo
                            <span style="color:#dc3545;">*</span>
                        </label>

                        <!-- Actual file submitted to the RTSE server -->
                        <input
                            type="file"
                            name="photo"
                            id="photo"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                            style="display:none;"
                        >

                        <!-- Gallery picker -->
