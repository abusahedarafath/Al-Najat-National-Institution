<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
            background: #f1f5f9;
            color: #0f172a;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .centre-login-wrapper {
            width: 100%;
            max-width: 430px;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
            box-shadow:
                0 20px 45px rgba(15, 23, 42, 0.10),
                0 4px 12px rgba(15, 23, 42, 0.05);
        }

        .login-header {
            background: linear-gradient(135deg, #0f3d91, #2563eb);
            color: #ffffff;
            padding: 30px 25px;
            text-align: center;
        }

        .portal-badge {
            width: 62px;
            height: 62px;
            margin: 0 auto 15px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.25);
            font-size: 27px;
            font-weight: 800;
        }

        .login-header h1 {
            margin: 0;
            font-size: 24px;
            line-height: 1.25;
        }

        .login-header p {
            margin: 8px 0 0;
            font-size: 13px;
            opacity: .88;
        }

        .login-body {
            padding: 25px;
        }

        .flash {
            border-radius: 10px;
            padding: 11px 13px;
            margin-bottom: 15px;
            font-size: 13px;
            line-height: 1.5;
        }

        .flash-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .flash-success {
            background: #f0fdf4;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .form-group {
            margin-bottom: 17px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .input-wrap {
            position: relative;
        }

        input {
            width: 100%;
            height: 48px;
            padding: 0 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            outline: none;
            background: #ffffff;
            color: #0f172a;
            font-size: 14px;
            transition: .2s ease;
        }

        input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

        input::placeholder {
            color: #94a3b8;
        }

        .login-button {
            width: 100%;
            height: 49px;
            border: 0;
            border-radius: 10px;
            background: #2563eb;
            color: #ffffff;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: .2s ease;
            margin-top: 3px;
        }

        .login-button:hover {
            background: #1d4ed8;
        }

        .login-button:active {
            transform: translateY(1px);
        }

        .login-help {
            margin-top: 18px;
            padding: 13px;
            border-radius: 10px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
            text-align: center;
        }

        .login-footer {
            text-align: center;
            margin-top: 15px;
            color: #94a3b8;
            font-size: 11px;
        }

        @media (max-width: 480px) {
            body {
                padding: 12px;
            }

            .login-header {
                padding: 26px 20px;
            }

            .login-body {
                padding: 20px;
            }

            .login-header h1 {
                font-size: 21px;
            }

            .portal-badge {
                width: 56px;
                height: 56px;
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

<div class="centre-login-wrapper">

    <div class="login-card">

        <div class="login-header">
            <div class="portal-badge">R</div>

            <h1>RTSE Centre Portal</h1>

            <p>
                Examination Centre Management System
            </p>
        </div>

        <div class="login-body">

            <% if (typeof messages !== "undefined" && messages.error && messages.error.length) { %>
                <% messages.error.forEach(function(message) { %>
                    <div class="flash flash-error">
                        <%= message %>
                    </div>
                <% }) %>
            <% } %>

            <% if (typeof messages !== "undefined" && messages.success && messages.success.length) { %>
                <% messages.success.forEach(function(message) { %>
                    <div class="flash flash-success">
                        <%= message %>
                    </div>
                <% }) %>
            <% } %>

            <form
                method="POST"
                action="/rtse/centre/login"
                autocomplete="on"
            >

                <div class="form-group">
                    <label for="username">
                        Centre ID
                    </label>

                    <div class="input-wrap">
                        <input
                            type="text"
                            id="username"
                            name="username"
                            placeholder="Enter your Centre ID"
                            autocomplete="username"
                            autocapitalize="none"
                            spellcheck="false"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrap">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >
                    </div>
                </div>

                <button
                    type="submit"
                    class="login-button"
                >
                    Sign In to Centre Portal
                </button>

            </form>

            <div class="login-help">
                Use the <strong>Centre ID</strong> issued during RTSE Centre registration.
                <br>
                First-time login requires you to change the temporary password.
            </div>

        </div>

    </div>

    <div class="login-footer">
        RTSE Centre Portal &nbsp;•&nbsp; Al-Najat National Institution
    </div>

</div>

</body>
</html>
