<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Roboto, Arial, sans-serif;
            background: #f1f5f9;
            color: #0f172a;
        }

        .topbar {
            background: linear-gradient(135deg, #0f3d91, #2563eb);
            color: #fff;
            padding: 17px 22px;
        }

        .topbar-inner {
            width: min(1200px, calc(100% - 10px));
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .brand h1 {
            margin: 0;
            font-size: 21px;
        }

        .brand p {
            margin: 4px 0 0;
            font-size: 12px;
            opacity: .86;
        }

        .logout {
            color: #fff;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.35);
            padding: 9px 13px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
        }

        .container {
            width: min(1200px, calc(100% - 28px));
            margin: 24px auto 40px;
        }

        .back {
            display: inline-flex;
            margin-bottom: 14px;
            color: #2563eb;
            font-size: 12px;
            font-weight: 800;
        }

        .header {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .header h2 {
            margin: 0 0 5px;
            font-size: 20px;
        }

        .header p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
        }

        .school-list {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .school {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 17px;
        }

        .school-name {
            font-size: 15px;
            font-weight: 800;
        }

        .school-meta {
            margin-top: 9px;
            display: grid;
            gap: 6px;
            color: #64748b;
            font-size: 11px;
        }

        .school-meta strong {
            color: #0f172a;
        }

        .badge {
            display: inline-block;
            width: fit-content;
            margin-top: 10px;
            padding: 5px 9px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 10px;
            font-weight: 800;
        }

        .empty {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 40px 20px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }

        @media (max-width: 700px) {
            .school-list {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 520px) {
            .topbar {
                padding: 15px;
            }

            .container {
                width: min(100% - 20px, 1200px);
                margin-top: 15px;
            }

            .brand h1 {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="topbar-inner">
        <div class="brand">
            <h1>RTSE Centre Portal</h1>
            <p>Assigned Schools</p>
        </div>

        <a class="logout" href="/rtse/centre/logout">
            Logout
        </a>
    </div>
</header>

<main class="container">

    <a class="back" href="/rtse/centre/dashboard">
        ← Back to Dashboard
    </a>

    <section class="header">
        <h2>Assigned Schools</h2>
        <p>
            Schools assigned to
            <strong><%= centre.centre_name %></strong>.
        </p>
    </section>

    <% if (assignedSchools && assignedSchools.length) { %>

        <div class="school-list">

            <% assignedSchools.forEach(function(school) { %>

                <article class="school">

                    <div class="school-name">
                        <%= school.school_name %>
                    </div>

                    <div class="school-meta">

                        <div>
                            School Code:
                            <strong>
                                <%= school.school_code || "—" %>
                            </strong>
                        </div>

                        <div>
                            Application Year:
                            <strong>
                                <%= school.application_year || "—" %>
                            </strong>
                        </div>

                    </div>

                    <span class="badge">
                        Assigned
                    </span>

                </article>

            <% }); %>

        </div>

    <% } else { %>

        <div class="empty">
            No schools are currently assigned to this centre.
        </div>

    <% } %>

</main>

</body>
</html>
