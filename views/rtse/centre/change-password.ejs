<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/centre-portal.css">
</head>

<body>
<div class="centre-page">
    <div class="centre-container">

        <header class="centre-topbar">
            <div class="centre-brand">
                <div class="centre-brand-badge">R</div>
                <div>
                    <h1>RTSE Centre Portal</h1>
                    <p>Examination Centre Management System</p>
                </div>
            </div>
        </header>

        <main class="centre-card">

            <h2>Change Password</h2>

            <p class="centre-card-subtitle">
                For security, you must create a new password before
                accessing your Centre Portal dashboard.
            </p>

            <% if (typeof messages !== "undefined" && messages.error && messages.error.length) { %>
                <% messages.error.forEach(function(message) { %>
                    <div class="centre-alert centre-alert-error">
                        <%= message %>
                    </div>
                <% }) %>
            <% } %>

            <% if (typeof messages !== "undefined" && messages.success && messages.success.length) { %>
                <% messages.success.forEach(function(message) { %>
                    <div class="centre-alert centre-alert-success">
                        <%= message %>
                    </div>
                <% }) %>
            <% } %>

            <% if (centre) { %>
                <div class="centre-info-grid" style="margin-bottom:20px;">
                    <div class="centre-info-item">
                        <span class="centre-info-label">Centre ID</span>
                        <span class="centre-info-value">
                            <%= centre.centre_id %>
                        </span>
                    </div>

                    <div class="centre-info-item">
                        <span class="centre-info-label">Centre Code</span>
                        <span class="centre-info-value">
                            <%= centre.centre_code %>
                        </span>
                    </div>
                </div>
            <% } %>

            <form method="POST" action="/rtse/centre/change-password">

                <div class="centre-form-group">
                    <label for="new_password">New Password</label>
                    <input
                        type="password"
                        id="new_password"
                        name="new_password"
                        minlength="8"
                        autocomplete="new-password"
                        placeholder="Enter your new password"
                        required
                    >
                </div>

                <div class="centre-form-group">
                    <label for="confirm_password">Confirm Password</label>
                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        minlength="8"
                        autocomplete="new-password"
                        placeholder="Re-enter your new password"
                        required
                    >
                </div>

                <div class="centre-actions">
                    <button type="submit" class="centre-btn centre-btn-primary">
                        Change Password
                    </button>

                    <a href="/rtse/centre/logout"
                       class="centre-btn centre-btn-secondary">
                        Logout
                    </a>
                </div>

            </form>

        </main>

        <footer class="centre-footer">
            RTSE Centre Portal
        </footer>

    </div>
</div>
</body>
</html>
