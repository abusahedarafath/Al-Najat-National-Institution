<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f1f5f9;
            color: #0f172a;
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Roboto, Arial, sans-serif;
        }

        .page {
            width: min(1400px, 100%);
            margin: auto;
            padding: 20px;
        }

        .topbar {
            background: linear-gradient(135deg, #0f3d91, #2563eb);
            color: #fff;
            border-radius: 18px;
            padding: 22px;
            margin-bottom: 18px;
        }

        .topbar h1 {
            margin: 0;
            font-size: 24px;
        }

        .topbar p {
            margin: 7px 0 0;
            opacity: .9;
            font-size: 13px;
        }

        .actions {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 15px;
            border-radius: 9px;
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
        }

        .btn-light {
            background: #fff;
            color: #1e3a8a;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
        }

        .filters {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 10px;
        }

        .field label {
            display: block;
            margin-bottom: 6px;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
        }

        input,
        select {
            width: 100%;
            height: 44px;
            padding: 0 12px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            background: #fff;
            color: #0f172a;
            outline: none;
        }

        input:focus,
        select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

        .filter-button {
            height: 44px;
            align-self: end;
            padding: 0 20px;
            border: 0;
            border-radius: 9px;
            background: #2563eb;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
        }

        .heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 14px;
        }

        .heading h2 {
            margin: 0;
            font-size: 18px;
        }

        .count {
            padding: 6px 10px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 12px;
            font-weight: 800;
        }

        .table-wrap {
            overflow-x: auto;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
        }

        table {
            width: 100%;
            min-width: 1050px;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 12px 13px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
            font-size: 13px;
            white-space: nowrap;
        }

        th {
            background: #f8fafc;
            color: #475569;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        .status {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .approved {
            background: #dcfce7;
            color: #166534;
        }

        .pending {
            background: #fef3c7;
            color: #92400e;
        }

        .rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        .present {
            color: #166534;
            font-weight: 800;
        }

        .absent {
            color: #991b1b;
            font-weight: 800;
        }

        .empty {
            padding: 45px 20px;
            text-align: center;
            color: #64748b;
        }

        @media (max-width: 800px) {
            .page {
                padding: 12px;
            }

            .filters {
                grid-template-columns: 1fr;
            }

            .filter-button {
                width: 100%;
            }

            .topbar {
                padding: 18px;
            }

            .topbar h1 {
                font-size: 21px;
            }
        }

        .view-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 0 11px;
            border-radius: 8px;
            background: #2563eb;
            color: #ffffff;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
        }

        .view-button:hover {
            background: #1d4ed8;
        }

    </style>
</head>

<body>
<div class="page">

    <section class="topbar">
        <h1>RTSE Centre Student Registry</h1>

        <p>
            <%= centre.centre_name %>
            <% if (centre.centre_code) { %>
                · <%= centre.centre_code %>
            <% } %>
        </p>

        <div class="actions">
            <a class="btn btn-light" href="/rtse/centre/dashboard">
                ← Dashboard
            </a>

            <a class="btn btn-light" href="/rtse/centre/logout">
                Logout
            </a>
        </div>
    </section>

    <section class="card">
        <form method="GET" action="/rtse/centre/students">

            <div class="filters">

                <div class="field">
                    <label for="search">Search</label>
                    <input
                        type="search"
                        id="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Name, registration, roll, mobile, school..."
                    >
                </div>

                <div class="field">
                    <label for="status">Status</label>
                    <select id="status" name="status">
                        <option value="">All Status</option>
                        <option value="Approved" <%= status === "Approved" ? "selected" : "" %>>
                            Approved
                        </option>
                        <option value="Pending" <%= status === "Pending" ? "selected" : "" %>>
                            Pending
                        </option>
                        <option value="Rejected" <%= status === "Rejected" ? "selected" : "" %>>
                            Rejected
                        </option>
                    </select>
                </div>

                <div class="field">
                    <label for="year">Application Year</label>
                    <select id="year" name="year">
                        <option value="">All Years</option>

                        <% applicationYears.forEach(function(item) { %>
                            <option
                                value="<%= item.application_year %>"
                                <%= selectedYear === String(item.application_year) ? "selected" : "" %>
                            >
                                <%= item.application_year %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <button class="filter-button" type="submit">
                    Search
                </button>

            </div>
        </form>
    </section>

    <section class="card">

        <div class="heading">
            <h2>Candidate Registry</h2>

            <span class="count">
                <%= students.length %>
                candidate<%= students.length === 1 ? "" : "s" %>
            </span>
        </div>

        <% if (!students.length) { %>

            <div class="empty">
                No candidates found for the selected filters.
            </div>

        <% } else { %>

            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th>Registration</th>
                        <th>Student</th>
                        <th>School</th>
                        <th>Class</th>
                        <th>Section</th>
                        <th>Roll No.</th>
                        <th>Status</th>
                        <th>Admit</th>
                        <th>Attendance</th>
                                                           <th>Action</th>
                    </tr>
                    </thead>

                    <tbody>
                    <% students.forEach(function(student) { %>

                        <tr>

                            <td>
                                <strong>
                                    <%= student.registration_no || "—" %>
                                </strong>
                            </td>

                            <td>
                                <strong>
                                    <%= student.full_name || "—" %>
                                </strong>

                                <% if (student.mobile) { %>
                                    <br>
                                    <small><%= student.mobile %></small>
                                <% } %>
                            </td>

                            <td>
                                <%= student.school_name ||
                                    student.registered_school_name ||
                                    "—" %>
                            </td>

                            <td><%= student.class || "—" %></td>

                            <td><%= student.section || "—" %></td>

                            <td>
                                <%= student.roll_no ||
                                    student.roll_number ||
                                    "Not Generated" %>
                            </td>

                            <td>
                                <% if (student.status === "Approved") { %>
                                    <span class="status approved">
                                        Approved
                                    </span>
                                <% } else if (student.status === "Rejected") { %>
                                    <span class="status rejected">
                                        Rejected
                                    </span>
                                <% } else { %>
                                    <span class="status pending">
                                        <%= student.status || "Pending" %>
                                    </span>
                                <% } %>
                            </td>

                            <td>
                                <% if (Number(student.admit_generated) === 1) { %>
                                    <span class="status approved">
                                        Generated
                                    </span>
                                <% } else { %>
                                    —
                                <% } %>
                            </td>

                            <td>
                                <% if (student.attendance_status === "PRESENT") { %>
                                    <span class="present">PRESENT</span>
                                <% } else if (student.attendance_status === "ABSENT") { %>
                                    <span class="absent">ABSENT</span>
                                <% } else { %>
                                    —
                                <% } %>
                            </td>

                        </tr>

                    <% }) %>
                    </tbody>
                </table>
            </div>

        <% } %>

    </section>

</div>
</body>
</html>
