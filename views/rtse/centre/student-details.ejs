<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f1f5f9;
            color: #0f172a;
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Roboto, Arial, sans-serif;
        }

        .page {
            width: min(1100px, 100%);
            margin: auto;
            padding: 20px;
        }

        .topbar {
            background: linear-gradient(135deg, #0f3d91, #2563eb);
            color: #fff;
            border-radius: 18px;
            padding: 22px;
            margin-bottom: 18px;
        }

        .topbar h1 {
            margin: 0;
            font-size: 24px;
        }

        .topbar p {
            margin: 7px 0 0;
            opacity: .9;
            font-size: 13px;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 16px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 0 14px;
            border-radius: 9px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
        }


.btn-primary {
    background: #2563eb;
    color: #fff;
}

.btn-primary:hover {
    background: #1d4ed8;
}

.btn-light {
            background: #fff;
            color: #1e3a8a;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
        }

        .candidate-head {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .avatar {
            width: 76px;
            height: 76px;
            border-radius: 14px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
        }

        .candidate-head h2 {
            margin: 0;
            font-size: 21px;
        }

        .candidate-head p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 13px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .item {
            border: 1px solid #e2e8f0;
            border-radius: 11px;
            padding: 13px;
            background: #f8fafc;
        }

        .label {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 5px;
        }

        .value {
            font-size: 14px;
            font-weight: 700;
            word-break: break-word;
        }

        .status {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .approved,
        .present {
            background: #dcfce7;
            color: #166534;
        }

        .pending {
            background: #fef3c7;
            color: #92400e;
        }

        .rejected,
        .absent {
            background: #fee2e2;
            color: #991b1b;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 17px;
        }

        .notice {
            padding: 13px;
            border-radius: 10px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
            font-size: 13px;
            line-height: 1.6;
        }

        @media (max-width: 700px) {
            .page {
                padding: 12px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .candidate-head {
                align-items: flex-start;
            }

            .avatar {
                width: 64px;
                height: 64px;
            }

            .topbar h1 {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>
<div class="page">

    <section class="topbar">
        <h1>Candidate Details</h1>

        <p>
            <%= centre.centre_name %>
            <% if (centre.centre_code) { %>
                · <%= centre.centre_code %>
            <% } %>
        </p>

        <div class="actions">
            <a class="btn btn-light" href="/rtse/centre/students">
                ← Student Registry
            </a>

            <a class="btn btn-light" href="/rtse/centre/dashboard">
                Dashboard
            </a>

            <a class="btn btn-light" href="/rtse/centre/logout">
                Logout
            </a>
        </div>
    </section>

    <section class="card">
        <div class="candidate-head">

            <% if (student.photo) { %>
                <img
                    class="avatar"
                    src="/<%= String(student.photo).replace(/^\/+/, '') %>"
                    alt="Candidate Photo"
                >
            <% } else { %>
                <div class="avatar"></div>
            <% } %>

            <div>
                <h2><%= student.full_name || "Candidate" %></h2>

                <p>
                    Registration:
                    <strong>
                        <%= student.registration_no || "—" %>
                    </strong>
                </p>
            </div>

        </div>
    </section>

    <section class="card">
        <h2 class="section-title">Examination Information</h2>

        <div class="grid">

            <div class="item">
                <span class="label">Registration No.</span>
                <div class="value"><%= student.registration_no || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Application Year</span>
                <div class="value"><%= student.application_year || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Roll No.</span>
                <div class="value">
                    <%= student.roll_no || student.roll_number || "Not Generated" %>
                </div>
            </div>

            <div class="item">
                <span class="label">Admit Card</span>
                <div class="value">
                    <% if (Number(student.admit_generated) === 1) { %>
                        <span class="status approved">Generated</span>
                    <% } else { %>
                        Not Generated
                    <% } %>
                </div>
            </div>

            <div class="item">
                <span class="label">Class</span>
                <div class="value"><%= student.class || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Section</span>
                <div class="value"><%= student.section || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Application Status</span>
                <div class="value">
                    <% if (student.status === "Approved") { %>
                        <span class="status approved">Approved</span>
                    <% } else if (student.status === "Rejected") { %>
                        <span class="status rejected">Rejected</span>
                    <% } else { %>
                        <span class="status pending">
                            <%= student.status || "Pending" %>
                        </span>
                    <% } %>
                </div>
            </div>

            <div class="item">
                <span class="label">Centre Assignment</span>
                <div class="value">
                    <%= student.assignment_status || "—" %>
                </div>
            </div>

        </div>
    </section>

    <section class="card">
        <h2 class="section-title">Student Information</h2>

        <div class="grid">

            <div class="item">
                <span class="label">Father's Name</span>
                <div class="value"><%= student.father_name || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Mother's Name</span>
                <div class="value"><%= student.mother_name || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Gender</span>
                <div class="value"><%= student.gender || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Date of Birth</span>
                <div class="value"><%= student.dob || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Mobile</span>
                <div class="value"><%= student.mobile || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Email</span>
                <div class="value"><%= student.email || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Address</span>
                <div class="value"><%= student.address || "—" %></div>
            </div>

            <div class="item">
                <span class="label">Pincode</span>
                <div class="value"><%= student.pincode || "—" %></div>
            </div>

        </div>
    </section>

    <section class="card">
        <h2 class="section-title">School Information</h2>

        <div class="grid">

            <div class="item">
                <span class="label">School</span>
                <div class="value">
                    <%= student.school_name ||
                        student.registered_school_name ||
                        "—" %>
                </div>
            </div>

            <div class="item">
                <span class="label">School Code</span>
                <div class="value"><%= student.school_code || "—" %></div>
            </div>

            <div class="item">
                <span class="label">District</span>
                <div class="value"><%= student.district || "—" %></div>
            </div>

            <div class="item">
                <span class="label">State</span>
                <div class="value"><%= student.state || "—" %></div>
            </div>

        </div>
    </section>


<section class="card">
    <h2 class="section-title">Admit Card</h2>

    <% if (
        Number(student.admit_generated) === 1 &&
        student.status === "Approved" &&
        student.roll_no
    ) { %>

    <div class="notice">
        The admit card has been generated for this candidate.
        It is accessible only through this Centre's authenticated portal.
    </div>

    <div class="actions" style="margin-top:14px;">
        <a
            class="btn btn-primary"
            href="/rtse/centre/student/<%= student.id %>/admit-card"
        >
            View Admit Card
        </a>
    </div>

    <% } else { %>

    <div class="notice">
        Admit Card is not available yet. It will appear here after
        the candidate is approved, assigned a roll number, and the
        admit card is generated.
    </div>

    <% } %>
</section>

<section class="card">
        <h2 class="section-title">Examination Attendance</h2>

        <div class="grid">

            <div class="item">
                <span class="label">Attendance</span>
                <div class="value">

                    <% if (student.attendance_status === "PRESENT") { %>
                        <span class="status present">PRESENT</span>
                    <% } else if (student.attendance_status === "ABSENT") { %>
                        <span class="status absent">ABSENT</span>
                    <% } else { %>
                        Not Marked
                    <% } %>

                </div>
            </div>

            <div class="item">
                <span class="label">Scanned At</span>
                <div class="value">
                    <%= student.scanned_at || "—" %>
                </div>
            </div>

        </div>
    </section>

    <section class="card">
        <div class="notice">
            Candidate information displayed here is restricted
            to students assigned to this examination centre.
            Existing student-uploaded documents and photographs
            are not modified by the Centre Portal.
        </div>
    </section>

</div>
</body>
</html>
