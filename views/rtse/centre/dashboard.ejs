<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        :root {
            --arsp-blue: #082b6f;
            --arsp-blue-2: #123f88;
            --arsp-blue-3: #1d4f9a;
            --arsp-gold: #d9a83d;
            --text: #17315f;
            --muted: #71809a;
            --border: #e5eaf2;
            --bg: #f6f8fc;
            --white: #ffffff;
            --success: #16803d;
            --warning: #b77900;
            --danger: #c53030;
            --shadow: 0 4px 18px rgba(23, 49, 95, .07);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        body {
            min-height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .portal {
            min-height: 100vh;
        }

        /* =========================
           TOP HEADER
        ========================== */

        .topbar {
            height: 118px;
            background: linear-gradient(135deg, #06255f 0%, #0b3478 52%, #123f88 100%);
            color: #fff;
            display: flex;
            align-items: center;
        }

        .topbar-inner {
            width: 100%;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 20px;
            min-width: 0;
        }

        .brand-logo {
            width: 86px;
            height: 86px;
            border-radius: 50%;
            object-fit: contain;
            background: rgba(255,255,255,.98);
            padding: 4px;
            flex: 0 0 auto;
        }

        .brand-copy {
            min-width: 0;
        }

        .brand-title {
            margin: 0;
            font-size: 34px;
            line-height: 1;
            font-weight: 850;
            letter-spacing: .02em;
        }

        .brand-tagline {
            margin: 8px 0 0;
            color: #e2b54d;
            font-size: 18px;
            line-height: 1.1;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .brand-portal {
            margin: 7px 0 0;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .account-area {
            display: flex;
            align-items: center;
            gap: 18px;
            flex: 0 0 auto;
        }

        .account-copy {
            text-align: right;
            line-height: 1.35;
        }

        .account-copy .welcome-small {
            display: block;
            font-size: 14px;
            opacity: .88;
        }

        .account-copy .centre-name {
            display: block;
            margin-top: 2px;
            font-size: 16px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .account-copy .centre-code {
            display: block;
            margin-top: 2px;
            font-size: 13px;
            opacity: .86;
        }

        .account-divider {
            width: 1px;
            height: 60px;
            background: rgba(255,255,255,.35);
        }

        .account-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #fff;
            color: var(--arsp-blue);
            display: grid;
            place-items: center;
            font-size: 24px;
            font-weight: 900;
            box-shadow: 0 3px 10px rgba(0,0,0,.12);
        }

        /* =========================
           APP SHELL
        ========================== */

        .app-shell {
            display: grid;
            grid-template-columns: 285px minmax(0, 1fr);
            min-height: calc(100vh - 118px);
        }

        .sidebar {
            background: #fff;
            border-right: 1px solid var(--border);
            padding: 22px 18px 20px;
            display: flex;
            flex-direction: column;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 14px;
            min-height: 46px;
            padding: 10px 16px;
            border-radius: 10px;
            color: #102d61;
            font-size: 14px;
            font-weight: 650;
            transition: .16s ease;
        }

        .nav-link:hover {
            background: #f1f5fb;
        }

        .nav-link.active {
            background: linear-gradient(135deg, #082b6f, #123f88);
            color: #fff;
            box-shadow: 0 4px 12px rgba(8,43,111,.18);
        }

        .nav-icon {
            width: 23px;
            text-align: center;
            font-size: 18px;
            flex: 0 0 23px;
        }

        .nav-section {
            margin: 24px 12px 8px;
            color: #77849a;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .nav-rule {
            height: 1px;
            background: #dfe4eb;
            margin: 0 4px 8px;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 20px;
        }

        .logout-link {
            border: 1px solid var(--border);
            color: #123668;
        }

        /* =========================
           MAIN
        ========================== */

        .main {
            min-width: 0;
            padding: 24px 28px 42px;
        }

        .content {
            width: min(1220px, 100%);
            margin: 0 auto;
        }

        .welcome-card {
            min-height: 145px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 17px;
            box-shadow: var(--shadow);
            padding: 26px 26px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            overflow: hidden;
            position: relative;
        }

        .welcome-card::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -65px;
            bottom: -115px;
            border-radius: 50%;
            background: rgba(18,63,136,.035);
        }

        .welcome-text {
            position: relative;
            z-index: 1;
        }

        .welcome-label {
            margin: 0 0 5px;
            color: #12366e;
            font-size: 17px;
            font-weight: 700;
        }

        .welcome-title {
            margin: 0;
            color: var(--arsp-blue);
            font-size: 28px;
            line-height: 1.1;
            font-weight: 850;
            text-transform: uppercase;
        }

        .welcome-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 14px;
        }

        .meta-pill {
            background: #f0f3f9;
            color: #44536d;
            padding: 7px 12px;
            border-radius: 7px;
            font-size: 12px;
        }

        .meta-pill strong {
            color: #1b2f55;
        }

        .welcome-emblem {
            position: relative;
            z-index: 1;
            width: 210px;
            height: 110px;
            opacity: .9;
            display: grid;
            place-items: center;
            color: #d9e1ee;
            font-size: 78px;
            font-weight: 900;
        }

        /* =========================
           STATISTICS
        ========================== */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-top: 20px;
        }

        .stat {
            min-height: 128px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 18px 18px 15px;
            display: grid;
            grid-template-columns: 56px minmax(0, 1fr);
            column-gap: 14px;
            align-items: center;
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
        }

        .stat.clickable:hover {
            transform: translateY(-2px);
            border-color: #aac0e2;
            box-shadow: 0 8px 24px rgba(8,43,111,.11);
        }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(145deg, #082b6f, #174a94);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 24px;
            font-weight: 900;
            grid-row: 1 / span 3;
        }

        .stat-label {
            color: #65728a;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .stat-value {
            margin-top: 4px;
            color: var(--arsp-blue);
            font-size: 31px;
            line-height: 1;
            font-weight: 900;
        }

        .stat-note {
            margin-top: 7px;
            color: #7d899d;
            font-size: 10px;
        }

        /* =========================
           REGISTRY
        ========================== */

        .panel {
            margin-top: 20px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 15px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .panel-header {
            min-height: 55px;
            padding: 13px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #102f66;
            font-size: 14px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .panel-title-icon {
            font-size: 18px;
        }

        .view-button {
            background: var(--arsp-blue);
            color: #fff;
            padding: 7px 12px;
            border-radius: 7px;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 850px;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 11px 13px;
            border-bottom: 1px solid #edf0f5;
            text-align: left;
            font-size: 11px;
            white-space: nowrap;
        }

        th {
            background: #fbfcfe;
            color: #68758b;
            font-size: 10px;
            font-weight: 800;
        }

        td {
            color: #4d5d76;
        }

        td strong {
            color: #24385d;
        }

        tr:last-child td {
            border-bottom: 0;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 800;
        }

        .status-approved {
            color: var(--success);
            background: #eaf7ee;
        }

        .status-pending {
            color: var(--warning);
            background: #fff6df;
        }

        .status-rejected {
            color: var(--danger);
            background: #fdecec;
        }

        .attendance-present {
            color: #16803d;
            background: #eaf7ee;
        }

        .attendance-absent {
            color: #b52d35;
            background: #fdebec;
        }

        .attendance-other {
            color: #55647c;
            background: #f0f3f8;
        }

        .empty {
            text-align: center;
            padding: 35px 20px;
            color: #7c899e;
            font-size: 12px;
        }

        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 1100px) {
            .topbar {
                height: auto;
                min-height: 105px;
            }

            .brand-title {
                font-size: 29px;
            }

            .brand-tagline {
                font-size: 14px;
            }

            .app-shell {
                grid-template-columns: 235px minmax(0, 1fr);
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 820px) {
            .topbar-inner {
                padding: 14px 18px;
            }

            .account-copy {
                display: none;
            }

            .account-divider {
                display: none;
            }

            .app-shell {
                grid-template-columns: 1fr;
            }

            .sidebar {
                border-right: 0;
                border-bottom: 1px solid var(--border);
                padding: 12px;
            }

            .sidebar .nav-section,
            .sidebar .nav-rule {
                display: none;
            }

            .sidebar nav {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 7px;
            }

            .nav-link {
                justify-content: center;
                padding: 9px 7px;
                font-size: 11px;
                min-height: 42px;
            }

            .nav-icon {
                width: auto;
                flex: 0 0 auto;
            }

            .sidebar-bottom {
                margin-top: 8px;
                padding-top: 0;
            }

            .sidebar-bottom .nav-link {
                justify-content: center;
            }

            .main {
                padding: 16px;
            }
        }

        @media (max-width: 560px) {
            .topbar-inner {
                gap: 10px;
            }

            .brand {
                gap: 11px;
            }

            .brand-logo {
                width: 58px;
                height: 58px;
            }

            .brand-title {
                font-size: 22px;
            }

            .brand-tagline {
                margin-top: 4px;
                font-size: 9px;
                letter-spacing: .08em;
            }

            .brand-portal {
                margin-top: 4px;
                font-size: 9px;
            }

            .account-area {
                gap: 0;
            }

            .account-icon {
                width: 42px;
                height: 42px;
                font-size: 20px;
            }

            .sidebar nav {
                grid-template-columns: repeat(2, 1fr);
            }

            .welcome-card {
                min-height: 125px;
                padding: 19px;
            }

            .welcome-label {
                font-size: 14px;
            }

            .welcome-title {
                font-size: 22px;
            }

            .welcome-emblem {
                display: none;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 9px;
            }

            .stat {
                min-height: 118px;
                grid-template-columns: 42px minmax(0, 1fr);
                column-gap: 9px;
                padding: 13px;
            }

            .stat-icon {
                width: 42px;
                height: 42px;
                font-size: 18px;
            }

            .stat-label {
                font-size: 9px;
            }

            .stat-value {
                font-size: 24px;
            }

            .stat-note {
                font-size: 8px;
            }

            .panel-header {
                padding: 12px;
            }

            .panel-title {
                font-size: 11px;
            }
        }


        /* =====================================================
           ARSP MOBILE DASHBOARD
           Reference layout: 864 x 1536
        ====================================================== */

        .mobile-menu-button,
        .mobile-welcome-avatar,
        .mobile-dashboard-section,
        .mobile-bottom-nav {
            display: none;
        }

        @media (max-width: 760px) {

            html,
            body {
                background: #f7f9fd;
            }

            body {
                padding-bottom: 86px;
            }

            /* ---------------------------------------------
               HEADER
            --------------------------------------------- */

            .topbar {
                height: 146px;
                min-height: 146px;
                border-radius: 0 0 18px 18px;
                background:
                    linear-gradient(
                        135deg,
                        #06265f 0%,
                        #0b3478 55%,
                        #123f88 100%
                    );
            }

            .topbar-inner {
                height: 100%;
                padding: 12px 18px 14px;
                align-items: center;
            }

            .brand {
                gap: 12px;
                flex: 1;
                min-width: 0;
            }

            .brand-logo {
                width: 92px;
                height: 92px;
                padding: 3px;
            }

            .brand-title {
                font-size: 34px;
                line-height: .95;
            }

            .brand-tagline {
                margin-top: 6px;
                font-size: 16px;
                line-height: 1.05;
                letter-spacing: .045em;
                white-space: nowrap;
            }

            .brand-portal {
                margin-top: 7px;
                font-size: 13px;
                white-space: nowrap;
            }

            .account-area {
                display: none;
            }

            .mobile-menu-button {
                width: 50px;
                height: 50px;
                padding: 7px 3px;
                border: 0;
                background: transparent;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                flex: 0 0 auto;
            }

            .mobile-menu-button span {
                display: block;
                width: 38px;
                height: 4px;
                border-radius: 5px;
                background: #fff;
            }

            /* ---------------------------------------------
               DESKTOP SIDEBAR OFF
            --------------------------------------------- */

            .app-shell {
                display: block;
                min-height: auto;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 18px 20px 30px;
            }

            .content {
                width: 100%;
            }

            /* ---------------------------------------------
               WELCOME
            --------------------------------------------- */

            .welcome-card {
                min-height: 150px;
                margin: 0;
                padding: 17px 18px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .mobile-welcome-avatar {
                width: 112px;
                height: 112px;
                border-radius: 50%;
                background:
                    linear-gradient(
                        145deg,
                        #082b6f,
                        #174a94
                    );
                color: #fff;
                display: grid;
                place-items: center;
                flex: 0 0 112px;
                position: relative;
                z-index: 2;
            }

            .mobile-welcome-avatar span {
                width: 35px;
                height: 35px;
                border-radius: 50%;
                background: #fff;
                color: transparent;
                position: relative;
            }

            .mobile-welcome-avatar span::after {
                content: "";
                position: absolute;
                left: -8px;
                right: -8px;
                bottom: -25px;
                height: 30px;
                border-radius: 24px 24px 8px 8px;
                background: #fff;
            }

            .welcome-text {
                flex: 1;
                min-width: 0;
            }

            .welcome-label {
                font-size: 15px;
                margin-bottom: 5px;
            }

            .welcome-title {
                font-size: 24px;
                line-height: 1.08;
                white-space: normal;
            }

            .welcome-meta {
                margin-top: 10px;
                gap: 7px;
            }

            .meta-pill {
                padding: 6px 9px;
                font-size: 9px;
                white-space: nowrap;
            }

            .welcome-emblem {
                display: block;
                position: absolute;
                right: -20px;
                bottom: -20px;
                width: 210px;
                height: 170px;
                font-size: 120px;
                opacity: .08;
            }

            /* ---------------------------------------------
               STAT CARDS
            --------------------------------------------- */

            .stats {
                margin-top: 20px;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }

            .stat {
                min-height: 128px;
                padding: 14px;
                border-radius: 17px;
                grid-template-columns: 56px minmax(0, 1fr);
                column-gap: 11px;
            }

            .stat-icon {
                width: 56px;
                height: 56px;
                font-size: 24px;
            }

            .stat-label {
                font-size: 11px;
                line-height: 1.15;
            }

            .stat-value {
                margin-top: 5px;
                font-size: 31px;
            }

            .stat-note {
                margin-top: 7px;
                font-size: 9px;
                line-height: 1.25;
            }

            /* ---------------------------------------------
               MOBILE SECTIONS
            --------------------------------------------- */

            .mobile-dashboard-section {
                display: block;
                margin-top: 24px;
                background: #fff;
                border: 1px solid #e1e7f0;
                border-radius: 18px;
                box-shadow: 0 4px 18px rgba(23,49,95,.055);
                padding: 13px 10px 12px;
            }

            .mobile-section-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                padding: 3px 10px 11px;
            }

            .mobile-section-title {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #092d70;
                font-size: 17px;
                font-weight: 850;
            }

            .mobile-section-icon {
                font-size: 22px;
            }

            .mobile-view-all {
                background: #0b357d;
                color: #fff;
                padding: 7px 12px;
                border-radius: 8px;
                font-size: 10px;
                font-weight: 800;
            }

            .mobile-info-box {
                border: 1px solid #e4e9f1;
                border-radius: 16px;
                overflow: hidden;
            }

            .mobile-info-row {
                min-height: 46px;
                padding: 9px 14px;
                display: grid;
                grid-template-columns: 42% 58%;
                align-items: center;
                border-bottom: 1px solid #e4e8ef;
                font-size: 13px;
            }

            .mobile-info-row:last-child {
                border-bottom: 0;
            }

            .mobile-info-row span {
                color: #435777;
            }

            .mobile-info-row strong {
                color: #0c2d67;
                font-size: 13px;
                word-break: break-word;
            }

            /* ---------------------------------------------
               ASSIGNED SCHOOLS
            --------------------------------------------- */

            .mobile-school-list {
                display: grid;
                gap: 9px;
            }

            .mobile-school-card {
                min-height: 91px;
                padding: 14px 13px;
                border: 1px solid #e1e7ef;
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                background: #fff;
            }

            .mobile-school-content {
                min-width: 0;
                flex: 1;
            }

            .mobile-school-content strong {
                display: block;
                color: #102c60;
                font-size: 15px;
                line-height: 1.25;
            }

            .mobile-school-content span {
                display: block;
                margin-top: 8px;
                color: #425574;
                font-size: 11px;
            }

            .mobile-school-content b {
                margin: 0 4px;
            }

            .mobile-school-status {
                padding: 10px 13px;
                border-radius: 9px;
                background: #e9f8ed;
                color: #187b39;
                font-size: 11px;
                font-weight: 850;
                white-space: nowrap;
            }

            .mobile-empty {
                padding: 25px;
                text-align: center;
                color: #77859b;
                font-size: 12px;
            }

            /* ---------------------------------------------
               HIDE DESKTOP CANDIDATE PANEL UNTIL AFTER
               MOBILE SECTIONS
            --------------------------------------------- */

            .panel {
                margin-top: 24px;
                border-radius: 18px;
            }

            /* ---------------------------------------------
               BOTTOM NAVIGATION
            --------------------------------------------- */

            .mobile-bottom-nav {
                position: fixed;
                z-index: 9999;
                left: 10px;
                right: 10px;
                bottom: 9px;
                height: 82px;
                background: rgba(255,255,255,.98);
                border: 1px solid #e2e7ef;
                border-radius: 25px;
                box-shadow:
                    0 7px 30px rgba(16,43,90,.14);
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                align-items: center;
                padding: 6px 8px;
                backdrop-filter: blur(10px);
            }

            .mobile-bottom-link {
                height: 68px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 3px;
                color: #193e7c;
                font-size: 11px;
                font-weight: 750;
                position: relative;
            }

            .bottom-icon {
                font-size: 28px;
                line-height: 1;
            }

            .mobile-bottom-link.active::after {
                content: "";
                position: absolute;
                bottom: 1px;
                width: 58px;
                height: 6px;
                border-radius: 6px;
                background: #082f77;
            }

            /* ---------------------------------------------
               MOBILE DRAWER
            --------------------------------------------- */

            body.mobile-menu-open .sidebar {
                display: block;
                position: fixed;
                z-index: 10000;
                top: 0;
                left: 0;
                bottom: 0;
                width: 285px;
                overflow-y: auto;
                box-shadow: 10px 0 30px rgba(0,0,0,.16);
            }

            body.mobile-menu-open .sidebar nav {
                display: block;
            }

            body.mobile-menu-open .sidebar .nav-section,
            body.mobile-menu-open .sidebar .nav-rule {
                display: block;
            }

            body.mobile-menu-open::after {
                content: "";
                position: fixed;
                z-index: 9998;
                inset: 0;
                background: rgba(5,25,60,.42);
            }
        }

        @media (max-width: 520px) {

            .topbar {
                height: 128px;
                min-height: 128px;
            }

            .topbar-inner {
                padding: 9px 12px;
            }

            .brand-logo {
                width: 72px;
                height: 72px;
            }

            .brand-title {
                font-size: 28px;
            }

            .brand-tagline {
                font-size: 12px;
            }

            .brand-portal {
                font-size: 10px;
            }

            .mobile-menu-button {
                width: 44px;
                height: 44px;
            }

            .mobile-menu-button span {
                width: 33px;
                height: 4px;
            }

            .main {
                padding: 17px 12px 25px;
            }

            .welcome-card {
                min-height: 148px;
                padding: 15px 12px;
            }

            .mobile-welcome-avatar {
                width: 88px;
                height: 88px;
                flex-basis: 88px;
            }

            .mobile-welcome-avatar span {
                width: 29px;
                height: 29px;
            }

            .mobile-welcome-avatar span::after {
                bottom: -21px;
                height: 27px;
            }

            .welcome-title {
                font-size: 21px;
            }

            .welcome-label {
                font-size: 14px;
            }

            .meta-pill {
                font-size: 8px;
                padding: 5px 7px;
            }

            .stats {
                gap: 10px;
            }

            .stat {
                min-height: 116px;
                padding: 11px;
                grid-template-columns: 45px minmax(0,1fr);
            }

            .stat-icon {
                width: 45px;
                height: 45px;
                font-size: 20px;
            }

            .stat-label {
                font-size: 9px;
            }

            .stat-value {
                font-size: 27px;
            }

            .stat-note {
                font-size: 8px;
            }

            .mobile-section-title {
                font-size: 15px;
            }

            .mobile-section-icon {
                font-size: 19px;
            }

            .mobile-info-row {
                grid-template-columns: 40% 60%;
                font-size: 12px;
            }

            .mobile-info-row strong {
                font-size: 12px;
            }

            .mobile-school-content strong {
                font-size: 13px;
            }

            .mobile-school-content span {
                font-size: 10px;
            }

            .mobile-school-status {
                font-size: 10px;
                padding: 8px 10px;
            }

            .mobile-bottom-nav {
                left: 6px;
                right: 6px;
                bottom: 6px;
                height: 76px;
                border-radius: 23px;
            }

            .mobile-bottom-link {
                height: 64px;
                font-size: 10px;
            }

            .bottom-icon {
                font-size: 25px;
            }
        }

    </style>
</head>

<body>
<div class="portal">

    <!-- =========================
         ARSP HEADER
    ========================== -->
    <header class="topbar">
        <div class="topbar-inner">

            <div class="brand">
                <% if (arspSettings && arspSettings.logo) { %>
                    <img
                        class="brand-logo"
                        src="/uploads/arsp-settings/<%= arspSettings.logo %>"
                        alt="ARSP Logo"
                    >
                <% } else { %>
                    <img
                        class="brand-logo"
                        src="/images/logo.png"
                        alt="ARSP Logo"
                    >
                <% } %>

                <div class="brand-copy">
                    <h1 class="brand-title">
                        <%= arspSettings && arspSettings.short_name
                            ? arspSettings.short_name
                            : "ARSP" %>
                    </h1>

                    <p class="brand-tagline">
                        <%= arspSettings && arspSettings.organization_name
                            ? arspSettings.organization_name
                            : "ACTIVE RURAL SOCIAL PROGRESS" %>
                    </p>

                    <p class="brand-portal">
                        Examination Centre Portal
                    </p>
                </div>
            </div>


            <button
                type="button"
                class="mobile-menu-button"
                onclick="document.body.classList.toggle('mobile-menu-open')"
                aria-label="Open navigation menu"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

<div class="account-area">
                <div class="account-copy">
                    <span class="welcome-small">Welcome,</span>
                    <span class="centre-name">
                        <%= centre.centre_name %>
                    </span>
                    <span class="centre-code">
                        Centre Code: <%= centre.centre_code %>
                    </span>
                </div>

                <div class="account-divider"></div>

                <div class="account-icon" aria-hidden="true">●</div>
            </div>

        </div>
    </header>

    <div class="app-shell">

        <!-- =========================
             SIDEBAR
        ========================== -->
        <aside class="sidebar">

            <nav>

                <a class="nav-link active" href="/rtse/centre/dashboard">
                    <span class="nav-icon">⌂</span>
                    <span>Dashboard</span>
                </a>

                <div class="nav-section">Centre Management</div>
                <div class="nav-rule"></div>

                <a class="nav-link" href="#centre-information">
                    <span class="nav-icon">ⓘ</span>
                    <span>Centre Information</span>
                </a>

                <a class="nav-link" href="/rtse/centre/schools">
                    <span class="nav-icon">▦</span>
                    <span>Assigned Schools</span>
                </a>

                <a class="nav-link" href="/rtse/centre/students">
                    <span class="nav-icon">♙</span>
                    <span>Candidate Registry</span>
                </a>

                <a class="nav-link" href="#attendance">
                    <span class="nav-icon">✓</span>
                    <span>Attendance</span>
                </a>

                <div class="nav-section">Exam Management</div>
                <div class="nav-rule"></div>

                <a class="nav-link" href="/rtse/centre/students">
                    <span class="nav-icon">✓</span>
                    <span>Approvals</span>
                </a>

                <a class="nav-link" href="/rtse/centre/students">
                    <span class="nav-icon">#</span>
                    <span>Roll Number Generation</span>
                </a>

                <a class="nav-link" href="/rtse/centre/students">
                    <span class="nav-icon">▣</span>
                    <span>Admit Card</span>
                </a>

                <a class="nav-link" href="/rtse/centre/students">
                    <span class="nav-icon">▦</span>
                    <span>Seat Plan</span>
                </a>

                <div class="nav-section">Communication</div>
                <div class="nav-rule"></div>

                <a class="nav-link" href="#">
                    <span class="nav-icon">♧</span>
                    <span>Notices</span>
                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">⌁</span>
                    <span>Notifications</span>
                </a>

            </nav>

            <div class="sidebar-bottom">
                <a class="nav-link logout-link" href="/rtse/centre/logout">
                    <span class="nav-icon">↪</span>
                    <span>Logout</span>
                </a>
            </div>

        </aside>

        <!-- =========================
             MAIN CONTENT
        ========================== -->
        <main class="main">
            <div class="content">

                <!-- Welcome -->
                <section class="welcome-card" id="centre-information">


                    <div class="mobile-welcome-avatar">
                        <span>●</span>
                    </div>

                    <div class="welcome-text">
                        <p class="welcome-label">Welcome back,</p>

                        <h2 class="welcome-title">
                            <%= centre.centre_name %>
                        </h2>

                        <div class="welcome-meta">
                            <span class="meta-pill">
                                Centre ID:
                                <strong><%= centre.centre_id %></strong>
                            </span>

                            <span class="meta-pill">
                                Centre Code:
                                <strong><%= centre.centre_code %></strong>
                            </span>
                        </div>
                    </div>

                    <div class="welcome-emblem" aria-hidden="true">
                        ✦
                    </div>

                </section>

                <!-- Statistics -->
                <section class="stats">

                    <a
                        class="stat clickable"
                        href="/rtse/centre/schools"
                        aria-label="Open assigned schools"
                    >
                        <div class="stat-icon">▦</div>

                        <div class="stat-label">
                            Assigned Schools
                        </div>

                        <div class="stat-value">
                            <%= Number(stats.assigned_schools || 0) %>
                        </div>

                        <div class="stat-note">
                            Schools linked to this centre
                        </div>
                    </a>

                    <a
                        class="stat clickable"
                        href="/rtse/centre/students"
                        aria-label="Open candidate registry"
                    >
                        <div class="stat-icon">♙</div>

                        <div class="stat-label">
                            Total Candidates
                        </div>

                        <div class="stat-value">
                            <%= Number(stats.total_students || 0) %>
                        </div>

                        <div class="stat-note">
                            Registered candidates
                        </div>
                    </a>

                    <a
                        class="stat clickable"
                        href="/rtse/centre/students?status=Approved"
                        aria-label="Open approved candidates"
                    >
                        <div class="stat-icon">✓</div>

                        <div class="stat-label">
                            Approved Candidates
                        </div>

                        <div class="stat-value">
                            <%= Number(stats.approved_students || 0) %>
                        </div>

                        <div class="stat-note">
                            Applications approved
                        </div>
                    </a>

                    <a
                        class="stat clickable"
                        href="/rtse/centre/students"
                        aria-label="Open roll number registry"
                    >
                        <div class="stat-icon">#</div>

                        <div class="stat-label">
                            Roll Numbers Generated
                        </div>

                        <div class="stat-value">
                            <%= Number(stats.roll_generated || 0) %>
                        </div>

                        <div class="stat-note">
                            Roll numbers generated
                        </div>
                    </a>

                </section>


                <!-- =========================================
                     MOBILE CENTRE INFORMATION
                ========================================== -->
                <section class="mobile-dashboard-section centre-info-mobile">

                    <div class="mobile-section-header">
                        <div class="mobile-section-title">
                            <span class="mobile-section-icon">▦</span>
                            <span>Centre Information</span>
                        </div>

                        <a href="#centre-information" class="mobile-view-all">
                            View All
                        </a>
                    </div>

                    <div class="mobile-info-box">

                        <div class="mobile-info-row">
                            <span>Centre ID</span>
                            <strong>
                                <%= centre.centre_id || "—" %>
                            </strong>
                        </div>

                        <div class="mobile-info-row">
                            <span>Centre Code</span>
                            <strong>
                                <%= centre.centre_code || "—" %>
                            </strong>
                        </div>

                        <div class="mobile-info-row">
                            <span>Centre Type</span>
                            <strong>
                                <%= centre.centre_type || "School" %>
                            </strong>
                        </div>

                        <div class="mobile-info-row">
                            <span>Account Username</span>
                            <strong>
                                <%= centreAccount.username || "—" %>
                            </strong>
                        </div>

                        <div class="mobile-info-row">
                            <span>Present</span>
                            <strong>
                                <%= Number(stats.present_students || 0) %>
                            </strong>
                        </div>

                        <div class="mobile-info-row">
                            <span>Absent</span>
                            <strong>
                                <%= Number(stats.absent_students || 0) %>
                            </strong>
                        </div>

                    </div>
                </section>


                <!-- =========================================
                     MOBILE ASSIGNED SCHOOLS
                ========================================== -->
                <section class="mobile-dashboard-section schools-mobile">

                    <div class="mobile-section-header">
                        <div class="mobile-section-title">
                            <span class="mobile-section-icon">▦</span>
                            <span>Assigned Schools</span>
                        </div>

                        <a
                            href="/rtse/centre/schools"
                            class="mobile-view-all"
                        >
                            View All
                        </a>
                    </div>

                    <div class="mobile-school-list">

                        <% if (assignedSchools && assignedSchools.length) { %>

                            <% assignedSchools.slice(0, 5).forEach(function(school) { %>

                                <a
                                    class="mobile-school-card"
                                    href="/rtse/centre/schools"
                                >

                                    <div class="mobile-school-content">

                                        <strong>
                                            <%= school.school_name ||
                                                school.registered_school_name ||
                                                "School" %>
                                        </strong>

                                        <span>
                                            School Code:
                                            <%= school.school_code || "—" %>

                                            <b>•</b>

                                            Year:
                                            <%= school.application_year ||
                                                school.year ||
                                                2026 %>
                                        </span>

                                    </div>

                                    <span class="mobile-school-status">
                                        <%= school.status || "Approved" %>
                                    </span>

                                </a>

                            <% }); %>

                        <% } else { %>

                            <div class="mobile-empty">
                                No assigned schools found.
                            </div>

                        <% } %>

                    </div>

                </section>


                <!-- =========================================
                     MOBILE BOTTOM NAVIGATION
                ========================================== -->

                <nav class="mobile-bottom-nav">

                    <a
                        href="/rtse/centre/dashboard"
                        class="mobile-bottom-link active"
                    >
                        <span class="bottom-icon">⌂</span>
                        <span>Home</span>
                    </a>

                    <a
                        href="/rtse/centre/schools"
                        class="mobile-bottom-link"
                    >
                        <span class="bottom-icon">▦</span>
                        <span>Schools</span>
                    </a>

                    <a
                        href="/rtse/centre/students"
                        class="mobile-bottom-link"
                    >
                        <span class="bottom-icon">♙</span>
                        <span>Candidates</span>
                    </a>

                    <a
                        href="/rtse/centre/change-password"
                        class="mobile-bottom-link"
                    >
                        <span class="bottom-icon">●</span>
                        <span>Profile</span>
                    </a>

                </nav>

                <!-- Candidate Registry -->
                <section class="panel" id="attendance">

                    <div class="panel-header">
                        <div class="panel-title">
                            <span class="panel-title-icon">♙</span>
                            Candidate Registry Overview
                        </div>

                        <a
                            class="view-button"
                            href="/rtse/centre/students"
                        >
                            View All Candidates
                        </a>
                    </div>

                    <% if (students && students.length) { %>

                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Registration No.</th>
                                        <th>Candidate Name</th>
                                        <th>School</th>
                                        <th>Class</th>
                                        <th>Section</th>
                                        <th>Roll No.</th>
                                        <th>Status</th>
                                        <th>Attendance</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% students.slice(0, 5).forEach(function(student) { %>

                                        <%
                                            const candidateStatus =
                                                String(student.status || "").toLowerCase();

                                            let statusClass = "status-pending";

                                            if (candidateStatus === "approved") {
                                                statusClass = "status-approved";
                                            } else if (candidateStatus === "rejected") {
                                                statusClass = "status-rejected";
                                            }

                                            const attendance =
                                                String(student.attendance_status || "").trim();

                                            let attendanceClass = "attendance-other";
                                            let attendanceText = attendance || "NOT SCANNED";

                                            if (attendance.toLowerCase() === "present") {
                                                attendanceClass = "attendance-present";
                                            } else if (attendance.toLowerCase() === "absent") {
                                                attendanceClass = "attendance-absent";
                                            }
                                        %>

                                        <tr>
                                            <td>
                                                <strong>
                                                    <%= student.registration_no || "—" %>
                                                </strong>
                                            </td>

                                            <td>
                                                <%= student.full_name || "—" %>
                                            </td>

                                            <td>
                                                <%= student.school_name ||
                                                    student.registered_school_name ||
                                                    "—" %>
                                            </td>

                                            <td>
                                                <%= student.class || "—" %>
                                            </td>

                                            <td>
                                                <%= student.section || "—" %>
                                            </td>

                                            <td>
                                                <%= student.roll_no ||
                                                    student.roll_number ||
                                                    "—" %>
                                            </td>

                                            <td>
                                                <span class="status-badge <%= statusClass %>">
                                                    <%= student.status || "Pending" %>
                                                </span>
                                            </td>

                                            <td>
                                                <span class="status-badge <%= attendanceClass %>">
                                                    <%= attendanceText.toUpperCase() %>
                                                </span>
                                            </td>
                                        </tr>

                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                    <% } else { %>

                        <div class="empty">
                            No candidates are currently linked to this centre.
                        </div>

                    <% } %>

                </section>

            </div>
        </main>

    </div>
</div>
</body>
</html>
