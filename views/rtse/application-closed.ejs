<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/rtse.css">

<%- include("../partials/navbar") %>

<div class="rtse-page">
    <div style="
        min-height:70vh;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:30px 15px;
    ">
        <div style="
            max-width:600px;
            width:100%;
            text-align:center;
            background:#fff;
            border-radius:16px;
            padding:40px 25px;
            box-shadow:0 8px 30px rgba(0,0,0,0.10);
        ">

            <div style="
                font-size:55px;
                margin-bottom:15px;
            ">
                ⏰
            </div>

            <h1 style="
                margin:0 0 15px;
                color:#b42318;
            ">
                RTSE Application Date Is Over
            </h1>

            <p style="
                font-size:16px;
                line-height:1.7;
                color:#555;
                margin:0;
            ">
                The RTSE application process is currently closed.
                Please check back later for further updates.
            </p>

            <a
                href="/rtse"
                style="
                    display:inline-block;
                    margin-top:25px;
                    padding:12px 22px;
                    background:#1f7a4d;
                    color:#fff;
                    text-decoration:none;
                    border-radius:8px;
                    font-weight:600;
                "
            >
                ← Back to RTSE
            </a>

        </div>
    </div>
</div>

<%- include("../partials/footer") %>
