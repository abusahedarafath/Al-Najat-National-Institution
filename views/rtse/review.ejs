<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/rtse.css">
<link rel="stylesheet" href="/css/rtse-review.css">

<%- include("../partials/navbar") %>

<main class="rtse-review-page">

    <!-- PAGE HERO -->
    <section class="rtse-review-hero">
        <div class="rtse-review-hero-inner">
            <div class="rtse-review-eyebrow">
                RTSE ONLINE APPLICATION
            </div>

            <h1>Review Your Application</h1>

            <p>
                Please carefully verify all information before submitting your application.
            </p>
        </div>
    </section>

    <div class="rtse-review-container">

        <!-- BREADCRUMB -->
        <nav class="rtse-review-breadcrumb" aria-label="breadcrumb">
            <a href="/rtse/apply">Application</a>
            <span>›</span>
            <strong>Review</strong>
        </nav>

        <!-- APPLICATION SUMMARY -->
        <section class="rtse-review-summary">

            <div class="rtse-review-photo-wrap">
                <% if (draft.photo) { %>
                    <img
                        src="/uploads/rtse/<%= draft.photo %>"
                        alt="Candidate Photo"
                        class="rtse-review-photo"
                    >
                <% } else { %>
                    <div class="rtse-review-photo-placeholder">
                        <span>Photo</span>
                    </div>
                <% } %>
            </div>

            <div class="rtse-review-summary-content">

                <span class="rtse-review-status">
                    APPLICATION DRAFT
                </span>

                <h2>
                    <%= draft.full_name || "Applicant" %>
                </h2>

                <p class="rtse-review-summary-subtitle">
                    Ratabari Talent Search Examination
                </p>

                <div class="rtse-review-summary-grid">

                    <div>
                        <small>Father's Name</small>
                        <strong><%= draft.father_name || "-" %></strong>
                    </div>

                    <div>
                        <small>Class</small>
                        <strong>Class <%= draft.class || "-" %></strong>
                    </div>

                    <div>
                        <small>District</small>
                        <strong><%= draft.district || "-" %></strong>
                    </div>

                    <div>
                        <small>Mobile</small>
                        <strong><%= draft.mobile || "-" %></strong>
                    </div>

                </div>

            </div>

        </section>

        <!-- PERSONAL DETAILS -->
        <section class="rtse-review-section">

            <div class="rtse-review-section-heading">
                <div class="rtse-review-section-icon">01</div>

                <div>
                    <h2>Personal Details</h2>
                    <p>Basic information provided by the candidate.</p>
                </div>
            </div>

            <div class="rtse-review-details-grid">

                <div class="rtse-review-detail">
                    <span>Full Name</span>
                    <strong><%= draft.full_name || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Father's Name</span>
                    <strong><%= draft.father_name || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Mother's Name</span>
                    <strong><%= draft.mother_name || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Gender</span>
                    <strong><%= draft.gender || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Date of Birth</span>
                    <strong><%= draft.dob || "-" %></strong>
                </div>

            </div>

        </section>

        <!-- CONTACT DETAILS -->
        <section class="rtse-review-section">

            <div class="rtse-review-section-heading">
                <div class="rtse-review-section-icon">02</div>

                <div>
                    <h2>Contact & Address</h2>
                    <p>Contact information and residential details.</p>
                </div>
            </div>

            <div class="rtse-review-details-grid">

                <div class="rtse-review-detail">
                    <span>Mobile</span>
                    <strong><%= draft.mobile || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Email</span>
                    <strong><%= draft.email || "Not provided" %></strong>
                </div>

                <div class="rtse-review-detail rtse-review-detail-wide">
                    <span>Address</span>
                    <strong><%= draft.address || "Not provided" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>District</span>
                    <strong><%= draft.district || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>State</span>
                    <strong><%= draft.state || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>PIN Code</span>
                    <strong><%= draft.pincode || "Not provided" %></strong>
                </div>

            </div>

        </section>

        <!-- EXAMINATION DETAILS -->
        <section class="rtse-review-section">

            <div class="rtse-review-section-heading">
                <div class="rtse-review-section-icon">03</div>

                <div>
                    <h2>Examination Details</h2>
                    <p>School and examination information.</p>
                </div>
            </div>

            <div class="rtse-review-details-grid">

                <div class="rtse-review-detail rtse-review-detail-wide">
                    <span>School</span>
                    <strong><%= draft.school_name || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Class</span>
                    <strong>Class <%= draft.class || "-" %></strong>
                </div>

                <div class="rtse-review-detail">
                    <span>Section</span>
                    <strong>SECTION <%= draft.section || "-" %></strong>
                </div>

            </div>

        </section>

        <!-- DOCUMENTS -->
        <section class="rtse-review-section">

            <div class="rtse-review-section-heading">
                <div class="rtse-review-section-icon">04</div>

                <div>
                    <h2>Uploaded Documents</h2>
                    <p>Documents attached to this application.</p>
                </div>
            </div>

            <div class="rtse-review-documents">

                <div class="rtse-review-document">
                    <div class="rtse-review-document-icon">✓</div>

                    <div>
                        <strong>Candidate Photograph</strong>
                        <span>Photo uploaded successfully</span>
                    </div>

                    <b class="rtse-review-uploaded">
                        Uploaded
                    </b>
                </div>

                <div class="rtse-review-document">

                    <div class="rtse-review-document-icon
                        <%= draft.identity_document ? "" : "missing" %>">
                        <%= draft.identity_document ? "✓" : "!" %>
                    </div>

                    <div>
                        <strong>Identity Document</strong>

                        <% if (draft.identity_document) { %>
                            <span>Identity document uploaded</span>
                        <% } else { %>
                            <span>No identity document provided</span>
                        <% } %>
                    </div>

                    <b class="<%= draft.identity_document
                        ? 'rtse-review-uploaded'
                        : 'rtse-review-missing' %>">
                        <%= draft.identity_document ? "Uploaded" : "Not provided" %>
                    </b>

                </div>

            </div>

        </section>

        <!-- DECLARATION -->
        <section class="rtse-review-declaration">

            <label for="declaration">

                <input
                    type="checkbox"
                    id="declaration"
                >

                <span class="rtse-review-checkmark"></span>

                <span class="rtse-review-declaration-text">
                    <strong>Applicant Declaration</strong>

                    I hereby declare that the information provided in this
                    application is true and correct to the best of my knowledge.
                    I understand that providing false or misleading information
                    may result in cancellation of my application.
                </span>

            </label>

        </section>

        <!-- ACTIONS -->
        <section class="rtse-review-actions">

            <a
                href="/rtse/edit"
                class="rtse-review-edit-btn"
            >
                <span>←</span>
                Edit Application
            </a>

            <form
                action="/rtse/confirm"
                method="POST"
            >

                <button
                    type="submit"
                    id="confirmButton"
                    class="rtse-review-confirm-btn"
                    disabled
                >
                    Confirm & Submit Application
                    <span>→</span>
                </button>

            </form>

        </section>

        <p class="rtse-review-final-note">
            Please make sure all information is correct before confirming.
        </p>

    </div>

</main>

<script>
    const declaration = document.getElementById("declaration");
    const confirmButton = document.getElementById("confirmButton");

    declaration.addEventListener("change", function () {
        confirmButton.disabled = !this.checked;
    });
</script>

<%- include("../partials/footer") %>
