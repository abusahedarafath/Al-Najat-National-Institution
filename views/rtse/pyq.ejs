<%- include("../partials/header") %>
<link rel="stylesheet" href="/css/rtse-pyq.css">

<main class="rtse-pyq-page">

    <section class="rtse-pyq-hero">
        <div class="rtse-pyq-container">

            <a href="/rtse/" class="rtse-pyq-back">
                ← Back to RTSE
            </a>

            <span class="rtse-pyq-badge">
                RTSE STUDY RESOURCE
            </span>

            <h1>Previous Year Questions</h1>

            <p>
                Select a year to explore all available RTSE question papers.
            </p>

        </div>
    </section>

    <section class="rtse-pyq-content">

        <div class="rtse-pyq-container">

            <% if (!categories || !categories.length) { %>

                <div class="rtse-pyq-empty">

                    <div>📚</div>

                    <h2>No PYQ Categories Available</h2>

                    <p>
                        Previous year question papers will appear here when
                        they are published.
                    </p>

                </div>

            <% } else { %>

                <div class="rtse-pyq-category-grid">

                    <% categories.forEach(category => { %>

                        <a
                            href="/rtse/pyq/<%= category.year %>"
                            class="rtse-pyq-year-card"
                        >

                            <div class="rtse-pyq-year-card-icon">
                                <span>
                                    <%= category.year %>
                                </span>
                            </div>

                            <div class="rtse-pyq-year-card-body">

                                <span class="rtse-pyq-year-label">
                                    RTSE <%= category.year %>
                                </span>

                                <h2>
                                    <%= category.title %>
                                </h2>

                                <span class="rtse-pyq-year-card-link">
                                    View Question Papers
                                    <span aria-hidden="true">→</span>
                                </span>

                            </div>

                        </a>

                    <% }); %>

                </div>

            <% } %>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>
