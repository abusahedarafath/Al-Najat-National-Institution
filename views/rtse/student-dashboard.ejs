<script>
(function () {
    const trigger = document.getElementById("rtseResultTrigger");
    const modal = document.getElementById("rtseResultModal");
    const closeButton = document.getElementById("rtseResultClose");
    const loading = document.getElementById("rtseResultLoading");
    const errorBox = document.getElementById("rtseResultError");
    const content = document.getElementById("rtseResultContent");

    if (!trigger || !modal || !closeButton) {
        return;
    }

    const photo = document.getElementById("rtseResultPhoto");
    const registration = document.getElementById("rtseResultRegistration");
    const roll = document.getElementById("rtseResultRoll");
    const marks = document.getElementById("rtseResultMarks");
    const total = document.getElementById("rtseResultTotal");
    const fullTotal = document.getElementById("rtseResultFullTotal");
    const percentage = document.getElementById("rtseResultPercentage");
    const grade = document.getElementById("rtseResultGrade");
    const status = document.getElementById("rtseResultStatus");

    function safeValue(value) {
        return value === null || value === undefined || value === ""
            ? "—"
            : String(value);
    }

    function formatMark(value) {
        if (value === null || value === undefined || value === "") {
            return "—";
        }

        const number = Number(value);

        if (!Number.isFinite(number)) {
            return String(value);
        }

        return Number.isInteger(number)
            ? String(number)
            : number.toFixed(2).replace(/\.?0+$/, "");
    }

    function escapeHtml(value) {
        return String(value === null || value === undefined ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function resetModal() {
        loading.style.display = "block";
        loading.textContent = "Loading your result…";
        errorBox.style.display = "none";
        errorBox.textContent = "";
        content.style.display = "none";
        marks.innerHTML = "";
        photo.removeAttribute("src");
    }

    function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    function renderResult(data) {
        const result = data.result || {};

        registration.textContent = safeValue(result.registration_no);
        roll.textContent = safeValue(result.roll_no);

        if (result.photo) {
            photo.src =
                "/uploads/rtse/" +
                encodeURIComponent(String(result.photo));
        } else {
            photo.src =
                "data:image/svg+xml;charset=UTF-8," +
                encodeURIComponent(
                    '<svg xmlns="http://www.w3.org/2000/svg" width="104" height="104">' +
                    '<rect width="104" height="104" fill="#e2e8f0"/>' +
                    '<text x="52" y="58" text-anchor="middle" font-size="42">👤</text>' +
                    '</svg>'
                );
        }

        const rows = [];

        rows.push({
            name: "OMR",
            marks: result.omr_marks,
            maximum_marks: 100
        });

        (Array.isArray(result.components)
            ? result.components
            : []
        ).forEach(function (component) {
            rows.push({
                name: component.name,
                marks: component.marks,
                maximum_marks: component.maximum_marks
            });
        });

        marks.innerHTML = rows.map(function (row) {
            return (
                '<div class="rtse-result-mark-row">' +
                    '<span class="rtse-result-mark-name">' +
                        escapeHtml(row.name) +
                    '</span>' +
                    '<span class="rtse-result-mark-obtained">' +
                        escapeHtml(formatMark(row.marks)) +
                    '</span>' +
                    '<span class="rtse-result-mark-full">' +
                        '/ ' +
                        escapeHtml(formatMark(row.maximum_marks)) +
                    '</span>' +
                '</div>'
            );
        }).join("");

        total.textContent = formatMark(result.total_marks);
        fullTotal.textContent = formatMark(result.total_full_marks);

        const per = Number(result.percentage);

        percentage.textContent =
            Number.isFinite(per)
                ? per.toFixed(2) + "%"
                : safeValue(result.percentage);

        grade.textContent = safeValue(result.grade);

        status.textContent =
            result.result_status
                ? "Result Status: " + result.result_status
                : "";

        loading.style.display = "none";
        content.style.display = "block";
    }

    async function loadResult() {
        resetModal();

        try {
            const response = await fetch(
                "/rtse/student/result-data",
                {
                    method: "GET",
                    credentials: "same-origin",
                    cache: "no-store",
                    headers: {
                        "Accept": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }
            );

            let data = null;

            try {
                data = await response.json();
            } catch (jsonError) {
                throw new Error(
                    "Unable to read the examination result response."
                );
            }

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message ||
                    "Unable to load your examination result."
                );
            }

            renderResult(data);
        } catch (error) {
            loading.style.display = "none";
            content.style.display = "none";
            errorBox.style.display = "block";
            errorBox.textContent =
                error.message ||
                "Unable to load your examination result.";
        }
    }

    trigger.addEventListener("click", function () {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        loadResult();
    });

    closeButton.addEventListener("click", closeModal);

    modal.addEventListener("click", function (event) {
        if (event.target === modal) {
            closeModal();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (
            event.key === "Escape" &&
            modal.classList.contains("is-open")
        ) {
            closeModal();
        }
    });
})();
</script>

