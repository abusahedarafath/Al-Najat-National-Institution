<script>
(function () {
    "use strict";

    const actions =
        document.getElementById("rtseLoginInformationPdfActions");

    if (!actions) {
        return;
    }

    function renderPrepare() {
        actions.innerHTML = `
            <button
                type="button"
                id="rtseLoginInformationPdfPrepare"
                style="border:0;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;cursor:pointer;width:100%;"
            >
                Prepare Login Information PDF
            </button>
        `;

        const button =
            document.getElementById("rtseLoginInformationPdfPrepare");

        if (button) {
            button.addEventListener(
                "click",
                prepare
            );
        }
    }

    function renderPrepared() {
        actions.innerHTML = `
            <div style="display:grid;gap:8px;">
                <a
                    href="/rtse/student/login-information-pdf"
                    style="display:block;text-align:center;text-decoration:none;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;"
                >
                    View Login Information PDF
                </a>

                <button
                    type="button"
                    id="rtseLoginInformationPdfReset"
                    style="border:1px solid #174a86;border-radius:9px;padding:8px 12px;background:#fff;color:#174a86;font-weight:700;cursor:pointer;"
                >
                    Reset Login Information
                </button>
            </div>
        `;

        const resetButton =
            document.getElementById(
                "rtseLoginInformationPdfReset"
            );

        if (!resetButton) {
            return;
        }

        resetButton.addEventListener(
            "click",
            async function () {

                if (!window.confirm(
                    "Reset the prepared Login Information PDF? Your RTSE application data will not be changed."
                )) {
                    return;
                }

                resetButton.disabled = true;
                resetButton.textContent = "Resetting...";

                try {
                    const response = await fetch(
                        "/rtse/student/login-information-pdf/reset",
                        {
                            method: "POST",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    );

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(
                            data.message ||
                            "Unable to reset PDF."
                        );
                    }

                    renderPrepare();

                } catch (error) {

                    resetButton.disabled = false;
                    resetButton.textContent =
                        "Reset Login Information";

                    window.alert(error.message);
                }
            }
        );
    }

    async function prepare() {

        const button =
            document.getElementById(
                "rtseLoginInformationPdfPrepare"
            );

        if (!button) {
            return;
        }

        button.disabled = true;
        button.textContent = "Preparing PDF...";

        try {
            const response = await fetch(
                "/rtse/student/login-information-pdf/prepare",
                {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message ||
                    "Unable to prepare PDF."
                );
            }

            renderPrepared();

        } catch (error) {

            button.disabled = false;
            button.textContent =
                "Prepare Login Information PDF";

            window.alert(error.message);
        }
    }

    async function loadStatus() {

        try {
            const response = await fetch(
                "/rtse/student/login-information-pdf/status",
                {
                    cache: "no-store"
                }
            );

            if (!response.ok) {
                renderPrepare();
                return;
            }

            const data = await response.json();

            if (
                data.success &&
                data.prepared
            ) {
                renderPrepared();
            } else {
                renderPrepare();
            }

        } catch (_) {
            renderPrepare();
        }
    }

    loadStatus();

})();
</script>


<script>
(function () {
    "use strict";

    const trigger =
        document.getElementById("rtseAdmitCardTrigger");

    const modal =
        document.getElementById("rtseAdmitVerificationModal");

    const closeButton =
        document.getElementById("rtseAdmitModalClose");

    const message =
        document.getElementById("rtseAdmitVerificationMessage");

    const googleStep =
        document.getElementById("rtseAdmitGoogleStep");

    const detailsStep =
        document.getElementById("rtseAdmitDetailsStep");

    const successStep =
        document.getElementById("rtseAdmitSuccessStep");

    const googleButton =
        document.getElementById("rtseAdmitGoogleButton");

    const googleInfo =
        document.getElementById("rtseAdmitGoogleInfo");

    const nameInput =
        document.getElementById("rtseAdmitNameInput");

    const mobileInput =
        document.getElementById("rtseAdmitMobileInput");

    const authorizeButton =
        document.getElementById("rtseAdmitAuthorize");

    const continueButton =
        document.getElementById("rtseAdmitContinue");

    const countdown =
        document.getElementById("rtseAdmitCountdown");

    if (!trigger || !modal) {
        return;
    }

    let countdownTimer = null;

    function showMessage(text) {
        message.textContent = text || "";
        message.classList.toggle(
            "show",
            Boolean(text)
        );
    }

    function clearMessage() {
        showMessage("");
    }

    function showStep(step) {
        googleStep.classList.remove("active");
        detailsStep.classList.remove("active");
        successStep.classList.remove("active");

        step.classList.add("active");
    }

    function resetModal() {
        clearMessage();

        showStep(googleStep);

        nameInput.value = "";
        mobileInput.value = "";

        authorizeButton.disabled = false;

        googleInfo.textContent =
            "Google account verified.";

        countdown.textContent = "";

        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    }

    function openModal() {
        resetModal();

        modal.classList.add("is-open");
        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        renderGoogleButton();
    }

    function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    }

    async function postJson(url, data) {
        const response = await fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            credentials: "same-origin",
            body: JSON.stringify(data || {})
        });

        let result = {};

        try {
            result = await response.json();
        } catch (error) {
            result = {};
        }

        if (!response.ok || !result.success) {
            throw new Error(
                result.message ||
                "The verification request failed."
            );
        }

        return result;
    }

    function startCountdown(seconds) {
        let remaining = Number(seconds || 0);

        if (countdownTimer) {
            clearInterval(countdownTimer);
        }

        function update() {
            if (remaining <= 0) {
                countdown.textContent =
                    "Authorization has expired. Please start again.";

                clearInterval(countdownTimer);
                countdownTimer = null;

                return;
            }

            countdown.textContent =
                "Authorization expires in " +
                remaining +
                " seconds.";

            remaining -= 1;
        }

        update();

        countdownTimer =
            setInterval(update, 1000);
    }

    function handleGoogleCredential(response) {
        clearMessage();

        if (
            !response ||
            !response.credential
        ) {
            showMessage(
                "Google authentication did not return a valid credential."
            );

            return;
        }

        postJson(
            "/rtse/student/admit-download/google",
            {
                credential:
                    response.credential
            }
        )
        .then(function (result) {
            showStep(detailsStep);

            if (
                result.google &&
                result.google.email
            ) {
                googleInfo.textContent =
                    "Google account verified: " +
                    result.google.email +
                    ". Now enter your name and mobile number.";
            }

            nameInput.focus();
        })
        .catch(function (error) {
            showMessage(
                error.message ||
                "Unable to verify the Google account."
            );
        });
    }

    function renderGoogleButton() {
        if (
            !window.google ||
            !window.google.accounts ||
            !window.google.accounts.id
        ) {
            googleButton.innerHTML =
                "<span style='font-size:12px;color:#64748b'>Loading Google authentication…</span>";

            setTimeout(
                renderGoogleButton,
                500
            );

            return;
        }

        const clientId =
            "<%= typeof googleClientId !== 'undefined' ? googleClientId : '' %>";

        if (!clientId) {
            googleButton.innerHTML =
                "<span style='font-size:12px;color:#991b1b'>Google authentication is not configured.</span>";

            return;
        }

        google.accounts.id.initialize({
            client_id: clientId,
            callback: handleGoogleCredential,
            ux_mode: "popup"
        });

        googleButton.innerHTML = "";

        google.accounts.id.renderButton(
            googleButton,
            {
                theme: "outline",
                size: "large",
                text: "signin_with",
                shape: "rectangular",
                width: 320
            }
        );
    }

    trigger.addEventListener(
        "click",
        function (event) {
            event.preventDefault();
            openModal();
        }
    );

    closeButton.addEventListener(
        "click",
        closeModal
    );

    modal.addEventListener(
        "click",
        function (event) {
            if (event.target === modal) {
                closeModal();
            }
        }
    );

    document.addEventListener(
        "keydown",
        function (event) {
            if (
                event.key === "Escape" &&
                modal.classList.contains("is-open")
            ) {
                closeModal();
            }
        }
    );

    authorizeButton.addEventListener(
        "click",
        async function () {
            clearMessage();

            const name =
                String(nameInput.value || "")
                    .replace(/\s+/g, " ")
                    .trim();

            const mobile =
                String(mobileInput.value || "")
                    .replace(/\D/g, "");

            if (name.length < 2) {
                showMessage(
                    "Please enter your name."
                );

                nameInput.focus();
                return;
            }

            if (name.length > 255) {
                showMessage(
                    "Name is too long."
                );

                nameInput.focus();
                return;
            }

            if (!/^[6-9]\d{9}$/.test(mobile)) {
                showMessage(
                    "Please enter a valid 10-digit Indian mobile number."
                );

                mobileInput.focus();
                return;
            }

            authorizeButton.disabled = true;

            try {
                const result =
                    await postJson(
                        "/rtse/student/admit-download/details",
                        {
                            name: name,
                            mobile: mobile
                        }
                    );

                showStep(successStep);

                startCountdown(
                    result.expiresInSeconds || 600
                );
            } catch (error) {
                showMessage(
                    error.message ||
                    "Unable to authorize admit-card access."
                );

                authorizeButton.disabled = false;
            }
        }
    );

    continueButton.addEventListener(
        "click",
        function () {
            window.location.href =
                "/rtse/student/admit-card";
        }
    );
})();
</script>




