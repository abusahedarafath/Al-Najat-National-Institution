<%- include("../partials/rtse-student-header") %>

<style>

    .rtse-student-dashboard {
        min-height: calc(100vh - 160px);
        background: #f5f7fb;
        padding: 25px 15px;
    }

    .rtse-dashboard-container {
        max-width: 850px;
        margin: auto;
    }

    .rtse-dashboard-header {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-dashboard-header h1 {
        margin: 0;
        font-size: 25px;
    }

    .rtse-dashboard-header p {
        margin: 6px 0 0;
        color: #666;
        font-size: 14px;
    }

    .rtse-student-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-student-card h2 {
        margin-top: 0;
        font-size: 19px;
    }

    .rtse-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .rtse-info-item {
        background: #f8fafc;
        border-radius: 9px;
        padding: 12px;
    }

    .rtse-info-label {
        display: block;
        color: #777;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .rtse-info-value {
        font-weight: 600;
        font-size: 14px;
    }

    .rtse-status-card {
        text-align: center;
        border-radius: 15px;
        padding: 25px;
        background: #ffffff;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-status-card h2 {
        margin: 0 0 15px;
        font-size: 18px;
    }

    .rtse-status {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 15px;
    }

    .rtse-status.pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .rtse-status.approved {
        background: #dcfce7;
        color: #166534;
    }

    .rtse-status.rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .rtse-status.other {
        background: #e5e7eb;
        color: #374151;
    }

    .rtse-dashboard-actions {
        text-align: center;
        margin-top: 20px;
    }

    .rtse-logout {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 8px;
        background: #374151;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
    }


    .rtse-student-services {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-student-services h2 {
        margin: 0 0 16px;
        font-size: 19px;
    }

    .rtse-services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .rtse-service-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: inherit;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .rtse-service-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .rtse-service-icon {
        font-size: 25px;
    }

    .rtse-service-title {
        font-weight: 700;
        font-size: 15px;
    }

    .rtse-service-description {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.4;
    }

    @media (max-width: 600px) {

        .rtse-info-grid {
            grid-template-columns: 1fr;
        }

        .rtse-services-grid {
            grid-template-columns: 1fr;
        }

        .rtse-student-services {
            padding: 17px;
        }

        .rtse-dashboard-header h1 {
            font-size: 21px;
        }

        .rtse-student-card,
        .rtse-dashboard-header,
        .rtse-status-card {
            padding: 17px;
        }

    }

    /* =====================================
       RTSE Admit Card Verification Modal
       ===================================== */

    .rtse-admit-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(15, 23, 42, .62);
        padding: 20px;
        overflow-y: auto;
        align-items: center;
        justify-content: center;
    }

    .rtse-admit-modal.is-open {
        display: flex;
    }

    .rtse-admit-modal-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 20px 60px rgba(0,0,0,.22);
        padding: 24px;
        position: relative;
    }

    .rtse-admit-modal-close {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #475569;
        font-size: 21px;
        cursor: pointer;
        line-height: 1;
    }

    .rtse-admit-modal-title {
        margin: 0 35px 6px 0;
        font-size: 20px;
        color: #111827;
    }

    .rtse-admit-modal-subtitle {
        margin: 0 0 20px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .rtse-admit-step {
        display: none;
    }

    .rtse-admit-step.active {
        display: block;
    }

    .rtse-admit-step-label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #374151;
    }

    .rtse-admit-mobile-input,
    .rtse-admit-otp-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 13px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
    }

    .rtse-admit-mobile-input:focus,
    .rtse-admit-otp-input:focus {
        border-color: #64748b;
        box-shadow: 0 0 0 3px rgba(100,116,139,.12);
    }

    .rtse-admit-primary-button {
        width: 100%;
        margin-top: 14px;
        padding: 12px 16px;
        border: 0;
        border-radius: 9px;
        background: #111827;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .rtse-admit-primary-button:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .rtse-admit-secondary-button {
        width: 100%;
        margin-top: 9px;
        padding: 10px 16px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #ffffff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .rtse-admit-google-box {
        min-height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .rtse-admit-google-status {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
        line-height: 1.45;
        text-align: center;
    }

    .rtse-admit-message {
        display: none;
        margin-bottom: 14px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 12px;
        line-height: 1.45;
    }

    .rtse-admit-message.show {
        display: block;
    }

    .rtse-admit-success {
        text-align: center;
    }

    .rtse-admit-success-icon {
        font-size: 42px;
        margin-bottom: 8px;
    }

    .rtse-admit-countdown {
        margin-top: 10px;
        color: #64748b;
        font-size: 12px;
    }

    @media (max-width: 600px) {
        .rtse-admit-modal {
            padding: 12px;
        }

        .rtse-admit-modal-card {
            padding: 20px;
            border-radius: 15px;
        }
    }


    /* =====================================
       RTSE Student Examination Result Modal
       ===================================== */

    .rtse-result-trigger {
        width: 100%;
        border: 1px solid #e5e7eb;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
    }

    .rtse-result-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100000;
        padding: 14px;
        background:
            radial-gradient(circle at 20% 10%, rgba(59,130,246,.20), transparent 30%),
            radial-gradient(circle at 85% 15%, rgba(234,179,8,.20), transparent 30%),
            rgba(15,23,42,.72);
        overflow-y: auto;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .rtse-result-modal.is-open {
        display: flex;
    }

    .rtse-result-modal-card {
        width: 100%;
        max-width: 560px;
        max-height: calc(100vh - 28px);
        overflow-y: auto;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 25px 80px rgba(0,0,0,.28);
        position: relative;
        overflow-x: hidden;
    }

    .rtse-result-hero {
        position: relative;
        padding: 30px 22px 24px;
        text-align: center;
        color: #ffffff;
        background:
            radial-gradient(circle at 15% 20%, rgba(255,255,255,.22), transparent 25%),
            radial-gradient(circle at 85% 10%, rgba(250,204,21,.30), transparent 25%),
            linear-gradient(135deg, #0f2a5f 0%, #174a86 48%, #7c3aed 100%);
    }

    .rtse-result-close {
        position: absolute;
        top: 12px;
        right: 13px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        color: #ffffff;
        font-size: 23px;
        cursor: pointer;
        line-height: 1;
    }

    .rtse-result-confetti {
        font-size: 30px;
        margin-bottom: 5px;
    }

    .rtse-result-congrats {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .rtse-result-subtitle {
        margin: 7px 0 0;
        font-size: 13px;
        opacity: .90;
    }

    .rtse-result-photo-wrap {
        margin: 18px auto 0;
        width: 104px;
        height: 104px;
        border-radius: 50%;
        padding: 4px;
        background: linear-gradient(135deg, #facc15, #ffffff, #60a5fa);
        box-shadow: 0 8px 25px rgba(0,0,0,.20);
    }

    .rtse-result-photo {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        border-radius: 50%;
        background: #e5e7eb;
    }

    .rtse-result-body {
        padding: 20px;
    }

    .rtse-result-identity {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    .rtse-result-info {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        padding: 12px;
    }

    .rtse-result-info-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
    }

    .rtse-result-info-value {
        display: block;
        color: #0f172a;
        font-size: 14px;
        font-weight: 800;
        word-break: break-word;
    }

    .rtse-result-marks-title {
        margin: 18px 0 10px;
        font-size: 16px;
        color: #172554;
    }

    .rtse-result-mark-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rtse-result-mark-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 10px;
        align-items: center;
        padding: 12px 13px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
    }

    .rtse-result-mark-name {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
    }

    .rtse-result-mark-obtained {
        font-size: 14px;
        font-weight: 800;
        color: #174a86;
    }

    .rtse-result-mark-full {
        font-size: 12px;
        color: #64748b;
        white-space: nowrap;
    }

    .rtse-result-total-card {
        margin-top: 15px;
        padding: 18px;
        border-radius: 17px;
        background:
            linear-gradient(135deg, #eff6ff 0%, #f5f3ff 55%, #fffbeb 100%);
        border: 1px solid #dbeafe;
        text-align: center;
    }

    .rtse-result-total-label {
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .rtse-result-total-value {
        margin-top: 5px;
        color: #0f2a5f;
        font-size: 30px;
        font-weight: 900;
    }

    .rtse-result-total-value span {
        font-size: 15px;
        color: #64748b;
        font-weight: 700;
    }

    .rtse-result-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 10px;
    }

    .rtse-result-summary-box {
        padding: 14px 10px;
        border-radius: 13px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .rtse-result-summary-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .rtse-result-summary-value {
        display: block;
        margin-top: 4px;
        color: #111827;
        font-size: 20px;
        font-weight: 900;
    }

    .rtse-result-grade {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        color: #92400e;
        border-color: #fcd34d;
    }

    .rtse-result-status {
        margin-top: 12px;
        text-align: center;
        font-size: 12px;
        color: #64748b;
    }

    .rtse-result-loading,
    .rtse-result-error {
        padding: 50px 25px;
        text-align: center;
        color: #475569;
    }

    .rtse-result-error {
        color: #991b1b;
    }

    @media (max-width: 600px) {
        .rtse-result-modal {
            padding: 8px;
        }

        .rtse-result-modal-card {
            max-height: calc(100vh - 16px);
            border-radius: 20px;
        }

        .rtse-result-hero {
            padding: 27px 17px 21px;
        }

        .rtse-result-congrats {
            font-size: 23px;
        }

        .rtse-result-body {
            padding: 15px;
        }

        .rtse-result-identity {
            grid-template-columns: 1fr;
        }

        .rtse-result-mark-row {
            grid-template-columns: 1fr auto;
        }

        .rtse-result-mark-full {
            grid-column: 2;
            grid-row: 1;
        }

        .rtse-result-mark-obtained {
            grid-column: 2;
            grid-row: 2;
        }

        .rtse-result-mark-name {
            grid-column: 1;
            grid-row: 1 / span 2;
            align-self: center;
        }
    }

</style>

<div class="rtse-student-dashboard">

    <div class="rtse-dashboard-container">

        <div class="rtse-dashboard-header">

            <h1>
                RTSE Student Dashboard
            </h1>

            <p>
                RTSE <%= application.application_year %>
                — Application Status
            </p>

        </div>


        <div class="rtse-student-card">

            <h2>
                Student Information
            </h2>

            <div class="rtse-info-grid">

                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Student Name
                    </span>

                    <span class="rtse-info-value">
                        <%= application.full_name %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Registration Number
                    </span>

                    <span class="rtse-info-value">
                        <%= application.registration_no %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Class
                    </span>

                    <span class="rtse-info-value">
                        Class <%= application.class %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Section
                    </span>

                    <span class="rtse-info-value">
                        Section <%= application.section %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        School
                    </span>

                    <span class="rtse-info-value">
                        <%= application.school_name %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Application Year
                    </span>

                    <span class="rtse-info-value">
                        <%= application.application_year %>
                    </span>
                </div>

            </div>

        </div>


        <div class="rtse-status-card">

            <h2>
                APPLICATION STATUS
            </h2>

            <%
                const status =
                    String(application.status || "").toLowerCase();

                let statusClass = "other";

                if (status === "pending") {
                    statusClass = "pending";
                } else if (status === "approved") {
                    statusClass = "approved";
                } else if (status === "rejected") {
                    statusClass = "rejected";
                }
            %>

            <span class="rtse-status <%= statusClass %>">

                <% if (status === "pending") { %>
                    🟠 Pending Approval
                <% } else if (status === "approved") { %>
                    🟢 Approved
                <% } else if (status === "rejected") { %>
                    🔴 Rejected
                <% } else { %>
                    <%= application.status || "Unknown" %>
                <% } %>

            </span>

            
            <% if (String(application.status || "").toLowerCase() === "approved") { %>

                <div class="rtse-approved-slip-action">

                    <a
                        href="/rtse/student/approved-slip"
                        class="rtse-approved-slip-button"
                    >
                        ✓ View Approved Examination Slip
                    </a>

                </div>

            <% } %>

<div class="rtse-student-services">

                <h2>RTSE Student Services</h2>

                <div class="rtse-services-grid">

                    <div
                        class="rtse-service-card"
                        id="rtseLoginInformationPdfCard"
                    >
                        <span class="rtse-service-icon">🔐</span>

                        <span class="rtse-service-title">
                            Login Information PDF
                        </span>

                        <span class="rtse-service-description">
                            Prepare and view your RTSE student login information PDF
                        </span>

                        <div
                            id="rtseLoginInformationPdfActions"
                            style="margin-top:12px;"
                        >
                            <button
                                type="button"
                                id="rtseLoginInformationPdfPrepare"
                                style="border:0;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;cursor:pointer;width:100%;"
                            >
                                Prepare Login Information PDF
                            </button>
                        </div>
                    </div>



                    <a
                        href="/rtse/student/registration-slip"
                        class="rtse-service-card"
                    >
                        <span class="rtse-service-icon">📄</span>
                        <span class="rtse-service-title">
                            Registration Slip
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE registration slip
                        </span>
                    </a>

<% if (rtseSetting && Number(rtseSetting.result_publish) === 1) { %>
                    <button
                        type="button"
                        class="rtse-service-card rtse-result-trigger"
                        id="rtseResultTrigger"
                    >
                        <span class="rtse-service-icon">📊</span>
                        <span class="rtse-service-title">
                            Examination Result
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE result and marks
                        </span>
                    </button>

<% } %>
<% if (rtseSetting && Number(rtseSetting.certificate_publish) === 1) { %>
                    <a
                        href="/rtse/student/certificate"
                        class="rtse-service-card"
                    >
                        <span class="rtse-service-icon">🏆</span>
                        <span class="rtse-service-title">
                            Certificate
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE certificate
                        </span>
                    </a>

<% } %>
                    <% if (rtseSetting && Number(rtseSetting.admit_publish) === 1) { %>
                    <a
                        href="/rtse/student/admit-card"
                        class="rtse-service-card"
                        id="rtseAdmitCardTrigger"
                    >
                        <span class="rtse-service-icon">🎫</span>
                        <span class="rtse-service-title">
                            Admit Card
                        </span>
                        <span class="rtse-service-description">
                            View and print your RTSE admit card
                        </span>
                    </a>
                    <% } %>

                    <% if (String(application.status || "").toLowerCase() === "approved") { %>

                        <a
                            href="/rtse/student/approved-slip"
                            class="rtse-service-card"
                        >
                            <span class="rtse-service-icon">🎫</span>
                            <span class="rtse-service-title">
                                Approved Examination Slip
                            </span>
                            <span class="rtse-service-description">
                                View your approved examination slip
                            </span>
                        </a>

                    <% } %>

                </div>

            </div>

            <div class="rtse-dashboard-actions">

                <a
                    href="/rtse/student/logout"
                    class="rtse-logout"
                >
                    Logout
                </a>

            </div>

        </div>

    </div>

</div>


<!-- =====================================
     RTSE STUDENT EXAMINATION RESULT MODAL
     ===================================== -->
<div
    id="rtseResultModal"
    class="rtse-result-modal"
    aria-hidden="true"
>
    <div
        class="rtse-result-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="rtseResultCongrats"
    >
        <div class="rtse-result-hero">
            <button
                type="button"
                class="rtse-result-close"
                id="rtseResultClose"
                aria-label="Close examination result"
            >×</button>

            <div class="rtse-result-confetti">🎉 🏆 🎉</div>

            <h2
                class="rtse-result-congrats"
                id="rtseResultCongrats"
            >
                Congratulations!
            </h2>

            <p class="rtse-result-subtitle">
                Your RTSE examination result is now available
            </p>

            <div class="rtse-result-photo-wrap">
                <img
                    id="rtseResultPhoto"
                    class="rtse-result-photo"
                    alt="Student Photo"
                >
            </div>
        </div>

