<%- include("../partials/rtse-student-header") %>

<style>

    .rtse-student-dashboard {
        min-height: calc(100vh - 160px);
        background: #f5f7fb;
        padding: 25px 15px;
    }

    .rtse-dashboard-container {
        max-width: 850px;
        margin: auto;
    }

    .rtse-dashboard-header {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-dashboard-header h1 {
        margin: 0;
        font-size: 25px;
    }

    .rtse-dashboard-header p {
        margin: 6px 0 0;
        color: #666;
        font-size: 14px;
    }

    .rtse-student-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-student-card h2 {
        margin-top: 0;
        font-size: 19px;
    }

    .rtse-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .rtse-info-item {
        background: #f8fafc;
        border-radius: 9px;
        padding: 12px;
    }

    .rtse-info-label {
        display: block;
        color: #777;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .rtse-info-value {
        font-weight: 600;
        font-size: 14px;
    }

    .rtse-status-card {
        text-align: center;
        border-radius: 15px;
        padding: 25px;
        background: #ffffff;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-status-card h2 {
        margin: 0 0 15px;
        font-size: 18px;
    }

    .rtse-status {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 15px;
    }

    .rtse-status.pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .rtse-status.approved {
        background: #dcfce7;
        color: #166534;
    }

    .rtse-status.rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .rtse-status.other {
        background: #e5e7eb;
        color: #374151;
    }

    .rtse-dashboard-actions {
        text-align: center;
        margin-top: 20px;
    }

    .rtse-logout {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 8px;
        background: #374151;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
    }


    .rtse-student-services {
        background: #ffffff;
        border-radius: 15px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 25px rgba(0,0,0,.07);
    }

    .rtse-student-services h2 {
        margin: 0 0 16px;
        font-size: 19px;
    }

    .rtse-services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .rtse-service-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: inherit;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .rtse-service-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .rtse-service-icon {
        font-size: 25px;
    }

    .rtse-service-title {
        font-weight: 700;
        font-size: 15px;
    }

    .rtse-service-description {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.4;
    }

    @media (max-width: 600px) {

        .rtse-info-grid {
            grid-template-columns: 1fr;
        }

        .rtse-services-grid {
            grid-template-columns: 1fr;
        }

        .rtse-student-services {
            padding: 17px;
        }

        .rtse-dashboard-header h1 {
            font-size: 21px;
        }

        .rtse-student-card,
        .rtse-dashboard-header,
        .rtse-status-card {
            padding: 17px;
        }

    }

    /* =====================================
       RTSE Admit Card Verification Modal
       ===================================== */

    .rtse-admit-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(15, 23, 42, .62);
        padding: 20px;
        overflow-y: auto;
        align-items: center;
        justify-content: center;
    }

    .rtse-admit-modal.is-open {
        display: flex;
    }

    .rtse-admit-modal-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 20px 60px rgba(0,0,0,.22);
        padding: 24px;
        position: relative;
    }

    .rtse-admit-modal-close {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #475569;
        font-size: 21px;
        cursor: pointer;
        line-height: 1;
    }

    .rtse-admit-modal-title {
        margin: 0 35px 6px 0;
        font-size: 20px;
        color: #111827;
    }

    .rtse-admit-modal-subtitle {
        margin: 0 0 20px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .rtse-admit-step {
        display: none;
    }

    .rtse-admit-step.active {
        display: block;
    }

    .rtse-admit-step-label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #374151;
    }

    .rtse-admit-mobile-input,
    .rtse-admit-otp-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 13px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
    }

    .rtse-admit-mobile-input:focus,
    .rtse-admit-otp-input:focus {
        border-color: #64748b;
        box-shadow: 0 0 0 3px rgba(100,116,139,.12);
    }

    .rtse-admit-primary-button {
        width: 100%;
        margin-top: 14px;
        padding: 12px 16px;
        border: 0;
        border-radius: 9px;
        background: #111827;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .rtse-admit-primary-button:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .rtse-admit-secondary-button {
        width: 100%;
        margin-top: 9px;
        padding: 10px 16px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #ffffff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .rtse-admit-google-box {
        min-height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .rtse-admit-google-status {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
        line-height: 1.45;
        text-align: center;
    }

    .rtse-admit-message {
        display: none;
        margin-bottom: 14px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 12px;
        line-height: 1.45;
    }

    .rtse-admit-message.show {
        display: block;
    }

    .rtse-admit-success {
        text-align: center;
    }

    .rtse-admit-success-icon {
        font-size: 42px;
        margin-bottom: 8px;
    }

    .rtse-admit-countdown {
        margin-top: 10px;
        color: #64748b;
        font-size: 12px;
    }

    @media (max-width: 600px) {
        .rtse-admit-modal {
            padding: 12px;
        }

        .rtse-admit-modal-card {
            padding: 20px;
            border-radius: 15px;
        }
    }

</style>

<div class="rtse-student-dashboard">

    <div class="rtse-dashboard-container">

        <div class="rtse-dashboard-header">

            <h1>
                RTSE Student Dashboard
            </h1>

            <p>
                RTSE <%= application.application_year %>
                — Application Status
            </p>

        </div>


        <div class="rtse-student-card">

            <h2>
                Student Information
            </h2>

            <div class="rtse-info-grid">

                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Student Name
                    </span>

                    <span class="rtse-info-value">
                        <%= application.full_name %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Registration Number
                    </span>

                    <span class="rtse-info-value">
                        <%= application.registration_no %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Class
                    </span>

                    <span class="rtse-info-value">
                        Class <%= application.class %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Section
                    </span>

                    <span class="rtse-info-value">
                        Section <%= application.section %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        School
                    </span>

                    <span class="rtse-info-value">
                        <%= application.school_name %>
                    </span>
                </div>


                <div class="rtse-info-item">
                    <span class="rtse-info-label">
                        Application Year
                    </span>

                    <span class="rtse-info-value">
                        <%= application.application_year %>
                    </span>
                </div>

            </div>

        </div>


        <div class="rtse-status-card">

            <h2>
                APPLICATION STATUS
            </h2>

            <%
                const status =
                    String(application.status || "").toLowerCase();

                let statusClass = "other";

                if (status === "pending") {
                    statusClass = "pending";
                } else if (status === "approved") {
                    statusClass = "approved";
                } else if (status === "rejected") {
                    statusClass = "rejected";
                }
            %>

            <span class="rtse-status <%= statusClass %>">

                <% if (status === "pending") { %>
                    🟠 Pending Approval
                <% } else if (status === "approved") { %>
                    🟢 Approved
                <% } else if (status === "rejected") { %>
                    🔴 Rejected
                <% } else { %>
                    <%= application.status || "Unknown" %>
                <% } %>

            </span>

            
            <% if (String(application.status || "").toLowerCase() === "approved") { %>

                <div class="rtse-approved-slip-action">

                    <a
                        href="/rtse/student/approved-slip"
                        class="rtse-approved-slip-button"
                    >
                        ✓ View Approved Examination Slip
                    </a>

                </div>

            <% } %>

<div class="rtse-student-services">

                <h2>RTSE Student Services</h2>

                <div class="rtse-services-grid">

                    <div
                        class="rtse-service-card"
                        id="rtseLoginInformationPdfCard"
                    >
                        <span class="rtse-service-icon">🔐</span>

                        <span class="rtse-service-title">
                            Login Information PDF
                        </span>

                        <span class="rtse-service-description">
                            Prepare and view your RTSE student login information PDF
                        </span>

                        <div
                            id="rtseLoginInformationPdfActions"
                            style="margin-top:12px;"
                        >
                            <button
                                type="button"
                                id="rtseLoginInformationPdfPrepare"
                                style="border:0;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;cursor:pointer;width:100%;"
                            >
                                Prepare Login Information PDF
                            </button>
                        </div>
                    </div>



                    <a
                        href="/rtse/student/registration-slip"
                        class="rtse-service-card"
                    >
                        <span class="rtse-service-icon">📄</span>
                        <span class="rtse-service-title">
                            Registration Slip
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE registration slip
                        </span>
                    </a>

                    <a
                        href="/rtse/student/result"
                        class="rtse-service-card"
                    >
                        <span class="rtse-service-icon">📊</span>
                        <span class="rtse-service-title">
                            Examination Result
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE result and marks
                        </span>
                    </a>

                    <a
                        href="/rtse/student/certificate"
                        class="rtse-service-card"
                    >
                        <span class="rtse-service-icon">🏆</span>
                        <span class="rtse-service-title">
                            Certificate
                        </span>
                        <span class="rtse-service-description">
                            View your RTSE certificate
                        </span>
                    </a>

                    <% if (rtseSetting && Number(rtseSetting.admit_publish) === 1) { %>
                    <a
                        href="/rtse/student/admit-card"
                        class="rtse-service-card"
                        id="rtseAdmitCardTrigger"
                    >
                        <span class="rtse-service-icon">🎫</span>
                        <span class="rtse-service-title">
                            Admit Card
                        </span>
                        <span class="rtse-service-description">
                            View and print your RTSE admit card
                        </span>
                    </a>
                    <% } %>

                    <% if (String(application.status || "").toLowerCase() === "approved") { %>

                        <a
                            href="/rtse/student/approved-slip"
                            class="rtse-service-card"
                        >
                            <span class="rtse-service-icon">🎫</span>
                            <span class="rtse-service-title">
                                Approved Examination Slip
                            </span>
                            <span class="rtse-service-description">
                                View your approved examination slip
                            </span>
                        </a>

                    <% } %>

                </div>

            </div>

            <div class="rtse-dashboard-actions">

                <a
                    href="/rtse/student/logout"
                    class="rtse-logout"
                >
                    Logout
                </a>

            </div>

        </div>

    </div>

</div>

<!-- =====================================
     RTSE Admit Card Verification Modal
     ===================================== -->

<div
    class="rtse-admit-modal"
    id="rtseAdmitVerificationModal"
    aria-hidden="true"
>
    <div
        class="rtse-admit-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="rtseAdmitModalTitle"
    >

        <button
            type="button"
            class="rtse-admit-modal-close"
            id="rtseAdmitModalClose"
            aria-label="Close"
        >
            ×
        </button>

        <h2
            class="rtse-admit-modal-title"
            id="rtseAdmitModalTitle"
        >
            Admit Card Verification
        </h2>

        <p class="rtse-admit-modal-subtitle">
            Select your Google account, then enter your name and mobile number before accessing the admit card.
        </p>

        <div
            class="rtse-admit-message"
            id="rtseAdmitVerificationMessage"
        ></div>

        <!-- STEP 1: GOOGLE -->

        <div
            class="rtse-admit-step active"
            id="rtseAdmitGoogleStep"
        >

            <span class="rtse-admit-step-label">
                Step 1 — Select your Google account
            </span>

            <div
                class="rtse-admit-google-box"
                id="rtseAdmitGoogleButton"
            ></div>

            <div class="rtse-admit-google-status">
                Select the Google account you want recorded with this admit-card access.
            </div>

        </div>

        <!-- STEP 2: NAME + MOBILE -->

        <div
            class="rtse-admit-step"
            id="rtseAdmitDetailsStep"
        >

            <span class="rtse-admit-step-label">
                Step 2 — Enter your details
            </span>

            <p
                class="rtse-admit-modal-subtitle"
                id="rtseAdmitGoogleInfo"
            >
                Google account verified.
            </p>

            <input
                type="text"
                id="rtseAdmitNameInput"
                class="rtse-admit-mobile-input"
                autocomplete="name"
                maxlength="255"
                placeholder="Enter your name"
            >

            <input
                type="tel"
                id="rtseAdmitMobileInput"
                class="rtse-admit-mobile-input"
                inputmode="numeric"
                autocomplete="tel"
                maxlength="10"
                placeholder="10-digit mobile number"
            >

            <button
                type="button"
                class="rtse-admit-primary-button"
                id="rtseAdmitAuthorize"
            >
                Continue to Admit Card
            </button>

        </div>

        <!-- STEP 3: SUCCESS -->

        <div
            class="rtse-admit-step"
            id="rtseAdmitSuccessStep"
        >

            <div class="rtse-admit-success">

                <div class="rtse-admit-success-icon">
                    ✅
                </div>

                <h3>
                    Verification successful
                </h3>

                <p class="rtse-admit-modal-subtitle">
                    Your admit-card access has been authorized.
                </p>

                <button
                    type="button"
                    class="rtse-admit-primary-button"
                    id="rtseAdmitContinue"
                >
                    Continue to Admit Card
                </button>

                <div
                    class="rtse-admit-countdown"
                    id="rtseAdmitCountdown"
                ></div>

            </div>

        </div>

    </div>
</div>

<script src="https://accounts.google.com/gsi/client" async defer></script>

<script>
(function () {
    "use strict";

    const actions =
        document.getElementById("rtseLoginInformationPdfActions");

    if (!actions) {
        return;
    }

    function renderPrepare() {
        actions.innerHTML = `
            <button
                type="button"
                id="rtseLoginInformationPdfPrepare"
                style="border:0;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;cursor:pointer;width:100%;"
            >
                Prepare Login Information PDF
            </button>
        `;

        const button =
            document.getElementById("rtseLoginInformationPdfPrepare");

        if (button) {
            button.addEventListener(
                "click",
                prepare
            );
        }
    }

    function renderPrepared() {
        actions.innerHTML = `
            <div style="display:grid;gap:8px;">
                <a
                    href="/rtse/student/login-information-pdf"
                    style="display:block;text-align:center;text-decoration:none;border-radius:9px;padding:9px 12px;background:#174a86;color:#fff;font-weight:700;"
                >
                    View Login Information PDF
                </a>

                <button
                    type="button"
                    id="rtseLoginInformationPdfReset"
                    style="border:1px solid #174a86;border-radius:9px;padding:8px 12px;background:#fff;color:#174a86;font-weight:700;cursor:pointer;"
                >
                    Reset Login Information
                </button>
            </div>
        `;

        const resetButton =
            document.getElementById(
                "rtseLoginInformationPdfReset"
            );

        if (!resetButton) {
            return;
        }

        resetButton.addEventListener(
            "click",
            async function () {

                if (!window.confirm(
                    "Reset the prepared Login Information PDF? Your RTSE application data will not be changed."
                )) {
                    return;
                }

                resetButton.disabled = true;
                resetButton.textContent = "Resetting...";

                try {
                    const response = await fetch(
                        "/rtse/student/login-information-pdf/reset",
                        {
                            method: "POST",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    );

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(
                            data.message ||
                            "Unable to reset PDF."
                        );
                    }

                    renderPrepare();

                } catch (error) {

                    resetButton.disabled = false;
                    resetButton.textContent =
                        "Reset Login Information";

                    window.alert(error.message);
                }
            }
        );
    }

    async function prepare() {

        const button =
            document.getElementById(
                "rtseLoginInformationPdfPrepare"
            );

        if (!button) {
            return;
        }

        button.disabled = true;
        button.textContent = "Preparing PDF...";

        try {
            const response = await fetch(
                "/rtse/student/login-information-pdf/prepare",
                {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message ||
                    "Unable to prepare PDF."
                );
            }

            renderPrepared();

        } catch (error) {

            button.disabled = false;
            button.textContent =
                "Prepare Login Information PDF";

            window.alert(error.message);
        }
    }

    async function loadStatus() {

        try {
            const response = await fetch(
                "/rtse/student/login-information-pdf/status",
                {
                    cache: "no-store"
                }
            );

            if (!response.ok) {
                renderPrepare();
                return;
            }

            const data = await response.json();

            if (
                data.success &&
                data.prepared
            ) {
                renderPrepared();
            } else {
                renderPrepare();
            }

        } catch (_) {
            renderPrepare();
        }
    }

    loadStatus();

})();
</script>


<script>
(function () {
    "use strict";

    const trigger =
        document.getElementById("rtseAdmitCardTrigger");

    const modal =
        document.getElementById("rtseAdmitVerificationModal");

    const closeButton =
        document.getElementById("rtseAdmitModalClose");

    const message =
        document.getElementById("rtseAdmitVerificationMessage");

    const googleStep =
        document.getElementById("rtseAdmitGoogleStep");

    const detailsStep =
        document.getElementById("rtseAdmitDetailsStep");

    const successStep =
        document.getElementById("rtseAdmitSuccessStep");

    const googleButton =
        document.getElementById("rtseAdmitGoogleButton");

    const googleInfo =
        document.getElementById("rtseAdmitGoogleInfo");

    const nameInput =
        document.getElementById("rtseAdmitNameInput");

    const mobileInput =
        document.getElementById("rtseAdmitMobileInput");

    const authorizeButton =
        document.getElementById("rtseAdmitAuthorize");

    const continueButton =
        document.getElementById("rtseAdmitContinue");

    const countdown =
        document.getElementById("rtseAdmitCountdown");

    if (!trigger || !modal) {
        return;
    }

    let countdownTimer = null;

    function showMessage(text) {
        message.textContent = text || "";
        message.classList.toggle(
            "show",
            Boolean(text)
        );
    }

    function clearMessage() {
        showMessage("");
    }

    function showStep(step) {
        googleStep.classList.remove("active");
        detailsStep.classList.remove("active");
        successStep.classList.remove("active");

        step.classList.add("active");
    }

    function resetModal() {
        clearMessage();

        showStep(googleStep);

        nameInput.value = "";
        mobileInput.value = "";

        authorizeButton.disabled = false;

        googleInfo.textContent =
            "Google account verified.";

        countdown.textContent = "";

        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    }

    function openModal() {
        resetModal();

        modal.classList.add("is-open");
        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        renderGoogleButton();
    }

    function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    }

    async function postJson(url, data) {
        const response = await fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            credentials: "same-origin",
            body: JSON.stringify(data || {})
        });

        let result = {};

        try {
            result = await response.json();
        } catch (error) {
            result = {};
        }

        if (!response.ok || !result.success) {
            throw new Error(
                result.message ||
                "The verification request failed."
            );
        }

        return result;
    }

    function startCountdown(seconds) {
        let remaining = Number(seconds || 0);

        if (countdownTimer) {
            clearInterval(countdownTimer);
        }

        function update() {
            if (remaining <= 0) {
                countdown.textContent =
                    "Authorization has expired. Please start again.";

                clearInterval(countdownTimer);
                countdownTimer = null;

                return;
            }

            countdown.textContent =
                "Authorization expires in " +
                remaining +
                " seconds.";

            remaining -= 1;
        }

        update();

        countdownTimer =
            setInterval(update, 1000);
    }

    function handleGoogleCredential(response) {
        clearMessage();

        if (
            !response ||
            !response.credential
        ) {
            showMessage(
                "Google authentication did not return a valid credential."
            );

            return;
        }

        postJson(
            "/rtse/student/admit-download/google",
            {
                credential:
                    response.credential
            }
        )
        .then(function (result) {
            showStep(detailsStep);

            if (
                result.google &&
                result.google.email
            ) {
                googleInfo.textContent =
                    "Google account verified: " +
                    result.google.email +
                    ". Now enter your name and mobile number.";
            }

            nameInput.focus();
        })
        .catch(function (error) {
            showMessage(
                error.message ||
                "Unable to verify the Google account."
            );
        });
    }

    function renderGoogleButton() {
        if (
            !window.google ||
            !window.google.accounts ||
            !window.google.accounts.id
        ) {
            googleButton.innerHTML =
                "<span style='font-size:12px;color:#64748b'>Loading Google authentication…</span>";

            setTimeout(
                renderGoogleButton,
                500
            );

            return;
        }

        const clientId =
            "<%= typeof googleClientId !== 'undefined' ? googleClientId : '' %>";

        if (!clientId) {
            googleButton.innerHTML =
                "<span style='font-size:12px;color:#991b1b'>Google authentication is not configured.</span>";

            return;
        }

        google.accounts.id.initialize({
            client_id: clientId,
            callback: handleGoogleCredential,
            ux_mode: "popup"
        });

        googleButton.innerHTML = "";

        google.accounts.id.renderButton(
            googleButton,
            {
                theme: "outline",
                size: "large",
                text: "signin_with",
                shape: "rectangular",
                width: 320
            }
        );
    }

    trigger.addEventListener(
        "click",
        function (event) {
            event.preventDefault();
            openModal();
        }
    );

    closeButton.addEventListener(
        "click",
        closeModal
    );

    modal.addEventListener(
        "click",
        function (event) {
            if (event.target === modal) {
                closeModal();
            }
        }
    );

    document.addEventListener(
        "keydown",
        function (event) {
            if (
                event.key === "Escape" &&
                modal.classList.contains("is-open")
            ) {
                closeModal();
            }
        }
    );

    authorizeButton.addEventListener(
        "click",
        async function () {
            clearMessage();

            const name =
                String(nameInput.value || "")
                    .replace(/\s+/g, " ")
                    .trim();

            const mobile =
                String(mobileInput.value || "")
                    .replace(/\D/g, "");

            if (name.length < 2) {
                showMessage(
                    "Please enter your name."
                );

                nameInput.focus();
                return;
            }

            if (name.length > 255) {
                showMessage(
                    "Name is too long."
                );

                nameInput.focus();
                return;
            }

            if (!/^[6-9]\d{9}$/.test(mobile)) {
                showMessage(
                    "Please enter a valid 10-digit Indian mobile number."
                );

                mobileInput.focus();
                return;
            }

            authorizeButton.disabled = true;

            try {
                const result =
                    await postJson(
                        "/rtse/student/admit-download/details",
                        {
                            name: name,
                            mobile: mobile
                        }
                    );

                showStep(successStep);

                startCountdown(
                    result.expiresInSeconds || 600
                );
            } catch (error) {
                showMessage(
                    error.message ||
                    "Unable to authorize admit-card access."
                );

                authorizeButton.disabled = false;
            }
        }
    );

    continueButton.addEventListener(
        "click",
        function () {
            window.location.href =
                "/rtse/student/admit-card";
        }
    );
})();
</script>




