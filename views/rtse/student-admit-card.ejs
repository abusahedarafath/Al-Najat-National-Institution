<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>RTSE Hall Ticket</title>

<style>

*{
    box-sizing:border-box;
    -webkit-print-color-adjust:exact !important;
    print-color-adjust:exact !important;
}

html,
body{
    margin:0;
    padding:0;
    background:#e9eef5;
    color:#102b50;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    padding:10px;
}

/* =========================================================
   A4 MASTER PAGE
========================================================= */

.admit-page{
    width:210mm;
    height:297mm;
    margin:0 auto;
    padding:4mm;

    display:grid;
    grid-template-rows:155mm 1fr;
    gap:3mm;

    background:#fff;
}

/* =========================================================
   COMMON SECTION
========================================================= */

.ticket-section{
    position:relative;
    min-height:0;
    overflow:hidden;

    border:1.2px solid #174a86;
    border-radius:4mm;

    background:
        radial-gradient(
            circle at 94% 12%,
            rgba(27,91,158,.09),
            transparent 24%
        ),
        linear-gradient(
            135deg,
            #ffffff 0%,
            #f8fbff 100%
        );

    box-shadow:0 1px 3px rgba(16,43,80,.12);

    padding:4mm;
}

/* Decorative blue corner */

.ticket-section::after{
    content:"";
    position:absolute;
    right:-15mm;
    bottom:-20mm;

    width:50mm;
    height:45mm;

    border-radius:50%;
    border:7mm solid rgba(23,74,134,.06);

    pointer-events:none;
}

/* =========================================================
   HALL TICKET HEADER
========================================================= */

.ticket-header{
    position:relative;
    z-index:2;

    height:24mm;

    display:grid;
    grid-template-columns:25mm 1fr 30mm;

    align-items:center;

    border-bottom:1px solid #c8d7e8;
}

.logo-wrap{
    display:flex;
    justify-content:center;
    align-items:center;
}

.logo{
    width:20mm;
    height:20mm;

    object-fit:contain;
}

.header-title{
    text-align:center;
    padding:0 2mm;
}

.header-title h1{
    margin:0;

    color:#123e73;

    font-size:5.4mm;
    line-height:1.05;

    font-weight:900;
    letter-spacing:.2px;
}

.header-title .organised{
    margin-top:1.5mm;

    font-size:3.1mm;
    color:#34465c;
}

.header-title .organised strong{
    color:#174f91;
}

.header-title .exam-year{
    margin-top:.7mm;

    font-size:2.6mm;
    font-weight:bold;
    color:#174f91;
}

.header-side{
    text-align:right;
    padding-right:1mm;
}

.header-side .arsp{
    font-size:5.5mm;
    font-weight:900;
    color:#174f91;
    letter-spacing:.5px;
}

.header-side .tagline{
    margin-top:1mm;
    font-size:2.2mm;
    line-height:1.3;
    color:#52657b;
}

/* =========================================================
   HALL TICKET TITLE
========================================================= */

.ticket-title{
    height:9mm;

    display:flex;
    align-items:center;
    justify-content:center;

    margin:2.5mm 0 2.5mm;
}

.ticket-title::before,
.ticket-title::after{
    content:"";
    height:1px;
    flex:1;
    background:#2d659e;
}

.ticket-title span{
    margin:0 4mm;

    min-width:48mm;

    padding:1.7mm 6mm;

    text-align:center;

    color:#fff;
    background:#174a86;

    font-size:4mm;
    font-weight:900;

    letter-spacing:.6px;

    clip-path:polygon(
        5% 0,
        95% 0,
        100% 50%,
        95% 100%,
        5% 100%,
        0 50%
    );
}

/* =========================================================
   CANDIDATE AREA
========================================================= */

.candidate-area{
    display:grid;

    grid-template-columns:minmax(0,1fr) 29mm;

    gap:2.5mm;

    min-height:0;
}

/* =========================================================
   CANDIDATE DETAILS
========================================================= */

.identity-column{
    min-width:0;
}

.id-row{
    display:grid;

    grid-template-columns:31mm 4mm minmax(0,1fr);

    min-height:5.1mm;

    border-bottom:1px dotted #b9c8d8;
}

.id-label{
    padding:1mm 1.5mm;

    background:#eaf2fb;

    border-left:1.1mm solid #174a86;

    color:#174a86;

    font-size:2.35mm;
    font-weight:800;

    display:flex;
    align-items:center;
}

.id-colon{
    display:flex;
    align-items:center;
    justify-content:center;

    font-size:2.5mm;
    font-weight:bold;
}

.id-value{
    padding:1mm 1.5mm;

    color:#172d48;

    font-size:2.55mm;
    font-weight:600;

    display:flex;
    align-items:center;

    min-width:0;

    overflow:hidden;
    white-space:nowrap;
    text-overflow:ellipsis;
}

/* =========================================================
   PHOTO + QR PANEL
========================================================= */

.identity-column-right{
    min-width:0;

    display:flex;
    flex-direction:column;
    align-items:center;

    gap:2mm;
}

.photo-frame{
    width:24mm;
    height:26mm;

    padding:1mm;

    background:#fff;

    border:1px solid #174a86;
    border-radius:2.5mm;

    box-shadow:0 1px 2px rgba(0,0,0,.15);

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.photo-frame img{
    width:100%;
    height:100%;

    object-fit:cover;

    display:block;
}

.qr-frame{
    width:24mm;
    height:24mm;

    padding:1.2mm;

    background:#fff;

    border:1px solid #174a86;
    border-radius:2.5mm;

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.qr-frame img{
    display:block;

    width:100%;
    height:100%;

    max-width:100%;
    max-height:100%;

    object-fit:contain;

    image-rendering:auto;

    background:#fff;
}

.qr-label{
    width:24mm;

    margin-top:-1mm;

    padding:.9mm 0;

    text-align:center;

    background:#174a86;
    color:#fff;

    border-radius:1mm;

    font-size:1.8mm;
    font-weight:900;

    letter-spacing:.2px;
}

.qr-warning{
    display:none;
}

/* =========================================================
   EXAMINATION DETAILS
========================================================= */

.exam-information{
    display:grid;

    grid-template-columns:1fr 1.2fr 1fr;

    gap:1.5mm;

    margin-top:2mm;

    padding-top:2mm;

    border-top:1px solid #8da8c4;
}

.exam-box{
    min-height:10.5mm;

    padding:1.5mm;

    border:1px solid #174a86;
    border-radius:1.8mm;

    background:#f8fbff;

    display:flex;
    flex-direction:column;
    justify-content:center;
}

.exam-label{
    color:#174a86;

    font-size:2mm;
    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.2px;
}

.exam-value{
    margin-top:1mm;

    color:#162c47;

    font-size:2.5mm;
    font-weight:700;

    line-height:1.2;

    min-height:3mm;
}

/* =========================================================
   IMPORTANT STRIP
========================================================= */

.important-strip{
    position:relative;

    width:100%;
    margin-top:2mm;

    min-height:6.5mm;

    display:flex;
    align-items:center;

    padding:1.5mm 2.5mm;

    border:1px solid #174a86;
    border-radius:1.5mm;

    background:#edf5fd;

    color:#17324f;

    font-size:2.15mm;
    font-weight:600;
}

.important-strip strong{
    color:#174a86;
    margin-right:1mm;
}

/* =========================================================
   CONTROLLER SIGNATURE
========================================================= */

.ticket-footer{
    position:relative;

    width:100%;
    min-height:8mm;

    margin-top:2mm;

    display:flex;
    flex-direction:column;
    align-items:flex-end;
    justify-content:center;

    text-align:center;
}

.signature{
    font-size:2mm;
    color:#34485e;
}

.signature-line{
    width:25mm;
    height:4mm;

    margin:0 auto 1mm;

    border-bottom:1px solid #30465f;
}

.signature strong{
    display:block;

    color:#174a86;

    font-size:2mm;
}

/* =========================================================
   INSTRUCTIONS SECTION
========================================================= */

.instructions-header{
    height:11mm;

    display:flex;
    align-items:center;
    justify-content:center;

    margin-bottom:2mm;
}

.instructions-header::before,
.instructions-header::after{
    content:"";

    height:1px;

    flex:1;

    background:#2d659e;
}

.instructions-header span{
    margin:0 4mm;

    padding:2mm 8mm;

    color:#fff;
    background:#174a86;

    font-size:4mm;
    font-weight:900;

    letter-spacing:.4px;

    clip-path:polygon(
        5% 0,
        95% 0,
        100% 50%,
        95% 100%,
        5% 100%,
        0 50%
    );
}

.instructions-list{
    position:relative;

    padding:0 2mm 0 9mm;
}

.instructions-list::before{
    content:"";

    position:absolute;

    left:4mm;
    top:3mm;
    bottom:13mm;

    width:1px;

    background:#174a86;
}

.instruction{
    position:relative;

    min-height:13mm;

    display:grid;

    grid-template-columns:8mm minmax(0,1fr);

    gap:2mm;

    padding:2mm 0;

    border-bottom:1px dotted #aebfd2;
}

.instruction-number{
    position:relative;
    z-index:2;

    width:6mm;
    height:6mm;

    margin-top:.5mm;

    border-radius:50%;

    background:#174a86;
    color:#fff;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:2.4mm;
    font-weight:900;
}

.instruction-text{
    color:#1b3049;

    font-size:2.35mm;
    line-height:1.45;

    font-weight:500;
}

.instruction-text strong{
    color:#174a86;
    font-weight:900;
}

.instruction-text .danger{
    color:#c62828;
    font-weight:900;
}

/* =========================================================
   BEST OF LUCK
========================================================= */

.best-luck{
    position:absolute;

    left:8mm;
    right:8mm;
    bottom:3.5mm;

    height:8mm;

    border:1px solid #c2d4e7;

    border-radius:2mm;

    background:#eef6ff;

    display:flex;
    align-items:center;
    justify-content:center;
}

.best-luck span{
    min-width:42mm;

    padding:1.7mm 7mm;

    border-radius:4mm;

    background:#174a86;
    color:#fff;

    text-align:center;

    font-size:3.2mm;
    font-weight:900;

    letter-spacing:.5px;
}

/* =========================================================
   CENTRE PORTAL NAVIGATION
========================================================= */

.centre-portal-controls{
    width:210mm;
    margin:10px auto 0;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
}

.centre-portal-controls a{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:40px;
    padding:0 18px;
    border-radius:6px;
    background:#fff;
    color:#174a86;
    border:1px solid #174a86;
    text-decoration:none;
    font-size:14px;
    font-weight:bold;
}

.centre-portal-controls a:hover{
    background:#eef6ff;
}

/* =========================================================
   PRINT BUTTON
========================================================= */

.print-controls{
    width:210mm;

    margin:10px auto;

    text-align:center;
}

.print-controls button{
    border:0;

    padding:10px 20px;

    border-radius:6px;

    background:#174a86;
    color:#fff;

    font-size:14px;
    font-weight:bold;

    cursor:pointer;
}

/* =========================================================
   PRINT
========================================================= */

@page{
    size:A4 portrait;
    margin:0;
}

@media print{

    html,
    body{
        width:210mm !important;
        height:297mm !important;

        margin:0 !important;
        padding:0 !important;

        background:#fff !important;

        overflow:hidden !important;
    }

    body{
        -webkit-print-color-adjust:exact !important;
        print-color-adjust:exact !important;
    }

    .admit-page{
        width:210mm !important;
        height:297mm !important;

        margin:0 !important;

        padding:4mm !important;

        gap:3mm !important;

        box-shadow:none !important;
    }

    .ticket-section{
        break-inside:avoid !important;
        page-break-inside:avoid !important;

        box-shadow:none !important;
    }

    .photo-frame,
    .qr-frame,
    .qr-frame img,
    .important-strip,
    .exam-box,
    .best-luck,
    .ticket-section{
        -webkit-print-color-adjust:exact !important;
        print-color-adjust:exact !important;
    }

    .qr-frame{
        display:flex !important;
        visibility:visible !important;
        opacity:1 !important;
    }

    .qr-frame img{
        display:block !important;
        visibility:visible !important;
        opacity:1 !important;
    }

    .important-strip{
        display:flex !important;
        visibility:visible !important;
        opacity:1 !important;

        color:#17324f !important;
    }

    .print-controls{
        display:none !important;
    }

    .centre-portal-controls{
        display:none !important;
    }
}

</style>
</head>

<body>

<%
    const safeStudent = student || {};

    const registrationNo =
        safeStudent.registration_no || "—";

    const storedRollNo =
        safeStudent.roll_no || "—";

    /*
       Keep the database roll_no unchanged.
       Display it as:
       ROLL — RTSE26
       NO   — 2001

       Supports the existing RTSE26-2001 format and
       also safely handles a value that does not contain "-".
    */
    let rollCode = "—";
    let rollNumber = "—";

    if (
        storedRollNo &&
        String(storedRollNo).trim() !== "—"
    ) {

        const rollParts =
            String(storedRollNo)
                .trim()
                .split("-");

        if (rollParts.length >= 2) {

            rollCode =
                rollParts.shift().trim() || "—";

            rollNumber =
                rollParts.join("-").trim() || "—";

        } else {

            rollCode =
                String(storedRollNo).trim();

            rollNumber = "—";
        }
    }

    const fullName =
        safeStudent.full_name || "—";

    const fatherName =
        safeStudent.father_name || "—";

    const schoolName =
        safeStudent.school_name || "—";

    const studentClass =
        safeStudent.class || "—";

    const section =
        safeStudent.section || "—";

    const photo =
        safeStudent.photo || "";

    /*
       These values are deliberately optional.
       This keeps the page working even when the current
       controller does not provide examSetting.
    */

    const examSettingSafe =
        (typeof examSetting !== "undefined" && examSetting)
            ? examSetting
            : {};

    function formatExamDate(value) {
        if (!value) return "________________";

        const raw = String(value).trim();

        // Prefer the calendar date contained in YYYY-MM-DD values.
        // This avoids UTC timezone conversion changing the displayed day.
        const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);

        if (match) {
            const year = Number(match[1]);
            const month = Number(match[2]);
            const day = Number(match[3]);

            const date = new Date(year, month - 1, day);

            if (
                date.getFullYear() === year &&
                date.getMonth() === month - 1 &&
                date.getDate() === day
            ) {
                return date.toLocaleDateString("en-IN", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                });
            }
        }

        const parsed = new Date(raw);

        if (!Number.isNaN(parsed.getTime())) {
            return parsed.toLocaleDateString("en-IN", {
                day: "numeric",
                month: "long",
                year: "numeric"
            });
        }

        return raw;
    }

    const examinationDate = formatExamDate(
        examSettingSafe.exam_date ||
        examSettingSafe.examination_date ||
        safeStudent.exam_date ||
        safeStudent.examination_date
    );

    const examCentreSafe =
          (typeof examCentre !== "undefined" && examCentre)
              ? examCentre
              : null;

      const examinationCentre =
          examCentreSafe?.centre_name ||
          examCentreSafe?.centre_code ||
          "________________";

      const examShiftSafe =
          (typeof examShift !== "undefined" && examShift)
              ? examShift
              : null;

      const shift =
          examShiftSafe?.shift_name ||
          (
              examShiftSafe?.shift_no
                  ? `Shift ${examShiftSafe.shift_no}`
                  : "________________"
          );

      function formatExamTime(value) {
          if (!value) return "________________";

          const raw = String(value);
          const match = raw.match(/(\d{1,2}):(\d{2})(?::\d{2})?/);

          if (!match) return raw;

          let hour = Number(match[1]);
          const minute = match[2];

          if (!Number.isInteger(hour) || hour < 0 || hour > 23) {
              return raw;
          }

          const suffix = hour >= 12 ? "PM" : "AM";

          hour = hour % 12;
          if (hour === 0) hour = 12;

          return `${hour}:${minute} ${suffix}`;
      }

      const reportingTime =
          formatExamTime(examShiftSafe?.reporting_time);

      const examStartTime =
          formatExamTime(examShiftSafe?.exam_start_time);

      const examEndTime =
          formatExamTime(examShiftSafe?.exam_end_time);

      const examSections =
          Array.isArray(examShiftSafe?.sections)
              ? examShiftSafe.sections
                  .map(item => item?.section || item)
                  .filter(Boolean)
              : [];

      const examinationSections =
          examSections.length
              ? examSections.join(", ")
              : "________________";

      const qrAvailable =
        typeof qrData === "string" &&
        qrData.startsWith("data:image/") &&
        qrData.length > 100;

    const logo =
        (setting && setting.logo)
            ? setting.logo
            : "";
%>

<div class="admit-page">

    <!-- =====================================================
         HALL TICKET
    ====================================================== -->

    <section class="ticket-section">

        <div class="ticket-header">

            <div class="logo-wrap">

                <% if (logo) { %>

                    <img
                        src="/uploads/arsp-settings/<%= logo %>"
                        class="logo"
                        alt="ARSP Logo">

                <% } %>

            </div>

            <div class="header-title">

                <h1>
                    <%= examSettingSafe.exam_name || "RATABARI TALENT SEARCH EXAMINATION" %>
                </h1>

                <div class="organised">
                    Organised by
                    <strong>ARSP</strong>
                </div>

                <div class="exam-year">
                    RTSE <%= examYear || new Date().getFullYear() %>
                </div>

            </div>

            <div class="header-side">

                <div class="arsp">
                    ARSP
                </div>

                <div class="tagline">
                    Education with Purpose<br>
                    Excellence with Integrity
                </div>

            </div>

        </div>


        <div class="ticket-title">
            <span>HALL TICKET</span>
        </div>


        <div class="candidate-area">

            <div class="identity-column">

                <div class="id-row">
                    <div class="id-label">
                        Registration No.
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <%= registrationNo %>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        Roll
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <strong><%= rollCode %></strong>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        No.
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <strong><%= rollNumber %></strong>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        Name
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <%= fullName %>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        Father's Name
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <%= fatherName %>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        School Name
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        <%= schoolName %>
                    </div>
                </div>

                <div class="id-row">
                    <div class="id-label">
                        Class & Section
                    </div>
                    <div class="id-colon">:</div>
                    <div class="id-value">
                        CLASS <%= studentClass %> - <%= section %>
                    </div>
                </div>

            </div>


            <!-- PHOTO + QR -->

            <div class="identity-column-right">

                <% if (photo) { %>

                    <div class="photo-frame">

                        <img
                            src="/uploads/rtse/<%= photo %>"
                            alt="Candidate Photo">

                    </div>

                <% } %>


                <% if (qrAvailable) { %>

                    <div class="qr-frame">

                        <img
                            src="<%= qrData %>"
                            alt="RTSE QR Verification">

                    </div>

                    <div class="qr-label">
                        SCAN FOR VERIFICATION
                    </div>

                <% } %>

            </div>

        </div>


          <!-- EXAMINATION INFORMATION -->

          <div class="exam-information">

              <div class="exam-box">
                  <div class="exam-label">
                      Examination Date
                  </div>
                  <div class="exam-value">
                      <%= examinationDate %>
                  </div>
              </div>

              <div class="exam-box">
                  <div class="exam-label">
                      Examination Centre
                  </div>
                  <div class="exam-value">
                      <%= examinationCentre %>
                  </div>
              </div>

              <div class="exam-box">
                  <div class="exam-label">
                      Shift
                  </div>
                  <div class="exam-value">
                      <%= shift %>
                  </div>
              </div>

              <div class="exam-box">
                  <div class="exam-label">
                      Reporting Time
                  </div>
                  <div class="exam-value">
                      <%= reportingTime %>
                  </div>
              </div>

              <div class="exam-box">
                  <div class="exam-label">
                      Examination Time
                  </div>
                  <div class="exam-value">
                      <%= examStartTime %> – <%= examEndTime %>
                  </div>
              </div>

              <div class="exam-box">
                  <div class="exam-label">
                      Sections
                  </div>
                  <div class="exam-value">
                      <%= examinationSections %>
                  </div>
              </div>

          </div>


<!-- CONTROLLER SIGNATURE -->

        <div class="ticket-footer">

            <div class="signature-line"></div>

            <div class="signature">
                Controller of Examination
            </div>

            <div class="signature">
                <strong>ARSP</strong>
            </div>

        </div>


        <!-- IMPORTANT MESSAGE -->

        <div class="important-strip">

            <strong>IMPORTANT:</strong>

            Bring this Hall Ticket and a valid School ID Card
            to the examination centre.

        </div>

    </section>


    <!-- =====================================================
         IMPORTANT INSTRUCTIONS
    ====================================================== -->

    <section class="ticket-section">

        <div class="instructions-header">

            <span>
                IMPORTANT INSTRUCTIONS
            </span>

        </div>


        <div class="instructions-list">

            <div class="instruction">

                <div class="instruction-number">
                    1
                </div>

                <div class="instruction-text">

                    Carry your School ID Card and Admit Card.
                    Ensure the Admit Card is scanned by the
                    <strong>ARSP Super Scanner</strong>,
                    or you may be marked
                    <span class="danger">ABSENT</span>.

                </div>

            </div>


            <div class="instruction">

                <div class="instruction-number">
                    2
                </div>

                <div class="instruction-text">

                    Report at least
                    <strong>30 minutes</strong>
                    before the reporting time.
                    No entry will be allowed after the gate closes.

                </div>

            </div>


            <div class="instruction">

                <div class="instruction-number">
                    3
                </div>

                <div class="instruction-text">

                    Mobile phones, smart watches, Bluetooth devices,
                    calculators and other electronic devices are
                    <span class="danger">strictly prohibited</span>.
                    Violation may result in expulsion.

                </div>

            </div>


            <div class="instruction">

                <div class="instruction-number">
                    4
                </div>

                <div class="instruction-text">

                    Fill and mark the OMR carefully as instructed.
                    Do not fold, damage or tamper with it.
                    <strong>Submit the OMR</strong>
                    to the invigilator before leaving.

                </div>

            </div>


            <div class="instruction">

                <div class="instruction-number">
                    5
                </div>

                <div class="instruction-text">

                    Cheating, copying, impersonation or any unfair
                    means will result in
                    <span class="danger">disqualification</span>.
                    Follow all instructions given by examination officials.

                </div>

            </div>

        </div>


        <div class="best-luck">

            <span>
                ★ &nbsp; BEST OF LUCK &nbsp; ★
            </span>

        </div>

    </section>

</div>


<% if (typeof centrePortal !== "undefined" && centrePortal && backUrl) { %>
<div class="centre-portal-controls">
    <a href="<%= backUrl %>">
        ← Back to Candidate
    </a>
</div>
<% } %>

<div class="print-controls">

    <button onclick="window.print()">
        Print / Save Admit Card
    </button>

</div>


</body>
</html>
