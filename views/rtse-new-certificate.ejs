<%
const sectionRank = Number(certificate?.section_rank || 0);

if (
    !Number.isFinite(sectionRank) ||
    sectionRank < 1 ||
    sectionRank > 10
) {
    throw new Error(
        "The new certificate system only supports Section Rank 1–10."
    );
}

let design = "";
let category = "";
let rankLabel = `Section Rank ${sectionRank}`;

if (sectionRank === 1) {
    design = "rank1";
    category = "Excellence Certificate";
    rankLabel = "1st Rank";
} else if (sectionRank === 2) {
    design = "rank2";
    category = "Excellence Certificate";
    rankLabel = "2nd Rank";
} else if (sectionRank === 3) {
    design = "rank3";
    category = "Excellence Certificate";
    rankLabel = "3rd Rank";
} else if (sectionRank >= 4 && sectionRank <= 10) {
    design = "merit";
    category = "Merit Certificate";
}

let writingSkillGrade =
    certificate?.writing_skill_grade ||
    certificate?.writingSkillGrade ||
    "";

if (!writingSkillGrade && certificate?.writing_skill_marks != null) {
    const marks = Number(certificate.writing_skill_marks);
    const maximum = Number(certificate.writing_skill_maximum_marks || 100);

    if (maximum > 0) {
        const percentage = (marks / maximum) * 100;

        if (percentage >= 90) writingSkillGrade = "A+";
        else if (percentage >= 80) writingSkillGrade = "A";
        else if (percentage >= 70) writingSkillGrade = "B+";
        else if (percentage >= 60) writingSkillGrade = "B";
        else if (percentage >= 50) writingSkillGrade = "C+";
        else if (percentage >= 40) writingSkillGrade = "C";
        else writingSkillGrade = "F";
    }
}

writingSkillGrade = writingSkillGrade || "—";

const examName =
    certificateSetting?.exam_name ||
    "RATABARI TALLENT SEARCH EXAMINATION 2026";

const organizedBy =
    certificateSetting?.organized_by ||
    "ARSP NGO";

const certificateName =
    certificateCategorySetting?.certificate_name ||
    category;

const certificateDescriptionTemplate =
    certificateCategorySetting?.certificate_description ||
    "";

function renderCertificateDescription(template) {
    return String(template || "")
        .replace(/\{student_name\}/g, certificate?.full_name || "Student Name")
        .replace(/\{exam_name\}/g, examName)
        .replace(/\{rank\}/g, String(sectionRank))
        .replace(/\{rank_label\}/g, rankLabel)
        .replace(/\{section\}/g, certificate?.section || "Section")
        .replace(/\{year\}/g, String(new Date().getFullYear()));
}

const certificateDescription =
    renderCertificateDescription(
        certificateDescriptionTemplate
    );

const logo =
    siteSettings?.logo
        ? `/uploads/site-settings/${siteSettings.logo}`
        : "";

const qrCode =
    certificate?.qr_code
        ? `/uploads/rtse-certificates/${certificate.qr_code}`
        : "";

const presidentSignature =
    certificateSetting?.left_signature
        ? `/uploads/rtse-certificate-settings/${certificateSetting.left_signature}`
        : "";

const directorSignature =
    certificateSetting?.right_signature
        ? `/uploads/rtse-certificate-settings/${certificateSetting.right_signature}`
        : "";

const presidentLabel =
    certificateSetting?.left_signature_label ||
    "President";

const directorLabel =
    certificateSetting?.right_signature_label ||
    "RTSE Controller";
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= certificate?.full_name || "RTSE Certificate" %> - <%= category %></title>

    <link rel="stylesheet"
          href="/css/rtse-certificate-<%= design %>.css">
</head>

<body>
<% if (design === "rank1") { %>

    <%
        const studentPhoto =
            certificate?.photo
                ? `/uploads/rtse/${certificate.photo}`
                : "";
    %>

