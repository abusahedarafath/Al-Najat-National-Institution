<%
const sectionRank = Number(certificate?.section_rank || 0);

if (
    !Number.isFinite(sectionRank) ||
    sectionRank < 1 ||
    sectionRank > 10
) {
    throw new Error(
        "The new certificate system only supports Section Rank 1–10."
    );
}

let design = "";
let category = "";
let rankLabel = `Section Rank ${sectionRank}`;

if (sectionRank === 1) {
    design = "rank1";
    category = "Excellence Certificate";
    rankLabel = "1st Rank";
} else if (sectionRank === 2) {
    design = "rank2";
    category = "Excellence Certificate";
    rankLabel = "2nd Rank";
} else if (sectionRank === 3) {
    design = "rank3";
    category = "Excellence Certificate";
    rankLabel = "3rd Rank";
} else if (sectionRank >= 4 && sectionRank <= 10) {
    design = "merit";
    category = "Merit Certificate";
}

let writingSkillGrade =
    certificate?.writing_skill_grade ||
    certificate?.writingSkillGrade ||
    "";

if (!writingSkillGrade && certificate?.writing_skill_marks != null) {
    const marks = Number(certificate.writing_skill_marks);
    const maximum = Number(certificate.writing_skill_maximum_marks || 100);

    if (maximum > 0) {
        const percentage = (marks / maximum) * 100;

        if (percentage >= 90) writingSkillGrade = "A+";
        else if (percentage >= 80) writingSkillGrade = "A";
        else if (percentage >= 70) writingSkillGrade = "B+";
        else if (percentage >= 60) writingSkillGrade = "B";
        else if (percentage >= 50) writingSkillGrade = "C+";
        else if (percentage >= 40) writingSkillGrade = "C";
        else writingSkillGrade = "F";
    }
}

writingSkillGrade = writingSkillGrade || "—";

const examName =
    setting?.exam_name ||
    "RATABARI TALLENT SEARCH EXAMINATION 2026";

const logo =
    siteSettings?.logo
        ? `/uploads/site-settings/${siteSettings.logo}`
        : "";

const qrCode =
    certificate?.qr_code
        ? `/uploads/rtse-certificates/${certificate.qr_code}`
        : "";

const presidentSignature =
    setting?.president_signature
        ? `/uploads/arsp-settings/${setting.president_signature}`
        : "";

const directorSignature =
    certificate?.director_signature
        ? `/uploads/rtse/${certificate.director_signature}`
        : (
            setting?.director_signature
                ? `/uploads/arsp-settings/${setting.director_signature}`
                : ""
        );
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= certificate?.full_name || "RTSE Certificate" %> - <%= category %></title>

    <link rel="stylesheet"
          href="/css/rtse-certificate-<%= design %>.css">
</head>

<body>
<% if (design === "rank1") { %>

    <%
        const studentPhoto =
            certificate?.photo
                ? `/uploads/rtse/${certificate.photo}`
                : "";
    %>

    <div class="certificate-page rank1">

        <div class="rank1-frame">

    <img
        class="rank1-template-background"
        src="/images/rtse-certificates/rank1-template.png"
        alt=""
        aria-hidden="true"
    >

    <div class="rank1-overlay">

        <% if (logo) { %>
            <img
                class="rank1-overlay-logo"
                src="<%= logo %>"
                alt="ARSP Logo"
            >
        <% } %>

        <div class="rank1-overlay-heading">
            <div class="rank1-overlay-exam-name">
                <%= examName %>
            </div>
            <div class="rank1-overlay-organized">
                Organized by ARSP NGO
            </div>
        </div>

        <% if (studentPhoto) { %>
            <img
                class="rank1-overlay-photo"
                src="<%= studentPhoto %>"
                alt="Student Photo"
            >
        <% } %>

        <div class="rank1-overlay-student">
            <div class="rank1-overlay-student-name">
                <%= certificate?.full_name || "Student Name" %>
            </div>



            <div class="rank1-overlay-award">
                This certificate is proudly awarded for securing the
                <strong>First Rank</strong> in the
                <strong><%= examName %></strong>.
            </div>
        </div>

        <% if (qrCode) { %>
            <img
                class="rank1-overlay-qr"
                src="<%= qrCode %>"
                alt="Certification QR Code"
            >
        <% } %>

        <% if (presidentSignature) { %>
            <img
                class="rank1-overlay-president-signature"
                src="<%= presidentSignature %>"
                alt="President Signature"
            >
        <% } %>

        <% if (directorSignature) { %>
            <img
                class="rank1-overlay-director-signature"
                src="<%= directorSignature %>"
                alt="Director Signature"
            >
        <% } %>

        <div class="rank1-overlay-president-label">
            President
        </div>

        <div class="rank1-overlay-director-label">
            RTSE Controller
        </div>

    </div>
</div>

    </div>


