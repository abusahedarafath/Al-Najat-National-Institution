const db = require("../config/database");

class Gallery {

// Update image caption
static updateImageCaption(id, caption, callback) {
    db.query(
        "UPDATE gallery_images SET caption=? WHERE id=?",
        [caption, id],
        callback
    );
}


    // Get single image
static async getImageById(id) {
    const [rows] = await db.query(
        "SELECT * FROM gallery_images WHERE id=?",
        [id]
    );
    return rows;
}


// Get all albums
static async getAllAlbums() {
    const [rows] = await db.query(
        "SELECT * FROM gallery_albums ORDER BY id DESC"
    );

    return rows;
}

    // Get active albums
    static getActiveAlbums(callback) {
        db.query(
            "SELECT * FROM gallery_albums WHERE status='Active' ORDER BY id DESC",
            callback
        );
    }



//get one album
static async getAlbumById(id) {
    const [rows] = await db.query(
        "SELECT * FROM gallery_albums WHERE id=?",
        [id]
    );
    return rows;
}


    // Create album
    static createAlbum(data, callback) {
        db.query(
            `INSERT INTO gallery_albums
            (title, description, cover_image, status)
            VALUES (?, ?, ?, ?)`,
            [
                data.title,
                data.description,
                data.cover_image,
                data.status
            ],
            callback
        );
    }

    // Update album
    static updateAlbum(id, data, callback) {
        db.query(
            `UPDATE gallery_albums
             SET title=?,
                 description=?,
                 cover_image=?,
                 status=?
             WHERE id=?`,
            [
                data.title,
                data.description,
                data.cover_image,
                data.status,
                id
            ],
            callback
        );
    }



//get image
   static async getImages(albumId) {
    const [rows] = await db.query(
        "SELECT * FROM gallery_images WHERE album_id=? ORDER BY id DESC",
        [albumId]
    );
    return rows;
}

    // Add image
    static addImage(data, callback) {
        db.query(
            `INSERT INTO gallery_images
            (album_id, image, caption)
            VALUES (?, ?, ?)`,
            [
                data.album_id,
                data.image,
                data.caption
            ],
            callback
        );
    }

    // Delete image

static async deleteImage(id) {
    await db.query(
        "DELETE FROM gallery_images WHERE id=?",
        [id]
    );
}

}
module.exports = Gallery;

